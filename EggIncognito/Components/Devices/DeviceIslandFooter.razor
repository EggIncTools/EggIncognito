<div class="dis-foot">
    @if (_creating) {
        <input class="field-input" placeholder="island label" aria-label="New island label"
               @bind="_label" @bind:event="oninput" @onkeydown="LabelKeyAsync"/>
        <button type="button" class="btn-mini" disabled="@(Busy || _label.Trim().Length == 0)" @onclick="CreateAsync">Create</button>
        <button type="button" class="btn-mini" @onclick="CancelCreate">Cancel</button>
    } else {
        <button type="button" class="btn-mini" disabled="@Busy" @onclick="StartCreate">
            <Icon Name="plus" Class="icon-sm"/>
            New island
        </button>
        <button type="button" class="btn-mini" disabled="@Busy" @onclick="@(() => OnRefresh.InvokeAsync())">
            <Icon Name="refresh-cw" Class="icon-sm"/>
            Refresh
        </button>
        <span class="dis-note">one island runs at a time</span>
    }
</div>

@code {

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<string> OnCreate { get; set; }

    [Parameter] public EventCallback OnRefresh { get; set; }

    bool _creating;
    string _label = "";

    void StartCreate() {
        _creating = true;
        _label = "";
    }

    void CancelCreate() {
        _creating = false;
        _label = "";
    }

    Task LabelKeyAsync(KeyboardEventArgs e) {
        if (e.Key == "Enter") return CreateAsync();
        if (e.Key == "Escape") CancelCreate();
        return Task.CompletedTask;
    }

    async Task CreateAsync() {
        var label = _label.Trim();
        if (label.Length == 0) return;
        _creating = false;
        _label = "";
        await OnCreate.InvokeAsync(label);
    }

}
