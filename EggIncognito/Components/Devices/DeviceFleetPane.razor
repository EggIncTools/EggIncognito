@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Core
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Devices
@inherits BrowserApiComponentBase
@inject AdminNotifier Notifier

<div class="vd-pane">
    <div class="vd-head">
        <div class="sub-section-head">Fleet</div>
        <span class="text-xs text-muted">@(_status is { } head ? $"{head.LiveCount} of {head.MaxInstances} live" : "loading")</span>
        <div class="vd-head-actions">
            <button type="button" class="btn-mini" disabled="@(_busy || _status?.Enabled != true)" @onclick="Create">
                Provision
            </button>
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="Reconcile">Reconcile</button>
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="Load">Refresh</button>
        </div>
    </div>

    @if (_status?.Note is { Length: > 0 } note) {
        <div class="text-xs text-muted">@note</div>
    }

    @if (_status is null) {
        <div class="wb-note">loading</div>
    } else if (_status.Instances.Count == 0) {
        <div class="wb-note">No instances provisioned.</div>
    } else {
        <div class="reg-wrap">
            <table class="data-table">
                <thead>
                <tr>
                    <th>instance</th><th>state</th><th>activity</th><th>target</th><th>up</th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var i in _status.Instances) {
                    <tr @key="i.InstanceId">
                        <td class="font-mono text-xs">@i.InstanceId</td>
                        <td class="text-xs @StateCss(i)" title="@i.Note">@StateLabel(i)</td>
                        <td class="text-xs text-muted">@(i.Activity ?? i.Note)</td>
                        <td class="font-mono text-xs">@i.Target</td>
                        <td class="text-xs text-muted">
                            <TimeAgo Value="@i.CreatedAt" Hover="false"/>
                        </td>
                        <td class="vd-row-actions">
                            @if (_armedDestroy == i.InstanceId) {
                                <button type="button" class="btn-mini btn-danger" disabled="@_busy"
                                        @onclick="() => Destroy(i.InstanceId)">
                                    confirm destroy
                                </button>
                                <button type="button" class="btn-mini" disabled="@_busy" @onclick="DisarmDestroy">keep</button>
                            } else {
                                <button type="button" class="btn-mini btn-danger" disabled="@_busy"
                                        @onclick="() => ArmDestroy(i.InstanceId)">
                                    destroy
                                </button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div class="vd-cols">
        <div class="vd-col">
            <div class="vd-col-head">
                <div class="sub-section-head">Images</div>
                @if (_images is { } active) {
                    <span class="text-xs text-muted">active <span class="font-mono">@(active.ActiveTag is { Length: > 0 } ? active.ActiveTag : active.ConfigImage)</span></span>
                    @if (!active.DockerOk) {
                        <span class="text-xs text-err">docker unreachable</span>
                    }
                }
            </div>
            @if (_images is { } iv) {
                @if (iv.Note is { Length: > 0 } inote) {
                    <div class="text-xs text-muted">@inote</div>
                }

                <div class="vd-build">
                    <input type="text" class="field-input" @bind="_buildVer" placeholder="11.0.0" aria-label="android version"/>
                    <label class="vd-check"><input type="checkbox" @bind="_gapps"/> gapps</label>
                    <label class="vd-check"><input type="checkbox" @bind="_magisk"/> magisk</label>
                    <label class="vd-check"><input type="checkbox" @bind="_ndk"/> ndk</label>
                    <label class="vd-check"><input type="checkbox" @bind="_integrity"/> integrity</label>
                    <button type="button" class="btn-mini" disabled="@(_busy || !iv.BuildEnabled)" @onclick="BuildImage">
                        Build
                    </button>
                </div>
                @if (!iv.BuildEnabled) {
                    <div class="text-xs text-muted">builds disabled (Devices:Virtual:Build:Enabled)</div>
                }

                @if (_build is { } b) {
                    <div class="text-xs @(b.State == ImageBuildStates.Failed ? "text-err" : "text-muted")">
                        build <span class="font-mono">@b.Tag</span>: @b.State@(b.Note is { Length: > 0 } bn ? $", {bn}" : "")
                    </div>
                }

                @if (iv.Images.Count == 0) {
                    <div class="text-xs text-muted">no redroid images on this host</div>
                } else {
                    <div class="reg-wrap">
                        <table class="data-table">
                            <thead>
                            <tr>
                                <th>Tag</th><th>Size</th><th>Created</th><th></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var img in iv.Images) {
                                <tr class="@(img.Active ? "vd-row-active" : "")">
                                    <td class="font-mono text-xs">@(img.Tag ?? "none")</td>
                                    <td class="font-mono text-xs">@ByteFormat.Mb(img.Size, "F0")</td>
                                    <td class="text-muted text-xs">
                                        <TimeAgo Value="@img.Created" Hover="false"/>
                                    </td>
                                    <td class="vd-row-actions">
                                        @if (img.Tag is { Length: > 0 } t) {
                                            @if (!img.Active) {
                                                <button type="button" class="btn-mini" disabled="@_busy"
                                                        @onclick="() => UseImage(t)">
                                                    use
                                                </button>
                                            }

                                            <button type="button" class="btn-mini btn-danger" disabled="@_busy"
                                                    @onclick="() => RemoveImage(t)">
                                                remove
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            } else if (_imagesErr is { Length: > 0 } ierr) {
                <div class="text-xs text-muted">images unavailable: @ierr</div>
            } else {
                <div class="text-xs text-muted">loading</div>
            }
        </div>

        <div class="vd-col">
            <div class="vd-col-head">
                <div class="sub-section-head">Integrity modules</div>
                <div class="vd-head-actions">
                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="RefreshModules">Refresh cache</button>
                </div>
            </div>
            @if (_modules is { Count: > 0 } mods) {
                <div class="reg-wrap">
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th>Module</th><th>Version</th><th>Size</th><th>Source</th><th>State</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var m in mods) {
                            <tr>
                                <td class="font-mono text-xs">@m.Name</td>
                                <td class="text-xs">@(m.Version ?? "?")</td>
                                <td class="font-mono text-xs">@ByteFormat.Mb(m.ByteSize, "F1")</td>
                                <td class="text-muted text-xs truncate">@m.Source</td>
                                <td class="text-xs @(m.Error is { Length: > 0 } ? "text-err" : "")">
                                    @(m.Error is { Length: > 0 } err ? err : m.Cached ? "cached" : "fetched")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            } else {
                <div class="text-xs text-muted">no modules cached yet</div>
            }

            @if (_assets is { } assets) {
                @if (assets.Ok) {
                    <div class="text-xs">
                        @assets.Model <span class="font-mono">@assets.Fingerprint</span>
                        <span class="text-muted">until @(assets.Expiry ?? "?")</span>
                    </div>
                    <div class="text-xs">keybox @assets.KeyboxSource, @assets.KeyboxCerts certs, @assets.KeyboxNote</div>
                } else {
                    <div class="text-xs text-err">@assets.Error</div>
                }

                @foreach (var warning in assets.Warnings) {
                    <div class="text-xs text-muted">@warning</div>
                }
            }
        </div>
    </div>
</div>

@code {

    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback<DeviceNotice> OnNotice { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    VirtualDevicesStatus? _status;
    ImagesView? _images;
    string? _imagesErr;
    List<ModuleCacheRow>? _modules;
    IntegrityAssetsView? _assets;
    string? _armedDestroy;
    ImageBuildStatusView? _build;
    long? _buildId;
    string _buildVer = "11.0.0";
    bool _gapps = true;
    bool _magisk = true;
    bool _ndk = true;
    bool _integrity;
    bool _busy;
    bool _loaded;
    bool _loading;
    bool _visible = true;
    bool _pendingFleet;
    bool _pendingBuild;
    IDisposable? _topics;
    PageVisibility? _vis;

    PageVisibility Vis => _vis ??= new PageVisibility(Js, Env);

    static string StateLabel(VirtualInstanceRow row) {
        return row.ContainerPresent ? row.State : $"{row.State}, no container";
    }

    static string StateCss(VirtualInstanceRow row) {
        if (!row.ContainerPresent || row.State == ProvisionStates.Failed) return "text-err";
        if (row.State == ProvisionStates.Ready) return "text-ok";
        if (row.State is ProvisionStates.Creating or ProvisionStates.Booting) return "text-accent";
        return "text-muted";
    }

    protected override async Task OnApiReadyAsync() {
        _topics ??= Notifier.Subscribe(OnTopic);
        await Vis.ListenAsync(OnVisibilityAsync);
        await EnsureLoadedAsync();
    }

    void OnTopic(string topic) {
        if (topic != AdminTopics.VirtualDevices && topic != AdminTopics.ImageBuilds) return;
        _ = InvokeAsync(() => PushedAsync(topic));
    }

    async Task PushedAsync(string topic) {
        if (Api is null || !Active) return;
        if (topic == AdminTopics.ImageBuilds) _pendingBuild = true;
        else _pendingFleet = true;
        if (!_visible) return;
        await DrainAsync();
    }

    async Task OnVisibilityAsync(bool visible) {
        _visible = visible;
        if (!visible) return;
        await InvokeAsync(DrainAsync);
    }

    async Task DrainAsync() {
        if (Api is null || !Active || _busy || _loading) return;
        _loading = true;
        try {
            while (_pendingFleet || _pendingBuild) {
                var fleet = _pendingFleet;
                var build = _pendingBuild;
                _pendingFleet = false;
                _pendingBuild = false;
                if (fleet) await LoadFleet();
                if (build) await LoadBuild();
            }
        } finally {
            _loading = false;
        }

        StateHasChanged();
    }

    protected override Task OnParametersSetAsync() {
        return EnsureLoadedAsync();
    }

    async Task EnsureLoadedAsync() {
        if (!Active || Api is null || _loaded) return;
        _loaded = true;
        await Load();
    }

    public override async ValueTask DisposeAsync() {
        _topics?.Dispose();
        _topics = null;
        if (_vis is not null) await _vis.DisposeAsync();
        await base.DisposeAsync();
    }

    async Task Load() {
        if (Api is null) return;
        _pendingFleet = false;
        _pendingBuild = false;
        var res = await Api.GetAsync("/api/devices/virtual");
        if (!res.Ok) {
            await Say($"load failed: {res.Describe()}", StatusNoteKind.Error);
            return;
        }

        _status = res.Json<VirtualDevicesStatus>();
        StateHasChanged();
        await LoadImages();
        await LoadModules();
        StateHasChanged();
        await LoadAssets();
    }

    async Task LoadFleet() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/devices/virtual");
        if (!res.Ok) return;
        _status = res.Json<VirtualDevicesStatus>();
    }

    async Task LoadBuild() {
        if (Api is null) return;
        if (_buildId is { } id) {
            var res = await Api.GetAsync($"/api/devices/virtual/images/build/{id}");
            if (res.Ok && res.Json<ImageBuildStatusView>() is { } b) {
                _build = b;
                if (ImageBuildStates.IsTerminal(b.State)) {
                    _buildId = null;
                    var ok = b.State == ImageBuildStates.Ready;
                    await Say(ok ? $"image {b.Tag} built" : $"build failed: {b.Note ?? "see log"}",
                        ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
                }
            }
        }

        await LoadImages();
    }

    async Task LoadImages() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/devices/virtual/images");
        if (res.Ok) {
            _images = res.Json<ImagesView>();
            _imagesErr = null;
        } else {
            _imagesErr = res.Describe();
        }
    }

    async Task LoadModules() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/devices/virtual/modules");
        if (res.Ok) _modules = res.Json<List<ModuleCacheRow>>();
    }

    async Task LoadAssets() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/devices/virtual/integrity");
        if (res.Ok) _assets = res.Json<IntegrityAssetsView>();
    }

    async Task Create() {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostJsonAsync("/api/devices/virtual", new VirtualCreateRequest(null),
                TimeSpan.FromMinutes(2));
            var body = res.Json<VirtualActionResult>();
            await Say(res.Ok
                    ? $"provisioned {body?.InstanceId ?? "instance"}"
                    : $"provision failed: {body?.Note ?? res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        } finally {
            _busy = false;
        }

        await Load();
        await Changed();
    }

    void ArmDestroy(string instanceId) {
        _armedDestroy = instanceId;
    }

    void DisarmDestroy() {
        _armedDestroy = null;
    }

    async Task Destroy(string instanceId) {
        if (Api is null || _busy) return;
        _busy = true;
        _armedDestroy = null;
        try {
            var res = await Api.SendAsync("DELETE", $"/api/devices/virtual/{Uri.EscapeDataString(instanceId)}",
                timeout: TimeSpan.FromMinutes(2));
            var body = res.Json<VirtualActionResult>();
            await Say(res.Ok
                    ? $"destroyed {instanceId}"
                    : $"destroy refused: {body?.Note ?? res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        } finally {
            _busy = false;
        }

        await Load();
        await Changed();
    }

    async Task Reconcile() {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostAsync("/api/devices/virtual/reconcile", TimeSpan.FromMinutes(2));
            var body = res.Json<VirtualActionResult>();
            await Say(res.Ok ? body?.Note ?? "reconciled" : $"reconcile failed: {res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        } finally {
            _busy = false;
        }

        await Load();
        await Changed();
    }

    async Task BuildImage() {
        if (Api is null || _busy) return;
        _busy = true;
        _build = null;
        _buildId = null;
        try {
            var req = new ImageBuildRequest(_buildVer, _gapps, _magisk, _ndk, null, _integrity);
            var res = await Api.PostJsonAsync("/api/devices/virtual/images/build", req, TimeSpan.FromMinutes(2));
            var start = res.Json<ImageBuildStartResult>();
            if (!res.Ok || start is not { Ok: true, Id: { } sid }) {
                await Say($"build refused: {start?.Note ?? res.Describe()}", StatusNoteKind.Error);
                return;
            }

            _buildId = sid;
            await Say($"build {start.Tag} started, running in the background", StatusNoteKind.Ok);
        } finally {
            _busy = false;
        }

        _pendingBuild = true;
        await DrainAsync();
    }

    async Task UseImage(string tag) {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostJsonAsync("/api/devices/virtual/images/use", new ImageUseRequest(tag));
            var body = res.Json<VirtualActionResult>();
            await Say(res.Ok ? body?.Note ?? $"active image set to {tag}" : $"use failed: {res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        } finally {
            _busy = false;
        }

        await LoadImages();
    }

    async Task RemoveImage(string tag) {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostJsonAsync("/api/devices/virtual/images/remove", new ImageRemoveRequest(tag));
            var body = res.Json<VirtualActionResult>();
            await Say(res.Ok ? $"removed {tag}" : $"remove refused: {body?.Note ?? res.Describe()}",
                res.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error);
        } finally {
            _busy = false;
        }

        await LoadImages();
    }

    async Task RefreshModules() {
        if (Api is null || _busy) return;
        _busy = true;
        try {
            var res = await Api.PostAsync("/api/devices/virtual/modules/refresh", TimeSpan.FromMinutes(2));
            if (!res.Ok) {
                await Say($"refresh failed: {res.Describe()}", StatusNoteKind.Error);
                return;
            }

            _modules = res.Json<List<ModuleCacheRow>>();
            var assets = await Api.PostAsync("/api/devices/virtual/integrity/refresh", TimeSpan.FromMinutes(3));
            if (assets.Ok) _assets = assets.Json<IntegrityAssetsView>();
            var problem = !assets.Ok ? assets.Describe() : _assets is { Ok: false } failed ? failed.Error : null;
            await Say(problem is null ? "integrity cache refreshed" : $"modules refreshed, integrity assets: {problem}",
                problem is null ? StatusNoteKind.Ok : StatusNoteKind.Error);
        } finally {
            _busy = false;
        }
    }

    Task Changed() {
        return OnChanged.HasDelegate ? OnChanged.InvokeAsync() : Task.CompletedTask;
    }

    Task Say(string message, StatusNoteKind kind) {
        return OnNotice.InvokeAsync(new DeviceNotice(message, kind));
    }

}
