@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IServiceProvider Services
@inject DeviceWorkbenchState State
@inject ToastService Toasts
@inject AdminNotifier Notifier
@inject ILogger<DeviceWorkbenchModal> Logger
@inject ICaptureContributionKinds Kinds
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Threading.Channels
@using EggIncognito.Capture
@using EggIncognito.Components.Capture
@using EggIncognito.Core
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Contributions
@using EggIncognito.Models.Devices
@using EggIncognito.Services.Devices
@implements IDisposable

<WorkbenchModal Open="@(_open && _isAdmin)" Title="Devices" TitleId="deviceWorkbenchTitle"
                Size="WorkbenchSize.Wide" CardClass="dwb-card" BodyId="deviceWorkbench" OnClose="CloseModal">
    <Rail>
        <WorkbenchRail>
            @if (Physical().Any()) {
                <WorkbenchSection Label="Physical">
                    @foreach (var d in Physical()) {
                        @DeviceEntry(d)
                    }
                </WorkbenchSection>
            }
            <WorkbenchSection Label="Virtual">
                <WorkbenchEntry Selected="@State.FleetOpen" OnClick="ShowFleet">
                    <Lead>
                        <span class="wb-lead">
                            <Icon Name="server" Class="icon-sm"/>
                        </span>
                    </Lead>
                    <Name>Fleet</Name>
                    <MetaLine>
                        <span class="dwb-meta-vd">
                            <span>@(_fleet is { } fleet ? $"{fleet.LiveCount} of {fleet.MaxInstances} live" : "")</span>
                        </span>
                    </MetaLine>
                </WorkbenchEntry>
                @foreach (var d in Virtual()) {
                    @DeviceEntry(d)
                }
                @foreach (var i in PendingInstances()) {
                    <WorkbenchEntry Selected="false" OnClick="ShowFleet" @key="i.InstanceId">
                        <Lead>
                            <span class="wb-lead">
                                <Icon Name="circle-x" Class="icon-sm text-err"/>
                                <PlatformIcon Platform="android"/>
                            </span>
                        </Lead>
                        <Name>@i.InstanceId</Name>
                        <MetaLine>
                            <span class="dwb-meta-vd">
                                <span>@i.State@(i.Note is { Length: > 0 } ? $", {i.Note}" : "")</span>
                            </span>
                        </MetaLine>
                    </WorkbenchEntry>
                }
            </WorkbenchSection>
        </WorkbenchRail>
    </Rail>
    <ChildContent>
        @if (State.FleetOpen) {
            <DeviceFleetPane Active="true" OnNotice="Notice" OnChanged="ReloadDevices"/>
        } else if (Current is not { } dev) {
            @if (_devicesFailed) {
                <div class="wb-note">
                    Device list unavailable, the status call failed.
                    <button type="button" class="btn-mini" @onclick="ReloadDevices">Retry</button>
                </div>
            } else {
                <div class="wb-note">@(_devices.Count == 0 ? "No devices declared on this host." : "Pick a device.")</div>
            }
        } else {
            <div class="dwb-tabs">
                <WorkbenchModes Modes="@Tabs(dev)" Current="@State.Mode" CurrentChanged="SelectTab" Label="Device view"/>
            </div>

            <div class="dwb-pane @(DeviceWorkbenchState.IsConsoleTab(State.Mode) ? "dwb-pane-fill" : "")">
                @if (DeviceWorkbenchState.IsConsoleTab(State.Mode)) {
                    <DeviceConsolePane DeviceId="@dev.Id" Platform="@dev.Platform" Virtual="@dev.Virtual" Active="true"
                                       OnNotice="Notice" OnChanged="ReloadDevices">
                        <Actions>
                            @if (State.Mode == DeviceWorkbenchState.TabDevice) {
                                <button type="button" class="btn-primary" disabled="@Busy" @onclick="Launch">
                                    <Icon Name="play" Class="icon-sm"/>
                                    Launch
                                </button>
                                <button type="button" class="btn-mini" disabled="@Busy" @onclick="RestartApp">Restart app</button>
                                <button type="button" class="btn-mini" disabled="@Busy" @onclick="Recert">Recert</button>
                                <button type="button" class="btn-mini btn-danger" disabled="@Busy" @onclick="Destroy">
                                    <Icon Name="trash-2" Class="icon-sm"/>
                                    @(_destroyArmed ? "Destroy?" : "Destroy")
                                </button>
                            } else {
                                <button type="button" class="btn-primary" disabled="@Busy" @onclick="ProbeNow">
                                    <Icon Name="refresh-cw" Class="icon-sm"/>
                                    Probe
                                </button>
                                <button type="button" class="btn-mini" disabled="@Busy" @onclick="CheckStore">Check store</button>
                                <button type="button" class="btn-mini" disabled="@Busy" @onclick="RestartApp">Restart app</button>
                                @if (dev.Platform == "android") {
                                    <button type="button" class="btn-mini" disabled="@Busy" @onclick="Recert">Recert</button>
                                }

                                @if (_harvest is { InRegistry: false }) {
                                    <button type="button" class="btn-mini" disabled="@Busy" @onclick="SaveToRegistry">
                                        Save to registry
                                    </button>
                                }

                                <button type="button" class="btn-mini" disabled="@Busy" @onclick="Poke">Poke harvest</button>
                            }
                        </Actions>
                        <ActionNotes>@ActionLines(dev)</ActionNotes>
                    </DeviceConsolePane>
                }

                @if (State.Mode == DeviceWorkbenchState.TabJobs) {
                    <WorkbenchLoad T="JobGroupRow" Items="_jobs" EmptyText="No jobs yet." Context="jobs">
                        <div class="reg-wrap">
                            <table class="data-table dwb-jobs-table">
                                <thead>
                                <tr>
                                    <th>when</th><th>kind</th><th>outcome</th><th>repeat</th><th>took</th><th>trigger</th>
                                </tr>
                                </thead>
                                <tbody>
                                @{
                                    DateOnly? lastDay = null;
                                }
                                @foreach (var j in jobs) {
                                    var open = State.Expanded.Contains(j.Id);
                                    var day = DateOnly.FromDateTime(j.LastAt.ToLocalTime().DateTime);
                                    if (day != lastDay) {
                                        lastDay = day;
                                        <tr class="dwb-job-day">
                                            <td colspan="6">@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }

                                    <tr class="dwb-job-row @(open ? "dwb-job-open" : "")" @key="j.Id" @onclick="@(() => ToggleJob(j))">
                                        <td class="font-mono">@Stamp(j.LastAt)</td>
                                        <td>@j.Kind</td>
                                        <td>
                                            <span class="dwb-status">
                                                <Icon Name="@StateIcon(j.State)" Class="@($"icon-sm {StateClass(j.State)}")"/>
                                                <span>@(j.Outcome ?? j.State)</span>
                                            </span>
                                        </td>
                                        <td class="font-mono text-accent" title="@(j.Repeat > 1 ? $"since {Stamp(j.StartedAt)}" : null)">
                                            @(j.Repeat > 1 ? $"x{j.Repeat}" : "")
                                        </td>
                                        <td class="font-mono">@Duration(j)</td>
                                        <td class="dwb-job-trigger" title="@j.Trigger">@j.Trigger</td>
                                    </tr>
                                    @if (open) {
                                        <tr class="dwb-job-detail">
                                            <td colspan="6">
                                                <div class="dwb-job-lines">
                                                    @if (!string.IsNullOrEmpty(j.Message)) {
                                                        <div class="dwb-job-line text-muted">@j.Message</div>
                                                    }
                                                    @foreach (var l in LinesFor(j.Id)) {
                                                        <div class="dwb-job-line">
                                                            <span class="font-mono text-muted">@l.At.ToLocalTime().ToString("HH:mm:ss")</span>
                                                            @if (l.Entry is not null) {
                                                                <span class="font-mono">@l.Entry</span>
                                                            }
                                                            <span class="@LevelClass(l.Level)">@l.Text</span>
                                                            @if (l.Bytes is > 0) {
                                                                <span class="text-muted font-mono">@ByteFormat.Mb(l.Bytes.Value, "F1")</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                        @if (_jobsMore is not null) {
                            <button type="button" class="btn-mini mt-2" disabled="@_jobsBusy" @onclick="LoadMoreJobsAsync">
                                @(_jobsBusy ? "Loading..." : "Older jobs")
                            </button>
                        }
                    </WorkbenchLoad>
                }

                @if (State.Mode == DeviceWorkbenchState.TabCapture) {
                    @if (_hub is null) {
                        <div class="wb-note">Capture is not configured for this device on this host.</div>
                    } else {
                        <div class="dwb-capture">
                            <div class="dwb-capture-bar">
                                <CaptureControlsPanel View="State.Capture" ReadOnly="true"
                                                      OnViewChanged="StateHasChanged"/>
                            </div>
                            <div class="dwb-capture-body">
                                <FlowList Flows="_flows" SelectedId="_selectedFlowId" Connected="_connected"
                                          View="State.Capture" OnSelect="SelectFlow"/>
                                @if (_selectedFlow is { } selected) {
                                    <DetailPane Flow="selected" View="State.Capture" ClientFactory="Client">
                                        <Tools>
                                            @if (Kinds.For(selected.Path) is not null) {
                                                <button type="button" class="btn-mini" disabled="@(_offerBusy || _offered.Contains(selected.Id))"
                                                        @onclick="@(() => OfferAsync(dev, selected))">
                                                    <Icon Name="send" Class="icon-sm"/>
                                                    @(_offered.Contains(selected.Id) ? "Offered" : _offerBusy ? "Offering..." : "Offer for review")
                                                </button>
                                            }
                                        </Tools>
                                    </DetailPane>
                                }
                            </div>
                            <ContributePanel @ref="_contribute" ClientFactory="Client"/>
                        </div>
                    }
                }

                @if (State.Mode == DeviceWorkbenchState.TabBinaries) {
                    <div class="reg-wrap">
                        <table class="data-table">
                            <thead>
                            <tr>
                                <th>Version</th><th>SHA-256</th><th>Size</th><th>Symbols</th><th>Source</th><th>Pulled</th>
                                @if (_isContributor) {
                                    <th></th>
                                }
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var b in (_binaries ?? []).Where(x => x.Platform == dev.Platform)) {
                                <tr>
                                    <td>
                                        <VersionLine App="@b.Version"/>
                                    </td>
                                    <td class="font-mono text-xs">@(b.Sha256.Length >= 12 ? b.Sha256[..12] : b.Sha256)</td>
                                    <td class="font-mono text-xs">@ByteFormat.Mb(b.ByteSize, "F1")</td>
                                    <td class="font-mono text-xs">@(b.EffectiveSymbols > 0 ? b.EffectiveSymbols : b.NativeSymbols)</td>
                                    <td class="text-xs">@b.Source</td>
                                    <td class="text-muted text-xs">@b.PulledAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    @if (_isContributor) {
                                        <td class="dwb-row-tools">
                                            <a class="btn-mini" href="@DownloadUrl(b)" download>
                                                <Icon Name="download" Class="icon-sm"/>
                                                Download
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (_harvest is { Entries.Count: > 0 }) {
                        <div class="sub-section-head mt-4 mb-2">Latest harvest</div>
                        <div class="reg-wrap">
                            <table class="data-table">
                                <thead>
                                <tr>
                                    <th>Entry</th><th>Outcome</th><th>Size</th><th>Detail</th><th>When</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var e in _harvest.Entries) {
                                    <tr>
                                        <td class="font-mono text-xs">@e.Entry</td>
                                        <td class="text-xs">@e.Outcome</td>
                                        <td class="font-mono text-xs">@ByteFormat.Mb(e.Bytes, "F1")</td>
                                        <td class="text-muted text-xs">@e.Note</td>
                                        <td class="text-muted text-xs">@e.RanAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
</WorkbenchModal>

@code {

    [Parameter] public EventCallback OnChanged { get; set; }

    bool _open;
    bool _isAdmin;
    bool _isContributor;
    bool _disposed;
    bool _jobsBusy;
    bool _refreshing;
    bool _devicesFailed;
    bool _destroyArmed;
    IDisposable? _topics;
    CancellationTokenSource? _destroyCts;

    List<DeviceRow> _devices = [];
    List<LiveJob> _live = [];
    List<JobGroupRow>? _jobs;
    long? _jobsMore;
    readonly Dictionary<long, List<JobLineRow>> _jobLines = [];
    List<StoredBinaryRow>? _binaries;
    HarvestInfo? _harvest;
    RecertResultDto? _recert;
    VirtualDevicesStatus? _fleet;

    CaptureHub? _hub;
    IDisposable? _subscription;
    CancellationTokenSource? _loopCts;
    readonly List<DashboardFlow> _flows = [];
    readonly Dictionary<long, int> _flowIndex = new();
    bool _connected;
    int _port;
    long? _selectedFlowId;
    DashboardFlow? _selectedFlow;
    bool _offerBusy;
    readonly HashSet<long> _offered = [];
    ContributePanel? _contribute;

    DeviceRow? Current => _devices.FirstOrDefault(d => d.Id == State.SelectedId);

    DeviceJobFeed? Feed => Services.GetService(typeof(DeviceJobFeed)) as DeviceJobFeed;

    bool Busy => Current is not null && RunningFor(Current.Id) is not null;

    LiveJob? RunningFor(string id) {
        return _live.FirstOrDefault(j => j.Device == id);
    }

    IEnumerable<DeviceRow> Physical() {
        return Ordered().Where(d => !d.Virtual);
    }

    IEnumerable<DeviceRow> Virtual() {
        return Ordered().Where(d => d.Virtual);
    }

    IEnumerable<VirtualInstanceRow> PendingInstances() {
        if (_fleet is null) return [];
        return _fleet.Instances
            .Where(i => ProvisionStates.IsLive(i.State) || i.State == ProvisionStates.Failed)
            .Where(i => i.DeviceId is null || _devices.All(d => d.Id != i.DeviceId))
            .OrderBy(i => i.InstanceId, StringComparer.Ordinal);
    }

    RenderFragment DeviceEntry(DeviceRow d) => @<WorkbenchEntry Selected="@(State.SelectedId == d.Id && !State.FleetOpen)" @key="d.Id"
                                                                Foot="@FootFor(d)"
                                                                OnClick="@(() => Select(d.Id))">
                                                   <Lead>
                                                       <span class="wb-lead">
                                                           <Icon Name="@(d.Reachable ? "circle-check" : "circle-x")"
                                                                 Class="@($"icon-sm {(d.Reachable ? "text-ok" : "text-err")}")"/>
                                                           <PlatformIcon Platform="@d.Platform"/>
                                                       </span>
                                                   </Lead>
                                                   <Name>@d.Label</Name>
                                                   <MetaLine>
                                                       <VersionLine App="@d.InstalledAppVersion" Build="@d.InstalledBuild" Client="@Number(d.ClientVersion)"/>
                                                       @if (d.Virtual) {
                                                           <span class="dwb-meta-vd meta-dots">
                                                               <span>@(d.Target ?? "no address yet")</span>
                                                               @if (d.Up is { } up) {
                                                                   <span>up <TimeAgo Value="@up" Hover="false"/></span>
                                                               }
                                                           </span>
                                                       }
                                                   </MetaLine>
                                               </WorkbenchEntry>;

    RenderFragment? FootFor(DeviceRow d) {
        if (RunningFor(d.Id) is not { } busy) return null;
        return @<span class="dwb-status wb-st-run">
                   <Icon Name="play" Class="icon-sm"/><span>@busy.Kind</span>
               </span>;
    }

    RenderFragment ActionLines(DeviceRow dev) => @<text>
                                                      @if (!string.IsNullOrEmpty(dev.Note)) {
                                                          <div class="font-mono text-xs text-muted mt-2">@dev.Note</div>
                                                      }
                                                      @if (RunningFor(dev.Id) is { } run) {
                                                          <div class="dwb-job-line mt-2">
                                                              <span class="dwb-status wb-st-run">
                                                                  <Icon Name="play" Class="icon-sm"/>
                                                                  <span>@run.Kind</span>
                                                              </span>
                                                              <span class="text-muted">@run.Message</span>
                                                          </div>
                                                      }
                                                      @if (_recert is { } rc) {
                                                          <div class="dwb-job-lines mt-2">
                                                              <div class="dwb-job-line">
                                                                  <span class="dwb-status">
                                                                      <Icon Name="@(rc.Ok ? "circle-check" : "circle-x")"
                                                                            Class="@($"icon-sm {(rc.Ok ? "text-ok" : "text-err")}")"/>
                                                                      <span>@(rc.Ok ? "recert ok" : "recert failed")</span>
                                                                  </span>
                                                                  @if (!rc.Ok) {
                                                                      <span class="text-muted">at @(rc.FailedStep ?? "an unknown step")</span>
                                                                  }
                                                              </div>
                                                              @if (rc.Fields.TryGetValue("expiry", out var expiry)) {
                                                                  <div class="dwb-job-line text-muted">expiry @expiry</div>
                                                              }
                                                              @foreach (var line in rc.Log) {
                                                                  <div class="dwb-job-line font-mono text-xs text-muted">@line</div>
                                                              }
                                                          </div>
                                                      }
                                                  </text>;

    IReadOnlyList<(string Key, string Label, int? Count)> Tabs(DeviceRow dev) {
        return [.. DeviceWorkbenchState.ModesFor(dev.Virtual).Select(m => (m.Key, m.Label, TabCount(m.Key)))];
    }

    int? TabCount(string key) {
        return key switch {
            DeviceWorkbenchState.TabCapture => _flows.Count,
            DeviceWorkbenchState.TabBinaries => _binaries?.Count(x => x.Platform == Current?.Platform),
            _ => null
        };
    }

    static string Stamp(DateTimeOffset at) {
        return at.ToLocalTime().ToString("MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
    }

    static string? Number(int? value) {
        return value?.ToString(CultureInfo.InvariantCulture);
    }

    IEnumerable<DeviceRow> Ordered() {
        return _devices
            .OrderBy(d => d.Platform == "ios" ? 0 : d.Platform == "android" ? 1 : 2)
            .ThenBy(d => d.Label, StringComparer.OrdinalIgnoreCase);
    }

    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        _isContributor = User.IsAtLeast(UserRole.Contributor);
    }

    static string DownloadUrl(StoredBinaryRow b) {
        return $"/api/decomp/stored-binaries/{Uri.EscapeDataString(b.Platform)}/{Uri.EscapeDataString(b.Version)}/download";
    }

    public async Task Open(string? deviceId = null) {
        if (!_isAdmin) return;
        _open = true;
        if (deviceId is not null) {
            State.SelectedId = deviceId;
            State.FleetOpen = false;
        }

        await LoadAsync();
        State.SelectedId ??= Ordered().FirstOrDefault()?.Id;
        await LoadForDeviceAsync();
        await LoadBinariesAsync();
        _topics ??= Notifier.Subscribe(OnTopic);
        StateHasChanged();
    }

    public async Task OpenScreen(string? deviceId = null) {
        State.Mode = DeviceWorkbenchState.TabScreen;
        await Open(deviceId);
    }

    public async Task OpenCapture(string? deviceId = null) {
        State.Mode = DeviceWorkbenchState.TabCapture;
        await Open(deviceId);
    }

    public async Task OpenFleet() {
        State.FleetOpen = true;
        await Open();
    }

    void CloseModal() {
        _open = false;
        Unsubscribe();
        DetachCapture();
        DisarmDestroy();
        StateHasChanged();
    }

    void Unsubscribe() {
        _topics?.Dispose();
        _topics = null;
    }

    async Task Select(string id) {
        var wasFleet = State.FleetOpen;
        State.FleetOpen = false;
        if (State.SelectedId == id) {
            if (wasFleet) await LoadForDeviceAsync();
            return;
        }

        State.SelectedId = id;
        _recert = null;
        _jobs = null;
        _jobsMore = null;
        _jobLines.Clear();
        DisarmDestroy();
        DetachCapture();
        if (_devices.All(d => d.Id != id)) await LoadAsync();
        await LoadForDeviceAsync();
    }

    void ShowFleet() {
        if (State.FleetOpen) return;
        State.FleetOpen = true;
        DetachCapture();
    }

    async Task SelectTab(string tab) {
        State.Mode = tab;
        if (State.Mode == DeviceWorkbenchState.TabCapture) AttachCapture();
        if (State.Mode == DeviceWorkbenchState.TabJobs) await LoadJobsAsync();
    }

    void OnTopic(string topic) {
        if (_disposed || !_open) return;
        if (topic == AdminTopics.DeviceStatus) _ = InvokeAsync(RefreshAsync);
        else if (topic == AdminTopics.VirtualDevices) _ = InvokeAsync(RefreshFleetAsync);
    }

    async Task RefreshFleetAsync() {
        if (_disposed || !_open) return;
        await LoadAsync();
        await LoadFleetAsync();
        StateHasChanged();
    }

    async Task RefreshAsync() {
        if (_disposed || !_open || _refreshing) return;
        _refreshing = true;
        try {
            await LoadLiveAsync();
            if (_devicesFailed || _live.Any(j => _devices.All(d => d.Id != j.Device))) await LoadAsync();
            if (State.Mode == DeviceWorkbenchState.TabJobs && Current is not null) await RefreshJobsAsync();
            if (_subscription is null) ResolveHub();
            StateHasChanged();
        }
        finally {
            _refreshing = false;
        }
    }

    async Task LoadAsync() {
        var (ok, rows) = await Client().TryListAsync<DeviceRow>("/api/devices/status", Logger);
        if (ok) _devices = rows;
        _devicesFailed = !ok;
        await LoadLiveAsync();
        await LoadFleetAsync();
    }

    async Task ReloadDevices() {
        await LoadAsync();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    async Task LoadForDeviceAsync() {
        if (Current is not { } dev) return;
        State.AlignMode(dev.Virtual);
        ResolveHub();
        await LoadHarvestAsync();
        await LoadJobsAsync();
        if (State.Mode == DeviceWorkbenchState.TabCapture) AttachCapture();
    }

    async Task LoadLiveAsync() {
        if (!_isAdmin || Feed is not { } feed) {
            _live = [];
            return;
        }

        _live = [.. await feed.LiveAsync(CancellationToken.None)];
    }

    async Task LoadJobsAsync() {
        if (!_isAdmin || Current is not { } dev || Feed is not { } feed) return;
        var page = await feed.PageAsync(dev.Id, JobGroupCollapser.DefaultTake, null, CancellationToken.None);
        _jobs = [.. page.Rows];
        _jobsMore = page.NextBefore;
    }

    async Task RefreshJobsAsync() {
        if (!_isAdmin || Current is not { } dev || Feed is not { } feed) return;
        var page = await feed.PageAsync(dev.Id, JobGroupCollapser.DefaultTake, null, CancellationToken.None);
        if (_jobs is not { Count: > 0 } loaded) {
            _jobs = [.. page.Rows];
            _jobsMore = page.NextBefore;
        } else if (page.Rows.Count == 0) {
            _jobs = [];
            _jobsMore = null;
        } else {
            var oldest = page.Rows[^1].Id;
            _jobs = [.. page.Rows, .. loaded.Where(g => g.Id < oldest)];
        }

        PruneJobState();
        await RefreshOpenLinesAsync(dev.Id, feed);
    }

    void PruneJobState() {
        if (_jobs is not { } jobs) return;
        var ids = jobs.Select(j => j.Id).ToHashSet();
        State.Expanded.RemoveWhere(id => !ids.Contains(id));
        foreach (var id in _jobLines.Keys.Where(id => !ids.Contains(id)).ToList()) _jobLines.Remove(id);
    }

    async Task RefreshOpenLinesAsync(string deviceId, DeviceJobFeed feed) {
        if (_jobs is not { } jobs) return;
        foreach (var job in jobs.Where(j => j.FinishedAt is null && State.Expanded.Contains(j.Id))) {
            _jobLines[job.Id] = [.. await feed.LinesAsync(deviceId, job.Id, CancellationToken.None)];
        }
    }

    async Task LoadMoreJobsAsync() {
        if (!_isAdmin || Current is not { } dev || Feed is not { } feed) return;
        if (_jobsMore is not { } before || _jobsBusy) return;
        _jobsBusy = true;
        try {
            var page = await feed.PageAsync(dev.Id, JobGroupCollapser.DefaultTake, before, CancellationToken.None);
            _jobs = [.. _jobs ?? [], .. page.Rows];
            _jobsMore = page.NextBefore;
        }
        finally {
            _jobsBusy = false;
        }
    }

    IReadOnlyList<JobLineRow> LinesFor(long jobId) {
        return _jobLines.TryGetValue(jobId, out var lines) ? lines : [];
    }

    async Task ToggleJob(JobGroupRow job) {
        if (State.Expanded.Remove(job.Id)) return;
        State.Expanded.Add(job.Id);
        if (!_isAdmin || Current is not { } dev || Feed is not { } feed) return;
        if (_jobLines.ContainsKey(job.Id)) return;
        _jobLines[job.Id] = [.. await feed.LinesAsync(dev.Id, job.Id, CancellationToken.None)];
    }

    async Task LoadHarvestAsync() {
        if (Current is not { } dev) return;
        _harvest = await Client().OneAsync<HarvestInfo>($"/api/devices/{dev.Id}/harvest", Logger);
    }

    async Task LoadFleetAsync() {
        if (!_isAdmin) return;
        _fleet = await Client().OneAsync<VirtualDevicesStatus>("/api/devices/virtual", Logger);
    }

    VirtualInstanceRow? InstanceFor(DeviceRow dev) {
        return _fleet?.Instances.FirstOrDefault(i => string.Equals(i.DeviceId, dev.Id, StringComparison.Ordinal));
    }

    async Task LoadBinariesAsync() {
        var list = await Client().OneAsync<StoredBinaryList>("/api/decomp/stored-binaries", Logger);
        _binaries = list?.Binaries ?? [];
    }

    static string StateClass(string state) {
        return WorkbenchStatus.Class(WorkbenchStatus.Parse(state));
    }

    static string StateIcon(string state) {
        return WorkbenchStatus.Parse(state) switch {
            WorkbenchStatusKind.Done => "circle-check",
            WorkbenchStatusKind.Error => "circle-x",
            WorkbenchStatusKind.Running => "play",
            WorkbenchStatusKind.Queued => "clock",
            _ => "circle"
        };
    }

    static string LevelClass(string level) {
        return level switch {
            "error" => "text-err",
            "warn" => "dwb-warn",
            _ => "text-fg"
        };
    }

    static string Duration(JobGroupRow j) {
        if (j.FinishedAt is not { } end) return "running";
        var span = end - j.LastAt;
        return span.TotalSeconds < 1 ? "<1s" : $"{(int)span.TotalSeconds}s";
    }

    void Notice(DeviceNotice notice) {
        Toasts.Push(notice.Kind, notice.Text);
    }

    void Note(string text, bool ok) {
        Toasts.Push(ok ? StatusNoteKind.Ok : StatusNoteKind.Error, text);
    }

    async Task Act(string url, string ok) {
        if (Current is null) return;
        var res = await Client().PostAsync(url, null);
        var good = res.IsSuccessStatusCode || res.StatusCode == HttpStatusCode.Accepted;
        Note(good ? ok : await ReadError(res), good);
        await LoadAsync();
        await LoadForDeviceAsync();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    async Task OfferAsync(DeviceRow dev, DashboardFlow flow) {
        if (_offerBusy) return;
        _offerBusy = true;
        try {
            var res = await Client().PostAsJsonAsync("/api/contributions/offer",
                new ContributionOfferRequest(dev.Id, flow.Id), SelfCallJson.Web);
            if (!res.IsSuccessStatusCode) {
                Note(await ReadError(res), false);
                return;
            }

            _offered.Add(flow.Id);
            Note($"recorded {flow.Path} to your account", true);
            await Task.Delay(500);
            if (_contribute is { } panel) await panel.RefreshAsync();
        }
        finally {
            _offerBusy = false;
            StateHasChanged();
        }
    }

    Task ProbeNow() {
        return Act($"/api/devices/{Current!.Id}/refresh", "probed");
    }

    Task CheckStore() {
        return Act($"/api/devices/{Current!.Id}/check-update", "store check started");
    }

    Task SaveToRegistry() {
        return Act($"/api/devices/{Current!.Id}/save", "installed to registry");
    }

    Task Poke() {
        return Act($"/api/devices/{Current!.Id}/poke", "harvest queued");
    }

    async Task Launch() {
        if (Current is not { } dev) return;
        var res = await Client().PostAsJsonAsync($"/api/devices/{dev.Id}/cookbooks",
            new DeviceCookbookRequest(DeviceCookbookIds.LaunchApp), SelfCallJson.Web);
        Note(res.IsSuccessStatusCode ? "launch started" : await ReadError(res), res.IsSuccessStatusCode);
        await LoadLiveAsync();
        await LoadJobsAsync();
    }

    async Task Destroy() {
        if (Current is not { Virtual: true } dev) return;
        if (!_destroyArmed) {
            _ = ArmDestroy();
            return;
        }

        DisarmDestroy();
        if (InstanceFor(dev) is not { } instance) {
            await LoadFleetAsync();
            instance = InstanceFor(dev);
        }

        if (instance is null) {
            Note("no fleet instance registered for this device", false);
            return;
        }

        var res = await Client().DeleteAsync($"/api/devices/virtual/{instance.InstanceId}");
        if (!res.IsSuccessStatusCode) {
            var body = await ReadBody<VirtualActionResult>(res);
            Note($"destroy refused: {body?.Note ?? $"failed ({(int)res.StatusCode})"}", false);
            return;
        }

        Note($"destroyed {instance.InstanceId}", true);

        DetachCapture();
        State.SelectedId = null;
        _recert = null;
        _jobs = null;
        _jobsMore = null;
        _jobLines.Clear();
        await ReloadDevices();
        State.SelectedId = Ordered().FirstOrDefault()?.Id;
        await LoadForDeviceAsync();
    }

    async Task ArmDestroy() {
        _destroyCts?.Cancel();
        _destroyCts?.Dispose();
        _destroyCts = new CancellationTokenSource();
        var ct = _destroyCts.Token;
        _destroyArmed = true;
        try {
            await Task.Delay(TimeSpan.FromSeconds(4), ct);
        }
        catch (OperationCanceledException) {
            return;
        }

        _destroyArmed = false;
        StateHasChanged();
    }

    void DisarmDestroy() {
        _destroyArmed = false;
        _destroyCts?.Cancel();
        _destroyCts?.Dispose();
        _destroyCts = null;
    }

    async Task RestartApp() {
        if (Current is not { } dev) return;
        var id = dev.Id;
        var before = (await LiveProbeFor(id))?.LastSeen;
        var res = await Client().PostAsync($"/api/devices/{id}/restart-app", null);
        if (!res.IsSuccessStatusCode) {
            Note(await ReadError(res), false);
            return;
        }

        Note("launched, waiting for an API call...", true);
        StateHasChanged();
        for (var i = 0; i < 8 && !_disposed; i++) {
            await Task.Delay(2000);
            if (await LiveProbeFor(id) is { ClientVersion: { } n } probe && probe.LastSeen != before) {
                Note($"clientVersion {n} captured (fresh)", true);
                await LoadAsync();
                return;
            }
        }

        var proxyHint = _hub is not null && _port > 0 ? $" and its proxy points at :{_port}" : "";
        Note($"no fresh traffic captured (timed out); check the device is unlocked{proxyHint}", false);
    }

    async Task Recert() {
        if (Current is not { } dev) return;
        var id = dev.Id;
        _recert = null;
        var res = await Client().PostAsync($"/api/devices/{id}/recert", null);
        if (!res.IsSuccessStatusCode) {
            Note(await ReadError(res), false);
            return;
        }

        _recert = await res.Content.ReadFromJsonAsync<RecertResultDto>(SelfCallJson.Web);
        Note(_recert is { Ok: true } ? "recert ok" : $"recert failed at {_recert?.FailedStep ?? "?"}",
            _recert is { Ok: true });
        await LoadJobsAsync();
    }

    async Task<LiveProbe?> LiveProbeFor(string id) {
        return await Client().OneAsync<LiveProbe>($"/api/devices/{id}/live", Logger);
    }

    void ResolveHub() {
        if (Current is not { } dev) return;
        if (Services.GetService(typeof(IDeviceCaptureHubs)) is not IDeviceCaptureHubs hubs) return;
        if (hubs.HubFor(dev.Id) is not { } hub) return;
        _hub = hub;
        foreach (var f in hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(hub.StatsSnapshot());
    }

    void AttachCapture() {
        if (_hub is not { } hub || _subscription is not null) return;

        var (reader, subscription) = hub.Subscribe();
        _subscription = subscription;
        foreach (var f in hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(hub.StatsSnapshot());

        _loopCts = new CancellationTokenSource();
        var ct = _loopCts.Token;
        _ = Task.Run(async () => {
            try {
                await foreach (var env in reader.ReadAllAsync(ct)) {
                    await InvokeAsync(() => ApplyEnvelope(env));
                }
            }
            catch (OperationCanceledException) {
            }
            catch (ChannelClosedException) {
            }
        }, ct);
    }

    void DetachCapture() {
        _loopCts?.Cancel();
        _loopCts?.Dispose();
        _loopCts = null;
        _subscription?.Dispose();
        _subscription = null;
        _hub = null;
        _flows.Clear();
        _flowIndex.Clear();
        _selectedFlowId = null;
        _selectedFlow = null;
        _connected = false;
        _port = 0;
    }

    void ApplyEnvelope(CaptureEnvelope env) {
        switch (env.Kind) {
            case "flow" when env.Flow is not null:
                AddOrUpdateFlow(env.Flow);
                break;
            case "stats" when env.Stats is not null:
                ApplyStats(env.Stats);
                break;
        }

        StateHasChanged();
    }

    void AddOrUpdateFlow(DashboardFlow flow) {
        if (_flowIndex.TryGetValue(flow.Id, out var idx)) {
            _flows[idx] = flow;
            if (_selectedFlowId == flow.Id) _selectedFlow = flow;
            return;
        }

        _flowIndex[flow.Id] = _flows.Count;
        _flows.Add(flow);
    }

    void ApplyStats(CaptureStats stats) {
        _port = stats.Port;
        _connected = stats.ActiveConnections > 0 || stats.DeviceCount > 0;
    }

    void SelectFlow(long id) {
        _selectedFlowId = id;
        _selectedFlow = _flowIndex.TryGetValue(id, out var idx) ? _flows[idx] : null;
    }

    static async Task<T?> ReadBody<T>(HttpResponseMessage resp) {
        try {
            return await resp.Content.ReadFromJsonAsync<T>(SelfCallJson.Web);
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return default;
        }
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed ({(int)resp.StatusCode})";
        }
        catch {
        }

        return $"failed ({(int)resp.StatusCode})";
    }

    public void Dispose() {
        _disposed = true;
        Unsubscribe();
        DetachCapture();
        DisarmDestroy();
    }

}
