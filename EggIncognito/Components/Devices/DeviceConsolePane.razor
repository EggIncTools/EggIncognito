    Task ReplayAsync(RecordedGesture g) {
        return g.Kind == RecordedGestureKind.Tap
            ? TapAsync(g.X, g.Y)
            : SwipeAsync(g.X, g.Y, g.X2, g.Y2, g.DurationMs);
    }

    async Task ReplayAllAsync() {
        if (_replaying || _deviceId is null) return;
        _replaying = true;
        try {
            var steps = _recorded.ToArray();
            for (var i = 0; i < steps.Length; i++) {
                if (i > 0) {
                    var gap = steps[i].At - steps[i - 1].At;
                    if (gap > TimeSpan.Zero) await Task.Delay(gap > TimeSpan.FromSeconds(10) ? TimeSpan.FromSeconds(10) : gap);
                }

                _selectedGesture = steps[i];
                StateHasChanged();
                await ReplayAsync(steps[i]);
            }
        }
        finally {
            _replaying = false;
        }
    }

