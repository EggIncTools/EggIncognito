    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed [{(int)resp.StatusCode}]";
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return $"failed [{(int)resp.StatusCode}]";
        }

        return $"failed [{(int)resp.StatusCode}]";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_disposed) return;
        if (await ModuleAsync() is not { } module) return;

        if (_videoSupported is null) {
            _videoSupported = await SafeValueAsync<bool>(module, "supportsVideo");
            await Vis.ListenAsync(OnVisibilityAsync);
            _visible = await Vis.IsVisibleAsync();
            if (RecomputeVideo()) {
                StateHasChanged();
                return;
            }
        }

        await SyncStreamAsync(module);
        await SyncStageAsync(module);
        await SyncKeysAsync(module);
        await SyncWatchAsync(module);
    }

    async Task SyncStreamAsync(IJSObjectReference module) {
        if (_syncing) return;
        var wanted = _live && Active && _deviceId is not null && _streamError is null && (_visible || StreamWhileHidden);
        var video = $"{_deviceId}|video|{_quality}";
        if (wanted && _useVideo && string.IsNullOrEmpty(_canvas.Id)) return;
        var desired = !wanted ? "" : _useVideo ? $"{video}|{_canvas.Id}" : $"{_deviceId}|jpeg|{_fps}";
        if (desired == _streamKey) return;

        _syncing = true;
        try {
            _streamKey = desired;
            await HaltAsync(module);
            if (desired.Length == 0) return;

            _streamOnVideo = _useVideo;
            _videoKey = _useVideo ? video : "";
            var started = _useVideo
                ? await SafeValueAsync<bool>(module, "startVideo", _canvas, VideoUrl(), Ref(), new { maxQueue = 4, key = video, token = desired })
                : await SafeValueAsync<bool>(module, "start", _img, StreamUrl(), ScreenshotUrl(), Ref());
            if (!started && _streamKey == desired) {
                await StreamEndedAsync(_useVideo
                    ? "the browser could not start the video decoder"
                    : "the browser could not attach the image stream", 0);
            }
        }
        finally {
            _syncing = false;
        }
    }

    async Task SyncStageAsync(IJSObjectReference module) {
        var media = _useVideo ? _canvas : _img;
        var desired = _deviceId is null || !Active || string.IsNullOrEmpty(media.Id) || string.IsNullOrEmpty(_stage.Id)
            ? ""
            : $"{_deviceId}|{(_useVideo ? "v" : "j")}|{_stage.Id}|{media.Id}";
        if (desired == _stageKey) return;
        if (_stageKey.Length > 0) await SafeAsync(module, "unbindStage", _stage);
        _stageKey = desired;
        _keysKey = "";
        if (desired.Length == 0) return;

        await SafeAsync(module, "bindStage", _stage, media, Ref(),
            new { threshold = DragThresholdPx, longPressMs = LongPressMs, swipeMs = 200 });
    }

    async Task SyncKeysAsync(IJSObjectReference module) {
        var desired = _captureKeys && Active && _deviceId is not null && _stageKey.Length > 0 ? $"{_deviceId}|k" : "";
        if (desired == _keysKey) return;
        _keysKey = desired;
        await SafeAsync(module, "captureKeys", _stage, Ref(), desired.Length > 0, null);
    }

    async Task SyncWatchAsync(IJSObjectReference module) {
        var points = _useVideo && _hasFrame && TapWidth > 0 && !string.IsNullOrEmpty(_canvas.Id) ? WatchPayload() : [];
        var desired = points.Count == 0 ? "" : _canvas.Id + "|" + string.Join(";", points.Select(p => string.Create(CultureInfo.InvariantCulture,
            $"{p.Id} {p.Fx:0.####} {p.Fy:0.####} {p.R} {p.G} {p.B}")));
        if (desired == _watchKey) return;
        _watchKey = desired;
        if (points.Count == 0) {
            await SafeAsync(module, "clearWatchPoints", _canvas);
            if (_clientWatchingFor is { } was) SetClientWatching(was, false);
            return;
        }

        await SafeAsync(module, "watchPoints", _canvas, points,
            new { tolerance = WatchTolerance, cooldownMs = WatchCooldownMs });
        if (_deviceId is { } id) SetClientWatching(id, true);
    }

    List<WatchPoint> WatchPayload() {
        List<WatchPoint> list = [];
        foreach (var point in _watch.Points) {
            if (Rgb(point.Color) is not { } rgb) continue;
            var (fx, fy) = Fraction(point.X, point.Y);
            if (fx < 0) continue;
            list.Add(new WatchPoint(point.Id, fx, fy, rgb.R, rgb.G, rgb.B));
        }

        return list;
    }

    async Task HaltAsync(IJSObjectReference module) {
        if (_streamOnVideo || _videoKey.Length > 0)
            await SafeAsync(module, "stopVideo", _canvas, _videoKey);
        else if (!string.IsNullOrEmpty(_img.Id))
            await SafeAsync(module, "stop", _img);
        _streamOnVideo = false;
        _videoKey = "";
    }

    async Task StopStreamAsync() {
        _streamKey = "";
        _hasFrame = false;
        if (_module is not { } module) return;
        _watchKey = "";
        await SafeAsync(module, "clearWatchPoints", _canvas);
        if (_clientWatchingFor is { } watching) SetClientWatching(watching, false);
        await HaltAsync(module);
        if (_stageKey.Length > 0) {
            _stageKey = "";
            _keysKey = "";
            await SafeAsync(module, "unbindStage", _stage);
        }
    }

