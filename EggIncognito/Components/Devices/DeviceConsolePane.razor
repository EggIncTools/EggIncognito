    string PointStyle(int x, int y) {
        var (fx, fy) = Fraction(x, y);
        if (fx < 0) return "display:none";
        return string.Create(CultureInfo.InvariantCulture, $"left:{100.0 * fx:0.###}%;top:{100.0 * fy:0.###}%");
    }

    (double Fx, double Fy) Fraction(int x, int y) {
        var width = TapWidth;
        var height = TapHeight;
        if (width <= 0 || height <= 0) return (-1, -1);
        var (ox, oy, cw, ch) = ContentRect(width, height);
        return (ox + cw * x / width, oy + ch * y / height);
    }

