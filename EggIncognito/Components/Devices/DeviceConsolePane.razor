        if (Stale(id)) return;
        _islands = islands;
        if (current is not null)
            _selectedUserId = current.UserId != IslandScope.Owner && islands.Any(i => i.UserId == current.UserId) ? current.UserId : null;
        if (_selectedUserId is { } uid && islands.All(i => i.UserId != uid)) _selectedUserId = null;
        if (Cache is { } cache) {
            cache.Islands = islands;
            cache.IslandsLoaded = true;
            cache.CurrentUserId = _selectedUserId;
        }

        _islandBusy = false;
        StateHasChanged();
