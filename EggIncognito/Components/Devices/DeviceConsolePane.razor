    static string RunTitle(JobGroupRow job) {
        return job.Cookbook ?? job.Message ?? "cookbook";
    }

    string? RunNote() {
        if (_steps.Count > 0 || !_runDone || _runOk || _runCancelled) return null;
        return _runNote is { Length: > 0 } note ? note : null;
    }

    void StartRunWatch() {
        _topics ??= Notifier.Subscribe(OnTopic);
    }

    void StopRunWatch() {
        _topics?.Dispose();
        _topics = null;
    }

    void StartTick() {
        _tick ??= new Timer(Tick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    void StopTick() {
        _tick?.Dispose();
        _tick = null;
    }

    void Tick(object? state) {
        if (_disposed || _runDone || _mode != DeviceConsoleMode.Running) return;
        _ = InvokeAsync(StateHasChanged);
    }

    string Elapsed() {
        if (_runStartedAt is not { } started) return "0:00";
        var span = (_runFinishedAt ?? DateTimeOffset.UtcNow) - started;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.TotalHours >= 1
            ? string.Create(CultureInfo.InvariantCulture, $"{(int)span.TotalHours}:{span.Minutes:00}:{span.Seconds:00}")
            : string.Create(CultureInfo.InvariantCulture, $"{span.Minutes}:{span.Seconds:00}");
    }

    static string Stamp(DateTimeOffset at) {
        return at.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture);
    }

    static string OutcomeClass(string state) {
        return state.ToLowerInvariant() switch {
            "succeeded" => "text-ok",
            "failed" => "text-err",
            _ => "text-muted"
        };
    }

    string RunStateClass() {
        return !_runDone ? "text-accent" : _runCancelled ? "text-muted" : _runOk ? "text-ok" : "text-err";
    }

    string RunStateLine() {
        return !_runDone ? "running" : _runCancelled ? "stopped" : _runOk ? "done" : "failed";
    }

    static string StepClass(CookbookStepStatus status) {
        return status switch {
            CookbookStepStatus.Ok => "text-ok",
            CookbookStepStatus.Skipped => "text-muted",
            _ => "text-err"
        };
    }

    static string StepStateWord(CookbookStepStatus status) {
        return status switch {
            CookbookStepStatus.Ok => "done",
            CookbookStepStatus.Skipped => "skipped",
            _ => "failed"
        };
    }

    string RunReport() {
        var sb = new StringBuilder();
        sb.Append(_runTitle ?? "run").Append(' ').Append(RunStateLine());
        if (_runDone && !_runOk && !_runCancelled && _runFailedStepTitle is { Length: > 0 } failedAt) sb.Append(" at ").Append(failedAt);
        if (_runDone && !_runOk && _runNote is { Length: > 0 } runNote) sb.Append(", ").Append(runNote);
        sb.AppendLine();
        foreach (var step in _steps) {
            sb.Append("- ").Append(step.Title).Append(": ").Append(StepStateWord(step.Status));
            if (step.Note is { Length: > 0 } note) sb.Append(" (").Append(note).Append(')');
            sb.AppendLine();
        }

        if (_runLog.Count > 0) {
            sb.AppendLine();
            foreach (var line in _runLog) sb.AppendLine(line);
        }

        return sb.ToString();
    }

    Task Fail(string text) {
        return OnNotice.InvokeAsync(new DeviceNotice(text, StatusNoteKind.Error));
    }

    static async Task<long?> ReadJobId(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind != JsonValueKind.Object) return null;
            foreach (var name in JobIdNames) {
                if (!body.TryGetProperty(name, out var value)) continue;
                var text = value.ValueKind switch {
                    JsonValueKind.String => value.GetString(),
                    JsonValueKind.Number => value.GetRawText(),
                    _ => null
                };
                if (long.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id)) return id;
            }
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return null;
        }

        return null;
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed [{(int)resp.StatusCode}]";
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return $"failed [{(int)resp.StatusCode}]";
        }

        return $"failed [{(int)resp.StatusCode}]";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_disposed) return;
        if (await ModuleAsync() is not { } module) return;

        if (_videoSupported is null) {
            _videoSupported = await SafeValueAsync(() => module.InvokeAsync<bool>("supportsVideo").AsTask());
            if (RecomputeVideo()) {
                StateHasChanged();
                return;
            }
        }

        await SyncStreamAsync(module);
        await SyncStageAsync(module);
    }

    async Task SyncStreamAsync(IJSObjectReference module) {
        var wanted = _live && Active && _deviceId is not null && _streamError is null;
        var desired = !wanted ? "" : _useVideo ? $"{_deviceId}|video|{_quality}" : $"{_deviceId}|jpeg|{_fps}";
        if (desired == _streamKey) return;

        await HaltAsync(module);
        _streamKey = desired;
        if (desired.Length == 0) return;

        _streamOnVideo = _useVideo;
        if (_useVideo) await SafeAsync(() => module.InvokeVoidAsync("startVideo", _canvas, VideoUrl(), Ref(), new { maxQueue = 2 }).AsTask());
        else await SafeAsync(() => module.InvokeAsync<bool>("start", _img, StreamUrl(), Ref()).AsTask());
    }

    async Task SyncStageAsync(IJSObjectReference module) {
        var desired = _deviceId is null || !Active ? "" : _useVideo ? $"{_deviceId}|v" : $"{_deviceId}|j";
        if (desired == _stageKey) return;
        if (_stageKey.Length > 0) await SafeAsync(() => module.InvokeVoidAsync("unbindStage", _stage).AsTask());
        _stageKey = desired;
        if (desired.Length == 0) return;

        var media = _useVideo ? _canvas : _img;
        await SafeAsync(() => module.InvokeVoidAsync("bindStage", _stage, media, Ref(),
            new { threshold = DragThresholdPx, longPressMs = LongPressMs, swipeMs = 200 }).AsTask());
    }

    async Task HaltAsync(IJSObjectReference module) {
        if (_streamOnVideo) await SafeAsync(() => module.InvokeVoidAsync("stopVideo", _canvas).AsTask());
        else await SafeAsync(() => module.InvokeVoidAsync("stop", _img).AsTask());
        _streamOnVideo = false;
    }

    async Task StopStreamAsync() {
        _streamKey = "";
        _hasFrame = false;
        if (_module is not { } module) return;
        await HaltAsync(module);
        if (_stageKey.Length > 0) {
            _stageKey = "";
            await SafeAsync(() => module.InvokeVoidAsync("unbindStage", _stage).AsTask());
        }
    }

    string StreamUrl() {
        return $"/api/devices/{_deviceId}/ui/stream?fps={_fps}";
    }

    (int W, int H, int Bitrate) QualitySpec() {
        return _quality switch {
            StreamQuality.Fluid => (540, 960, 1_500_000),
            StreamQuality.Crisp => (1080, 1920, 6_000_000),
            _ => (720, 1280, 3_000_000)
        };
    }

    string VideoUrl() {
        var (w, h, bitrate) = QualitySpec();
        return string.Create(CultureInfo.InvariantCulture,
            $"/api/devices/{_deviceId}/ui/video?size={w}x{h}&bitrate={bitrate}");
    }

    [JSInvokable]
    public Task OnFrameSize(int naturalW, int naturalH) {
        _shotW = naturalW;
        _shotH = naturalH;
        _hasFrame = naturalW > 0;
