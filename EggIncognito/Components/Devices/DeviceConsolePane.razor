    async Task RunCookbookAsync(DeviceCookbookInfo book) {
        if (_deviceId is null || _runBusy) return;
        StopRunWatch();
        ResetRun();
        _runBusy = true;
        _runTitle = book.Title;
        _runStartedAt = DateTimeOffset.UtcNow;
        _mode = DeviceConsoleMode.Running;
        StateHasChanged();

        var argument = book.Options is { Count: > 0 } ? ArgFor(book) : null;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/cookbooks",
            new DeviceCookbookRequest(book.Id, argument, _selectedUserId), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) {
            var failed = await ReadError(res);
            _runBusy = false;
            _runDone = true;
            _runNote = failed;
            _runFinishedAt = DateTimeOffset.UtcNow;
            await Fail(failed);
            return;
        }

        _runJobId = await ReadJobId(res);
        if (_runJobId is null) {
            _runBusy = false;
            _runDone = true;
            _runNote = "run started but no job id came back";
            _runFinishedAt = DateTimeOffset.UtcNow;
            return;
        }

        StartTick();
        StartRunWatch();
        await RefreshRunAsync();
    }

    async Task CheckRunningAsync() {
        if (_deviceId is not { } id) return;
        var status = await Client().OneAsync<CookbookRunningInfo>($"/api/devices/{id}/cookbooks/running", Logger);
        if (status is not { Running: true, JobId: { } jobId } || Stale(id)) return;

        StopRunWatch();
        ResetRun();
        _runBusy = true;
        _runTitle = await TitleForJobAsync(jobId) ?? "cookbook";
        _runJobId = jobId;
        _mode = DeviceConsoleMode.Running;
        StartTick();
        StartRunWatch();
        await RefreshRunAsync();
        StateHasChanged();
    }

    async Task OpenRunAsync(JobGroupRow job) {
        if (_deviceId is null || _runBusy) return;
        StopRunWatch();
        ResetRun();
        _runReadOnly = true;
        _runJobId = job.Id;
        _runTitle = RunTitle(job);
        _runStartedAt = job.StartedAt;
        _runFinishedAt = job.FinishedAt;
        _mode = DeviceConsoleMode.Running;
        await RefreshRunAsync();
        if (!_runDone) {
            _runDone = true;
            _runOk = string.Equals(job.State, "succeeded", StringComparison.OrdinalIgnoreCase);
            _runCancelled = string.Equals(job.State, "cancelled", StringComparison.OrdinalIgnoreCase);
            _runNote ??= job.Message;
        }
    }

    async Task StopRunAsync() {
        if (_deviceId is null || _runJobId is null || _stopBusy) return;
        _stopBusy = true;
        StateHasChanged();

        var res = await Client().PostAsync($"/api/devices/{_deviceId}/cookbooks/stop", null);
        _stopBusy = false;
        if ((int)res.StatusCode == 409) await RefreshRunAsync();
        else if (!res.IsSuccessStatusCode) await Fail(await ReadError(res));
        StateHasChanged();
    }

    void OnTopic(string topic) {
        if (_disposed || topic != AdminTopics.DeviceStatus) return;
        _ = InvokeAsync(RefreshRunAsync);
    }

    async Task RefreshRunAsync() {
        if (_disposed || !Active || _deviceId is null || _runJobId is null) {
            StopRunWatch();
            return;
        }

        if (_refreshing || !_isAdmin || CookbookFeed is not { } feed) return;
        _refreshing = true;
        try {
            if (await feed.RunAsync(_deviceId, _runJobId.Value, CancellationToken.None) is not { } status) {
                StopRunWatch();
                StopTick();
                _runBusy = false;
                _runDone = true;
                _runNote = "run fell out of the job history window";
                _runFinishedAt ??= DateTimeOffset.UtcNow;
                StateHasChanged();
                return;
            }

            if (status.Log is { } log) _runLog = [.. log];
            if (status.Steps is { } steps) _steps = [.. steps];
            _runNote = status.Note ?? _runNote;
            _runFailedStepTitle = status.FailedStepTitle ?? _runFailedStepTitle;
            _runStartedAt = status.StartedAt ?? _runStartedAt;
            _runFinishedAt = status.FinishedAt ?? _runFinishedAt;
            if (status.Finished) {
                var wasLive = !_runDone && !_runReadOnly;
                _runDone = true;
                _runOk = status.Succeeded;
                _runCancelled = status.Cancelled;
                _runBusy = false;
                StopRunWatch();
                StopTick();
                if (wasLive) await AfterRunAsync();
            }

            StateHasChanged();
        }
        finally {
            _refreshing = false;
        }
    }

    async Task AfterRunAsync() {
        await Task.WhenAll(LoadCookbooksAsync(), LoadReadinessAsync(), LoadLastRunsAsync(), LoadIslandsAsync());
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    async Task<string?> TitleForJobAsync(long jobId) {
        if (_deviceId is null || !_isAdmin || JobFeed is not { } feed) return null;
        var page = await feed.PageAsync(_deviceId, LastRunPage, null, CancellationToken.None);
        return page.Rows.FirstOrDefault(j => j.Id == jobId)?.Cookbook;
    }

    static string RunTitle(JobGroupRow job) {
        return job.Cookbook ?? job.Message ?? "cookbook";
    }

    string? RunNote() {
        if (_steps.Count > 0 || !_runDone || _runOk || _runCancelled) return null;
        return _runNote is { Length: > 0 } note ? note : null;
    }

    void StartRunWatch() {
        _topics ??= Notifier.Subscribe(OnTopic);
    }

    void StopRunWatch() {
        _topics?.Dispose();
        _topics = null;
    }

    void StartTick() {
        _tick ??= new Timer(Tick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    void StopTick() {
        _tick?.Dispose();
        _tick = null;
    }

    void Tick(object? state) {
        if (_disposed || _runDone || _mode != DeviceConsoleMode.Running) return;
        _ = InvokeAsync(StateHasChanged);
    }

    string Elapsed() {
        if (_runStartedAt is not { } started) return "0:00";
        var span = (_runFinishedAt ?? DateTimeOffset.UtcNow) - started;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.TotalHours >= 1
            ? string.Create(CultureInfo.InvariantCulture, $"{(int)span.TotalHours}:{span.Minutes:00}:{span.Seconds:00}")
            : string.Create(CultureInfo.InvariantCulture, $"{span.Minutes}:{span.Seconds:00}");
    }

    static string Stamp(DateTimeOffset at) {
        return at.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture);
    }

    static string OutcomeIcon(string state) {
        return state.ToLowerInvariant() switch {
            "succeeded" => "circle-check",
            "failed" => "circle-x",
            "running" => "play",
            _ => "circle"
        };
    }

    static string OutcomeIconClass(string state) {
        return state.ToLowerInvariant() switch {
            "succeeded" => "text-ok",
            "failed" => "text-err",
            _ => "text-muted"
        };
    }

    string RunIcon() {
        return !_runDone ? "play" : _runCancelled ? "circle" : _runOk ? "circle-check" : "circle-x";
    }

    string RunIconClass() {
        return !_runDone ? "text-accent" : _runCancelled ? "text-muted" : _runOk ? "text-ok" : "text-err";
    }

    string RunStateLine() {
        return !_runDone ? "running" : _runCancelled ? "stopped" : _runOk ? "done" : "failed";
    }

    static string StepIcon(CookbookStepStatus status) {
        return status switch {
            CookbookStepStatus.Ok => "circle-check",
            CookbookStepStatus.Skipped => "circle",
            _ => "circle-x"
        };
    }

    static string StepIconClass(CookbookStepStatus status) {
        return status switch {
            CookbookStepStatus.Ok => "text-ok",
            CookbookStepStatus.Skipped => "text-muted",
            _ => "text-err"
        };
    }

    static string StepStateWord(CookbookStepStatus status) {
        return status switch {
            CookbookStepStatus.Ok => "done",
            CookbookStepStatus.Skipped => "skipped",
            _ => "failed"
        };
    }

    string RunReport() {
        var sb = new StringBuilder();
        sb.Append(_runTitle ?? "run").Append(' ').Append(RunStateLine());
        if (_runDone && !_runOk && !_runCancelled && _runFailedStepTitle is { Length: > 0 } failedAt) sb.Append(" at ").Append(failedAt);
        if (_runDone && !_runOk && _runNote is { Length: > 0 } runNote) sb.Append(", ").Append(runNote);
        sb.AppendLine();
        foreach (var step in _steps) {
            sb.Append("- ").Append(step.Title).Append(": ").Append(StepStateWord(step.Status));
            if (step.Note is { Length: > 0 } note) sb.Append(" (").Append(note).Append(')');
            sb.AppendLine();
        }

        if (_runLog.Count > 0) {
            sb.AppendLine();
            foreach (var line in _runLog) sb.AppendLine(line);
        }

        return sb.ToString();
    }

    Task Fail(string text) {
        return OnNotice.InvokeAsync(new DeviceNotice(text, StatusNoteKind.Error));
    }

    static async Task<long?> ReadJobId(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind != JsonValueKind.Object) return null;
            foreach (var name in JobIdNames) {
                if (!body.TryGetProperty(name, out var value)) continue;
                var text = value.ValueKind switch {
                    JsonValueKind.String => value.GetString(),
                    JsonValueKind.Number => value.GetRawText(),
                    _ => null
                };
                if (long.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id)) return id;
            }
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return null;
        }

        return null;
    }

    static async Task<string> ReadError(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var e))
                return e.GetString() ?? $"failed [{(int)resp.StatusCode}]";
        }
        catch (Exception ex) when (ex is JsonException or HttpRequestException or NotSupportedException) {
            return $"failed [{(int)resp.StatusCode}]";
        }

        return $"failed [{(int)resp.StatusCode}]";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_disposed) return;
        if (await ModuleAsync() is not { } module) return;

        if (_videoSupported is null) {
            _videoSupported = await SafeValueAsync(() => module.InvokeAsync<bool>("supportsVideo").AsTask());
            if (RecomputeVideo()) {
                StateHasChanged();
                return;
            }
        }

        await SyncStreamAsync(module);
        await SyncStageAsync(module);
    }

    async Task SyncStreamAsync(IJSObjectReference module) {
        if (_syncing) return;
        var wanted = _live && Active && _deviceId is not null && _streamError is null;
        var desired = !wanted ? "" : _useVideo ? $"{_deviceId}|video|{_quality}" : $"{_deviceId}|jpeg|{_fps}";
        if (desired == _streamKey) return;

        _syncing = true;
        try {
            _streamKey = desired;
            await HaltAsync(module);
            if (desired.Length == 0) return;

            _streamOnVideo = _useVideo;
            var started = _useVideo
                ? await SafeValueAsync(() => module.InvokeAsync<bool>("startVideo", _canvas, VideoUrl(), Ref(), new { maxQueue = 4 }).AsTask())
                : await SafeValueAsync(() => module.InvokeAsync<bool>("start", _img, StreamUrl(), ScreenshotUrl(), Ref()).AsTask());
            if (!started && _streamKey == desired) {
                await StreamEndedAsync(_useVideo
                    ? "the browser could not start the video decoder"
                    : "the browser could not attach the image stream", 0);
            }
        }
        finally {
            _syncing = false;
        }
    }

    async Task SyncStageAsync(IJSObjectReference module) {
        var desired = _deviceId is null || !Active ? "" : _useVideo ? $"{_deviceId}|v" : $"{_deviceId}|j";
        if (desired == _stageKey) return;
        if (_stageKey.Length > 0) await SafeAsync(() => module.InvokeVoidAsync("unbindStage", _stage).AsTask());
        _stageKey = desired;
        if (desired.Length == 0) return;

        var media = _useVideo ? _canvas : _img;
        await SafeAsync(() => module.InvokeVoidAsync("bindStage", _stage, media, Ref(),
            new { threshold = DragThresholdPx, longPressMs = LongPressMs, swipeMs = 200 }).AsTask());
    }

    async Task HaltAsync(IJSObjectReference module) {
        if (_streamOnVideo) await SafeAsync(() => module.InvokeVoidAsync("stopVideo", _canvas).AsTask());
        else await SafeAsync(() => module.InvokeVoidAsync("stop", _img).AsTask());
        _streamOnVideo = false;
    }

    async Task StopStreamAsync() {
        _streamKey = "";
        _hasFrame = false;
        if (_module is not { } module) return;
        await HaltAsync(module);
        if (_stageKey.Length > 0) {
            _stageKey = "";
            await SafeAsync(() => module.InvokeVoidAsync("unbindStage", _stage).AsTask());
        }
    }

    string StreamUrl() {
        return $"/api/devices/{_deviceId}/ui/stream?fps={_fps}";
    }

    string ScreenshotUrl() {
        return $"/api/devices/{_deviceId}/ui/screenshot";
    }

    (int W, int H, int Bitrate) QualitySpec() {
        return _quality switch {
            StreamQuality.Fluid => (540, 960, 1_500_000),
            StreamQuality.Crisp => (1080, 1920, 6_000_000),
            _ => (720, 1280, 3_000_000)
        };
    }

    string VideoUrl() {
        var (w, h, bitrate) = QualitySpec();
        return string.Create(CultureInfo.InvariantCulture,
            $"/api/devices/{_deviceId}/ui/video?size={w}x{h}&bitrate={bitrate}");
    }

    [JSInvokable]
    public Task OnFrameSize(int naturalW, int naturalH) {
        _shotW = naturalW;
        _shotH = naturalH;
        _hasFrame = naturalW > 0;
        if (_hasFrame) _streamRetried = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnStreamFps(double fps) {
        _jpegFps = fps;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnFrameFailed(int status, string note) {
        return StreamEndedAsync(string.IsNullOrWhiteSpace(note) ? "the device stopped sending frames" : note, status);
    }

    [JSInvokable]
    public Task OnVideoStats(double fps, double latencyMs, int frameW, int frameH, double kbps) {
        _videoFps = fps;
        _videoLatency = latencyMs;
        _videoKbps = kbps;
        _shotW = frameW;
        _shotH = frameH;
        _hasFrame = frameW > 0;
        if (_hasFrame) _streamRetried = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnVideoEnded(string reason, int status) {
        if (string.Equals(reason, "stopped", StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
        return StreamEndedAsync(string.IsNullOrWhiteSpace(reason) ? "the server closed the stream" : reason, status);
    }

    async Task StreamEndedAsync(string reason, int status) {
        bool videoNeverDrew = _streamOnVideo && _shotW == 0;
        _streamKey = "";
        _streamOnVideo = false;
        _hasFrame = false;
        if (status == StreamBusyStatus && !_streamRetried && _live) {
            _streamRetried = true;
            await Task.Delay(StreamRetryDelay);
            if (_disposed) return;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (videoNeverDrew && _live && _useVideo && _deviceId is { } deviceId) {
            _videoFallback = true;
            RecomputeVideo();
            Logger.LogInformation("video stream for {DeviceId} gave no frame ({Reason}); jpeg until the next re-probe", deviceId, reason);
            _ = ReprobeVideoLaterAsync(deviceId, ++_videoReprobe);
            await InvokeAsync(StateHasChanged);
            return;
        }

        _live = false;
        _streamError = reason;
        await InvokeAsync(StateHasChanged);
    }

    DotNetObjectReference<DeviceConsolePane> Ref() {
        _self ??= DotNetObjectReference.Create(this);
        return _self;
    }

    async Task<IJSObjectReference?> ModuleAsync() {
        if (_module is not null) return _module;
        try {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/deviceConsole.js"));
            return _module;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console module import failed");
            return null;
        }
    }

    async Task SafeAsync(Func<Task> call) {
        try {
            await call();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console interop call failed");
        }
    }

    async Task<T?> SafeValueAsync<T>(Func<Task<T>> call) {
        try {
            return await call();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console interop call failed");
            return default;
        }
    }

    public async ValueTask DisposeAsync() {
        _disposed = true;
        if (_watchSubscribed && Watches is { } watches) watches.Changed -= OnWatchChanged;
        StopTick();
        StopRunWatch();
        if (_module is { } module) {
            if (_stageKey.Length > 0) await SafeAsync(() => module.InvokeVoidAsync("unbindStage", _stage).AsTask());
            await HaltAsync(module);
        }

        await _module.DisposeModuleQuietAsync(logger: Logger);
        _self?.Dispose();
        _self = null;
    }

