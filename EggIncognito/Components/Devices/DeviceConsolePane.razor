        var islandsTask = Client().ListAsync<IslandRow>($"/api/devices/{id}/islands", Logger);
        var currentTask = Client().OneAsync<IslandCurrent>($"/api/devices/{id}/islands/current", Logger);
        var islands = await islandsTask;
