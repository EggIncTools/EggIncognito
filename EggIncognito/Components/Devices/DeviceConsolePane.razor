@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ICurrentUser User
@inject IServiceProvider Services
@inject AdminNotifier Notifier
@inject ILogger<DeviceConsolePane> Logger
@using System.Globalization
@using System.Text
@using System.Text.Json
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Devices
@using EggIncognito.Services.Devices
@implements IAsyncDisposable

@if (_deviceId is null) {
    <div class="wb-note">Pick a device.</div>
} else {
    <div class="dcon">
        <div class="dcon-bar">
            <span class="dcon-bar-group">
                <span class="dcon-bar-k">Stream</span>
                <span class="dcon-bar-state @(_streamError is null ? "" : "text-err")">@StripText()</span>
            </span>
            <span class="dcon-bar-group">
                @Actions
                @if (_useVideo) {
                    <select class="field-input dcon-rate" aria-label="Stream quality" value="@_quality" @onchange="QualityChanged">
                        <option value="@StreamQuality.Fluid">Fluid</option>
                        <option value="@StreamQuality.Balanced">Balanced</option>
                        <option value="@StreamQuality.Crisp">Crisp</option>
                    </select>
                } else {
                    <select class="field-input dcon-rate" aria-label="Stream frame rate" value="@_fps" @onchange="FpsChanged">
                        @foreach (var fps in Rates) {
                            <option value="@fps">@fps fps</option>
                        }
                    </select>
                }
                <button type="button" class="btn-mini" @onclick="ToggleStreamAsync">@(_live ? "Pause" : "Resume")</button>
                <button type="button" class="btn-mini @(_mode == DeviceConsoleMode.Inspect ? "dcon-on" : "")"
                        @onclick="ToggleInspect">
                    Inspect
                </button>
            </span>
        </div>

        @if (IsAndroid) {
            <div class="dcon-bar">
                <span class="dcon-bar-group">
                    <span class="dcon-bar-k">Island</span>
                    <select class="field-input dcon-rate" aria-label="Island" value="@IslandValue()"
                            disabled="@_islandBusy" @onchange="IslandChanged">
                        <option value="">Device (no island)</option>
                        @foreach (var island in _islands) {
                            <option value="@island.UserId.ToString(CultureInfo.InvariantCulture)">@IslandLabel(island)</option>
                        }
                    </select>
                    @if (!_newIslandOpen) {
                        <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="OpenNewIsland">+ new island</button>
                    }
                    @if (SelectedIsland() is { } selIsland) {
                        <button type="button" class="btn-mini" disabled="@_islandBusy"
                                @onclick="@(() => RemoveIslandAsync(selIsland.UserId))">
                            Remove
                        </button>
                    }
                    <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="LoadIslandsAsync">
                        @(_islandBusy ? "..." : "Refresh")
                    </button>
                </span>
                <span class="dcon-bar-group">
                    @if (_islandsLoaded && _islands.Count == 0 && !_newIslandOpen) {
                        <span class="text-xs text-muted">no islands yet</span>
                    }
                    <span class="text-xs text-muted">islands run one at a time; only the foreground user renders</span>
                </span>
            </div>
            @if (_newIslandOpen) {
                <div class="dcon-run-row">
                    <input class="field-input" placeholder="island label" aria-label="New island label"
                           @bind="_newIslandLabel" @bind:event="oninput" @onkeydown="NewIslandKeyAsync"/>
                    <button type="button" class="btn-mini" disabled="@(_islandBusy || _newIslandLabel.Trim().Length == 0)"
                            @onclick="CreateIslandAsync">
                        Create
                    </button>
                    <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="CancelNewIsland">Cancel</button>
                </div>
            }
        }

        <div class="dcon-body">
            <div class="dcon-stage-col">
                <div class="dcon-stage">
                    <button type="button" class="dcon-shot" @ref="_stage"
                            aria-label="Device screen: tap, hold for long-press, drag or scroll to swipe">
                        @if (_useVideo) {
                            <canvas class="dcon-canvas" @ref="_canvas"></canvas>
                        } else {
                            <img class="dcon-img" alt="" @ref="_img"/>
                        }
                        @if (_hasFrame && _selected is { HasBounds: true } hl && TapWidth > 0) {
                            <span class="dcon-hl" style="@HighlightStyle(hl)"></span>
                        }
                    </button>
                    @if (!_hasFrame) {
                        <span class="dcon-stage-empty">@StageEmptyText()</span>
                    }
                </div>

                <div class="dcon-keys">
                    <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("back"))">Back</button>
                    <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("home"))">Home</button>
                    <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("recents"))">Recents</button>
                    <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("enter"))">Enter</button>
                    <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("wake"))">Wake</button>
                    <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("close-app"))">Close app</button>
                </div>

                <div class="dcon-typing">
                    <input class="field-input font-mono" placeholder="@(_captureKeys ? "capturing keys live" : "text for the focused field")"
                           aria-label="Text and hardware keys" @bind="_text" @bind:event="oninput"
                           @onkeydown="TextKeyAsync" @onkeydown:preventDefault="_captureKeys"/>
                    <button type="button" class="btn-mini @(_captureKeys ? "dcon-on" : "")" @onclick="ToggleCapture"
                            title="Send each keystroke live: printable keys as text, Enter and Escape as device keys">
                        Capture
                    </button>
                    <button type="button" class="btn-mini" disabled="@(_captureKeys || _text.Length == 0)" @onclick="SendTextAsync">Send</button>
                </div>
            </div>

            <div class="dcon-activity">
                <div class="dcon-activity-head">
                    @if (_mode == DeviceConsoleMode.Idle) {
                        <span class="dcon-activity-title">
                            <span class="dcon-bar-k">Ready</span>
                            @foreach (var (word, check) in ReadinessWords()) {
                                <span class="@ReadyClass(check)" title="@(check?.Note)">@word</span>
                            }
                        </span>
                        <span class="dcon-activity-tools">
                            <button type="button" class="btn-mini" disabled="@_readinessBusy" @onclick="LoadReadinessAsync">
                                @(_readinessBusy ? "Refreshing..." : "Refresh")
                            </button>
                        </span>
                    } else if (_mode == DeviceConsoleMode.Running) {
                        <span class="dcon-activity-title">
                            <span class="dcon-run-title">@_runTitle</span>
                            <span class="dcon-dot">&middot;</span>
                            <span class="font-mono text-muted">@Elapsed()</span>
                            <span class="@RunStateClass()">@RunStateLine()</span>
                        </span>
                        <span class="dcon-activity-tools">
                            @if (!_runDone && !_runReadOnly && _runJobId is not null) {
                                <button type="button" class="btn-mini" disabled="@_stopBusy" @onclick="StopRunAsync">
                                    @(_stopBusy ? "Stopping..." : "Stop")
                                </button>
                            }
                            <CopyButton GetText="RunReport" Label="Copy" CopiedLabel="Copied" ShowIcon="false"
                                        ButtonClass="btn-mini"/>
                            <button type="button" class="btn-mini" @onclick="ToggleWrap">@(_wrap ? "Nowrap" : "Wrap")</button>
                            @if (_runDone) {
                                <button type="button" class="btn-mini" @onclick="Done">Done</button>
                            }
                        </span>
                    } else {
                        <span class="dcon-activity-title">
                            <span class="dcon-bar-k">Inspect</span>
                        </span>
                        <span class="dcon-activity-tools">
                            <button type="button" class="btn-mini" @onclick="CloseInspect">Close</button>
                        </span>
                    }
                </div>

                <div class="dcon-activity-body">
                    @if (_mode == DeviceConsoleMode.Idle) {
                        @if (_books.Count > 0) {
                            <div class="dcon-run-row">
                                <select class="field-input dcon-pick" aria-label="Cookbook" value="@_bookId"
                                        disabled="@_runBusy" @onchange="BookChanged">
                                    @if (Workflows() is { Count: > 0 } workflows) {
                                        <optgroup label="workflows">
                                            @foreach (var book in workflows) {
                                                <option value="@book.Id" disabled="@(!book.Available)" title="@book.Unavailable">
                                                    @book.Title
                                                </option>
                                            }
                                        </optgroup>
                                    }
                                    @if (Steps() is { Count: > 0 } steps) {
                                        <optgroup label="steps">
                                            @foreach (var book in steps) {
                                                <option value="@book.Id" disabled="@(!book.Available)" title="@book.Unavailable">
                                                    @book.Title
                                                </option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                @if (Chosen() is { Options: { Count: > 0 } options } chosen) {
                                    <select class="field-input dcon-pick" aria-label="@(chosen.ArgumentLabel ?? "Option")"
                                            value="@ArgFor(chosen)" disabled="@_runBusy" @onchange="@(e => SetArg(chosen.Id, e))">
                                        @foreach (var option in options) {
                                            <option value="@option.Value" title="@option.Detail">@option.Label</option>
                                        }
                                    </select>
                                }
                                <button type="button" class="btn-mini" disabled="@(!CanRun())" @onclick="RunChosenAsync">Run</button>
                                @if (SelectedIsland() is { } target) {
                                    <span class="text-xs text-muted">to user @target.UserId</span>
                                }
                            </div>
                        } else if (!_booksBusy) {
                            <div class="text-xs text-muted">no cookbooks for this device</div>
                        }

                        @if (_lastRuns.Count > 0) {
                            <div class="reg-wrap">
                                <table class="data-table dcon-last">
                                    <tbody>
                                    @foreach (var job in _lastRuns) {
                                        <tr class="dcon-last-row" @key="job.Id" title="@job.Message" @onclick="@(() => OpenRunAsync(job))">
                                            <td class="font-mono text-muted">@Stamp(job.LastAt)</td>
                                            <td class="dcon-last-title">@RunTitle(job)</td>
                                            <td class="@OutcomeClass(job.State)">@(job.Outcome ?? job.State)</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    } else if (_mode == DeviceConsoleMode.Running) {
                        @if (_steps.Count > 0 || RunNote() is not null) {
                            <div class="dcon-steps">
                                @foreach (var step in _steps) {
                                    <div class="dcon-step">
                                        <span class="dcon-step-title">@step.Title</span>
                                        <span class="@StepClass(step.Status)">@StepStateWord(step.Status)</span>
                                        @if (step.Status != CookbookStepStatus.Ok && step.Note is { Length: > 0 } stepNote) {
                                            <span class="dcon-step-note">@stepNote</span>
                                        }
                                    </div>
                                }
                                @if (RunNote() is { } runNote) {
                                    <div class="dcon-step">
                                        <span class="dcon-step-title">@(_runTitle ?? "run")</span>
                                        <span class="@RunStateClass()">@RunStateLine()</span>
                                        <span class="dcon-step-note">@runNote</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="dcon-log @(_wrap ? "" : "dcon-log-nowrap")">
                            @for (var i = _runLog.Count - 1; i >= 0; i--) {
                                <div class="dcon-log-line">@_runLog[i]</div>
                            }
                        </div>
                    } else {
                        <div class="dcon-tree-bar">
                            <input class="field-input" type="search" placeholder="filter nodes"
                                   aria-label="Filter ui nodes" value="@_filter" @oninput="FilterChanged"/>
                            <label class="dcon-check">
                                <input type="checkbox" checked="@_clickableOnly" @onchange="ClickableChanged"/>
                                clickable only
                            </label>
                            <button type="button" class="btn-mini" disabled="@_dumpBusy" @onclick="LoadDumpAsync">
                                @(_dumpBusy ? "Reading..." : "Read")
                            </button>
                        </div>

                        @if (_dumpError is { } de) {
                            <div class="dcon-tree-note text-err">@de</div>
                        } else if (_dump is { } dump) {
                            <div class="dcon-tree-note">@_rows.Count of @dump.Count nodes</div>
                            <div class="dcon-tree">
                                @foreach (var node in _rows) {
                                    <button type="button" @key="node.Id"
                                            class="dcon-node @(_selected?.Id == node.Id ? "dcon-node-on" : "")"
                                            style="@IndentStyle(node)" @onclick="@(() => SelectNode(node))">
                                        <span class="dcon-node-kind">@node.Kind</span>
                                        <span class="dcon-node-label">@node.Label</span>
                                        @if (node.Clickable) {
                                            <span class="dcon-node-tap">tap</span>
                                        }
                                    </button>
                                }
                            </div>
                        }

                        @if (_selected is { } sel) {
                            <div class="dcon-sel">
                                <div class="dcon-sel-head">
                                    <span class="font-mono text-xs">@(sel.ClassName ?? sel.Kind)</span>
                                    <span class="font-mono text-muted text-xs">@sel.Left,@sel.Top @sel.Width x @sel.Height</span>
                                    <button type="button" class="btn-mini" @onclick="TapSelectedAsync">Tap node</button>
                                </div>

                                @if (sel.Selectors.Count == 0) {
                                    <div class="dcon-snip-row">
                                        <span class="dcon-snip-by">point</span>
                                        <code class="dcon-snip">@PointStep(sel)</code>
                                        <CopyButton Text="@PointStep(sel)" AriaLabel="Copy tap-point step"/>
                                    </div>
                                } else {
                                    @foreach (var hint in sel.Selectors) {
                                        <div class="dcon-snip-row @(hint == sel.Selectors[0] ? "dcon-snip-best" : "")">
                                            <span class="dcon-snip-by">@HintLabel(hint)</span>
                                            <code class="dcon-snip">@hint.Snippet</code>
                                            <CopyButton Text="@hint.Snippet" AriaLabel="Copy selector"/>
                                        </div>
                                    }

                                    <div class="dcon-sel-steps">
                                        <div class="dcon-snip-row">
                                            <span class="dcon-snip-by">tap step</span>
                                            <code class="dcon-snip">@TapStep(sel)</code>
                                            <CopyButton Text="@TapStep(sel)" AriaLabel="Copy tap step"/>
                                        </div>
                                        <div class="dcon-snip-row">
                                            <span class="dcon-snip-by">wait step</span>
                                            <code class="dcon-snip">@WaitStep(sel)</code>
                                            <CopyButton Text="@WaitStep(sel)" AriaLabel="Copy wait step"/>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public string? DeviceId { get; set; }

    [Parameter] public string? Platform { get; set; }

    [Parameter] public bool Virtual { get; set; }

    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback<DeviceNotice> OnNotice { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    static readonly int[] Rates = [5, 4, 3, 2, 1];
    static readonly string[] JobIdNames = ["jobId", "JobId", "runId", "RunId", "id", "Id"];
    const int LastRunCount = 5;
    const int LastRunPage = 25;

    bool _disposed;
    bool _isAdmin;
    bool _loaded;
    bool _live;
    bool _hasFrame;
    bool _useVideo;
    bool _streamOnVideo;
    bool? _videoSupported;
    bool _dumpBusy;
    bool _clickableOnly;
    bool _booksBusy;
    bool _readinessBusy;
    bool _runBusy;
    bool _runDone;
    bool _runOk;
    bool _runCancelled;
    bool _runReadOnly;
    bool _stopBusy;
    bool _refreshing;
    bool _wrap = true;
    bool _captureKeys;
    bool _islandBusy;
    bool _islandsLoaded;
    bool _newIslandOpen;
    int _fps = 3;
    int _shotW;
    int _shotH;
    int? _selectedUserId;
    double _videoFps;
    double _videoLatency;
    double _videoKbps;
    double _jpegFps;
    StreamQuality _quality = StreamQuality.Balanced;
    string _filter = "";
    string _text = "";
    string _newIslandLabel = "";
    string _streamKey = "";
    string _stageKey = "";
    string _bookId = "";
    string? _deviceId;
    string? _streamError;
    string? _dumpError;
    string? _runTitle;
    string? _runNote;
    string? _runFailedStepTitle;
    long? _runJobId;
    DateTimeOffset? _runStartedAt;
    DateTimeOffset? _runFinishedAt;
    DeviceConsoleMode _mode = DeviceConsoleMode.Idle;

    List<UiNodeRow> _rows = [];
    List<DeviceCookbookInfo> _books = [];
    List<JobGroupRow> _lastRuns = [];
    List<string> _runLog = [];
    List<CookbookStepResult> _steps = [];
    List<IslandRow> _islands = [];
    readonly Dictionary<string, string> _args = [];
    UiDumpResult? _dump;
    UiNodeRow? _selected;
    DeviceReadiness? _readiness;

    ElementReference _img;
    ElementReference _canvas;
    ElementReference _stage;
    IJSObjectReference? _module;
    DotNetObjectReference<DeviceConsolePane>? _self;
    IDisposable? _topics;
    Timer? _tick;

    DeviceCookbookFeed? CookbookFeed => Services.GetService(typeof(DeviceCookbookFeed)) as DeviceCookbookFeed;

    DeviceJobFeed? JobFeed => Services.GetService(typeof(DeviceJobFeed)) as DeviceJobFeed;

    bool IsIos => string.Equals(Platform, "ios", StringComparison.OrdinalIgnoreCase);

    bool IsAndroid => string.Equals(Platform, "android", StringComparison.OrdinalIgnoreCase);

    int TapWidth => IsIos && _dump is { Width: > 0 } d ? d.Width : _shotW;

    int TapHeight => IsIos && _dump is { Height: > 0 } d ? d.Height : _shotH;

    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    protected override async Task OnParametersSetAsync() {
        var next = string.IsNullOrEmpty(DeviceId) ? null : DeviceId;
        if (next != _deviceId) {
            await StopStreamAsync();
            StopRunWatch();
            _deviceId = next;
            _loaded = false;
            ResetDevice();
            RecomputeVideo();
            _live = next is not null;
        }

        if (!Active) {
            await StopStreamAsync();
            StopRunWatch();
            StopTick();
            return;
        }

        if (_deviceId is null) return;
        if (!_loaded) {
            _loaded = true;
            await LoadCookbooksAsync();
            await LoadReadinessAsync();
            await LoadLastRunsAsync();
            await LoadIslandsAsync();
            await CheckRunningAsync();
            return;
        }

        if (_runJobId is not null && !_runDone && !_runReadOnly) StartRunWatch();
    }

    void ResetDevice() {
        _dump = null;
        _rows = [];
        _selected = null;
        _dumpError = null;
        _streamError = null;
        _hasFrame = false;
        _shotW = _shotH = 0;
        _videoFps = _videoLatency = _videoKbps = _jpegFps = 0;
        _books = [];
        _lastRuns = [];
        _islands = [];
        _islandsLoaded = false;
        _islandBusy = false;
        _newIslandOpen = false;
        _newIslandLabel = "";
        _selectedUserId = null;
        _captureKeys = false;
        _args.Clear();
        _bookId = "";
        _readiness = null;
        _readinessBusy = false;
        _booksBusy = false;
        _mode = DeviceConsoleMode.Idle;
        ResetRun();
    }

    void ResetRun() {
        StopTick();
        _runTitle = null;
        _runJobId = null;
        _runNote = null;
        _runFailedStepTitle = null;
        _runStartedAt = null;
        _runFinishedAt = null;
        _runLog = [];
        _steps = [];
        _runBusy = false;
        _runDone = false;
        _runOk = false;
        _runCancelled = false;
        _runReadOnly = false;
        _stopBusy = false;
    }

    bool RecomputeVideo() {
        var next = _videoSupported == true && IsAndroid;
        if (next == _useVideo) return false;
        _useVideo = next;
        return true;
    }

    string StripText() {
        if (_streamError is { } err) return $"ended: {err}";
        if (!_live) return "paused";
        if (!_hasFrame) return "connecting";
        if (!_useVideo) return string.Create(CultureInfo.InvariantCulture,
            $"jpeg {_jpegFps:0.#} of {_fps} fps {_shotW}x{_shotH}");
        return string.Create(CultureInfo.InvariantCulture,
            $"live {_videoFps:0} fps {_videoLatency:0} ms {_shotW}x{_shotH} {_videoKbps / 1000:0.0} Mbps");
    }

    string StageEmptyText() {
        if (_streamError is not null) return "no picture";
        return _live ? "waiting for a frame" : "paused";
    }

    async Task ToggleStreamAsync() {
        await StopStreamAsync();
        if (_live) {
            _live = false;
            return;
        }

        _streamError = null;
        _live = true;
    }

    void FpsChanged(ChangeEventArgs e) {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var fps)) return;
        _fps = Math.Clamp(fps, 1, 5);
    }

    void QualityChanged(ChangeEventArgs e) {
        if (Enum.TryParse<StreamQuality>(e.Value?.ToString(), out var quality)) _quality = quality;
    }

    void ToggleCapture() {
        _captureKeys = !_captureKeys;
        if (_captureKeys) _text = "";
    }

    void ToggleInspect() {
        if (_mode == DeviceConsoleMode.Inspect) {
            CloseInspect();
            return;
        }

        _mode = DeviceConsoleMode.Inspect;
    }

    void CloseInspect() {
        _selected = null;
        _mode = _runJobId is not null ? DeviceConsoleMode.Running : DeviceConsoleMode.Idle;
    }

    void Done() {
        ResetRun();
        _mode = DeviceConsoleMode.Idle;
    }

    void ToggleWrap() {
        _wrap = !_wrap;
    }

    const int DragThresholdPx = 8;
    const int LongPressMs = 600;

    bool _swiping;

    [JSInvokable]
    public async Task OnStageTap(double fx, double fy) {
        if (_deviceId is null) return;
        if (DevicePoint(fx, fy) is not { } p) {
            await Fail("no frame measured yet");
            return;
        }

        await TapAsync(p.X, p.Y);
    }

    [JSInvokable]
    public async Task OnStageLongPress(double fx, double fy) {
        if (_deviceId is null || DevicePoint(fx, fy) is not { } p) return;
        await SwipeAsync(p.X, p.Y, p.X, p.Y, LongPressMs);
    }

    [JSInvokable]
    public async Task OnStageSwipe(double fx1, double fy1, double fx2, double fy2, int durationMs) {
        if (_deviceId is null) return;
        if (DevicePoint(fx1, fy1) is not { } from || DevicePoint(fx2, fy2) is not { } to) return;
        await SwipeAsync(from.X, from.Y, to.X, to.Y, Math.Clamp(durationMs, 50, 1000));
    }

    (int X, int Y)? DevicePoint(double fx, double fy) {
        var w = TapWidth;
        var h = TapHeight;
        if (w <= 0 || h <= 0) return null;
        return (Frac(fx, w), Frac(fy, h));
    }

    static int Frac(double fraction, int size) {
        var value = (int)Math.Round(Math.Clamp(fraction, 0, 1) * (size - 1), MidpointRounding.AwayFromZero);
        return Math.Clamp(value, 0, size - 1);
    }

    async Task SwipeAsync(int x1, int y1, int x2, int y2, int durationMs) {
        if (_swiping) return;
        _swiping = true;
        try {
            var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/swipe",
                new UiSwipeRequest(x1, y1, x2, y2, durationMs), SelfCallJson.Web);
            if (!res.IsSuccessStatusCode) await Fail(await ReadError(res));
        }
        finally {
            _swiping = false;
        }
    }

    async Task TapAsync(int x, int y) {
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/tap",
            new UiTapRequest(x, y), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) await Fail(await ReadError(res));
    }

    Task TapSelectedAsync() {
        return _selected is { } sel ? TapAsync(sel.CenterX, sel.CenterY) : Task.CompletedTask;
    }

    async Task TextKeyAsync(KeyboardEventArgs e) {
        if (_captureKeys) {
            await CaptureKeyAsync(e);
            return;
        }

        if (e.Key == "Enter") await SendTextAsync();
        else if (e.Key == "Escape") await KeyAsync("back");
    }

    async Task CaptureKeyAsync(KeyboardEventArgs e) {
        if (_deviceId is null) return;
        if (e.Key == "Enter") {
            await KeyAsync("enter");
            return;
        }

        if (e.Key == "Escape") {
            await KeyAsync("back");
            return;
        }

        if (e.Key.Length != 1) return;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/text",
            new UiTextRequest(e.Key), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) await Fail(await ReadError(res));
    }

    async Task SendTextAsync() {
        if (_deviceId is null || _text.Length == 0) return;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/text",
            new UiTextRequest(_text), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) {
            await Fail(await ReadError(res));
            return;
        }

        _text = "";
    }

    async Task KeyAsync(string key) {
        if (_deviceId is null) return;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/key",
            new UiKeyRequest(key), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) await Fail(await ReadError(res));
    }

    async Task LoadDumpAsync() {
        if (_deviceId is null) return;
        _dumpBusy = true;
        _dumpError = null;
        StateHasChanged();
        try {
            var res = await Client().GetAsync($"/api/devices/{_deviceId}/ui/dump");
            if (!res.IsSuccessStatusCode) {
                _dumpError = await ReadError(res);
                _dump = null;
                _rows = [];
                _selected = null;
                return;
            }

            _dump = await res.Content.ReadFromJsonAsync<UiDumpResult>(SelfCallJson.Web);
            _selected = null;
            ApplyFilter();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Logger.LogDebug(ex, "ui dump read failed");
            _dumpError = ex.Message;
            _dump = null;
            _rows = [];
        }
        finally {
            _dumpBusy = false;
        }
    }

    void FilterChanged(ChangeEventArgs e) {
        _filter = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    void ClickableChanged(ChangeEventArgs e) {
        _clickableOnly = e.Value is true;
        ApplyFilter();
    }

    void ApplyFilter() {
        if (_dump is null) {
            _rows = [];
            return;
        }

        IEnumerable<UiNodeRow> query = _dump.Nodes;
        if (_clickableOnly) query = query.Where(n => n.Clickable);
        var needle = _filter.Trim();
        if (needle.Length > 0) {
            query = query.Where(n => Has(n.Label, needle) || Has(n.ResourceId, needle) || Has(n.Text, needle)
                                     || Has(n.ContentDesc, needle) || Has(n.ClassName, needle));
        }

        _rows = [.. query];
    }

    static bool Has(string? value, string needle) {
        return value is not null && value.Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    void SelectNode(UiNodeRow node) {
        _selected = _selected?.Id == node.Id ? null : node;
