@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ICurrentUser User
@inject IServiceProvider Services
@inject AdminNotifier Notifier
@inject DeviceWorkbenchState State
@inject ILogger<DeviceConsolePane> Logger
@using System.Globalization
@using System.Text
@using System.Text.Json
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Devices
@using EggIncognito.Services.Devices
@implements IAsyncDisposable

@if (_deviceId is null) {
    <div class="wb-note">Pick a device.</div>
} else {
    <div class="dcon">
    <div class="dcon-body">
    <div class="dcon-stage-col">
        <div class="dcon-stage">
            <button type="button" class="dcon-shot" @ref="_stage"
                    aria-label="Device screen: tap, hold for long-press, drag or scroll to swipe">
                @if (_useVideo) {
                    <canvas class="dcon-canvas" @ref="_canvas"></canvas>
                } else {
                    <img class="dcon-img" alt="" @ref="_img"/>
                }
                @if (_hasFrame && _selectedGesture is { } hl && TapWidth > 0) {
                    <span class="dcon-hl dcon-hl-pt" style="@PointStyle(hl.X, hl.Y)"></span>
                    @if (hl.Kind == RecordedGestureKind.Swipe) {
                        <span class="dcon-hl dcon-hl-pt dcon-hl-end" style="@PointStyle(hl.X2, hl.Y2)"></span>
                    }
                }
                @if (_hasFrame && _watch is { } wp && TapWidth > 0) {
                    <span class="dcon-hl dcon-hl-pt dcon-hl-watch" style="@PointStyle(wp.X, wp.Y)"></span>
                }
            </button>
            @if (!_hasFrame) {
                <span class="dcon-stage-empty">
                    <Icon Name="@StreamIcon()" Class="@("icon-sm " + StreamIconClass())"/>
                    <span>@StageEmptyText()</span>
                    @if (_streamError is { } stageErr) {
                        <span class="text-muted dcon-stage-reason">@stageErr</span>
                    }
                </span>
            }
        </div>
    </div>

    <div class="dcon-side">
    <div class="dwb-bar">
        <span class="dwb-bar-group">
            <span class="dcon-k">Stream</span>
            <span class="dcon-status">
                <Icon Name="@StreamIcon()" Class="@("icon-sm " + StreamIconClass())"/>
                <span>@StreamLabel()</span>
            </span>
            @if (StreamDetail() is { } streamDetail) {
                <span class="text-muted text-xs dcon-status-detail">@streamDetail</span>
            }
        </span>
        <span class="dwb-bar-group">
            <span class="text-muted text-xs" title="@(_videoFallback ? "h264 gave no frame, retrying shortly" : null)">@(_useVideo ? "h264" : _videoFallback ? "jpeg, h264 retry pending" : "jpeg")</span>
            <select class="field-input dcon-rate" aria-label="Quality" value="@QualityValue()" @onchange="QualityPicked">
                @if (_useVideo) {
                    <option value="@StreamQuality.Fluid">Fluid</option>
                    <option value="@StreamQuality.Balanced">Balanced</option>
                    <option value="@StreamQuality.Crisp">Crisp</option>
                } else {
                    @foreach (var fps in Rates) {
                        <option value="@fps">@fps fps</option>
                    }
                }
            </select>
            <button type="button" class="btn-mini" @onclick="ToggleStreamAsync">
                <Icon Name="@(_live ? "pause" : "play")" Class="icon-sm"/>
                @(_live ? "Pause" : "Resume")
            </button>
            <button type="button" class="btn-mini @(_mode == DeviceConsoleMode.Record ? "dcon-on" : "")"
                    title="Record every tap, hold and swipe on the stage as flow steps" @onclick="ToggleRecord">
                <Icon Name="@(_mode == DeviceConsoleMode.Record ? "circle-check" : "circle")" Class="icon-sm"/>
                Record
            </button>
            @if (IsAndroid) {
                <button type="button" class="btn-mini @(_locking || _watch is not null ? "dcon-on" : "")"
                        title="@WatchTitle()" @onclick="ToggleWatchAsync">
                    <Icon Name="eye" Class="icon-sm"/>
                    @WatchLabel()
                </button>
            }
        </span>
    </div>

    @if (Actions is not null) {
        <DeviceSection Title="Actions" Open="@State.IsOpen(DeviceWorkbenchState.SectionActions)"
                       OpenChanged="@(o => State.SetOpen(DeviceWorkbenchState.SectionActions, o))">
            <Tools>@Actions</Tools>
            <ChildContent>@ActionNotes</ChildContent>
        </DeviceSection>
    }

    @if (IsAndroid) {
        <DeviceSection Title="Island" Open="@State.IsOpen(DeviceWorkbenchState.SectionIsland)"
                       OpenChanged="@(o => State.SetOpen(DeviceWorkbenchState.SectionIsland, o))">
            <Summary>
                <span class="text-muted text-xs">@CurrentIslandLabel()</span>
            </Summary>
            <Tools>
                @if (!_newIslandOpen) {
                    <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="OpenNewIsland">
                        <Icon Name="plus" Class="icon-sm"/>
                        New island
                    </button>
                }
                <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="LoadIslandsAsync">
                    <Icon Name="refresh-cw" Class="icon-sm"/>
                    @(_islandBusy ? "Refreshing..." : "Refresh")
                </button>
            </Tools>
            <ChildContent>
            <div class="text-muted text-xs">islands run one at a time; only the foreground user renders</div>
            <div class="reg-wrap dcon-island-wrap">
                <table class="data-table dcon-list">
                    <tbody>
                    <tr>
                        <td class="dcon-cur">
                            @if (_selectedUserId is null) {
                                <Icon Name="check" Class="icon-sm text-ok"/>
                            }
                        </td>
                        <td class="dcon-list-title">Device (no island)</td>
                        <td class="font-mono text-muted text-xs">user @IslandScope.Owner</td>
                        <td class="dcon-row-tools">
                            @if (_selectedUserId is not null) {
                                <button type="button" class="btn-mini" disabled="@_islandBusy"
                                        @onclick="@(() => SwitchIslandAsync(IslandScope.Owner))">
                                    Switch
                                </button>
                            }
                        </td>
                    </tr>
                    @foreach (var island in _islands) {
                        var current = _selectedUserId == island.UserId;
                        <tr @key="island.UserId">
                            <td class="dcon-cur">
                                @if (current) {
                                    <Icon Name="check" Class="icon-sm text-ok"/>
                                }
                            </td>
                            <td class="dcon-list-title">@IslandLabel(island)</td>
                            <td class="font-mono text-muted text-xs"
                                title="@(island.Provisioned ? null : "setup wizard not marked complete for this user; interstitials may cover the app")">
                                user @island.UserId@(island.Provisioned ? "" : ", unprovisioned")
                            </td>
                            <td class="dcon-row-tools">
                                @if (!current) {
                                    <button type="button" class="btn-mini" disabled="@_islandBusy"
                                            @onclick="@(() => SwitchIslandAsync(island.UserId))">
                                        Switch
                                    </button>
                                }
                                <button type="button" class="btn-mini btn-danger" disabled="@_islandBusy"
                                        @onclick="@(() => RemoveIslandAsync(island.UserId))">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (_newIslandOpen) {
                <div class="dcon-run-row">
                    <input class="field-input" placeholder="island label" aria-label="New island label"
                           @bind="_newIslandLabel" @bind:event="oninput" @onkeydown="NewIslandKeyAsync"/>
                    <button type="button" class="btn-mini" disabled="@(_islandBusy || _newIslandLabel.Trim().Length == 0)"
                            @onclick="CreateIslandAsync">
                        Create
                    </button>
                    <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="CancelNewIsland">Cancel</button>
                </div>
            }
            </ChildContent>
        </DeviceSection>
    }

    <DeviceSection Title="Input" Open="@State.IsOpen(DeviceWorkbenchState.SectionInput)"
                   OpenChanged="@(o => State.SetOpen(DeviceWorkbenchState.SectionInput, o))">
        <Tools>
            <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("back"))">Back</button>
            <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("home"))">Home</button>
            <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("recents"))">Recents</button>
            <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("enter"))">Enter</button>
            <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("wake"))">Wake</button>
            <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("close-app"))">Close app</button>
        </Tools>
        <ChildContent>
        <div class="dcon-typing">
            <input class="field-input font-mono" placeholder="@(_captureKeys ? "capturing keys live" : "text for the focused field")"
                   aria-label="Text and hardware keys" @bind="_text" @bind:event="oninput"
                   @onkeydown="TextKeyAsync" @onkeydown:preventDefault="_captureKeys"/>
            <button type="button" class="btn-mini @(_captureKeys ? "dcon-on" : "")" @onclick="ToggleCapture"
                    title="Send each keystroke live: printable keys as text, Enter and Escape as device keys">
                <Icon Name="@(_captureKeys ? "circle-check" : "circle")" Class="icon-sm"/>
                Live keys
            </button>
            <button type="button" class="btn-mini" disabled="@(_captureKeys || _text.Length == 0)" @onclick="SendTextAsync">
                <Icon Name="send" Class="icon-sm"/>
                Send
            </button>
        </div>
        </ChildContent>
    </DeviceSection>

    <div class="dcon-activity @(ActivityOpen ? "" : "dcon-activity-closed")">
        <div class="dcon-activity-head">
            <button type="button" class="dcon-sec-toggle" aria-expanded="@(ActivityOpen ? "true" : "false")" @onclick="ToggleActivity">
                <span class="ep-caret @(ActivityOpen ? "ep-caret-open" : "")"></span>
            </button>
            @if (_mode == DeviceConsoleMode.Idle) {
                <span class="dcon-activity-title">
                    <span class="dcon-k">Readiness</span>
                    <span class="dcon-status">
                        <Icon Name="@ReadinessIcon()" Class="@("icon-sm " + ReadinessIconClass())"/>
                        <span>@ReadinessLabel()</span>
                    </span>
                    @if (_readinessAt is { } probedAt) {
                        <span class="text-muted text-xs">probed @Stamp(probedAt)</span>
                    }
                </span>
                <span class="dcon-activity-tools">
                    <button type="button" class="btn-mini" disabled="@_readinessBusy" @onclick="LoadReadinessAsync">
                        <Icon Name="refresh-cw" Class="icon-sm"/>
                        @(_readinessBusy ? "Probing..." : "Probe")
                    </button>
                </span>
            } else if (_mode == DeviceConsoleMode.Running) {
                <span class="dcon-activity-title">
                    <span class="dcon-run-title">@_runTitle</span>
                    <span class="meta-dots">
                        <span class="font-mono text-muted">@Elapsed()</span>
                        <span class="dcon-status">
                            <Icon Name="@RunIcon()" Class="@("icon-sm " + RunIconClass())"/>
                            <span>@RunStateLine()</span>
                        </span>
                    </span>
                </span>
                <span class="dcon-activity-tools">
                    @if (!_runDone && !_runReadOnly && _runJobId is not null) {
                        <button type="button" class="btn-mini btn-danger" disabled="@_stopBusy" @onclick="StopRunAsync">
                            @(_stopBusy ? "Stopping..." : "Stop")
                        </button>
                    }
                    <CopyButton GetText="RunReport" Label="Copy" CopiedLabel="Copied" ShowIcon="false"
                                ButtonClass="btn-mini"/>
                    <button type="button" class="btn-mini" @onclick="ToggleWrap">@(_wrap ? "Nowrap" : "Wrap")</button>
                    @if (_runDone) {
                        <button type="button" class="btn-mini" @onclick="Done">Done</button>
                    }
                </span>
            } else {
                <span class="dcon-activity-title">
                    <span class="dcon-k">Record</span>
                    <span class="text-muted text-xs">@_recorded.Count @(_recorded.Count == 1 ? "step" : "steps")</span>
                </span>
                <span class="dcon-activity-tools">
                    <CopyButton GetText="@(() => RecordedGesture.FlowText(_recorded))" Label="Copy flow" CopiedLabel="Copied"
                                ShowIcon="false" ButtonClass="btn-mini"/>
                    <button type="button" class="btn-mini" disabled="@(_recorded.Count == 0 || _replaying)" @onclick="ReplayAllAsync">
                        <Icon Name="play" Class="icon-sm"/>
                        @(_replaying ? "Replaying..." : "Replay")
                    </button>
                    <button type="button" class="btn-mini" disabled="@(_recorded.Count == 0)" @onclick="ClearRecorded">Clear</button>
                    <button type="button" class="btn-mini" @onclick="CloseRecord">Close</button>
                </span>
            }
        </div>

        @if (ActivityOpen) {
        <div class="dcon-activity-body">
            @if (_mode == DeviceConsoleMode.Idle) {
                <div class="reg-wrap">
                    <table class="data-table dcon-list">
                        <tbody>
                        @foreach (var (label, check) in ReadinessRows()) {
                            <tr>
                                <td class="dcon-cur">
                                    <Icon Name="@CheckIcon(check)" Class="@("icon-sm " + CheckIconClass(check))"/>
                                </td>
                                <td class="dcon-check-label">@label</td>
                                <td class="text-muted text-xs dcon-list-title" title="@CheckDetail(check)">@CheckDetail(check)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (_books.Count > 0) {
                    <div class="dcon-run-row">
                        <select class="field-input dcon-pick" aria-label="Cookbook" value="@_bookId"
                                disabled="@_runBusy" @onchange="BookChanged">
                            @if (Workflows() is { Count: > 0 } workflows) {
                                <optgroup label="workflows">
                                    @foreach (var book in workflows) {
                                        <option value="@book.Id" disabled="@(!book.Available)" title="@book.Unavailable">
                                            @book.Title
                                        </option>
                                    }
                                </optgroup>
                            }
                            @if (Steps() is { Count: > 0 } steps) {
                                <optgroup label="steps">
                                    @foreach (var book in steps) {
                                        <option value="@book.Id" disabled="@(!book.Available)" title="@book.Unavailable">
                                            @book.Title
                                        </option>
                                    }
                                </optgroup>
                            }
                        </select>
                        @if (Chosen() is { Options: { Count: > 0 } options } chosen) {
                            <select class="field-input dcon-pick" aria-label="@(chosen.ArgumentLabel ?? "Option")"
                                    value="@ArgFor(chosen)" disabled="@_runBusy" @onchange="@(e => SetArg(chosen.Id, e))">
                                @foreach (var option in options) {
                                    <option value="@option.Value" title="@option.Detail">@option.Label</option>
                                }
                            </select>
                        }
                        <button type="button" class="btn-primary" disabled="@(!CanRun())" @onclick="RunChosenAsync">
                            <Icon Name="play" Class="icon-sm"/>
                            Run
                        </button>
                        @if (SelectedIsland() is { } target) {
                            <span class="text-xs text-muted">to user @target.UserId</span>
                        }
                    </div>
                    @if (Chosen() is { Unavailable: { Length: > 0 } why, Available: false }) {
                        <div class="text-xs text-muted">@why</div>
                    }
                } else if (!_booksBusy) {
                    <div class="text-xs text-muted">no cookbooks for this device</div>
                }

                @if (_lastRuns.Count > 0) {
                    <div class="reg-wrap">
                        <table class="data-table dcon-list dcon-last">
                            <tbody>
                            @foreach (var job in _lastRuns) {
                                <tr class="dcon-last-row" @key="job.Id" title="@job.Message" @onclick="@(() => OpenRunAsync(job))">
                                    <td class="dcon-cur">
                                        <Icon Name="@OutcomeIcon(job.State)" Class="@("icon-sm " + OutcomeIconClass(job.State))"/>
                                    </td>
                                    <td class="font-mono text-muted text-xs">@Stamp(job.LastAt)</td>
                                    <td class="dcon-list-title">@RunTitle(job)</td>
                                    <td class="text-muted text-xs">@(job.Outcome ?? job.State)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            } else if (_mode == DeviceConsoleMode.Running) {
                @if (_steps.Count > 0 || RunNote() is not null) {
                    <div class="reg-wrap">
                        <table class="data-table dcon-list">
                            <tbody>
                            @foreach (var step in _steps) {
                                <tr>
                                    <td class="dcon-cur">
                                        <Icon Name="@StepIcon(step.Status)" Class="@("icon-sm " + StepIconClass(step.Status))"/>
                                    </td>
                                    <td class="dcon-check-label">@step.Title</td>
                                    <td class="text-muted text-xs dcon-list-title">
                                        @(step.Status != CookbookStepStatus.Ok && step.Note is { Length: > 0 } stepNote ? stepNote : StepStateWord(step.Status))
                                    </td>
                                </tr>
                            }
                            @if (RunNote() is { } runNote) {
                                <tr>
                                    <td class="dcon-cur">
                                        <Icon Name="@RunIcon()" Class="@("icon-sm " + RunIconClass())"/>
                                    </td>
                                    <td class="dcon-check-label">@(_runTitle ?? "run")</td>
                                    <td class="text-muted text-xs dcon-list-title">@runNote</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="reg-wrap dcon-log-wrap">
                    <div class="dcon-log @(_wrap ? "" : "dcon-log-nowrap")">
                        @for (var i = _runLog.Count - 1; i >= 0; i--) {
                            <div class="dcon-log-line">@_runLog[i]</div>
                        }
                    </div>
                </div>
            } else {
                @if (_recorded.Count == 0) {
                    <div class="dcon-status text-xs">
                        <Icon Name="circle" Class="icon-sm text-muted"/>
                        <span class="text-muted">Tap, hold or swipe the screen. Each gesture lands here as a flow step at device pixels.</span>
                    </div>
                } else {
                    <div class="reg-wrap dcon-tree">
                        <table class="data-table dcon-list">
                            <tbody>
                            @for (var i = 0; i < _recorded.Count; i++) {
                                var index = i;
                                var g = _recorded[i];
                                <tr @key="index" class="dcon-node @(ReferenceEquals(_selectedGesture, g) ? "dcon-node-on" : "")"
                                    @onclick="@(() => SelectGesture(g))">
                                    <td class="dcon-cur text-muted">@(index + 1)</td>
                                    <td class="dcon-node-kind">@GestureKind(g)</td>
                                    <td class="dcon-list-title font-mono">@g.Where</td>
                                    <td class="dcon-node-kind">@(g.DurationMs > 0 ? $"{g.DurationMs}ms" : "")</td>
                                    <td class="dcon-row-tools">
                                        <button type="button" class="btn-mini" disabled="@_replaying" title="Replay this step"
                                                @onclick="@(() => ReplayAsync(g))" @onclick:stopPropagation="true">
                                            <Icon Name="play" Class="icon-sm"/>
                                        </button>
                                        <button type="button" class="btn-mini" title="Remove this step"
                                                @onclick="@(() => RemoveGesture(index))" @onclick:stopPropagation="true">
                                            <Icon Name="x" Class="icon-sm"/>
                                        </button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_selectedGesture is { } sel) {
                    <div class="dcon-sel">
                        <div class="dcon-snip-row">
                            <span class="dcon-snip-by">step</span>
                            <code class="dcon-snip">@sel.StepLine</code>
                            <CopyButton Text="@sel.StepLine" AriaLabel="Copy flow step"/>
                        </div>
                    </div>
                }
            }
        </div>
        }
    </div>

    @Sections
    </div>
    </div>
    </div>
}

@code {

    [Parameter] public string? DeviceId { get; set; }

    [Parameter] public string? Platform { get; set; }

    [Parameter] public bool Virtual { get; set; }

    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback<DeviceNotice> OnNotice { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ActionNotes { get; set; }

    [Parameter] public RenderFragment? Sections { get; set; }

    bool ActivityOpen => State.IsOpen(DeviceWorkbenchState.SectionActivity);

    void ToggleActivity() {
        State.SetOpen(DeviceWorkbenchState.SectionActivity, !ActivityOpen);
    }

    string CurrentIslandLabel() {
        return SelectedIsland() is { } island ? $"{IslandLabel(island)}, user {island.UserId}" : "device, no island";
    }

    static readonly int[] Rates = [5, 4, 3, 2, 1];
    static readonly string[] JobIdNames = ["jobId", "JobId", "runId", "RunId", "id", "Id"];
    const int LastRunCount = 5;
    const int LastRunPage = 25;
    const int StreamBusyStatus = 409;
    static readonly TimeSpan StreamRetryDelay = TimeSpan.FromSeconds(1);
    static readonly TimeSpan VideoReprobeDelay = TimeSpan.FromSeconds(20);

    bool _disposed;
    bool _isAdmin;
    bool _loaded;
    bool _live;
    bool _hasFrame;
    bool _useVideo;
    bool _streamOnVideo;
    bool _syncing;
    bool _streamRetried;
    bool _videoFallback;
    int _videoReprobe;
    bool? _videoSupported;
    bool _replaying;
    bool _booksBusy;
    bool _readinessBusy;
    bool _runBusy;
    bool _runDone;
    bool _runOk;
    bool _runCancelled;
    bool _runReadOnly;
    bool _stopBusy;
    bool _refreshing;
    bool _wrap = true;
    bool _captureKeys;
    bool _islandBusy;
    bool _newIslandOpen;
    int _fps = 3;
    int _shotW;
    int _shotH;
    int _screenW;
    int _screenH;
    int? _selectedUserId;
    double _videoFps;
    double _videoLatency;
    double _videoKbps;
    double _jpegFps;
    StreamQuality _quality = StreamQuality.Balanced;
    string _text = "";
    string _newIslandLabel = "";
    string _streamKey = "";
    string _stageKey = "";
    string _bookId = "";
    string? _deviceId;
    string? _streamError;
    string? _runTitle;
    string? _runNote;
    string? _runFailedStepTitle;
    long? _runJobId;
    DateTimeOffset? _runStartedAt;
    DateTimeOffset? _runFinishedAt;
    DateTimeOffset? _readinessAt;
    DeviceConsoleMode _mode = DeviceConsoleMode.Idle;

    List<RecordedGesture> _recorded = [];
    List<DeviceCookbookInfo> _books = [];
    List<JobGroupRow> _lastRuns = [];
    List<string> _runLog = [];
    List<CookbookStepResult> _steps = [];
    List<IslandRow> _islands = [];
    readonly Dictionary<string, string> _args = [];
    RecordedGesture? _selectedGesture;
    DeviceReadiness? _readiness;

    ElementReference _img;
    ElementReference _canvas;
    ElementReference _stage;
    IJSObjectReference? _module;
    DotNetObjectReference<DeviceConsolePane>? _self;
    IDisposable? _topics;
    Timer? _tick;

    DeviceCookbookFeed? CookbookFeed => Services.GetService(typeof(DeviceCookbookFeed)) as DeviceCookbookFeed;

    DeviceJobFeed? JobFeed => Services.GetService(typeof(DeviceJobFeed)) as DeviceJobFeed;

    DeviceCookbookRunner? Runner => Services.GetService(typeof(DeviceCookbookRunner)) as DeviceCookbookRunner;

    bool IsAndroid => string.Equals(Platform, "android", StringComparison.OrdinalIgnoreCase);

    int TapWidth => _screenW > 0 ? _screenW : _shotW;

    int TapHeight => _screenH > 0 ? _screenH : _shotH;

    DeviceConsoleCache? Cache => _deviceId is { } id ? State.ConsoleFor(id) : null;

    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    protected override async Task OnParametersSetAsync() {
        SubscribeWatches();
        var next = string.IsNullOrEmpty(DeviceId) ? null : DeviceId;
        if (next != _deviceId) {
            await StopStreamAsync();
            if (next is not null) _watch = Watches?.Status(next);
            StopRunWatch();
            _deviceId = next;
            _loaded = false;
            ResetDevice();
            RecomputeVideo();
            _live = next is not null;
            if (Cache is { } cache) PaintFromCache(cache);
        }

        if (!Active) {
            await StopStreamAsync();
            StopRunWatch();
            StopTick();
            return;
        }

        if (_deviceId is null) return;
        if (!_loaded) {
            _loaded = true;
            _ = RefreshAllAsync();
            return;
        }

        if (_runJobId is not null && !_runDone && !_runReadOnly) StartRunWatch();
    }

    void PaintFromCache(DeviceConsoleCache cache) {
        _books = [.. cache.Cookbooks];
        SeedCookbookDefaults();
        _readiness = cache.Readiness;
        _readinessAt = cache.ReadinessAt;
