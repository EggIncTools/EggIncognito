    }

    string VideoUrl() {
        var (w, h, bitrate) = QualitySpec();
        return string.Create(CultureInfo.InvariantCulture,
            $"/api/devices/{_deviceId}/ui/video?size={w}x{h}&bitrate={bitrate}");
    }

    [JSInvokable]
    public Task OnFrameSize(int naturalW, int naturalH) {
        _shotW = naturalW;
        _shotH = naturalH;
        _hasFrame = naturalW > 0;
        if (_hasFrame) _streamRetried = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnStreamFps(double fps) {
        _jpegFps = fps;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnFrameFailed(int status, string note) {
        return StreamEndedAsync(string.IsNullOrWhiteSpace(note) ? "the device stopped sending frames" : note, status);
    }

    [JSInvokable]
    public Task OnVideoStats(VideoStats stats) {
        if (stats.Token != _streamKey) return Task.CompletedTask;
        _videoFps = stats.Fps;
        _videoLatency = stats.LatencyMs;
        _videoKbps = stats.Kbps;
        _videoDecoded = stats.Decoded;
        _videoDrawn = stats.Drawn;
        _dropQueue = stats.DropQueue;
        _dropKey = stats.DropKey;
        _dropError = stats.DropError;
        _queueDepth = stats.Queue;
        _sinceDrawnMs = stats.SinceDrawnMs;
        if (stats.FrameW > 0) {
            _shotW = stats.FrameW;
            _shotH = stats.FrameH;
            _hasFrame = true;
            _streamRetried = false;
        }

        return InvokeAsync(StateHasChanged);
    }

    public sealed record VideoStats(string Token, double Fps, double LatencyMs, int FrameW, int FrameH, double Kbps,
        int Decoded, int Drawn, int DropQueue, int DropKey, int DropError, int Queue, int SinceDrawnMs);

    [JSInvokable]
    public Task OnVideoEnded(string token, string reason, int status, bool retryable) {
        if (string.Equals(reason, "stopped", StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
        if (token != _streamKey) return Task.CompletedTask;
        if (retryable && RestartVideo()) return InvokeAsync(StateHasChanged);
        return StreamEndedAsync(string.IsNullOrWhiteSpace(reason) ? "the server closed the stream" : reason, status);
    }

    void ResetVideoHealth() {
        _videoDecoded = _videoDrawn = _dropQueue = _dropKey = _dropError = _queueDepth = 0;
        _sinceDrawnMs = -1;
        _videoRestarts = 0;
        _restartWindowAt = default;
    }

    const int MaxRestartsPerMinute = 4;

    bool RestartVideo() {
        if (!_live || !_streamOnVideo || _deviceId is null) return false;
        var now = DateTimeOffset.UtcNow;
        if (now - _restartWindowAt > TimeSpan.FromMinutes(1)) {
            _restartWindowAt = now;
            _videoRestarts = 0;
        }

        if (++_videoRestarts > MaxRestartsPerMinute) return false;
        _streamKey = "";
        _videoKey = "";
        _streamOnVideo = false;
        _watchKey = "";
        return true;
    }

    async Task StreamEndedAsync(string reason, int status) {
        bool videoNeverDrew = _streamOnVideo && _shotW == 0;
        _streamKey = "";
        _videoKey = "";
        _streamOnVideo = false;
        _hasFrame = false;
        _watchKey = "";
        _ = InvokeAsync(PollUiStateAsync);
        if (status == StreamBusyStatus && !_streamRetried && _live) {
            _streamRetried = true;
            await Task.Delay(StreamRetryDelay);
            if (_disposed) return;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (videoNeverDrew && _live && _useVideo && _deviceId is { } deviceId) {
            _videoFallback = true;
            RecomputeVideo();
            Logger.LogInformation("video stream for {DeviceId} gave no frame ({Reason}); jpeg until the next re-probe", deviceId, reason);
            _ = ReprobeVideoLaterAsync(deviceId, ++_videoReprobe);
            await InvokeAsync(StateHasChanged);
            return;
        }

        _live = false;
        _streamError = reason;
        await InvokeAsync(StateHasChanged);
    }

    DotNetObjectReference<DeviceConsolePane> Ref() {
        _self ??= DotNetObjectReference.Create(this);
        return _self;
    }

    async Task<IJSObjectReference?> ModuleAsync() {
        if (_module is not null) return _module;
        try {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/deviceConsole.js"));
            return _module;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console module import failed");
            return null;
        }
    }

    async Task SafeAsync(IJSObjectReference module, string identifier, params object?[] args) {
        try {
            await module.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console interop call failed");
        }
    }

    async Task<T?> SafeValueAsync<T>(IJSObjectReference module, string identifier, params object?[] args) {
        try {
            return await module.InvokeAsync<T>(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "device console interop call failed");
            return default;
        }
    }

    public async ValueTask DisposeAsync() {
        _disposed = true;
        if (_watchSubscribed && Watches is { } watches) watches.Changed -= OnWatchChanged;
        StopUiPoll();
        if (_module is { } module) {
            await SafeAsync(module, "clearWatchPoints", _canvas);
            if (_stageKey.Length > 0) await SafeAsync(module, "unbindStage", _stage);
            await HaltAsync(module);
        }

        if (_vis is { } vis) await vis.DisposeAsync();
        await _module.DisposeModuleQuietAsync(logger: Logger);
        _self?.Dispose();
        _self = null;
    }

}
