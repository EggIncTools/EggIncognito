@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject IServiceProvider Services
@inject DeviceWorkbenchState State
@inject ILogger<DeviceConsolePane> Logger
@using System.Globalization
@using System.Text.Json
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Devices
@using EggIncognito.Services.Devices
@implements IAsyncDisposable

@if (_deviceId is null) {
    <div class="wb-note">Pick a device.</div>
} else {
    <div class="dcon">
    <div class="dcon-body">
    <div class="dcon-stage-col">
        <div class="dcon-stage">
            <button type="button" class="dcon-shot" @ref="_stage"
                    aria-label="Device screen: tap, hold for long-press, drag or scroll to swipe">
                @if (_useVideo) {
                    <canvas class="dcon-canvas" @ref="_canvas"></canvas>
                } else {
                    <img class="dcon-img" alt="" @ref="_img"/>
                }
                @if (_hasFrame && _selectedGesture is { } hl && TapWidth > 0) {
                    <span class="dcon-hl dcon-hl-pt" style="@PointStyle(hl.X, hl.Y)"></span>
                    @if (hl.Kind == RecordedGestureKind.Swipe) {
                        <span class="dcon-hl dcon-hl-pt dcon-hl-end" style="@PointStyle(hl.X2, hl.Y2)"></span>
                    }
                }
                @if (_hasFrame && TapWidth > 0) {
                    @foreach (var wp in _watch.Points) {
                        <span class="dcon-hl dcon-hl-pt dcon-hl-watch" style="@PointStyle(wp.X, wp.Y)"></span>
                    }
                }
                @if (_watch.Tapping) {
                    <span class="dcon-tapping" aria-hidden="true"></span>
                }
            </button>
            @if (ShowNavBar) {
                <div class="dcon-nav" role="group" aria-label="Device navigation">
                    @if (GestureNav) {
                        <button type="button" class="dcon-nav-btn dcon-nav-pill" aria-label="Home"
                                @onclick="@(() => KeyAsync("home"))">
                            <span class="dcon-nav-handle" aria-hidden="true"></span>
                        </button>
                    } else {
                        <button type="button" class="dcon-nav-btn" aria-label="Recents"
                                @onclick="@(() => KeyAsync("recents"))">
                            <span class="dcon-nav-recents" aria-hidden="true"></span>
                        </button>
                        <button type="button" class="dcon-nav-btn" aria-label="Home" @onclick="@(() => KeyAsync("home"))">
                            <span class="dcon-nav-home" aria-hidden="true"></span>
                        </button>
                        <button type="button" class="dcon-nav-btn" aria-label="Back" @onclick="@(() => KeyAsync("back"))">
                            <span class="dcon-nav-back" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            }
            @if (Asleep) {
                <button type="button" class="dcon-wake" disabled="@_waking" @onclick="WakeAsync">
                    <Icon Name="power" Class="icon-md"/>
                    <span>@(_waking ? "Waking..." : "Click to wake")</span>
                    <span class="text-muted dcon-stage-reason">@AsleepReason()</span>
                </button>
            } else if (!_hasFrame) {
                <span class="dcon-stage-empty">
                    <Icon Name="@StreamIcon()" Class="@("icon-sm " + StreamIconClass())"/>
                    <span>@StageEmptyText()</span>
                    @if (_streamError is { } stageErr) {
                        <span class="text-muted dcon-stage-reason">@stageErr</span>
                    }
                </span>
            }
        </div>
    </div>

    <div class="dcon-side">
    @if (Actions is not null) {
        <div class="dwb-bar dcon-actions">
            <span class="dwb-bar-group">@Actions</span>
        </div>
        @ActionNotes
    }

    <div class="dwb-bar">
        <span class="dwb-bar-group">
            <span class="dcon-k">Stream</span>
            <span class="dcon-status">
                <Icon Name="@StreamIcon()" Class="@("icon-sm " + StreamIconClass())"/>
                <span>@StreamLabel()</span>
            </span>
            @if (StreamDetail() is { } streamDetail) {
                <span class="text-muted text-xs dcon-status-detail">@streamDetail</span>
            }
        </span>
        <span class="dwb-bar-group">
            <span class="text-muted text-xs" title="@(_videoFallback ? "h264 gave no frame, retrying shortly" : null)">@(_useVideo ? "h264" : _videoFallback ? "jpeg, h264 retry pending" : "jpeg")</span>
            <select class="field-input dcon-rate" aria-label="Quality" value="@QualityValue()" @onchange="QualityPicked">
                @if (_useVideo) {
                    <option value="@StreamQuality.Fluid">Fluid</option>
                    <option value="@StreamQuality.Balanced">Balanced</option>
                    <option value="@StreamQuality.Crisp">Crisp</option>
                } else {
                    @foreach (var fps in Rates) {
                        <option value="@fps">@fps fps</option>
                    }
                }
            </select>
            <button type="button" class="btn-mini" @onclick="ToggleStreamAsync">
                <Icon Name="@(_live ? "pause" : "play")" Class="icon-sm"/>
                @(_live ? "Pause" : "Resume")
            </button>
            <button type="button" class="btn-mini @(_mode == DeviceConsoleMode.Record ? "dcon-on" : "")"
                    title="Record every tap, hold and swipe on the stage as flow steps" @onclick="ToggleRecord">
                <Icon Name="@(_mode == DeviceConsoleMode.Record ? "circle-check" : "circle")" Class="icon-sm"/>
                Record
            </button>
            @if (IsAndroid) {
                <button type="button" class="btn-mini @(_locking || _watch.Points.Count > 0 ? "dcon-on" : "")"
                        title="@WatchTitle()" @onclick="ToggleLocking">
                    <Icon Name="eye" Class="icon-sm"/>
                    @WatchLabel()
                </button>
                @if (_watch.Points.Count > 0) {
                    <button type="button" class="btn-mini" title="Stop every watch point on this device"
                            @onclick="StopAllWatchesAsync">
                        Clear @_watch.Points.Count
                    </button>
                }
            }
        </span>
    </div>

    <div class="dwb-bar">
        <span class="dwb-bar-group">
            <span class="dcon-k">Workflows</span>
            @if (_runLine is { } run) {
                <span class="dcon-run-title">@run.Title</span>
                <span class="font-mono text-muted text-xs">@run.Elapsed</span>
                <span class="dcon-status">
                    <Icon Name="@run.Icon" Class="@("icon-sm " + run.IconClass)"/>
                    <span>@run.State</span>
                </span>
            } else {
                <span class="text-muted text-xs">nothing running</span>
            }
        </span>
        <span class="dwb-bar-group">
            <button type="button" class="btn-mini" @onclick="OpenRunPanel">
                <Icon Name="play" Class="icon-sm"/>
                @(_runLine is null ? "Open" : "Show run")
            </button>
        </span>
    </div>

    @if (IsAndroid) {
        <DeviceSection Title="Island" Open="@State.IsOpen(DeviceWorkbenchState.SectionIsland)"
                       OpenChanged="@(o => State.SetOpen(DeviceWorkbenchState.SectionIsland, o))">
            <Summary>
                <span class="text-muted text-xs">@CurrentIslandLabel()</span>
            </Summary>
            <Tools>
                @if (!_newIslandOpen) {
                    <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="OpenNewIsland">
                        <Icon Name="plus" Class="icon-sm"/>
                        New island
                    </button>
                }
                <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="LoadIslandsAsync">
                    <Icon Name="refresh-cw" Class="icon-sm"/>
                    @(_islandBusy ? "Refreshing..." : "Refresh")
                </button>
            </Tools>
            <ChildContent>
            <div class="text-muted text-xs">islands run one at a time; only the foreground user renders</div>
            <div class="reg-wrap dcon-island-wrap">
                <table class="data-table dcon-list">
                    <tbody>
                    <tr>
                        <td class="dcon-cur">
                            @if (_selectedAndroidUserId is null) {
                                <Icon Name="check" Class="icon-sm text-ok"/>
                            }
                        </td>
                        <td class="dcon-list-title">Device (no island)</td>
                        <td class="font-mono text-muted text-xs">user @IslandScope.Owner</td>
                        <td class="dcon-row-tools">
                            @if (_selectedAndroidUserId is not null) {
                                <button type="button" class="btn-mini" disabled="@_islandBusy"
                                        @onclick="@(() => SwitchIslandAsync(IslandScope.Owner))">
                                    Switch
                                </button>
                            }
                        </td>
                    </tr>
                    @foreach (var island in _islands) {
                        var current = _selectedAndroidUserId == island.AndroidUserId;
                        <tr @key="island.AndroidUserId">
                            <td class="dcon-cur">
                                @if (current) {
                                    <Icon Name="check" Class="icon-sm text-ok"/>
                                }
                            </td>
                            <td class="dcon-list-title">@IslandLabel(island)</td>
                            <td class="font-mono text-muted text-xs"
                                title="@(island.Provisioned ? null : "setup wizard not marked complete for this user; interstitials may cover the app")">
                                user @island.AndroidUserId@(island.Provisioned ? "" : ", unprovisioned")
                            </td>
                            <td class="dcon-row-tools">
                                @if (!current) {
                                    <button type="button" class="btn-mini" disabled="@_islandBusy"
                                            @onclick="@(() => SwitchIslandAsync(island.AndroidUserId))">
                                        Switch
                                    </button>
                                }
                                <button type="button" class="btn-mini btn-danger" disabled="@_islandBusy"
                                        @onclick="@(() => RemoveIslandAsync(island.AndroidUserId))">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (_newIslandOpen) {
                <div class="dcon-run-row">
                    <input class="field-input" placeholder="island label" aria-label="New island label"
                           @bind="_newIslandLabel" @bind:event="oninput" @onkeydown="NewIslandKeyAsync"/>
                    <button type="button" class="btn-mini" disabled="@(_islandBusy || _newIslandLabel.Trim().Length == 0)"
                            @onclick="CreateIslandAsync">
                        Create
                    </button>
                    <button type="button" class="btn-mini" disabled="@_islandBusy" @onclick="CancelNewIsland">Cancel</button>
                </div>
            }
            </ChildContent>
        </DeviceSection>
    }

    <DeviceSection Title="Input" Open="@State.IsOpen(DeviceWorkbenchState.SectionInput)"
                   OpenChanged="@(o => State.SetOpen(DeviceWorkbenchState.SectionInput, o))">
        <Tools>
            <button type="button" class="btn-mini @(_captureKeys ? "dcon-on" : "")" @onclick="ToggleCapture"
                    title="Send every keystroke to the device as you type">
                <Icon Name="@(_captureKeys ? "circle-check" : "circle")" Class="icon-sm"/>
                Live keys
            </button>
            <button type="button" class="btn-mini" @onclick="@(() => KeyAsync("enter"))">Enter</button>
        </Tools>
        <ChildContent>
        @if (_captureKeys) {
            <div class="dcon-status text-xs">
                <Icon Name="circle-check" Class="icon-sm text-accent"/>
                <span class="text-muted">Keys go to the device as you type, anywhere on this page. Ctrl, Alt and Cmd shortcuts still reach the browser.</span>
            </div>
        } else {
            <div class="dcon-typing">
                <input class="field-input font-mono" placeholder="paste or type a whole string"
                       aria-label="Text to send" @bind="_text" @bind:event="oninput" @onkeydown="TextKeyAsync"/>
                <button type="button" class="btn-mini" disabled="@(_text.Length == 0)" @onclick="SendTextAsync">
                    <Icon Name="send" Class="icon-sm"/>
                    Send
                </button>
            </div>
        }
        </ChildContent>
    </DeviceSection>

    @if (_mode == DeviceConsoleMode.Record) {
        <div class="dcon-activity">
            <div class="dcon-activity-head">
                <span class="dcon-activity-title">
                    <span class="dcon-k">Record</span>
                    <span class="text-muted text-xs">@_recorded.Count @(_recorded.Count == 1 ? "step" : "steps")</span>
                </span>
                <span class="dcon-activity-tools">
                    <CopyButton GetText="@(() => RecordedGesture.FlowText(_recorded))" Label="Copy flow" CopiedLabel="Copied"
                                ShowIcon="false" ButtonClass="btn-mini"/>
                    <button type="button" class="btn-mini" disabled="@(_recorded.Count == 0 || _replaying)" @onclick="ReplayAllAsync">
                        <Icon Name="play" Class="icon-sm"/>
                        @(_replaying ? "Replaying..." : "Replay")
                    </button>
                    <button type="button" class="btn-mini" disabled="@(_recorded.Count == 0)" @onclick="ClearRecorded">Clear</button>
                    <button type="button" class="btn-mini" @onclick="CloseRecord">Close</button>
                </span>
            </div>
            <div class="dcon-activity-body">
                @if (_recorded.Count == 0) {
                    <div class="dcon-status text-xs">
                        <Icon Name="circle" Class="icon-sm text-muted"/>
                        <span class="text-muted">Tap, hold or swipe the screen. Each gesture lands here as a flow step at device pixels.</span>
                    </div>
                } else {
                    <div class="reg-wrap dcon-tree">
                        <table class="data-table dcon-list">
                            <tbody>
                            @foreach (var index in Enumerable.Range(0, _recorded.Count)) {
                                var g = _recorded[index];
                                <tr @key="index" class="dcon-node @(ReferenceEquals(_selectedGesture, g) ? "dcon-node-on" : "")"
                                    @onclick="@(() => SelectGesture(g))">
                                    <td class="dcon-cur text-muted">@(index + 1)</td>
                                    <td class="dcon-node-kind">@GestureKind(g)</td>
                                    <td class="dcon-list-title font-mono">@g.Where</td>
                                    <td class="dcon-node-kind">@(g.DurationMs > 0 ? $"{g.DurationMs}ms" : "")</td>
                                    <td class="dcon-row-tools">
                                        <button type="button" class="btn-mini" disabled="@_replaying" title="Replay this step"
                                                @onclick="@(() => ReplayAsync(g))" @onclick:stopPropagation="true">
                                            <Icon Name="play" Class="icon-sm"/>
                                        </button>
                                        <button type="button" class="btn-mini" title="Remove this step"
                                                @onclick="@(() => RemoveGesture(index))" @onclick:stopPropagation="true">
                                            <Icon Name="x" Class="icon-sm"/>
                                        </button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_selectedGesture is { } sel) {
                    <div class="dcon-sel">
                        <div class="dcon-snip-row">
                            <span class="dcon-snip-by">step</span>
                            <code class="dcon-snip">@sel.StepLine</code>
                            <CopyButton Text="@sel.StepLine" AriaLabel="Copy flow step"/>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @Sections
    </div>
    </div>
    </div>

    <DeviceRunPanel DeviceId="@_deviceId" Active="@Active" Open="@RunPanelOpen" AndroidUserId="@_selectedAndroidUserId"
                    OnClose="CloseRunPanel" OnOpenRequested="OpenRunPanel" OnNotice="OnNotice"
                    OnChanged="AfterRunAsync" OnRunChanged="RunLineChanged"/>
}

@code {

    [Parameter] public string? DeviceId { get; set; }

    [Parameter] public string? Platform { get; set; }

    [Parameter] public bool Virtual { get; set; }

    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback<DeviceNotice> OnNotice { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ActionNotes { get; set; }

    [Parameter] public RenderFragment? Sections { get; set; }

    string CurrentIslandLabel() {
        return SelectedIsland() is { } island ? $"{IslandLabel(island)}, user {island.AndroidUserId}" : "device, no island";
    }

    static readonly int[] Rates = [5, 4, 3, 2, 1];
    const int StreamBusyStatus = 409;
    const int WatchTolerance = 48;
    const int WatchCooldownMs = 2500;
    static readonly TimeSpan StreamRetryDelay = TimeSpan.FromSeconds(1);
    static readonly TimeSpan VideoReprobeDelay = TimeSpan.FromSeconds(20);
    static readonly TimeSpan UiPollInterval = TimeSpan.FromSeconds(5);

    bool _disposed;
    bool _loaded;
    bool _live;
    bool _hasFrame;
    bool _useVideo;
    bool _streamOnVideo;
    bool _syncing;
    bool _streamRetried;
    bool _videoFallback;
    int _videoReprobe;
    bool? _videoSupported;
    bool _replaying;
    bool _captureKeys;
    bool _islandBusy;
    bool _newIslandOpen;
    bool _uiProbed;
    bool _uiBusy;
    bool _waking;
    int _fps = 3;
    int _shotW;
    int _shotH;
    int _screenW;
    int _screenH;
    int? _selectedAndroidUserId;
    double _videoFps;
    double _videoLatency;
    double _videoKbps;
    double _jpegFps;
    int _videoDecoded;
    int _videoDrawn;
    int _dropQueue;
    int _dropKey;
    int _dropError;
    int _queueDepth;
    int _sinceDrawnMs;
    int _videoRestarts;
    DateTimeOffset _restartWindowAt;
    StreamQuality _quality = StreamQuality.Balanced;
    string _text = "";
    string _newIslandLabel = "";
    string _streamKey = "";
    string _videoKey = "";
    string _stageKey = "";
    string _keysKey = "";
    string _watchKey = "";
    bool _clientWatching;
    string? _clientWatchingFor;
    string? _deviceId;
    string? _streamError;
    DeviceConsoleMode _mode = DeviceConsoleMode.Idle;
    UiStateInfo? _uiState;
    DeviceRunLine? _runLine;
    List<RecordedGesture> _recorded = [];
    List<IslandRow> _islands = [];
    RecordedGesture? _selectedGesture;

    ElementReference _img;
    ElementReference _canvas;
    ElementReference _stage;
    IJSObjectReference? _module;
    DotNetObjectReference<DeviceConsolePane>? _self;
    Timer? _uiPoll;
    PageVisibility? _vis;
    bool _visible = true;

    PageVisibility Vis => _vis ??= new PageVisibility(JS, Env);

    bool StreamWhileHidden => _watch.Points.Count > 0;

    async Task OnVisibilityAsync(bool visible) {
        if (_disposed || visible == _visible) return;
        _visible = visible;
        if (!visible && !StreamWhileHidden) ResetVideoHealth();
        await InvokeAsync(StateHasChanged);
    }

    bool IsAndroid => string.Equals(Platform, "android", StringComparison.OrdinalIgnoreCase);

    int TapWidth => _screenW > 0 ? _screenW : _shotW;

    int TapHeight => _screenH > 0 ? _screenH : _shotH;

    bool Asleep => _uiProbed && _uiState is { } s && (!s.Awake || s.Locked);

    bool RunPanelOpen => State.RunPanelFor == _deviceId && _deviceId is not null;

    bool ShowNavBar => IsAndroid && _uiProbed && _uiState?.NavMode is not (0 or 1);

    bool GestureNav => _uiState?.NavMode is 2;

    DeviceConsoleCache? Cache => _deviceId is { } id ? State.ConsoleFor(id) : null;

    protected override async Task OnParametersSetAsync() {
        SubscribeWatches();
        var next = string.IsNullOrEmpty(DeviceId) ? null : DeviceId;
        if (next != _deviceId) {
            await StopStreamAsync();
            _watch = next is null ? PixelWatchState.Empty : Watches?.State(next) ?? PixelWatchState.Empty;
            _deviceId = next;
            _loaded = false;
            ResetDevice();
            RecomputeVideo();
            _live = next is not null;
            if (Cache is { } cache) PaintFromCache(cache);
        }

        if (!Active) {
            await StopStreamAsync();
            StopUiPoll();
            return;
        }

        if (_deviceId is null) return;
        StartUiPoll();
        if (!_loaded) {
            _loaded = true;
            _ = RefreshAllAsync();
        }
    }

    void PaintFromCache(DeviceConsoleCache cache) {
        _islands = [.. cache.Islands];
        _selectedAndroidUserId = cache.CurrentAndroidUserId;
        _screenW = cache.ScreenW;
        _screenH = cache.ScreenH;
    }

    async Task RefreshAllAsync() {
        var id = _deviceId;
        if (id is null) return;
        try {
            await Task.WhenAll(LoadScreenAsync(), LoadIslandsAsync(), PollUiStateAsync());
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException) {
            Logger.LogDebug(ex, "device console refresh failed for {DeviceId}", id);
        }

        if (!_disposed && _deviceId == id && Cache is { } cache) cache.FetchedAt = DateTimeOffset.UtcNow;
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    bool Stale(string id) {
        return _disposed || _deviceId != id;
    }

    void ResetDevice() {
        _recorded = [];
        _selectedGesture = null;
        _replaying = false;
        _locking = false;
        _watch = PixelWatchState.Empty;
        _watchKey = "";
        _streamError = null;
        _streamRetried = false;
        _videoFallback = false;
        _videoReprobe++;
        _hasFrame = false;
        _shotW = _shotH = 0;
        _screenW = _screenH = 0;
        _videoFps = _videoLatency = _videoKbps = _jpegFps = 0;
        ResetVideoHealth();
        _islands = [];
        _islandBusy = false;
        _newIslandOpen = false;
        _newIslandLabel = "";
        _selectedAndroidUserId = null;
        _captureKeys = false;
        _uiState = null;
        _uiProbed = false;
        _waking = false;
        _runLine = null;
        _mode = DeviceConsoleMode.Idle;
    }

    bool RecomputeVideo() {
        var next = _videoSupported == true && !_videoFallback;
        if (next == _useVideo) return false;
        _useVideo = next;
        return true;
    }

    void OpenRunPanel() {
        State.RunPanelFor = _deviceId;
    }

    void CloseRunPanel() {
        State.RunPanelFor = null;
    }

    void RunLineChanged(DeviceRunLine? line) {
        _runLine = line;
    }

    async Task AfterRunAsync() {
        await Task.WhenAll(LoadScreenAsync(), LoadIslandsAsync());
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    void StartUiPoll() {
        _uiPoll ??= new Timer(_ => _ = InvokeAsync(PollUiStateAsync), null, TimeSpan.Zero, UiPollInterval);
    }

    void StopUiPoll() {
        _uiPoll?.Dispose();
        _uiPoll = null;
    }

    async Task PollUiStateAsync() {
        if (_disposed || !Active || _uiBusy || _deviceId is not { } id) return;
        _uiBusy = true;
        try {
            var state = await Client().OneAsync<UiStateInfo>($"/api/devices/{id}/ui/state", Logger);
            if (Stale(id)) return;
            _uiState = state;
            _uiProbed = true;
            StateHasChanged();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) {
            Logger.LogDebug(ex, "ui state poll failed for {DeviceId}", id);
        }
        finally {
            _uiBusy = false;
        }
    }

    string AsleepReason() {
        if (_uiState is not { } s) return "";
        if (s.Locked && !s.Awake) return "screen off and locked";
        return s.Locked ? "locked" : "screen off";
    }

    async Task WakeAsync() {
        if (_deviceId is null || _waking) return;
        _waking = true;
        await KeyAsync("wake");
        await PollUiStateAsync();
        if (!Asleep) {
            ClearStreamError();
            RetryVideo();
            _live = true;
        }

        _waking = false;
    }

    string StreamIcon() {
        if (_streamError is not null) return "circle-x";
        if (!_live || (!_visible && !StreamWhileHidden)) return "pause";
        return _hasFrame ? "circle-check" : "circle";
    }

    string StreamIconClass() {
        if (_streamError is not null) return "text-err";
        return _live && _hasFrame ? "text-ok" : "text-muted";
    }

    string StreamLabel() {
        if (_streamError is not null) return "ended";
        if (!_live) return "paused";
        if (!_visible && !StreamWhileHidden) return "backgrounded";
        return _hasFrame ? "live" : "connecting";
    }

    string? StreamDetail() {
        if (_streamError is { } err) return err;
        if (!_live || !_hasFrame) return null;
        if (!_useVideo)
            return string.Create(CultureInfo.InvariantCulture,
                $"{_jpegFps:0.#} of {_fps} fps, {_shotW}x{_shotH}");
        return string.Create(CultureInfo.InvariantCulture,
            $"{_videoFps:0} fps, {_videoLatency:0} ms, {_shotW}x{_shotH}, {_videoKbps / 1000:0.0} Mbps{VideoHealth()}");
    }

    string VideoHealth() {
        if (_videoDrawn > 0 && _dropQueue + _dropKey + _dropError == 0 && _queueDepth <= 1) return "";
        List<string> parts = [];
        if (_videoDecoded != _videoDrawn) parts.Add(string.Create(CultureInfo.InvariantCulture, $"{_videoDrawn} of {_videoDecoded} drawn"));
        if (_dropQueue > 0) parts.Add(string.Create(CultureInfo.InvariantCulture, $"{_dropQueue} dropped, queue deep"));
        if (_dropKey > 0) parts.Add(string.Create(CultureInfo.InvariantCulture, $"{_dropKey} dropped, awaiting keyframe"));
        if (_dropError > 0) parts.Add(string.Create(CultureInfo.InvariantCulture, $"{_dropError} dropped, decoder error"));
        if (_queueDepth > 1) parts.Add(string.Create(CultureInfo.InvariantCulture, $"queue {_queueDepth}"));
        if (_sinceDrawnMs >= 1000) parts.Add(string.Create(CultureInfo.InvariantCulture, $"nothing drawn for {_sinceDrawnMs / 1000.0:0.#}s"));
        if (_videoRestarts > 0 && DateTimeOffset.UtcNow - _restartWindowAt < TimeSpan.FromMinutes(1))
            parts.Add(_videoRestarts == 1 ? "1 restart" : string.Create(CultureInfo.InvariantCulture, $"{_videoRestarts} restarts"));
        return parts.Count == 0 ? "" : " - " + string.Join(", ", parts);
    }

