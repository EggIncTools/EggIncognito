    const int MaxHoldMs = 10_000;

    bool _holding;
    bool _holdReplay;
    DateTimeOffset _holdStartedAt;
    (int X, int Y) _holdPoint;

    [JSInvokable]
    public async Task OnStageHoldStart(double fx, double fy) {
        if (_deviceId is null || DevicePoint(fx, fy) is not { } p) return;
        _holding = true;
        _holdReplay = false;
        _holdStartedAt = DateTimeOffset.UtcNow;
        _holdPoint = p;
        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/touch",
            new UiTouchRequest("down", p.X, p.Y), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) _holdReplay = true;
    }

    [JSInvokable]
    public async Task OnStageHoldEnd(double fx, double fy) {
        if (_deviceId is null || !_holding) return;
        _holding = false;
        var end = DevicePoint(fx, fy) ?? _holdPoint;
        var held = Math.Clamp((int)(DateTimeOffset.UtcNow - _holdStartedAt).TotalMilliseconds + LongPressMs, LongPressMs, MaxHoldMs);
        Record(RecordedGesture.Hold(_holdPoint.X, _holdPoint.Y, held));
        if (_holdReplay) {
            await SwipeAsync(_holdPoint.X, _holdPoint.Y, _holdPoint.X, _holdPoint.Y, held);
            return;
        }

        var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/touch",
            new UiTouchRequest("up", end.X, end.Y), SelfCallJson.Web);
        if (!res.IsSuccessStatusCode) await Fail(await ReadError(res));
    }

    [JSInvokable]
    public async Task OnStageSwipe(double fx1, double fy1, double fx2, double fy2, int durationMs) {
        if (_deviceId is null) return;
        if (DevicePoint(fx1, fy1) is not { } from || DevicePoint(fx2, fy2) is not { } to) return;
        var ms = Math.Clamp(durationMs, 50, 1000);
        Record(RecordedGesture.Swipe(from.X, from.Y, to.X, to.Y, ms));
        await SwipeAsync(from.X, from.Y, to.X, to.Y, ms);
    }

    (int X, int Y)? DevicePoint(double fx, double fy) {
        var w = TapWidth;
        var h = TapHeight;
        if (w <= 0 || h <= 0) return null;
        var (ox, oy, cw, ch) = ContentRect(w, h);
        return (Frac((fx - ox) / cw, w), Frac((fy - oy) / ch, h));
    }

    (double Ox, double Oy, double Cw, double Ch) ContentRect(int screenW, int screenH) {
        if (_shotW <= 0 || _shotH <= 0) return (0, 0, 1, 1);
        var frame = (double)_shotW / _shotH;
        var screen = (double)screenW / screenH;
        if (Math.Abs(frame - screen) < 0.002) return (0, 0, 1, 1);
        if (screen < frame) {
            var cw = screen / frame;
            return ((1 - cw) / 2, 0, cw, 1);
        }

        var ch = frame / screen;
        return (0, (1 - ch) / 2, 1, ch);
    }

    static int Frac(double fraction, int size) {
        var value = (int)Math.Round(Math.Clamp(fraction, 0, 1) * (size - 1), MidpointRounding.AwayFromZero);
        return Math.Clamp(value, 0, size - 1);
    }

    async Task SwipeAsync(int x1, int y1, int x2, int y2, int durationMs) {
        if (_swiping) return;
        _swiping = true;
        try {
            var res = await Client().PostAsJsonAsync($"/api/devices/{_deviceId}/ui/swipe",
                new UiSwipeRequest(x1, y1, x2, y2, durationMs), SelfCallJson.Web);
            if (!res.IsSuccessStatusCode) await Fail(await ReadError(res));
