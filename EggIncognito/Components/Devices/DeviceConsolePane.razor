    static (int R, int G, int B)? Rgb(string? hex) {
        if (hex is not { Length: 7 } h || h[0] != '#') return null;
        if (!int.TryParse(h.AsSpan(1, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var r)) return null;
        if (!int.TryParse(h.AsSpan(3, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var g)) return null;
        if (!int.TryParse(h.AsSpan(5, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var b)) return null;
        return (r, g, b);
    }

