@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject ILogger<DeviceLocksPane> Logger
@using System.Globalization
@using System.Text.Json
@using EggIncognito.Models.Devices
@using EggIncognito.Services.Devices
@using EggIncognito.Services.Events

<div class="dlk @(Watch.Paused ? "dlk-paused" : "")">
    <DeviceLocksToolbar Watch="Watch" Busy="_busy" Arming="Arming" ArmingChanged="ArmingChanged" ArmTitle="@ArmTitle()" NewKind="@_newKind" NewKindChanged="NewKindChanged" @bind-NewHoldMs="_newHoldMs" @bind-NewRateMs="_newRateMs" @bind-OffsetMs="_offsetMs" SelectedCount="_selected.Count" CanGroup="CanGroup()" OnTogglePause="TogglePauseAsync" OnGroupSelected="GroupSelectedAsync" OnClearAll="ClearAllAsync"/>

    @if (Watch.Points.Count > 0) {
        <TableScroll MaxHeight="24rem">
            <table class="data-table dlk-table">
                <thead>
                <tr>
                    <th></th>
                    <th></th>
                    <th>at</th>
                    <th>type</th>
                    <th>every</th>
                    <th>group</th>
                    <th>taps</th>
                    <th>last</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var p in Watch.Points) {
                    <DeviceLocksRow @key="p.Id" Point="p" Selected="_selected.Contains(p.Id)" Busy="_busy" Group="GroupOf(p)" GroupLabel="@(GroupOf(p) is { } g ? GroupLabel(g) : null)" OnSelectChanged="@((bool on) => Select(p.Id, on))" OnUpdate="@((PixelWatchPointUpdate u) => UpdateAsync(p.Id, u))" OnUngroup="@(() => UngroupAsync(GroupOf(p)!.Id))" OnRemove="@(() => RemoveAsync(p.Id))"/>
                }
                </tbody>
            </table>
        </TableScroll>
    }
</div>

@code {

    [Parameter] public string? DeviceId { get; set; }

    [Parameter] public PixelWatchState Watch { get; set; } = PixelWatchState.Empty;

    [Parameter] public bool Arming { get; set; }

    [Parameter] public EventCallback<bool> ArmingChanged { get; set; }

    [Parameter] public EventCallback<PixelWatchState> WatchChanged { get; set; }

    [Parameter] public EventCallback<DeviceNotice> OnNotice { get; set; }

    bool _busy;
    string _newKind = PixelWatchKinds.Tap;
    int _newHoldMs = PixelWatchService.DefaultHoldMs;
    int _newRateMs = PixelWatchService.DefaultRateMs;
    int _offsetMs = 150;
    readonly HashSet<string> _selected = new(StringComparer.Ordinal);

    public PixelWatchRequest NewPoint(int x, int y) {
        return new PixelWatchRequest(x, y, _newKind, _newKind == PixelWatchKinds.Hold ? _newHoldMs : null, _newRateMs);
    }

    protected override void OnParametersSet() {
        _selected.RemoveWhere(id => Watch.Points.All(p => p.Id != id));
    }

    string ArmTitle() {
        return Arming
            ? "Now tap the button on the screen; its colour at that point becomes the trigger"
            : "Lock a point: tap a button once and it is tapped again every time it reappears";
    }


    void NewKindChanged(ChangeEventArgs e) {
        _newKind = PixelWatchKinds.Normalize(e.Value?.ToString());
    }

    void Select(string id, bool on) {
        if (on) _selected.Add(id);
        else _selected.Remove(id);
    }

    bool CanGroup() {
        if (_selected.Count < 2) return false;
        var picked = Watch.Points.Where(p => _selected.Contains(p.Id)).ToList();
        if (picked.Count != _selected.Count || picked.Any(p => p.GroupId is not null)) return false;
        return picked.Select(p => p.Color).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1;
    }

    PixelWatchGroup? GroupOf(PixelWatchStatus p) {
        return p.GroupId is { } gid ? Watch.Groups.FirstOrDefault(g => g.Id == gid) : null;
    }

    string GroupLabel(PixelWatchGroup g) {
        var index = Watch.Groups.ToList().IndexOf(g);
        return index < 0 ? g.Id : $"G{index + 1}";
    }

    async Task UpdateAsync(string pointId, PixelWatchPointUpdate update) {
        if (DeviceId is null) return;
        if (update is { Kind: null, HoldMs: null, RateMs: null }) return;
        await Send(() => Client().PatchAsJsonAsync($"/api/devices/{DeviceId}/ui/watch/{pointId}", update, SelfCallJson.Web));
    }

    async Task GroupSelectedAsync() {
        if (DeviceId is null || !CanGroup()) return;
        var ordered = Watch.Points.Where(p => _selected.Contains(p.Id)).Select(p => p.Id).ToList();
        var req = new PixelWatchGroupRequest(ordered, Math.Clamp(_offsetMs, 0, PixelWatchService.MaxOffsetMs));
        await Send(() => Client().PostAsJsonAsync($"/api/devices/{DeviceId}/ui/watch/groups", req, SelfCallJson.Web));
        _selected.Clear();
    }

    async Task UngroupAsync(string groupId) {
        if (DeviceId is null) return;
        await Send(() => Client().DeleteAsync($"/api/devices/{DeviceId}/ui/watch/groups/{groupId}"));
    }

    async Task RemoveAsync(string pointId) {
        if (DeviceId is null) return;
        _selected.Remove(pointId);
        await Send(() => Client().DeleteAsync($"/api/devices/{DeviceId}/ui/watch?point={pointId}"), "state");
    }

    async Task TogglePauseAsync() {
        if (DeviceId is null) return;
        var on = Watch.Paused ? "false" : "true";
        await Send(() => Client().PostAsync($"/api/devices/{DeviceId}/ui/watch/pause?on={on}", null));
    }

    async Task ClearAllAsync() {
        if (DeviceId is null) return;
        _selected.Clear();
        await Send(() => Client().DeleteAsync($"/api/devices/{DeviceId}/ui/watch"), "state");
    }

    async Task Send(Func<Task<HttpResponseMessage>> call, string? stateProperty = null) {
        _busy = true;
        try {
            using var res = await call();
            if (!res.IsSuccessStatusCode) {
                await OnNotice.InvokeAsync(new DeviceNotice(await ApiErrors.ReadAsync(res), StatusNoteKind.Error));
                return;
            }

            var state = await ReadState(res, stateProperty);
            if (state is not null) await WatchChanged.InvokeAsync(state);
        } catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Logger.LogDebug(ex, "watch call failed for {DeviceId}", DeviceId);
            await OnNotice.InvokeAsync(new DeviceNotice("the lock call failed", StatusNoteKind.Error));
        } finally {
            _busy = false;
        }
    }

    static async Task<PixelWatchState?> ReadState(HttpResponseMessage res, string? property) {
        if (property is null) return await res.Content.ReadFromJsonAsync<PixelWatchState>(SelfCallJson.Web);
        var body = await res.Content.ReadFromJsonAsync<JsonElement>(SelfCallJson.Web);
        if (body.ValueKind != JsonValueKind.Object || !body.TryGetProperty(property, out var inner)) return null;
        return inner.Deserialize<PixelWatchState>(SelfCallJson.Web);
    }

}
