@using EggIncognito.Core.Services.Devices
@using EggIncognito.Models.Devices

<div class="dis">
    <button type="button" class="dis-btn" aria-haspopup="listbox" aria-expanded="@(_open ? "true" : "false")"
            disabled="@Busy" title="Switch island" @onclick="Toggle">
        <span class="dis-btn-main">
            <span class="dis-k">Island</span>
            <span class="dis-name">@CurrentLabel()</span>
            <span class="dis-user">user @CurrentUser()</span>
        </span>
        <Icon Name="chevron-down" Class="icon-sm"/>
    </button>
    @if (_open) {
        <div class="popover-backdrop" @onmousedown="Close" @onwheel="Close"></div>
        <div class="dis-pop" role="listbox" aria-label="Islands">
            <div class="dis-row @(Selected is null ? "dis-row-on" : "")" role="option" aria-selected="@(Selected is null ? "true" : "false")">
                <button type="button" class="dis-pick" @onclick="@(() => PickAsync(IslandScope.Owner))">
                    <span class="dis-cur dis-cur-on">
                        @if (Selected is null) {
                            <Icon Name="check" Class="icon-sm"/>
                        }
                    </span>
                    <span class="dis-name">Device, no island</span>
                    <span class="dis-user">user @IslandScope.Owner</span>
                </button>
            </div>
            @foreach (var island in Islands) {
                var current = Selected == island.AndroidUserId;
                <DeviceIslandRow @key="island.AndroidUserId" Island="island" Current="current" Busy="Busy" OnPick="PickAsync" OnRemove="OnRemove"/>
            }
            <DeviceIslandFooter Busy="Busy" OnCreate="OnCreate" OnRefresh="OnRefresh"/>
        </div>
    }
</div>

@code {

    [Parameter] public IReadOnlyList<IslandRow> Islands { get; set; } = [];

    [Parameter] public int? Selected { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<int> OnSwitch { get; set; }

    [Parameter] public EventCallback<int> OnRemove { get; set; }

    [Parameter] public EventCallback<string> OnCreate { get; set; }

    [Parameter] public EventCallback OnRefresh { get; set; }

    bool _open;

    IslandRow? Current => Selected is { } uid ? Islands.FirstOrDefault(i => i.AndroidUserId == uid) : null;

    string CurrentLabel() {
        return Current is { } island ? Label(island) : "Device, no island";
    }

    int CurrentUser() {
        return Selected ?? IslandScope.Owner;
    }

    static string Label(IslandRow island) {
        return string.IsNullOrWhiteSpace(island.Label) ? $"user {island.AndroidUserId}" : island.Label;
    }

    void Toggle() {
        _open = !_open;
    }

    void Close() {
        _open = false;
    }

    async Task PickAsync(int androidUserId) {
        _open = false;
        if (androidUserId == CurrentUser()) return;
        await OnSwitch.InvokeAsync(androidUserId);
    }

}
