@using System.Globalization
@using EggIncognito.Services.Coverage

<div class="atb-detail">
    @if (Ingredients is { Count: > 0 } ingredients) {
        <section class="atb-detail-col">
            <span class="atb-detail-head">Recipe</span>
            <div class="atb-recipe">
                @foreach (var ingredient in ingredients) {
                    <ArtifactTip Name="@ingredient.Name" Count="@ingredient.Count">
                        <span class="atb-recipe-item">
                            <img class="atb-recipe-ico" src="@ingredient.Icon" alt="@ingredient.Name" loading="lazy"/>
                            <span class="atb-recipe-count mono">@ingredient.Count</span>
                        </span>
                    </ArtifactTip>
                }
            </div>
        </section>
    }
    @if (Price is { } price && Catalog is { } catalog && Tier is { } tier) {
        <section class="atb-detail-col">
            <span class="atb-detail-head">Craft</span>
            <ArtifactCraftPlot Price="price" Catalog="catalog" AfxId="tier.AfxId" AfxLevel="tier.AfxLevel"/>
        </section>
    }
    @if (Row is { Buckets.Count: 1 } single) {
        <section class="atb-detail-col">
            <span class="atb-detail-head">Drops per consume</span>
            <span class="atb-fixed mono">@single.Buckets[0].Count</span>
        </section>
    } else if (Row is { Buckets.Count: > 0 } row) {
        <section class="atb-detail-col">
            <span class="atb-detail-head">Drops per consume</span>
            <div class="atb-buckets">
                @foreach (var bucket in row.Buckets) {
                    <Tooltip Text="@BucketHover(bucket.Count, bucket.Share)">
                        <span class="atb-bucket" style="--p:@bucket.Share.ToString("0.###", CultureInfo.InvariantCulture)"></span>
                    </Tooltip>
                }
            </div>
        </section>
    }
</div>

@code {
    public sealed record Ingredient(string Icon, string Name, int Count);

    [Parameter] public IReadOnlyList<Ingredient>? Ingredients { get; set; }
    [Parameter] public ArtifactCraftPlot.PriceCurve? Price { get; set; }
    [Parameter] public EggSharp.GameData.IArtifactCatalog? Catalog { get; set; }
    [Parameter] public (int AfxId, int AfxLevel)? Tier { get; set; }
    [Parameter] public DropRow? Row { get; set; }

    static string BucketHover(int count, double share) =>
        string.Create(CultureInfo.InvariantCulture, $"{count} dropped: {share * 100:0.#}% of consumes");
}
