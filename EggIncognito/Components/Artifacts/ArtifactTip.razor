<Tooltip Class="@Class" Content="Pop">@ChildContent</Tooltip>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Rarity { get; set; }
    [Parameter] public long? Count { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    RenderFragment Pop => @<span class="tt-title atip atip-r@(Math.Clamp(Rarity, 0, 3))">@Name@if (Count is { } n) {
            <span class="atip-count mono">x@(n.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</span>
        }</span>;
}
