<div class="arp" role="group" aria-label="@AriaLabel">
    @foreach (int rarity in Rarities) {
        int r = rarity;
        bool on = r == Selected;
        <button type="button" class="arp-opt arp-r@(r) @(on ? "arp-on" : null)" aria-pressed="@(on ? "true" : "false")"
                aria-label="@Label(r)" @onclick="() => PickAsync(r)">
            <img class="arp-ico" src="@Icon" alt="" loading="lazy"/>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<int> Rarities { get; set; } = [];
    [Parameter] public int Selected { get; set; }
    [Parameter] public EventCallback<int> SelectedChanged { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    static string Label(int rarity) =>
        EggIncognito.Services.Assets.EggIcons.Pretty(EggIncognito.Services.Artifacts.ArtifactTreeBuilder.RarityName(rarity));

    async Task PickAsync(int rarity) {
        if (rarity == Selected) return;
        Selected = rarity;
        await SelectedChanged.InvokeAsync(rarity);
    }
}
