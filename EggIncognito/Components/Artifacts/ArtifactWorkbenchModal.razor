@rendermode @(RenderModes.InteractiveServer)
@implements IAsyncDisposable
@using System.Text.Json
@using EggIdentity.Diagrams
@using EggIdentity.UI.Diagrams
@using EggIncognito.Core.Services.Devices
@using EggIncognito.Data.Services
@using EggIncognito.Models.Coverage
@using EggIncognito.Services.Artifacts
@using EggIncognito.Components.Api
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Coverage
@using EggIncognito.Services.DataApi
@using EggSharp.GameData
@using EggSharp.GameData.Artifacts
@using ArtifactFamily = EggSharp.GameData.Artifacts.ArtifactFamily
@inherits SelfCallComponentBase
@inject ArtifactWorkbenchState State
@inject DropStats Stats
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ICurrentUser User
@inject IEnumerable<IDevicePanel> Panels
@inject IEnumerable<ICoverageInventory> Inventories
@inject ILogger<ArtifactWorkbenchModal> Logger

<WorkbenchModal Open="_open" Title="@("Artifacts")" TitleId="artifactsWorkbenchTitle" Size="WorkbenchSize.Wide"
                CardClass="atb-card" OnClose="CloseAsync">
    <Rail>
        <WorkbenchRail HasFilter="true" Filter="@State.RailFilter" FilterChanged="@(v => State.RailFilter = v)"
                       FilterLabel="Filter families">
            <div class="atb-rail-grid">
                @foreach (var column in RailColumns) {
                    <div class="atb-rail-col">
                        @foreach (var group in column) {
                            var families = FilteredFamilies(group);
                            @if (families.Count > 0) {
                                <WorkbenchSection Label="@GroupLabel(group)">
                                    @foreach (var family in families) {
                                        <WorkbenchEntry @key="family.Name" Selected="@(State.Family == family.Name)"
                                                        OnClick="@(_ => SelectFamilyAsync(family))" MetaLine="@CoverageMetaLine(family)">
                                            <Lead><img class="atb-ico" src="@ArtifactTreeBuilder.Icon(family.Name, family.Tiers.Count == 0 ? 0 : family.Tiers.Max(t => t.Level))" alt="" loading="lazy"/></Lead>
                                            <Name>@EggIcons.Pretty(family.PluralName)</Name>
                                        </WorkbenchEntry>
                                    }
                                </WorkbenchSection>
                            }
                        }
                    </div>
                }
            </div>
        </WorkbenchRail>
    </Rail>
    <ChildContent>
        <div class="atb-wrap" @onpointermove="OnAdminDragMove" @onpointerup="OnAdminDragEnd" @onpointerleave="OnAdminDragEnd">
        @if (CurrentFamily() is not { } family) {
            <EmptyState Title="Pick a family" Hint="Choose an artifact, stone or ingredient from the rail."/>
        } else {
            <div class="atb-body @(_direction == DiagramDirection.Right ? "atb-body-side" : "")">
            <div class="atb-side">
            <div class="atb-head">
                <div class="atb-head-row">
                    <img class="atb-ico atb-ico-lg" src="@ArtifactAssets.TargetIconFor(family.Name)" alt="" loading="lazy"/>
                    <div class="atb-head-title">
                        <h2>@EggIcons.Pretty(family.PluralName)</h2>
                        <span class="atb-head-kind">@family.Kind</span>
                    </div>
                </div>
                @if (family.Description.Length > 0) {
                    <p class="atb-desc">@family.Description</p>
                }
                <div class="atb-seg" role="tablist" aria-label="View">
                    @foreach (var view in Enum.GetValues<ArtifactView>().Where(v => ViewAvailable(family, v))) {
                            var v = view;
                            <button type="button" role="tab" aria-selected="@(State.View == v ? "true" : "false")"
                                    class="atb-seg-btn @(State.View == v ? "atb-on" : "")"
                                    @onclick="@(() => SwitchViewAsync(v))">@ViewLabel(v)</button>
                        }
                    </div>
                    <div class="atb-tiers">
                        @foreach (var tier in family.Tiers.Where(t => State.View != ArtifactView.Crafting || ArtifactWorkbenchState.HasRecipe(t))) {
                            var t = tier;
                            IReadOnlyList<int> rarities = State.NeedsRarity ? Rarities(family, t) : [0];
                            <div class="atb-tier-col">
                                @foreach (var r in rarities) {
                                    int rarity = r;
                                    string rarityName = ArtifactTreeBuilder.RarityName(rarity);
                                    bool on = State.Tier == t.Level && (!State.NeedsRarity || State.Rarity == rarity);
                                    <ArtifactTip Name="@ArtifactTreeBuilder.DisplayName(family.Name, t.Level)" Rarity="@(State.NeedsRarity ? rarity : 0)">
                                        <button type="button" class="atb-tier-btn atb-r@(State.NeedsRarity ? rarity : 0) @(on ? "atb-on" : "")"
                                                aria-label="@ArtifactTreeBuilder.DisplayName(family.Name, t.Level)" @onclick="@(() => PickCellAsync(family, t, rarity))">
                                            <img class="atb-ico" src="@ArtifactTreeBuilder.Icon(family.Name, t.Level)" alt="" loading="lazy"/>
                                        </button>
                                    </ArtifactTip>
                                }
                            </div>
                        }
                    </div>
                    <div class="atb-seg" role="radiogroup" aria-label="Layout">
                        <button type="button" role="radio" aria-checked="@(_direction == DiagramDirection.Down ? "true" : "false")"
                                class="atb-seg-btn @(_direction == DiagramDirection.Down ? "atb-on" : "")"
                                @onclick="@(() => _direction = DiagramDirection.Down)">Top down</button>
                        <button type="button" role="radio" aria-checked="@(_direction == DiagramDirection.Right ? "true" : "false")"
                                class="atb-seg-btn @(_direction == DiagramDirection.Right ? "atb-on" : "")"
                                @onclick="@(() => _direction = DiagramDirection.Right)">Side branches</button>
                    </div>
            </div>

            <ArtifactNodeDetail Ingredients="@_detailIngredients" Price="@_detailPrice" RarityMults="@RarityMults" Row="@_detailRow"/>
            @if (State.View == ArtifactView.ConsumesInto && State.Rarity is { } selRarity && CurrentTier(family) is { } selTier) {
                <CoverageDrops Family="@family.Name" Level="@ArtifactTreeBuilder.LevelName(selTier.Level)"
                               Rarity="@ArtifactTreeBuilder.RarityName(selRarity)" Version="@_dropsVersion"/>
            }
            </div>

            <div class="atb-canvas">
                @if (_loadingGraph) {
                    <div class="wb-note">Loading...</div>
                } else if (_graph is null || _graph.Nodes.Count == 0) {
                    <EmptyState Title="Nothing to show" Hint="Pick a tier above."/>
                } else if (State.View != ArtifactView.Crafting && _graph.Nodes.Count == 1) {
                    <EmptyState Title="No recorded drops" Hint="No consume observations cover this tier and rarity yet."/>
                } else {
                    <TreeDiagram Graph="@_graph" Roots="@_roots" Direction="@_direction"
                                 ShowTools="false" Style="SplitStyle"
                                 AriaLabel="@(n => NodeName(n.Id))"
                                 NodeClass="@(n => NodeClass(n.Node.Id))"
                                 EdgeClass="@(e => ShareEdges ? "atb-share" : null)"
                                 EdgeStyle="@(ShareEdges ? EdgeStyle : null)"
                                 EdgeLabelTemplate="@(ShareEdges ? ShareLabel : null)"
                                 SelectedId="@_selectedNodeId" SelectedIdChanged="OnNodeSelectedAsync"
                                 @bind-Collapsed="State.Collapsed">
                        <NodeTemplate Context="node">
                            <ArtifactTip Name="@NodeName(node.Node.Id)" Rarity="@NodeRarity(node.Node.Id)">
                                <span class="atb-node">
                                    @if (NodeIcon(node.Node.Id) is { } icon) {
                                        <img class="atb-node-ico" src="@icon" alt="" loading="lazy"/>
                                    }
                                    <span class="atb-node-name">@NodeName(node.Node.Id)</span>
                                </span>
                            </ArtifactTip>
                        </NodeTemplate>
                    </TreeDiagram>
                }
            </div>
            </div>

        }
        @if (_admin && PanelShelf.Any(Panels, DevicePanelShelves.Artifacts)) {
            <div class="atb-admin @(_adminCollapsed ? "atb-admin-collapsed" : "")" style="@AdminStyle">
                <div class="atb-admin-head" @onpointerdown="OnAdminDragStart">
                    <span class="atb-admin-title">Admin</span>
                    <button type="button" class="btn-mini" @onclick="@(() => _adminCollapsed = !_adminCollapsed)">
                        <Icon Name="@(_adminCollapsed ? "chevron-down" : "chevron-up")" Class="icon-sm"/>
                    </button>
                </div>
                @if (!_adminCollapsed) {
                    <div class="atb-admin-body">
                        <PanelShelf Shelf="@DevicePanelShelves.Artifacts" Context="ArtifactContext"/>
                    </div>
                }
            </div>
        }
        </div>
    </ChildContent>
</WorkbenchModal>

@code {
    bool _open;
    PathRouteSync? _hash;
    bool _loadingGraph;
    DiagramDirection _direction = DiagramDirection.Right;
    DiagramGraph? _graph;
    IReadOnlyList<string> _roots = [];
    string? _selectedNodeId;
    DropSummary? _consumeSummary;
    ConsumeCoverageMap? _coverage;
    ArtifactCatalog? _catalog;
    IReadOnlyList<ArtifactNodeDetail.Ingredient>? _detailIngredients;
    ArtifactCraftPlot.PriceCurve? _detailPrice;
    DropRow? _detailRow;
    bool _admin;
    bool _adminCollapsed;
    double _adminX = 16;
    double _adminY = 16;
    bool _adminDragging;
    double _adminDragStartX;
    double _adminDragStartY;
    double _adminDragOriginX;
    double _adminDragOriginY;
    int _coverageReloadPending;
    int _dropsVersion;

    IReadOnlyList<double> RarityMults => _catalog is { } c ? [.. c.CraftingLevels.OrderBy(l => l.Level).Select(l => l.RarityMult)] : [];

    string AdminStyle => FormattableString.Invariant($"--x:{_adminX}px;--y:{_adminY}px;");

    ArtifactPanelContext ArtifactContext {
        get {
            var family = CurrentFamily();
            string? levelName = family is not null && CurrentTier(family) is { } tier ? ArtifactTreeBuilder.LevelName(tier.Level) : null;
            string? rarityName = State.Rarity is { } rarity ? ArtifactTreeBuilder.RarityName(rarity) : null;
            int suggestedBatch = levelName is not null && rarityName is not null
                && _coverage?.Families.FirstOrDefault(f => f.SpecName == State.Family)?.Tiers
                    .FirstOrDefault(t => t.Level == levelName)?.Cells.FirstOrDefault(c => c.Rarity == rarityName) is { } cell
                ? cell.SuggestedBatch
                : 0;
            return new ArtifactPanelContext(State.Family, levelName, rarityName, suggestedBatch);
        }
    }

    protected override void OnInitialized() {
        _admin = User.Current.IsAtLeast(UserRole.Admin);
        if (_admin) {
            foreach (var inv in Inventories) inv.Changed += OnInventoryChanged;
        }
    }

    void OnInventoryChanged() {
        if (Interlocked.Exchange(ref _coverageReloadPending, 1) == 1) return;
        _ = InvokeAsync(async () => {
            try {
                await Task.Delay(750);
                _coverage = null;
                await LoadCoverageAsync();
                _dropsVersion++;
                if (CurrentFamily() is { } family) await RefreshAsync(family);
            } finally {
                Interlocked.Exchange(ref _coverageReloadPending, 0);
            }

            StateHasChanged();
        });
    }

    void OnAdminDragStart(PointerEventArgs e) {
        _adminDragging = true;
        _adminDragStartX = e.ClientX;
        _adminDragStartY = e.ClientY;
        _adminDragOriginX = _adminX;
        _adminDragOriginY = _adminY;
    }

    void OnAdminDragMove(PointerEventArgs e) {
        if (!_adminDragging) return;
        _adminX = Math.Max(0, _adminDragOriginX + (e.ClientX - _adminDragStartX));
        _adminY = Math.Max(0, _adminDragOriginY + (e.ClientY - _adminDragStartY));
    }

    void OnAdminDragEnd() {
        _adminDragging = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        _hash = new PathRouteSync(Nav, JS, "");
        _hash.Changed += () => _ = InvokeAsync(async () => {
            await ApplyHashAsync(_hash.Fragment);
            StateHasChanged();
        });
        _hash.Start();
        await ApplyHashAsync(_hash.Fragment);
        StateHasChanged();
    }

    public async Task Open() {
        _open = true;
        await LoadCoverageAsync();
        await WriteHashAsync(true);
        StateHasChanged();
    }

    async Task CloseAsync() {
        _open = false;
        await WriteHashAsync(true, true);
    }

    static ArtifactFamily? FamilyOf(string name) => ArtifactDefinitions.All.FirstOrDefault(f => f.Name == name);

    ArtifactFamily? CurrentFamily() => State.HasFamily ? FamilyOf(State.Family) : null;

    ArtifactTier? CurrentTier(ArtifactFamily family) =>
        State.Tier is { } level ? family.Tiers.FirstOrDefault(t => t.Level == level) : null;

    static int? TopTier(ArtifactFamily family) => family.Tiers.Count == 0 ? null : family.Tiers.Max(t => t.Level);

    static string ViewLabel(ArtifactView view) => view switch {
        ArtifactView.ConsumesInto => "Consumes into",
        ArtifactView.ComesFrom => "Comes from",
        _ => "Crafting"
    };


    enum RailGroup {
        Artifacts,
        Ingredients,
        Stones,
        Fragments
    }

    static readonly RailGroup[][] RailColumns = [[RailGroup.Artifacts, RailGroup.Ingredients], [RailGroup.Stones, RailGroup.Fragments]];

    static RailGroup GroupOf(ArtifactFamily family) =>
        ArtifactTreeBuilder.IsFragment(family.Name) ? RailGroup.Fragments
        : family.Kind == ArtifactKind.Artifact ? RailGroup.Artifacts
        : family.Kind == ArtifactKind.Ingredient ? RailGroup.Ingredients
        : RailGroup.Stones;

    static string GroupLabel(RailGroup group) => group switch {
        RailGroup.Fragments => "Stone fragments",
        _ => group.ToString()
    };

    List<ArtifactFamily> FilteredFamilies(RailGroup group) {
        var filter = State.RailFilter.Trim();
        return [.. ArtifactDefinitions.All.Where(f => GroupOf(f) == group)
            .Where(f => filter.Length == 0
                        || f.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
                        || f.PluralName.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(f => f.Order)];
    }

    async Task SelectFamilyAsync(ArtifactFamily family) {
        State.SelectFamily(family.Name, TopTier(family));
        State.Collapsed = new HashSet<string>(StringComparer.Ordinal);
        await LoadCatalogAsync();
        if (State.NeedsRarity) SnapRarity(family);
        SnapCraftTier(family);
        await RefreshAsync(family);
        await WriteHashAsync();
    }

    async Task SwitchViewAsync(ArtifactView view) {
        State.View = view;
        var family = CurrentFamily();
        if (State.NeedsRarity && family is { } f) {
            await LoadCatalogAsync();
            SnapRarity(f);
        } else {
            State.Rarity = null;
        }

        if (family is not null) {
            SnapCraftTier(family);
            await RefreshAsync(family);
        }

        await WriteHashAsync();
    }

    async Task PickCellAsync(ArtifactFamily family, ArtifactTier tier, int rarity) {
        State.Tier = tier.Level;
        State.Rarity = State.NeedsRarity ? rarity : null;
        await RefreshAsync(family);
        await WriteHashAsync();
    }

    static bool CanComeFromConsume(ArtifactFamily family) => family.Kind == ArtifactKind.Stone || ArtifactTreeBuilder.IsFragment(family.Name);

    static bool ViewAvailable(ArtifactFamily family, ArtifactView view) => view switch {
        ArtifactView.Crafting => ArtifactWorkbenchState.CanCraft(family),
        ArtifactView.ComesFrom => CanComeFromConsume(family),
        _ => true
    };

    void SnapCraftTier(ArtifactFamily family) {
        if (State.View != ArtifactView.Crafting || CurrentTier(family) is { } tier && ArtifactWorkbenchState.HasRecipe(tier)) return;
        State.Tier = family.Tiers.Where(ArtifactWorkbenchState.HasRecipe).Select(t => (int?)t.Level).DefaultIfEmpty(null).Max();
    }

    async Task RefreshAsync(ArtifactFamily family) {
        await RebuildGraphAsync(family);
        _selectedNodeId = RootId(family);
        await UpdateDetailAsync(family);
    }

    string? RootId(ArtifactFamily family) {
        if (CurrentTier(family) is not { } tier) return null;
        if (State.View == ArtifactView.Crafting) return ArtifactTreeBuilder.TierNodeId(family.Name, tier.Level);
        return State.Rarity is { } rarity
            ? ArtifactTreeBuilder.CellNodeId(family.Name, ArtifactTreeBuilder.LevelName(tier.Level), ArtifactTreeBuilder.RarityName(rarity))
            : null;
    }

    async Task RebuildGraphAsync(ArtifactFamily family) {
        _consumeSummary = null;
        if (State.View == ArtifactView.Crafting) {
            _graph = ArtifactTreeBuilder.BuildCraftingGraph(ArtifactDefinitions.All, family);
            _roots = State.Tier is { } level ? [ArtifactTreeBuilder.TierNodeId(family.Name, level)] : ArtifactTreeBuilder.CraftingRoots(family);
            return;
        }

        if (CurrentTier(family) is not { } tier || State.Rarity is not { } rarity) {
            _graph = null;
            _roots = [];
            return;
        }

        _loadingGraph = true;
        StateHasChanged();
        try {
            string levelName = ArtifactTreeBuilder.LevelName(tier.Level);
            string rarityName = ArtifactTreeBuilder.RarityName(rarity);
            if (State.View == ArtifactView.ComesFrom) {
                _graph = await ArtifactTreeBuilder.BuildReverseConsumptionGraphAsync(Stats,
                    family.Name, levelName, rarityName, CancellationToken.None);
            } else {
                _consumeSummary = await Stats.ForCellAsync(family.Name, levelName, rarityName, CancellationToken.None);
                _graph = ArtifactTreeBuilder.BuildConsumptionGraph(_consumeSummary, family.Name, levelName, rarityName);
            }

            _roots = [ArtifactTreeBuilder.CellNodeId(family.Name, levelName, rarityName)];
        } catch (Exception ex) when (ex is not OperationCanceledException) {
            Logger.LogWarning(ex, "consume drops could not be loaded for the artifacts workbench");
            _graph = null;
            _roots = [];
        } finally {
            _loadingGraph = false;
        }
    }

    async Task OnNodeSelectedAsync(string? id) {
        _selectedNodeId = id;
        if (CurrentFamily() is { } family) await UpdateDetailAsync(family);
    }

    void ClearDetail() {
        _detailIngredients = null;
        _detailPrice = null;
        _detailRow = null;
    }

    async Task UpdateDetailAsync(ArtifactFamily family) {
        ClearDetail();
        if (_selectedNodeId is null) return;

        if (ArtifactTreeBuilder.ResolveTierNode(ArtifactDefinitions.All, _selectedNodeId) is { } tierNode) {
            var tier = tierNode.Tier;
            _detailIngredients = [.. tier.Recipe.Select(ToIngredient).OfType<ArtifactNodeDetail.Ingredient>()];
            await LoadCatalogAsync();
            string levelName = ArtifactTreeBuilder.LevelName(tier.Level);
            string common = ArtifactTreeBuilder.RarityName(0);
            var entry = _catalog?.Artifacts.FirstOrDefault(a =>
                a.SpecName == tierNode.Family.Name && (a.Level == levelName || a.Level == tier.Name) && a.Rarity == common);
            if (ArtifactWorkbenchState.HasRecipe(tier)
                && entry is { CraftingPrice: { } high, CraftingPriceLow: { } low, CraftingPriceCurve: { } curve, CraftingPriceDomain: { } domain }) {
                _detailPrice = new ArtifactCraftPlot.PriceCurve(high, low, curve, domain);
            }

            return;
        }

        if (_consumeSummary is not null) {
            _detailRow = _consumeSummary.Rows.FirstOrDefault(r => _selectedNodeId == ArtifactTreeBuilder.CellNodeId(r.Name, r.Level, r.Rarity));
        }
    }

    static ArtifactNodeDetail.Ingredient? ToIngredient(ArtifactIngredient ingredient) {
        var family = ArtifactDefinitions.All.FirstOrDefault(f => f.AfxId == ingredient.AfxId);
        if (family is null) return null;
        return new ArtifactNodeDetail.Ingredient(ArtifactTreeBuilder.Icon(family.Name, ingredient.Level),
            ArtifactTreeBuilder.DisplayName(family.Name, ingredient.Level), ingredient.Count);
    }

    static readonly DiagramStyle SplitStyle = DiagramStyle.Default with { SplitRoot = true };

    bool ShareEdges => State.View != ArtifactView.Crafting && _graph is { } g && ArtifactTreeBuilder.IsShareGraph(g);

    double MaxShare => _graph is { Edges.Count: > 0 } g ? g.Edges.Max(e => e.Weight ?? 0) : 0;

    double RelativeShare(PositionedEdge edge) => MaxShare <= 0 ? 0 : Math.Clamp((edge.Edge.Weight ?? 0) / MaxShare, 0, 1);

    string EdgeStyle(PositionedEdge edge) => string.Create(System.Globalization.CultureInfo.InvariantCulture,
        $"stroke-width:{edge.Width:0.##};opacity:1;--p:{RelativeShare(edge):0.###}");

    RenderFragment<PositionedEdge> ShareLabel => edge => @<span class="atb-share-label mono" style="@($"--p:{RelativeShare(edge).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}")">@edge.Edge.Label</span>;

    static int NodeRarity(string nodeId) =>
        ArtifactTreeBuilder.ResolveCellNode(nodeId) is { } cell ? ArtifactTreeBuilder.RarityIndex(cell.RarityName) : 0;


    IReadOnlyList<int> Rarities(ArtifactFamily family, ArtifactTier tier) {
        if (_catalog is { } catalog) {
            var rarities = catalog.Artifacts
                .Where(a => a.SpecName == family.Name && a.AfxLevel == tier.Level)
                .Select(a => a.AfxRarity)
                .Distinct()
                .OrderBy(r => r)
                .ToList();
            if (rarities.Count > 0) return rarities;
        }

        return [.. Enumerable.Range(0, Math.Max(1, tier.RarityCount))];
    }

    void SnapRarity(ArtifactFamily family) {
        if (CurrentTier(family) is not { } tier) {
            State.Rarity ??= 0;
            return;
        }

        var rarities = Rarities(family, tier);
        if (State.Rarity is { } rarity && rarities.Contains(rarity)) return;
        State.Rarity = rarities.Count > 0 ? rarities[0] : 0;
    }

    async Task LoadCatalogAsync() {
        if (_catalog is not null) return;
        using var scope = Scopes.CreateScope();
        if (scope.ServiceProvider.GetService<GameDataStore>() is not { } store) return;
        if (store.Doc(ArtifactCatalog.DocumentId) is not { } json) return;
        try {
            _catalog = ArtifactCatalog.Parse(json);
        } catch (Exception ex) when (ex is JsonException or InvalidOperationException or GameDataSchemaException) {
            Logger.LogDebug(ex, "artifact catalog could not be loaded for the artifacts workbench");
        }

        await Task.CompletedTask;
    }

    async Task LoadCoverageAsync() {
        if (_coverage is not null) return;
        using var scope = Scopes.CreateScope();
        if (scope.ServiceProvider.GetService<ConsumeCoverageCache>() is not { } cache) return;
        try {
            _coverage = await cache.GetAsync(CancellationToken.None);
        } catch (Exception ex) when (ex is JsonException or InvalidOperationException or GameDataSchemaException) {
            Logger.LogDebug(ex, "consume coverage could not be loaded for the artifacts workbench");
        }
    }

    RenderFragment? CoverageMetaLine(ArtifactFamily family) {
        var row = _coverage?.Families.FirstOrDefault(f => f.SpecName == family.Name);
        if (row is null) return null;
        string text = FormattableString.Invariant($"{row.Validity * 100:0.#}% coverage");
        return b => b.AddContent(0, text);
    }

    string NodeClass(string nodeId) {
        string css = $"atb-r{NodeRarity(nodeId)}";
        return _selectedNodeId == nodeId ? css + " atb-on" : css;
    }

    static readonly string? GoldIcon = EggIcons.Asset("icon", RewardIconMap.Stem(Ei.RewardType.Gold, null)!);

    static readonly string? PiggyIcon = EggIcons.Asset("icon", RewardIconMap.Stem(Ei.RewardType.PiggyFill, null)!);

    static string? NodeIcon(string nodeId) {
        if (nodeId == ArtifactTreeBuilder.GoldNodeId) return GoldIcon;
        if (nodeId == ArtifactTreeBuilder.PiggyNodeId) return PiggyIcon;
        if (ArtifactTreeBuilder.ResolveTierNode(ArtifactDefinitions.All, nodeId) is { } tierNode) {
            return ArtifactTreeBuilder.Icon(tierNode.Family.Name, tierNode.Tier.Level);
        }

        if (ArtifactTreeBuilder.ResolveCellNode(nodeId) is { } cell) {
            return ArtifactTreeBuilder.Icon(cell.FamilyName, ArtifactTreeBuilder.LevelIndex(cell.LevelName));
        }

        return null;
    }

    static string NodeName(string nodeId) {
        if (nodeId == ArtifactTreeBuilder.GoldNodeId) return "Golden eggs";
        if (nodeId == ArtifactTreeBuilder.PiggyNodeId) return "Piggy fill";
        if (ArtifactTreeBuilder.ResolveTierNode(ArtifactDefinitions.All, nodeId) is { } tierNode) {
            return ArtifactTreeBuilder.DisplayName(tierNode.Family.Name, tierNode.Tier.Level);
        }

        if (ArtifactTreeBuilder.ResolveCellNode(nodeId) is { } cell) {
            return ArtifactTreeBuilder.DisplayName(cell.FamilyName, ArtifactTreeBuilder.LevelIndex(cell.LevelName));
        }

        return nodeId;
    }

    async Task ApplyHashAsync(string hash) {
        if (!State.ApplyHash(hash)) {
            if (_open) {
                _open = false;
                StateHasChanged();
            }

            return;
        }

        _open = true;
        await LoadCoverageAsync();
        if (CurrentFamily() is { } family) {
            if (State.View == ArtifactView.ComesFrom && !CanComeFromConsume(family)) State.View = ArtifactView.Crafting;
            await LoadCatalogAsync();
            if (State.NeedsRarity) SnapRarity(family);
            else State.Rarity = null;
            SnapCraftTier(family);
            await RefreshAsync(family);
        }

        StateHasChanged();
    }

    Task WriteHashAsync(bool push = false, bool clear = false) {
        var fragment = clear ? "" : State.Hash() ?? "";
        if (push) _hash?.PushFragment(fragment);
        else _hash?.ReplaceFragment(fragment);
        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync() {
        _hash?.Dispose();
        if (_admin) {
            foreach (var inv in Inventories) inv.Changed -= OnInventoryChanged;
        }

        return ValueTask.CompletedTask;
    }
}
