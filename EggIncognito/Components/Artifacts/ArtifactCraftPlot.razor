@using System.Globalization
@using EggIncognito.Core.Services.Artifacts
@using EggSharp.GameData

<div class="acp">
    <div class="acp-inputs">
        <label class="acp-field">
            <span>Crafting level</span>
            <input type="number" class="form-input mono" min="1" max="@MaxLevel" value="@_level" @onchange="OnLevelInput"/>
        </label>
        <label class="acp-field">
            <span>Crafted count</span>
            <input type="number" class="form-input mono" min="0" max="@Price.Domain" value="@_count" @onchange="OnCountInput"/>
        </label>
    </div>
    <svg class="acp-plot" width="@PlotW" height="@PlotH" viewBox="0 0 @PlotW @PlotH" role="img" aria-label="@Readout">
        @for (int row = 0; row < MaxLevel; row++) {
            int level = MaxLevel - row;
            for (int col = 0; col < Cols; col++) {
                <rect class="acp-cell" x="@F(PadL + col * CellW)" y="@F(PadT + row * CellH)" width="@F(CellW + 0.5)" height="@F(CellH + 0.5)"
                      style="@CellStyle(level, col)"/>
            }
        }
        <line class="acp-axis" x1="@PadL" y1="@(PadT + GridH)" x2="@(PadL + GridW)" y2="@(PadT + GridH)"/>
        <line class="acp-axis" x1="@PadL" y1="@PadT" x2="@PadL" y2="@(PadT + GridH)"/>
        <text class="acp-tick" x="@(PadL - 4)" y="@(PadT + 8)" text-anchor="end">@MaxLevel</text>
        <text class="acp-tick" x="@(PadL - 4)" y="@(PadT + GridH)" text-anchor="end">1</text>
        <text class="acp-tick" x="@PadL" y="@(PadT + GridH + 12)" text-anchor="start">0</text>
        <text class="acp-tick" x="@(PadL + GridW)" y="@(PadT + GridH + 12)" text-anchor="end">@Price.Domain.ToString("N0", CultureInfo.InvariantCulture)</text>
        <line class="acp-guide" x1="@F(PointX)" y1="@PadT" x2="@F(PointX)" y2="@(PadT + GridH)"/>
        <line class="acp-guide" x1="@PadL" y1="@F(PointY)" x2="@(PadL + GridW)" y2="@F(PointY)"/>
        <circle class="acp-point" cx="@F(PointX)" cy="@F(PointY)" r="5"/>
        <text class="acp-label mono" x="@F(LabelX)" y="@F(LabelY)" text-anchor="@LabelAnchor">@Readout</text>
        <rect class="acp-hit" x="0" y="0" width="@PlotW" height="@PlotH"
              @onpointerdown="OnDown" @onpointermove="OnMove" @onpointerup="OnUp" @onpointerleave="OnUp"/>
    </svg>
    <dl class="acp-readout">
        <dt class="muted">Cost</dt>
        <dd class="mono">@Cost(_count)</dd>
        @foreach (int rarity in Rarities) {
            <dt class="acp-r@(rarity)">@RarityLabel(rarity)</dt>
            <dd class="mono">@Pct(Odds(rarity, _level, _count))</dd>
        }
    </dl>
</div>

@code {
    public sealed record PriceCurve(double High, double Low, double Curve, uint Domain);

    [Parameter, EditorRequired] public PriceCurve Price { get; set; } = default!;
    [Parameter, EditorRequired] public IArtifactCatalog Catalog { get; set; } = default!;
    [Parameter, EditorRequired] public int AfxId { get; set; }
    [Parameter, EditorRequired] public int AfxLevel { get; set; }

    const double PlotW = 320;
    const double PlotH = 200;
    const double PadL = 28;
    const double PadT = 8;
    const double PadR = 8;
    const double PadB = 18;
    const int Cols = 24;
    const double GridW = PlotW - PadL - PadR;
    const double GridH = PlotH - PadT - PadB;

    int _level = 1;
    uint _count;
    bool _dragging;
    IReadOnlyList<int> _rarities = [0];
    double _topMax;

    IReadOnlyList<int> Rarities => _rarities;
    int Top => _rarities[^1];
    int MaxLevel => CraftOdds.MaxLevel(Catalog);
    double CellW => GridW / Cols;
    double CellH => GridH / MaxLevel;

    double PointX => PadL + (Price.Domain == 0 ? 0 : (double)_count / Price.Domain) * GridW;
    double PointY => PadT + (MaxLevel - _level + 0.5) * CellH;
    bool LabelLeft => PointX > PadL + GridW / 2;
    double LabelX => LabelLeft ? PointX - 8 : PointX + 8;
    double LabelY => PointY < PadT + 14 ? PointY + 14 : PointY - 8;
    string LabelAnchor => LabelLeft ? "end" : "start";

    string Readout => string.Create(CultureInfo.InvariantCulture, $"Lv {_level}, {_count:N0} crafted");

    protected override void OnParametersSet() {
        _rarities = [0, .. Enumerable.Range(1, 3).Where(r => CraftOdds.Constant(Catalog, AfxId, AfxLevel, r) > 0)];
        _topMax = Top == 0 ? 0 : Odds(Top, MaxLevel, Price.Domain);
        _level = Math.Clamp(_level, 1, MaxLevel);
        _count = Math.Min(_count, Price.Domain);
    }

    double Odds(int rarity, int level, uint count) {
        if (rarity > 0) return CraftOdds.ChanceAtLevel(Catalog, AfxId, AfxLevel, rarity, level, count);
        double shiny = 0;
        for (int r = 1; r <= 3; r++) shiny += CraftOdds.ChanceAtLevel(Catalog, AfxId, AfxLevel, r, level, count);
        return Math.Max(0, 1 - shiny);
    }

    double PriceAt(double count) {
        double t = Price.Domain == 0 ? 1 : Math.Clamp(count / Price.Domain, 0, 1);
        return Price.High - (Price.High - Price.Low) * Math.Pow(t, Price.Curve);
    }

    string CellStyle(int level, int col) {
        uint count = (uint)Math.Round((col + 0.5) / Cols * Price.Domain);
        double p = _topMax <= 0 ? 0 : Math.Clamp(Odds(Top, level, count) / _topMax, 0, 1);
        return string.Create(CultureInfo.InvariantCulture, $"--p:{p:0.###}");
    }

    void SetFromPointer(PointerEventArgs e) {
        double tx = Math.Clamp((e.OffsetX - PadL) / GridW, 0, 1);
        double ty = Math.Clamp((e.OffsetY - PadT) / GridH, 0, 0.9999);
        _count = (uint)Math.Round(tx * Price.Domain);
        _level = Math.Clamp(MaxLevel - (int)(ty * MaxLevel), 1, MaxLevel);
    }

    void OnDown(PointerEventArgs e) {
        _dragging = true;
        SetFromPointer(e);
    }

    void OnMove(PointerEventArgs e) {
        if (_dragging && e.Buttons != 0) SetFromPointer(e);
    }

    void OnUp() => _dragging = false;

    void OnLevelInput(ChangeEventArgs e) {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int level)) _level = Math.Clamp(level, 1, MaxLevel);
    }

    void OnCountInput(ChangeEventArgs e) {
        if (long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out long count)) _count = (uint)Math.Clamp(count, 0, Price.Domain);
    }

    static string RarityLabel(int rarity) => EggIncognito.Services.Assets.EggIcons.Pretty(EggIncognito.Services.Artifacts.ArtifactTreeBuilder.RarityName(rarity));

    string Cost(double count) => PriceAt(count).ToString("N0", CultureInfo.InvariantCulture) + " GE";

    static string Pct(double p) => p >= 0.001 || p == 0
        ? (p * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%"
        : "1 in " + (1 / p).ToString("N0", CultureInfo.InvariantCulture);

    static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
