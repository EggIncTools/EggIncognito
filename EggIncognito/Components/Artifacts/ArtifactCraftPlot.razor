@using System.Globalization
@using EggIncognito.Core.Services.Artifacts
@using EggSharp.GameData
@using EggIncognito.Services.Artifacts
@inject EggIdentity.UI.Suite.SuiteContext Suite
@inject CraftProgressLoader Progress

<div class="acp">
    <div class="acp-bar">
        @if (Suite.Eids.Count > 0) {
            <EggIdentity.UI.Suite.SuiteEidPicker Class="acp-picker" SetsActive="false" Selected="@_account" SelectedChanged="LoadFromAsync" EmptyLabel="Load account"/>
        }
        @if (Shiny) {
            <label class="acp-field">
                <span class="acp-field-key">Level</span>
                <input type="number" class="acp-input mono" aria-label="Crafting level" min="1" max="@MaxLevel" value="@_level" @onchange="OnLevelInput"/>
            </label>
        }
        <label class="acp-field">
            <span class="acp-field-key">Crafts</span>
            <input type="number" class="acp-input mono" aria-label="Crafted count" min="0" max="@Domain" value="@_count" @onchange="OnCountInput"/>
        </label>
        @if (Shiny) {
            <label class="acp-field form-check">
                <input type="checkbox" checked="@_detail" @onchange="e => _detail = e.Value is true"/>
                <span class="acp-field-key">Detail</span>
            </label>
        }
    </div>
    @if (_loading) {
        <span class="acp-note">Loading...</span>
    } else if (_loadFailed && _account is { } failed) {
        <DependencyNotice Dependency="SuiteDependency.EggIncApi" Feature="Backup loading" OnRetry="() => LoadFromAsync(failed)"/>
    }
    <div class="acp-frame">
        @if (Shiny) {
            <div class="acp-scale">
                <span class="acp-r@(Top)">@RarityLabel(Top)</span>
                <span class="mono">0%</span>
                <span class="acp-scale-bar"></span>
                <span class="mono">@NumberFormat.Odds(_topMax)</span>
            </div>
        }
        <div class="acp-stage">
        <svg class="acp-plot" width="@PlotW" height="@F(PlotH)" viewBox="0 0 @PlotW @F(PlotH)" role="img" aria-label="@PointText">
            @if (Bounded) {
                <defs>
                    <pattern id="@_hatchId" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <line class="acp-hatch-line" x1="0" y1="0" x2="0" y2="6"/>
                    </pattern>
                </defs>
            }
            @if (Shiny) {
                <g class="acp-cells">@_cells</g>
            } else {
                <path class="acp-curve" d="@_curve"/>
            }
            <line class="acp-axis" x1="@AxisX" y1="@GridBottom" x2="@(GridRight)" y2="@GridBottom"/>
            <line class="acp-axis" x1="@AxisX" y1="@PadT" x2="@AxisX" y2="@GridBottom"/>
            @if (Shiny) {
                <g>
                    <text class="acp-tick" x="@(AxisX - 4)" y="@F(RowY(MaxLevel) + 4)" text-anchor="end">@MaxLevel</text>
                    <text class="acp-tick" x="@(AxisX - 4)" y="@F(RowY(1) + 4)" text-anchor="end">1</text>
                </g>
            } else {
                <g>
                    <text class="acp-tick" x="@(AxisX - 4)" y="@F(CostY(Price.High) + 4)" text-anchor="end">@NumberFormat.Compact(Price.High)</text>
                    <text class="acp-tick" x="@(AxisX - 4)" y="@F(CostY(Price.Low) + 4)" text-anchor="end">@NumberFormat.Compact(Price.Low)</text>
                </g>
            }
            <text class="acp-axis-title" transform="@YTitleTransform" text-anchor="middle">@(Shiny ? "Crafting level" : "Cost")</text>
            <text class="acp-tick" x="@PadL" y="@(GridBottom + 14)" text-anchor="start">0</text>
            <text class="acp-tick" x="@GridRight" y="@(GridBottom + 14)" text-anchor="end">@Domain.ToString("N0", CultureInfo.InvariantCulture)</text>
            @if (Shiny && Price.Domain > 0 && Price.Domain < Domain) {
                <g>
                    <line class="acp-cap" x1="@F(CapX)" y1="@PadT" x2="@F(CapX)" y2="@GridBottom"/>
                    <text class="acp-tick" x="@F(CapX)" y="@(GridBottom + 14)" text-anchor="middle">@Price.Domain.ToString("N0", CultureInfo.InvariantCulture)</text>
                    <text class="acp-cap-label" x="@F(CapX - 4)" y="@(PadT + 10)" text-anchor="end">Min cost</text>
                </g>
            }
            <text class="acp-axis-title" x="@F(PadL + GridW / 2)" y="@(GridBottom + 28)" text-anchor="middle">Crafted</text>
            <line class="acp-guide" x1="@F(PointX)" y1="@PadT" x2="@F(PointX)" y2="@GridBottom"/>
            @if (Shiny) {
                <line class="acp-guide" x1="@PadL" y1="@F(PointY)" x2="@GridRight" y2="@F(PointY)"/>
            }
            @if (!Bounded) {
                <circle class="acp-point" cx="@F(PointX)" cy="@F(PointY)" r="5"/>
            }
            @if (Shiny) {
                <g>
                    <text class="acp-common" x="@PadL" y="@(BarY - 5)" text-anchor="start">@RarityLabel(0) <tspan class="acp-common-pct">@NumberFormat.Odds(Odds(0, _level, _count))</tspan></text>
                    @foreach (var seg in Segments()) {
                        <rect class="acp-bg@(seg.Rarity)" x="@F(seg.X)" y="@BarY" width="@F(seg.W)" height="@BarH"/>
                    }
                    @foreach (var key in Keys()) {
                        <g class="acp-r@(key.Rarity)">
                            <path class="acp-leader" d="@key.Leader"/>
                            <text class="acp-key" x="@F(key.X)" y="@KeyY" text-anchor="middle">@key.Name <tspan class="acp-key-pct" style="@ChanceStyle(key.Rarity)">@key.Pct</tspan></text>
                        </g>
                    }
                </g>
            }
            <rect class="acp-hit" x="0" y="0" width="@PlotW" height="@GridBottom" @onpointerdown="OnDown"/>
            @if (Bounded) {
                <g class="acp-void" @onpointerdown="OnDown">
                    <path class="acp-void-base" d="@_void"/>
                    <path d="@_void" fill="url(#@_hatchId)"/>
                </g>
                <path class="acp-bound" d="@_bound"/>
                <circle class="acp-point" cx="@F(PointX)" cy="@F(PointY)" r="5"/>
            }
        </svg>
        @if (Bounded) {
            <span class="acp-void-tip" style="@VoidTipStyle">
                <span class="acp-void-tip-title">Unreachable</span>
                <span>Each craft grants @NumberFormat.Full(_xp) crafting XP, so these levels are already passed.</span>
            </span>
        }
        <span class="acp-label @LabelPlacement" style="@LabelStyle">
            <span class="acp-label-row">
                @if (Shiny) {
                    <span class="mono">Lv @_level</span>
                }
                <CompactNumber Value="@PriceAt(_count)" IconSrc="@GoldIcon" Class="acp-cost mono"/>
            </span>
            <span class="acp-label-row mono">@NumberFormat.Full(_count) Crafts</span>
        </span>
        </div>
    </div>
    @if (Shiny && _detail) {
        <div class="acp-math">
            <div class="acp-math-head">
                <span>Level @_level multiplier <span class="mono">m = @F(Multiplier(_level))</span></span>
                <span>Crafts <span class="mono">n = @NumberFormat.Full(_count)</span></span>
                <span>Exponent <span class="mono">e = 1 - min(1, n / @F(CraftOdds.CountDomain)) * @F(CraftOdds.CountExponentDrop) = @F4(Exponent)</span></span>
            </div>
            <table class="acp-math-table">
                <thead>
                    <tr><th>Rarity</th><th>c</th><th>max(@F(CraftOdds.FloorConstant), c / m)</th><th>t = min(@F(CraftOdds.MaxChance), s<sup>-e</sup>)</th><th>Chance = t - t<sub>above</sub></th></tr>
                </thead>
                <tbody>
                    @foreach (int rarity in Rarities.Where(r => r > 0)) {
                        <tr>
                            <td class="acp-r@(rarity)">@RarityLabel(rarity)</td>
                            <td class="mono">@F(_constants[rarity])</td>
                            <td class="mono">@F(Scaled(rarity))</td>
                            <td class="mono">@NumberFormat.Odds(Threshold(rarity))</td>
                            <td class="mono acp-key-pct" style="@ChanceStyle(rarity)">@NumberFormat.Odds(Odds(rarity, _level, _count))</td>
                        </tr>
                    }
                    <tr>
                        <td class="acp-r0">@RarityLabel(0)</td>
                        <td colspan="3" class="acp-math-note">1 - sum of shiny chances</td>
                        <td class="mono">@NumberFormat.Odds(Odds(0, _level, _count))</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    @if (_dragging) {
        <div class="acp-capture" @onpointermove="OnMove" @onpointerup="OnUp" @onpointercancel="OnUp"></div>
    }
</div>

@code {
    public sealed record PriceCurve(double High, double Low, double Curve, uint Domain);

    sealed record Key(int Rarity, double X, string Leader, string Name, string Pct);

    [Parameter, EditorRequired] public PriceCurve Price { get; set; } = default!;
    [Parameter, EditorRequired] public IArtifactCatalog Catalog { get; set; } = default!;
    [Parameter, EditorRequired] public int AfxId { get; set; }
    [Parameter, EditorRequired] public int AfxLevel { get; set; }

    const double PlotW = 384;
    const double PadL = 48;
    const double PadT = 10;
    const double PadR = 24;
    const double AxisGap = 16;
    const double GridH = 180;
    const double GridW = PlotW - PadL - PadR;
    const double GridBottom = PadT + GridH;
    const double GridRight = PadL + GridW;
    const double AxisX = PadL - AxisGap;
    const double BarY = GridBottom + 48;
    const double BarH = 8;
    const double KeyY = BarY + BarH + 30;
    const double CharW = 7.4;
    const double KeyGap = 10;
    const int Cols = 32;

    int _level = 1;
    uint _count;
    bool _dragging;
    IReadOnlyList<int> _rarities = [0];
    double[] _constants = [0, 0, 0, 0];
    double[] _multipliers = [1];
    double _topMax;
    RenderFragment? _cells;
    string _curve = "";
    string _void = "";
    string _bound = "";
    double _xp;
    double[] _starts = [0];
    readonly string _hatchId = "acp-hatch-" + Guid.NewGuid().ToString("N")[..8];
    (IArtifactCatalog, int, int, PriceCurve)? _built;

    IReadOnlyList<int> Rarities => _rarities;
    int Top => _rarities[^1];
    bool Shiny => Top > 0;
    double PlotH => Shiny ? KeyY + 6 : GridBottom + 36;
    uint Domain => Shiny ? Math.Max((uint)CraftOdds.CountDomain, Price.Domain) : Math.Max(1, Price.Domain);
    int MaxLevel => Math.Max(1, _multipliers.Length);
    double CellW => GridW / Cols;
    double CellH => (GridH - AxisGap) / MaxLevel;
    double CapX => PadL + (double)Price.Domain / Domain * GridW;
    static string YTitleTransform => string.Create(CultureInfo.InvariantCulture, $"translate(12 {PadT + GridH / 2}) rotate(-90)");

    double RowY(int level) => PadT + (MaxLevel - level + 0.5) * CellH;
    double CostY(double cost) {
        double span = Price.High - Price.Low;
        double t = span <= 0 ? 1 : (cost - Price.Low) / span;
        return GridBottom - AxisGap - t * (GridH - AxisGap * 2);
    }

    double PointX => PadL + PointInset + (double)_count / Domain * (GridW - PointInset * 2);
    const double PointInset = 6;
    double PointY => Shiny ? RowY(_level) : CostY(PriceAt(_count));
    bool LabelLeft => PointX > PadL + GridW / 2;
    bool LabelBelow => Shiny ? PointY < PadT + GridH / 3 : LabelLeft;
    string LabelPlacement => (LabelLeft ? "acp-label-left" : "acp-label-right") + (LabelBelow ? " acp-label-below" : " acp-label-above");
    string LabelStyle => string.Create(CultureInfo.InvariantCulture, $"left:{PointX / PlotW * 100:0.##}%;top:{PointY / PlotH * 100:0.##}%");
    string PointText => Shiny
        ? string.Create(CultureInfo.InvariantCulture, $"Level {_level}, {_count:N0} crafted")
        : string.Create(CultureInfo.InvariantCulture, $"{_count:N0} crafted, {NumberFormat.Full(PriceAt(_count))}");

    protected override void OnParametersSet() {
        var key = (Catalog, AfxId, AfxLevel, Price);
        if (_built == key) return;
        _built = key;
        _constants = CraftOdds.Constants(Catalog, AfxId, AfxLevel);
        _multipliers = CraftOdds.Multipliers(Catalog);
        _rarities = [0, .. Enumerable.Range(1, 3).Where(r => _constants[r] > 0)];
        _topMax = Top == 0 ? 0 : Odds(Top, MaxLevel, Domain);
        _xp = Catalog.Artifacts.FirstOrDefault(a => a.AfxId == AfxId && a.AfxLevel == AfxLevel && a.AfxRarity == 0)?.CraftingXp ?? 0;
        _starts = [.. Enumerable.Range(1, MaxLevel).Select(l => CraftOdds.LevelStart(Catalog, l))];
        _count = Math.Min(_count, Domain);
        _level = Math.Clamp(_level, MinLevel(_count), MaxLevel);
        _cells = Shiny ? BuildCells() : null;
        _curve = Shiny ? "" : BuildCurve();
        (_void, _bound) = Shiny ? BuildBound() : ("", "");
    }

    bool Bounded => _void.Length > 0;

    bool _detail;

    double Exponent => 1 - Math.Min(1, _count / CraftOdds.CountDomain) * CraftOdds.CountExponentDrop;

    double Scaled(int rarity) => Math.Max(CraftOdds.FloorConstant, _constants[rarity] / Multiplier(_level));

    double Threshold(int rarity) => CraftOdds.Threshold(_constants[rarity], Multiplier(_level), _count);

    static string F4(double v) => v.ToString("0.####", CultureInfo.InvariantCulture);

    double HeatBottom => PadT + MaxLevel * CellH;

    double XOf(double count) => PadL + PointInset + count / Domain * (GridW - PointInset * 2);

    int MinLevel(uint count) {
        if (_xp <= 0) return 1;
        double xp = count * _xp;
        int level = 1;
        while (level < _starts.Length && _starts[level] <= xp) level++;
        return level;
    }

    uint MaxCount(int level) =>
        _xp <= 0 || level >= MaxLevel ? Domain : (uint)Math.Clamp(Math.Ceiling(_starts[level] / _xp) - 1, 0, Domain);

    (string Void, string Bound) BuildBound() {
        if (_xp <= 0) return ("", "");
        var steps = new List<string>();
        for (int level = 2; level <= MaxLevel; level++) {
            double first = Math.Ceiling(_starts[level - 1] / _xp);
            if (first > Domain) break;
            double edge = PadT + (MaxLevel - level + 1) * CellH;
            steps.Add($"H{F(Math.Max(PadL, XOf(first - 0.5)))} V{F(edge)}");
        }

        if (steps.Count == 0) return ("", "");
        string line = $"M{F(PadL)},{F(HeatBottom)} {string.Join(' ', steps)} H{F(GridRight)}";
        return ($"{line} V{F(HeatBottom)} Z", line);
    }

    string VoidTipStyle => string.Create(CultureInfo.InvariantCulture,
        $"right:{(PlotW - GridRight) / PlotW * 100:0.##}%;bottom:{(PlotH - HeatBottom) / PlotH * 100:0.##}%");

    (uint Count, int Level) Bound(uint count, int level, double x, double y) {
        int min = MinLevel(count);
        if (level >= min) return (count, level);
        uint max = MaxCount(level);
        double raise = Math.Abs(RowY(min) - y);
        double pull = Math.Abs(XOf(max) - x);
        return raise <= pull ? (count, min) : (max, level);
    }

    RenderFragment BuildCells() {
        var cells = new List<(string X, string Y, string Style)>(MaxLevel * Cols);
        for (int row = 0; row < MaxLevel; row++) {
            int level = MaxLevel - row;
            for (int col = 0; col < Cols; col++) cells.Add((F(PadL + col * CellW), F(PadT + row * CellH), CellStyle(level, col)));
        }

        string w = F(CellW + 0.5);
        string h = F(CellH + 0.5);
        return b => {
            int seq = 0;
            foreach (var (x, y, style) in cells) {
                b.OpenElement(seq, "rect");
                b.AddAttribute(seq + 1, "x", x);
                b.AddAttribute(seq + 2, "y", y);
                b.AddAttribute(seq + 3, "width", w);
                b.AddAttribute(seq + 4, "height", h);
                b.AddAttribute(seq + 5, "style", style);
                b.CloseElement();
            }
        };
    }

    string BuildCurve() {
        const int steps = 64;
        var parts = new List<string>(steps + 1);
        for (int i = 0; i <= steps; i++) {
            double count = (double)i / steps * Domain;
            parts.Add($"{(i == 0 ? "M" : "L")}{F(PadL + (double)i / steps * GridW)},{F(CostY(PriceAt(count)))}");
        }

        return string.Join(' ', parts);
    }

    double Multiplier(int level) => _multipliers.Length == 0 ? 1 : _multipliers[Math.Clamp(level, 1, _multipliers.Length) - 1];

    double Odds(int rarity, int level, uint count) {
        double multiplier = Multiplier(level);
        if (rarity > 0) return CraftOdds.Chance(_constants, rarity, multiplier, count);
        double shiny = 0;
        for (int r = 1; r <= 3; r++) shiny += CraftOdds.Chance(_constants, r, multiplier, count);
        return Math.Max(0, 1 - shiny);
    }

    double PriceAt(double count) {
        double t = Price.Domain == 0 ? 1 : Math.Clamp(count / Price.Domain, 0, 1);
        return Price.High - (Price.High - Price.Low) * Math.Pow(t, Price.Curve);
    }

    string CellStyle(int level, int col) {
        uint count = (uint)Math.Round((col + 0.5) / Cols * Domain);
        double p = _topMax <= 0 ? 0 : Math.Clamp(Odds(Top, level, count) / _topMax, 0, 1);
        return string.Create(CultureInfo.InvariantCulture, $"fill:color-mix(in oklab, var(--color-ok) {p * 100:0.#}%, var(--color-err))");
    }

    IEnumerable<(int Rarity, double X, double W)> Segments() {
        var shiny = Rarities.Where(r => r > 0).ToList();
        double total = shiny.Sum(r => Math.Max(0, Odds(r, _level, _count)));
        double x = PadL;
        foreach (int rarity in shiny) {
            double w = total <= 0 ? GridW / shiny.Count : Math.Max(0, Odds(rarity, _level, _count)) / total * GridW;
            yield return (rarity, x, w);
            x += w;
        }
    }

    string ChanceStyle(int rarity) {
        double max = Odds(rarity, MaxLevel, Domain);
        return RatioStyle.Var(max <= 0 ? 0 : Odds(rarity, _level, _count) / max);
    }

    IReadOnlyList<Key> Keys() {
        var segs = Segments().ToList();
        var names = segs.Select(s => RarityLabel(s.Rarity)).ToList();
        var pcts = segs.Select(s => NumberFormat.Odds(Odds(s.Rarity, _level, _count))).ToList();
        var widths = names.Select((n, i) => (n.Length + 1 + pcts[i].Length) * CharW).ToList();
        var xs = segs.Select(s => s.X + s.W / 2).ToList();
        for (int i = 0; i < xs.Count; i++) {
            double min = i == 0 ? PadL + widths[i] / 2 : xs[i - 1] + (widths[i - 1] + widths[i]) / 2 + KeyGap;
            xs[i] = Math.Max(xs[i], min);
        }

        for (int i = xs.Count - 1; i >= 0; i--) {
            double max = i == xs.Count - 1 ? GridRight - widths[i] / 2 : xs[i + 1] - (widths[i + 1] + widths[i]) / 2 - KeyGap;
            xs[i] = Math.Min(xs[i], max);
        }

        double bend = BarY + BarH + 8;
        double top = KeyY - 11;
        return [.. segs.Select((s, i) => {
            double from = s.X + s.W / 2;
            string leader = string.Create(CultureInfo.InvariantCulture,
                $"M{F(from)},{F(BarY + BarH)} V{F(bend)} L{F(xs[i])},{F(top - 4)} V{F(top)}");
            return new Key(s.Rarity, xs[i], leader, names[i], pcts[i]);
        })];
    }

    bool _changed = true;

    protected override bool ShouldRender() {
        bool render = _changed;
        _changed = true;
        return render;
    }

    double _originX;
    double _originY;
    bool _loading;
    bool _loadFailed;
    ProfileEid? _account;

    protected override async Task OnInitializedAsync() {
        if (Suite.Eids.Count == 0 && Suite.CanEditEids) await Suite.LoadAsync();
        _account = Suite.ActiveAccount;
    }

    async Task LoadFromAsync(ProfileEid account) {
        _account = account;
        _loading = true;
        _loadFailed = false;
        _changed = true;
        try {
            if (await Progress.LoadAsync(account.Eid, CancellationToken.None) is not { } progress) {
                _loadFailed = true;
                return;
            }

            _level = Math.Clamp(CraftOdds.Level(Catalog, progress.CraftingXp), 1, MaxLevel);
            _count = Math.Min(progress.Counts.GetValueOrDefault((AfxId, AfxLevel)), Domain);
            var prior = account.Snapshot;
            progress.Snapshot.Color ??= prior?.Color;
            progress.Snapshot.EbText ??= prior?.EbText;
            progress.Snapshot.SeText ??= prior?.SeText;
            await Suite.UpdateEidSnapshotAsync(account.Eid, progress.Snapshot);
        } finally {
            _loading = false;
            _changed = true;
        }
    }

    void SetFrom(double x, double y) {
        double tx = Math.Clamp((x - PadL - PointInset) / (GridW - PointInset * 2), 0, 1);
        uint count = (uint)Math.Round(tx * Domain);
        int level = _level;
        if (Shiny) {
            double ty = Math.Clamp((y - PadT) / (GridH - AxisGap), 0, 0.9999);
            level = Math.Clamp(MaxLevel - (int)(ty * MaxLevel), 1, MaxLevel);
            (count, level) = Bound(count, level, x, y);
        }

        _changed = count != _count || level != _level;
        _count = count;
        _level = level;
    }

    void OnDown(PointerEventArgs e) {
        _originX = e.ClientX - e.OffsetX;
        _originY = e.ClientY - e.OffsetY;
        _dragging = true;
        SetFrom(e.OffsetX, e.OffsetY);
        _changed = true;
    }

    void OnMove(PointerEventArgs e) {
        if (e.Buttons == 0) {
            OnUp();
            return;
        }

        SetFrom(e.ClientX - _originX, e.ClientY - _originY);
    }

    void OnUp() {
        _changed = _dragging;
        _dragging = false;
    }

    void OnLevelInput(ChangeEventArgs e) {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int level)) {
            _level = Math.Clamp(level, 1, MaxLevel);
            _count = Math.Min(_count, MaxCount(_level));
        }
    }

    void OnCountInput(ChangeEventArgs e) {
        if (long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out long count)) {
            _count = (uint)Math.Clamp(count, 0, Domain);
            if (Shiny) _level = Math.Max(_level, MinLevel(_count));
        }
    }

    static string RarityLabel(int rarity) => EggIncognito.Services.Assets.EggIcons.Pretty(EggIncognito.Services.Artifacts.ArtifactTreeBuilder.RarityName(rarity));

    static readonly string? GoldIcon = EggIncognito.Services.Assets.EggIcons.Asset("icon",
        EggIncognito.Services.Assets.RewardIconMap.Stem(Ei.RewardType.Gold, null)!);

    static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
