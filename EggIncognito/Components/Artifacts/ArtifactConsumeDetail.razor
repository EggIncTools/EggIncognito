@using System.Globalization
@using EggIncognito.Services.Artifacts
@using EggIncognito.Services.Coverage
@using EggSharp.GameData

@if (_model is { } model) {
    <section class="acd">
        <div class="acd-head">
            <Tooltip Text="@ConsumeDropModel.Source">
                <span class="acd-title">Model</span>
            </Tooltip>
            <label class="form-check acd-toggle">
                <input type="checkbox" checked="@_math" @onchange="e => _math = e.Value is true"/>math
            </label>
        </div>

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Drop</th>
                    <th class="acd-fit">Chance</th>
                    <th class="acd-fit">Model</th>
                    <th class="acd-fit">Avg</th>
                    <th class="acd-fit">Model</th>
                    @if (_math) {
                        <th class="acd-fit acd-game"><Tooltip Text="baseQuality from the game config">q</Tooltip></th>
                        <th class="acd-fit acd-game"><Tooltip Text="oddsMultiplier from the game config">odds</Tooltip></th>
                        @if (model.HasSecondFamily) {
                            <th class="acd-fit acd-fitted"><Tooltip Text="Second family factor, fitted per artifact">fam</Tooltip></th>
                        }
                        <th class="acd-fit"><Tooltip Text="Quality units this item takes from the budget">cost</Tooltip></th>
                        <th class="acd-fit"><Tooltip Text="Share of the first pick while every item is still affordable">pick</Tooltip></th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var p in model.Predictions) {
                    var observed = Observed(p);
                    var item = model.Items.First(i => i.Family == p.Family && i.AfxLevel == p.AfxLevel && i.IsFragment == p.IsFragment);
                    <tr @key="@(p.Family + "|" + p.AfxLevel)">
                        <td>
                            <span class="acd-drop">
                                <img class="acd-ico" src="@ArtifactTreeBuilder.Icon(p.Family, p.AfxLevel)" alt="" loading="lazy"/>
                                <span>@ArtifactTreeBuilder.DisplayName(p.Family, p.AfxLevel)</span>
                            </span>
                        </td>
                        <td class="mono">@(observed is { } o ? NumberFormat.Percent(o.Share) : Summary?.Observations > 0 ? "0%" : "")</td>
                        <td class="mono @Delta(observed?.Share, p.Chance)">@NumberFormat.Percent(p.Chance)</td>
                        <td class="mono">@(observed is { } o2 ? Num(o2.Mean) : Summary?.Observations > 0 ? "0" : "")</td>
                        <td class="mono @Delta(observed?.Mean, p.Mean)">@Num(p.Mean)</td>
                        @if (_math) {
                            <td class="mono acd-game">@Num(item.Quality)</td>
                            <td class="mono acd-game">@Num(item.OddsMultiplier)</td>
                            @if (model.HasSecondFamily) {
                                <td class="mono acd-fitted">@(item.FamilyFactor == 1 ? "" : Num(item.FamilyFactor))</td>
                            }
                            <td class="mono">@Num(item.Cost)</td>
                            <td class="mono">@NumberFormat.Percent(item.Weight / model.Items.Sum(i => i.Weight))</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (_math) {
            <dl class="acd-math mono">
                <dt>input q</dt>
                <dd><span class="acd-game">@Num(model.InputQuality)</span></dd>
                <dt>budget</dt>
                <dd><span class="acd-fitted">@Num(ConsumeDropModel.BudgetPerQuality[model.Rarity])</span> × <span class="acd-game">@Num(model.InputQuality)</span> + <span class="acd-fitted">@Num(ConsumeDropModel.BudgetOffset)</span> = @Num(model.Budget)</dd>
                <dt>floor</dt>
                <dd><span class="acd-fitted">@Num(ConsumeDropModel.FloorFraction[model.Rarity])</span> × <span class="acd-game">@Num(model.InputQuality)</span> = @Num(model.WeightFloor)</dd>
                <dt>frag cost</dt>
                <dd><span class="acd-game">q</span> + <span class="acd-fitted">@Num(ConsumeDropModel.FragmentCostOffset)</span></dd>
                <dt>stone cost</dt>
                <dd><span class="acd-fitted">@Num(ConsumeDropModel.StoneCostPerQuality)</span> × <span class="acd-game">q</span> + <span class="acd-fitted">@Num(ConsumeDropModel.StoneCostOffset[model.Rarity])</span></dd>
                <dt>weight</dt>
                <dd>
                    <span class="acd-game">odds</span>
                    @if (model.HasSecondFamily) {
                        <text>× </text><span class="acd-fitted">fam</span>
                    }
                    / max(<span class="acd-game">q</span>, floor)²
                </dd>
                <dt>stone weight</dt>
                <dd>× <span class="acd-fitted">@Num(ConsumeDropModel.StoneWeight[model.Rarity])</span></dd>
                <dt>draw</dt>
                <dd>pick an affordable drop by weight, pay its cost, repeat until none fits</dd>
                <dt>jitter</dt>
                <dd>budget varies per roll by under one fragment cost, so totals near a cost boundary split both ways</dd>
            </dl>
            <p class="acd-legend"><span class="acd-game">game config</span> <span class="acd-fitted">fitted to recorded consumes</span></p>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public string Family { get; set; } = "";
    [Parameter, EditorRequired] public int AfxLevel { get; set; }
    [Parameter, EditorRequired] public int Rarity { get; set; }
    [Parameter] public IArtifactCatalog? Catalog { get; set; }
    [Parameter] public DropSummary? Summary { get; set; }

    bool _math;
    ConsumeDropExplanation? _model;
    string? _key;
    IArtifactCatalog? _catalog;

    protected override void OnParametersSet() {
        string key = $"{Family}|{AfxLevel}|{Rarity}|{Summary?.Observations}";
        if (key == _key && ReferenceEquals(Catalog, _catalog)) return;
        _key = key;
        _catalog = Catalog;
        _model = null;
        if (Catalog is null || Summary is null) return;
        var families = Summary.Rows.Select(r => r.Name.EndsWith("_FRAGMENT", StringComparison.Ordinal) ? r.Name[..^"_FRAGMENT".Length] : r.Name).Distinct().ToList();
        _model = ConsumeDropModel.Explain(Catalog, Family, AfxLevel, Rarity, families);
    }

    DropRow? Observed(ConsumeDropPrediction p) =>
        Summary?.Rows.FirstOrDefault(r => r.Name == p.Family && ArtifactTreeBuilder.LevelIndex(r.Level) == p.AfxLevel);

    static string Delta(double? observed, double predicted) {
        if (observed is not { } o) return "";
        double gap = Math.Abs(o - predicted);
        return gap < 0.01 ? "acd-ok" : gap < 0.03 ? "acd-near" : "acd-off";
    }

    static string Num(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
}
