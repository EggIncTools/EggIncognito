@typeparam TItem where TItem : ICalendarSpan
@using EggIncognito.Models.Calendar
@using EggIncognito.Services.Calendar
@using EggIncognito.Services.Events
@inject ICurrentUser User
@inject IServiceProvider Services

@if (_note.Length > 0) {
    <div class="evcal-note">@_note</div>
} else if (_row is { } row) {
    <div class="evcal-mini-scroll">
        <div class="evcal-shell evcal-view-week evcal-mini" style="@ShellStyle">
            <div class="evcal-scale">
                @foreach (var cell in row.Cells) {
                    <span class="evcal-scale-label" style="@TickStyle(cell.LeftPercent)">
                        <span class="evcal-scale-day">@DateLabels.Weekday(cell.LocalDate)</span>
                        <span class="evcal-scale-date">@DateLabels.MonthDay(cell.LocalDate)</span>
                    </span>
                }
            </div>
            <div class="evcal-canvas">
                <div class="evcal-row" style="@RowStyle(row)">
                    @foreach (var cell in row.Cells) {
                        if (cell.LeftPercent > 0) {
                            <div class="evcal-grid" style="@TickStyle(cell.LeftPercent)"></div>
                        }
                    }
                    @if (row.NowPercent is { } nowPercent) {
                        <div class="evcal-now" style="@TickStyle(nowPercent)"></div>
                    }
                    <div class="evcal-lanes">
                        <CalendarSurface>
                            @foreach (var lane in row.Lanes) {
                                <div class="evcal-lane">
                                    @foreach (var bar in lane) {
                                        @Bar(bar)
                                    }
                                </div>
                            }
                        </CalendarSurface>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    const int HistoryDays = 21;

    [Parameter, EditorRequired] public Func<DateTimeOffset, DateTimeOffset, Task<CalendarItemsLoad<TItem>>> Load { get; set; } = null!;

    [Parameter, EditorRequired] public RenderFragment<CalendarBar<TItem>> Bar { get; set; } = null!;

    [Parameter] public string EmptyNote { get; set; } = "Nothing in the last three weeks.";

    CalendarLayoutRow<TItem>? _row;
    DateTimeOffset _start;
    DateTimeOffset _end;
    string _note = "";

    int DayCount => Math.Max(1, (int)Math.Round((_end - _start).TotalDays));

    string ShellStyle => FormattableString.Invariant(
        $"--evcal-days:{DayCount};--evcal-gap:{CalendarLayout.GapPercent(_start, _end):0.###}%;");

    protected override async Task OnInitializedAsync() {
        var zone = ViewerZone.Fallback;
        if (ViewerClock.Of(Services) is { } clock) {
            await clock.EnsureAsync(Services, User, CancellationToken.None);
            zone = clock.Zone;
        }

        var now = DateTimeOffset.UtcNow;
        var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(now, zone).DateTime);
        _end = CalendarLayout.AddDays(CalendarLayout.DayStartForDate(today), 1);
        _start = CalendarLayout.AddDays(_end, -HistoryDays);
        var load = await Load(_start, _end);
        if (load.Note.Length > 0) {
            _note = load.Note;
            return;
        }

        _row = CalendarLayout.Row(load.Items, _start, _end, now);
        if (_row.Lanes.Count == 0) _note = EmptyNote;
    }

    static string TickStyle(double leftPercent) {
        return FormattableString.Invariant($"--tick-pos:{leftPercent:0.###};");
    }

    static string RowStyle(CalendarLayoutRow<TItem> row) {
        return FormattableString.Invariant($"--row-weight:{Math.Max(1, row.Lanes.Count)};");
    }

}
