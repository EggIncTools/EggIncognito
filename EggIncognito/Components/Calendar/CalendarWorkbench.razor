@typeparam TItem where TItem : ICalendarSpan
@using System.Globalization
@using EggIncognito.Models.Calendar
@using EggIncognito.Services.Calendar
@using EggIncognito.Services.Events
@implements IDisposable
@inject NavigationManager Nav
@inject ICurrentUser User
@inject IServiceProvider Services

<WorkbenchModal Open="_open" Title="@Title" TitleId="@TitleId" Size="WorkbenchSize.Wide" CardClass="@($"calwb-card {CardClass}")" OnClose="Close">
    <HeadTools>
        <div class="evwb-range" role="group" aria-label="Calendar range">
            <div class="evwb-zoom" role="group" aria-label="Zoom">
                @foreach (var zoom in Zooms) {
                    <button type="button" class="@(zoom == _zoom ? "evwb-zoom-opt active" : "evwb-zoom-opt")" @key="zoom"
                            aria-pressed="@(zoom == _zoom ? "true" : "false")" @onclick="@(() => SetZoom(zoom))">
                        @ZoomLabel(zoom)
                    </button>
                }
            </div>
            <button type="button" class="icon-btn icon-btn-sm" aria-label="Previous" @onclick="@(() => Pan(-1))">
                <Icon Name="chevron-left"/>
            </button>
            <span class="evwb-range-label">@RangeLabel</span>
            <button type="button" class="icon-btn icon-btn-sm" aria-label="Next" @onclick="@(() => Pan(1))">
                <Icon Name="chevron-right"/>
            </button>
            <button type="button" class="btn-mini" @onclick="Today">Today</button>
            <input type="date" class="evwb-date" aria-label="Jump to date" value="@CenterDate" @onchange="JumpToDate"/>
        </div>
        <span class="evwb-zone">@_zone.Id</span>
    </HeadTools>
    <Rail>
        @Rail
    </Rail>
    <ChildContent>
        <div class="@PaneCss" style="@PaneStyle">
            @if (Note is { Length: > 0 } note) {
                <div class="evcal-note">@note</div>
            }
            <div class="evcal-scale">
                @for (var i = 0; i < WeekdayNames.Length; i++) {
                    <span class="evcal-scale-label" style="@TickStyle((i + 0.5) / 7 * 100)">@WeekdayNames[i]</span>
                }
            </div>
            <CalendarSurface>
                <CalendarGrid TItem="CalendarBar<TItem>" @ref="_grid" Periods="_periods" LaneGroups="LaneGroups" OnCommitScrollPan="Pan"/>
            </CalendarSurface>
            @if (Shown is { } shown) {
                <div class="@(IsPinned(shown) ? "evcal-pop evcal-pop-pinned" : "evcal-pop")" role="dialog" aria-label="@DetailTitle(shown.Item)"
                     style="@(AnchorStyle?.Invoke(shown.Item))">
                    <div class="evcal-pop-head">
                        <span class="evcal-pop-title">@DetailTitle(shown.Item)</span>
                        @if (IsPinned(shown)) {
                            <button type="button" class="icon-btn icon-btn-sm" aria-label="Unpin details" @onclick="ClearSelection">
                                <Icon Name="x"/>
                            </button>
                        }
                    </div>
                    @Detail(shown.Item)
                </div>
            }
        </div>
    </ChildContent>
</WorkbenchModal>

@code {
    static readonly string[] WeekdayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    static readonly IReadOnlyList<CalendarZoom> Zooms = [CalendarZoom.Week, CalendarZoom.Month];

    const double MonthLaneMin = 1.75;
    const double MonthLaneGap = 0.25;
    const double RowHeader = 1.25;
    const double RowInset = 0.2;
    const double MinSlotRem = 3.5;
    const double MaxSlotRem = 18;

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public string TitleId { get; set; } = "";

    [Parameter, EditorRequired] public WorkbenchStateBase State { get; set; } = null!;

    [Parameter, EditorRequired] public RenderFragment Rail { get; set; } = null!;

    [Parameter, EditorRequired] public Func<CalendarRange, Task<CalendarLoad>> Load { get; set; } = null!;

    [Parameter, EditorRequired] public Func<IReadOnlyList<TItem>> Items { get; set; } = null!;

    [Parameter, EditorRequired] public RenderFragment<CalendarBar<TItem>> Bar { get; set; } = null!;

    [Parameter, EditorRequired] public RenderFragment<TItem> Detail { get; set; } = null!;

    [Parameter, EditorRequired] public Func<TItem, string> DetailTitle { get; set; } = null!;

    [Parameter] public string? CardClass { get; set; }

    [Parameter] public Func<TItem, string>? AnchorStyle { get; set; }

    [Parameter] public Func<DateTimeOffset, DateTimeOffset, Task>? OnWindowChanged { get; set; }

    [Parameter] public string FilterNote { get; set; } = "Nothing matches these filters.";

    [Parameter] public bool Filtering { get; set; }

    bool _open;
    bool _loading;
    string _note = "";
    CalendarZoom _zoom = CalendarZoom.Month;
    DateTimeOffset _center = DateTimeOffset.UtcNow;
    DateTimeOffset _visibleStart;
    DateTimeOffset _visibleEnd;
    IReadOnlyList<CalendarLayoutRow<TItem>> _rows = [];
    IReadOnlyList<PeriodSlot<CalendarBar<TItem>>> _periods = [];
    double _slotRem = MinSlotRem;
    CalendarBar<TItem>? _picked;
    CalendarBar<TItem>? _hover;
    CalendarGrid<CalendarBar<TItem>>? _grid;
    TimeZoneInfo _zone = ViewerZone.Fallback;
    ViewerClock? _clock;
    PathRouteSync? _hash;

    public bool IsOpen => _open;

    public TimeZoneInfo Zone => _zone;

    public CalendarZoom Zoom => _zoom;

    public DateTimeOffset VisibleStart => _visibleStart;

    public DateTimeOffset VisibleEnd => _visibleEnd;

    protected override async Task OnInitializedAsync() {
        _clock = ViewerClock.Of(Services);
        if (_clock is null) return;
        await _clock.EnsureAsync(Services, User, CancellationToken.None);
        _zone = _clock.Zone;
        _clock.Changed += OnZoneChanged;
    }

    public async Task Open() {
        await OpenCore();
        WriteHash(true);
        StateHasChanged();
    }

    async Task OpenCore() {
        _open = true;
        _loading = true;
        _center = DateTimeOffset.UtcNow;
        (_visibleStart, _visibleEnd) = CalendarLayout.Window(_center, _zoom);
        ClearSelection();
        StateHasChanged();
        await Refresh();
    }

    void Close() {
        _open = false;
        ClearSelection();
        WriteHash(true, true);
    }

    public void ClearSelection() {
        _picked = null;
        _hover = null;
    }

    public void Select(CalendarBar<TItem> bar) {
        _picked = ReferenceEquals(_picked, bar) ? null : bar;
    }

    bool IsPinned(CalendarBar<TItem> bar) {
        return ReferenceEquals(_picked, bar);
    }

    public void Relayout() {
        var items = Items();
        var now = DateTimeOffset.UtcNow;
        _rows = CalendarLayout.Rows(items, _visibleStart, _visibleEnd, _zoom, now);
        int? primaryMonth = _zoom == CalendarZoom.Month ? CalendarLayout.PrimaryMonth(_visibleStart, _visibleEnd) : null;
        var first = CalendarLayout.AddDays(_visibleStart, -7);
        var count = VisibleWeeks + 2;
        var periods = new List<PeriodSlot<CalendarBar<TItem>>>(count);
        var maxLanes = 1;
        for (var i = 0; i < count; i++) {
            var start = CalendarLayout.AddDays(first, 7 * i);
            var row = CalendarLayout.Row(items, start, CalendarLayout.AddDays(start, 7), now, primaryMonth);
            if (i > 0 && i < count - 1) maxLanes = Math.Max(maxLanes, row.Lanes.Count);
            periods.Add(new PeriodSlot<CalendarBar<TItem>>([ToCalendarRow(row)], start.UtcTicks));
        }

        _periods = periods;
        _slotRem = Math.Clamp(
            RowHeader + maxLanes * MonthLaneMin + (maxLanes - 1) * MonthLaneGap + 2 * RowInset, MinSlotRem, MaxSlotRem);
    }

    int VisibleWeeks => _zoom == CalendarZoom.Month ? CalendarLayout.MonthWeeks : 1;

    public void ApplyFilters() {
        ClearSelection();
        Relayout();
    }

    string Note {
        get {
            if (_loading) return "Loading...";
            if (_note.Length > 0) return _note;
            if (_rows.Any(r => r.Lanes.Count > 0)) return "";
            return Filtering ? FilterNote : "Nothing in this range.";
        }
    }

    async Task Refresh() {
        (_visibleStart, _visibleEnd) = CalendarLayout.Window(_center, _zoom);
        _center = _visibleStart + (_visibleEnd - _visibleStart) / 2;
        var load = await Load(new CalendarRange(
            UnixSeconds.FromTime(CalendarLayout.AddDays(_visibleStart, -7)),
            UnixSeconds.FromTime(CalendarLayout.AddDays(_visibleEnd, 7))));
        _note = load.Note;
        if (OnWindowChanged is { } changed) await changed(_visibleStart, _visibleEnd);
        _loading = false;
        Relayout();
    }

    async Task RefreshAndReset() {
        await Refresh();
        if (_grid is null) return;
        try {
            await _grid.ResetScrollAsync();
        } catch (JSDisconnectedException) {
        }
    }

    CalendarRow<CalendarBar<TItem>> ToCalendarRow(CalendarLayoutRow<TItem> row) {
        var cellLabels = row.Cells.Select(c => new CalendarCellLabel(c.LeftPercent, CalendarLayout.CellLabel(c, _zoom), c.Muted)).ToList();
        var gridLines = row.Cells.Where(c => c.LeftPercent > 0).Select(c => c.LeftPercent).ToList();
        var lanes = row.Lanes.Count > 0 ? row.Lanes : [[]];
        var laneGroups = new[] { new CalendarLaneGroupRow<CalendarBar<TItem>>(lanes) };
        return new CalendarRow<CalendarBar<TItem>>(cellLabels, gridLines, [], row.NowPercent, laneGroups);
    }

    LaneGroupDef<CalendarBar<TItem>>[] LaneGroups {
        get {
            var laneMin = _zoom == CalendarZoom.Week ? 6.75 : MonthLaneMin;
            return [new LaneGroupDef<CalendarBar<TItem>>(Anchored, laneMin, MonthLaneGap, RowHeader)];
        }
    }

    RenderFragment<CalendarBar<TItem>> Anchored => bar =>
        @<div class="@AnchorCss(bar)" style="@(CalendarBars.PositionStyle(bar) + (AnchorStyle?.Invoke(bar.Item) ?? ""))"
              @onmouseenter="@(() => _hover = bar)" @onmouseleave="@(() => Unhover(bar))">
            @Bar(bar)
        </div>;

    CalendarBar<TItem>? Shown => _hover ?? _picked;

    void Unhover(CalendarBar<TItem> bar) {
        if (ReferenceEquals(_hover, bar)) _hover = null;
    }

    string AnchorCss(CalendarBar<TItem> bar) {
        var css = IsPinned(bar) ? "evcal-anchor evcal-anchor-open" : "evcal-anchor";
        return ReferenceEquals(Shown, bar) ? css + " evcal-anchor-shown" : css;
    }

    string PaneCss => _zoom == CalendarZoom.Month ? "evcal-pane evcal-month" : "evcal-pane evcal-week";

    string PaneStyle => _zoom == CalendarZoom.Month
        ? FormattableString.Invariant(
            $"--evcal-slot-h:{_slotRem:0.###}rem;--evcal-vp-h:{_slotRem * CalendarLayout.MonthWeeks:0.###}rem;--strip-slot-h:{_slotRem:0.###}rem;--strip-h:{_slotRem * (CalendarLayout.MonthWeeks + 2):0.###}rem;--strip-top:-{_slotRem:0.###}rem;")
        : "";

    public string BarStyle(CalendarBar<TItem> bar) {
        var barH = _zoom == CalendarZoom.Week ? 4.5 : 1.125;
        return FormattableString.Invariant($"--evcal-bar-h:{barH:0.###}rem;");
    }

    public static string BarCss(CalendarBar<TItem> bar) {
        return CalendarBars.Css(bar) + " evcal-bar-anchored";
    }

    public string Absolute(double unixSeconds) {
        return TimeZoneInfo.ConvertTime(UnixSeconds.ToTime(unixSeconds), _zone)
            .ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    public string Weekday(double unixSeconds) {
        return TimeZoneInfo.ConvertTime(UnixSeconds.ToTime(unixSeconds), _zone)
            .ToString("dddd", CultureInfo.InvariantCulture);
    }

    Task SetZoom(CalendarZoom zoom) {
        if (_zoom == zoom) return Task.CompletedTask;
        _zoom = zoom;
        ClearSelection();
        return RefreshAndReset();
    }

    Task Pan(int direction) {
        _center = CalendarLayout.AddDays(CalendarLayout.WeekStart(_center), 7 * direction).AddDays(3);
        ClearSelection();
        return Refresh();
    }

    Task Today() {
        _center = DateTimeOffset.UtcNow;
        ClearSelection();
        return RefreshAndReset();
    }

    Task JumpToDate(ChangeEventArgs e) {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var picked)) return Task.CompletedTask;
        _center = CalendarLayout.DayStartForDate(picked).AddHours(1);
        ClearSelection();
        return RefreshAndReset();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        _hash = new PathRouteSync(Nav, "");
        _hash.Changed += () => _ = InvokeAsync(() => ApplyHash(_hash.Fragment));
        _hash.Start();
        await ApplyHash(_hash.Fragment);
    }

    void OnZoneChanged() => _ = InvokeAsync(() => {
        if (_clock is null || _clock.Zone.Id == _zone.Id) return;
        _zone = _clock.Zone;
        StateHasChanged();
    });

    async Task ApplyHash(string hash) {
        if (!State.ApplyHash(hash)) {
            if (_open) {
                _open = false;
                ClearSelection();
                StateHasChanged();
            }

            return;
        }

        if (!_open) await OpenCore();
        StateHasChanged();
    }

    void WriteHash(bool push = false, bool clear = false) {
        var fragment = clear ? "" : State.Hash() ?? "";
        if (push) _hash?.PushFragment(fragment);
        else _hash?.ReplaceFragment(fragment);
    }

    static string ZoomLabel(CalendarZoom zoom) {
        return zoom == CalendarZoom.Week ? "Week" : "Month";
    }

    string CenterDate => CalendarLayout.GridDate(CalendarLayout.DayStart(_center)).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    string RangeLabel => CalendarLayout.RangeLabel(_visibleStart, _visibleEnd, _zoom);

    static string TickStyle(double leftPercent) {
        return FormattableString.Invariant($"--tick-pos:{leftPercent:0.###};");
    }

    public void Dispose() {
        _hash?.Dispose();
        if (_clock is not null) _clock.Changed -= OnZoneChanged;
    }

}
