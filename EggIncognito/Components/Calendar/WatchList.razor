@using System.Text.Json
@using EggIncognito.Models.Calendar
@using EggIncognito.Services.Events
@inherits SelfCallComponentBase
@inject ViewerCookies Viewer
@inject ILogger<WatchList> Logger

<div class="watch">
    <div class="watch-head">
        <span class="watch-title">Pinned</span>
        @if (_entries is { Count: > 0 }) {
            <div class="watch-pick">
                @if (_open) {
                    <div class="popover-backdrop" @onmousedown="Close" @onwheel="Close"></div>
                    <div class="watch-pick-field" @onkeydown="OnKey" @onkeydown:stopPropagation="true">
                        <FilterInput Class="watch-pick-query" Placeholder="@AddLabel" AriaLabel="@AddLabel"
                                     Value="@_query" ValueChanged="OnQuery" autofocus="true"
                                     role="combobox" aria-autocomplete="list" aria-expanded="true"/>
                        <div class="watch-pick-list" role="listbox" aria-label="@AddLabel">
                            @if (_shown.Count == 0) {
                                <div class="watch-pick-empty">No matches</div>
                            }
                            @for (var i = 0; i < _shown.Count; i++) {
                                var e = _shown[i];
                                <button type="button" class="watch-pick-opt @(i == _active ? "watch-pick-on" : "")"
                                        role="option" aria-selected="@(i == _active ? "true" : "false")"
                                        @onmousedown:preventDefault="true" @onclick="() => Pin(e.Key)">
                                    <span class="watch-swatch" style="@e.BarStyle"></span>
                                    @if (e.IconUrl is { } icon) {
                                        <FallbackImg Class="watch-icon" Src="@icon" Alt=""/>
                                    }
                                    <span class="watch-pick-name">@e.Label</span>
                                    @if (e.Ultra) {
                                        <span class="watch-ultra">ultra</span>
                                    }
                                    @if (e.LastStart is { } ls) {
                                        <span class="watch-pick-when"><TimeAgo At="@UnixSeconds.ToTime(ls)" Hover="false" Class="time-ago"/></span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                } else {
                    <button type="button" class="btn-mini watch-pick-btn" aria-haspopup="listbox" aria-expanded="false" @onclick="Open">
                        <Icon Name="plus" Class="icon-sm"/>@AddLabel
                    </button>
                }
            </div>
        }
    </div>
    @if (_note.Length > 0) {
        <div class="watch-note">@_note</div>
    } else if (Pinned.Count == 0) {
        <div class="watch-note">@EmptyNote</div>
    } else {
        <ul class="watch-rows">
            @foreach (var e in Pinned) {
                <li class="watch-card" style="@e.BarStyle" @key="e.Key">
                    <span class="watch-swatch"></span>
                    @if (e.IconUrl is { } icon) {
                        <FallbackImg Class="watch-icon" Src="@icon" Alt=""/>
                    }
                    <span class="watch-body">
                        <span class="watch-label">
                            <span class="watch-name">@e.Label</span>
                            @if (e.Ultra) {
                                <span class="watch-ultra">ultra</span>
                            }
                            <button type="button" class="icon-btn icon-btn-sm watch-unpin" aria-label="@($"Unpin {e.Label}")" @onclick="() => Unpin(e.Key)">
                                <Icon Name="x"/>
                            </button>
                        </span>
                        <span class="watch-line">
                            <span class="watch-k">Last</span>
                            @if (e.LastStart is { } ls) {
                                <TimeAgo At="@UnixSeconds.ToTime(ls)" Class="time-ago"/>
                            } else {
                                <span>never seen</span>
                            }
                        </span>
                        <span class="watch-line">
                            <span class="watch-k">Next</span>
                            @if (e.Next.Count == 0) {
                                <span>no prediction</span>
                            } else {
                                <span class="watch-next">
                                    @foreach (var f in e.Next.Take(MaxNext)) {
                                        <span class="watch-forecast">
                                            <TimeAgo At="@UnixSeconds.ToTime(f.Start)" Class="time-ago"/>
                                            <span class="watch-conf" style="@PctStyle(f.Confidence)">@Percent(f.Confidence)</span>
                                        </span>
                                    }
                                </span>
                            }
                        </span>
                    </span>
                </li>
            }
        </ul>
    }
</div>

@code {
    const int MaxNext = 3;
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    [Parameter, EditorRequired] public string Source { get; set; } = "";

    [Parameter, EditorRequired] public string PrefKey { get; set; } = "";

    [Parameter] public string AddLabel { get; set; } = "Pin";

    [Parameter] public string EmptyNote { get; set; } = "Nothing pinned.";

    List<WatchEntry>? _entries;
    List<string> _pinned = [];
    string _note = "";
    bool _prefsLoaded;
    bool _open;
    string _query = "";
    int _active = -1;
    List<WatchEntry> _shown = [];

    List<WatchEntry> Pinned =>
        _entries is null ? [] : [.. _pinned.Select(k => _entries.FirstOrDefault(e => e.Key == k)).OfType<WatchEntry>()];

    protected override async Task OnInitializedAsync() {
        if (Speculative) return;
        try {
            var res = await Client().GetAsync(Source);
            if ((int)res.StatusCode == 503) {
                _note = "Predictions need a database. This instance has none.";
                return;
            }

            if (!res.IsSuccessStatusCode) {
                _note = "Predictions could not be loaded.";
                return;
            }

            _entries = (await res.Content.ReadFromJsonAsync<WatchResponse>(JsonOpts))?.Entries.ToList() ?? [];
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the watch list {Source} could not be loaded", Source);
            _note = "Predictions could not be loaded.";
        }
    }

    protected override void OnAfterRender(bool firstRender) {
        if (!firstRender || _prefsLoaded) return;
        _prefsLoaded = true;
        _pinned = Parse(Viewer.Get(PrefKey));
        StateHasChanged();
    }

    static List<string> Parse(string? raw) {
        if (string.IsNullOrWhiteSpace(raw)) return [];
        try {
            return JsonSerializer.Deserialize<List<string>>(raw) ?? [];
        } catch (JsonException) {
            return [];
        }
    }

    void Open() {
        _open = true;
        _query = "";
        Rebuild();
    }

    void Close() {
        _open = false;
        _query = "";
        _active = -1;
    }

    void OnQuery(string value) {
        _query = value;
        Rebuild();
    }

    void Rebuild() {
        var q = _query.Trim();
        _shown = [
            .. (_entries ?? [])
                .Where(e => !_pinned.Contains(e.Key))
                .Where(e => q.Length == 0 || e.Label.Contains(q, StringComparison.OrdinalIgnoreCase) || e.Key.Contains(q, StringComparison.OrdinalIgnoreCase))
        ];
        _active = _shown.Count == 0 ? -1 : 0;
    }

    void OnKey(KeyboardEventArgs e) {
        switch (e.Key) {
            case "ArrowDown":
                if (_shown.Count > 0) _active = (_active + 1) % _shown.Count;
                break;
            case "ArrowUp":
                if (_shown.Count > 0) _active = (_active - 1 + _shown.Count) % _shown.Count;
                break;
            case "Enter":
                if (_active >= 0 && _active < _shown.Count) Pin(_shown[_active].Key);
                break;
            case "Escape":
            case "Tab":
                Close();
                break;
        }
    }

    void Pin(string key) {
        if (!_pinned.Contains(key)) _pinned = [.. _pinned, key];
        Close();
        Save();
    }

    void Unpin(string key) {
        _pinned = [.. _pinned.Where(k => k != key)];
        Save();
    }

    void Save() {
        try {
            Viewer.Set(PrefKey, JsonSerializer.Serialize(_pinned));
        } catch (Exception ex) when (ex is InvalidOperationException or JSException or JSDisconnectedException) {
            Logger.LogDebug(ex, "the pin list {Key} could not be saved", PrefKey);
        }
    }

    static string Percent(double value) => (value * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "%";

    static string PctStyle(double p) => FormattableString.Invariant($"--p:{Math.Clamp(p, 0, 1):0.###};");

}
