@using System.Text.Json
@using EggIncognito.Models.Calendar
@using EggIncognito.Services.Events
@inherits SelfCallComponentBase
@inject ViewerCookies Viewer
@inject ILogger<WatchList> Logger

<div class="watch">
    <div class="watch-head">
        <span class="watch-title">Pinned</span>
        @if (_entries is { Count: > 0 }) {
            <PercentSlider Value="_minPct" ValueChanged="OnMin" Min="0" Max="95" Step="5" Label="Min"
                           Title="Hide predictions below this chance" AriaLabel="Minimum prediction chance"/>
            <button type="button" class="btn-mini watch-pick-btn" aria-expanded="@(_open ? "true" : "false")" @onclick="Toggle">
                <Icon Name="@(_open ? "x" : "plus")" Class="icon-sm"/>@(_open ? "Done" : AddLabel)
            </button>
        }
    </div>
    @if (_open) {
        <div class="watch-pick" @onkeydown="OnKey" @onkeydown:stopPropagation="true">
            <div class="watch-pick-row">
                <span class="watch-pick-k">Find</span>
                <FilterInput Class="watch-pick-query" Placeholder="@Placeholder" AriaLabel="@AddLabel"
                             Value="@_query" ValueChanged="OnQuery" autofocus="true"
                             role="combobox" aria-autocomplete="list" aria-expanded="true"/>
                @if (HasUltra) {
                    <label class="watch-pick-toggle">
                        <input type="checkbox" class="watch-pick-toggle-input" checked="@_ultra" @onchange="OnUltra"/>
                        <span>Ultra</span>
                    </label>
                }
            </div>
            <div class="watch-pick-list" role="listbox" aria-label="@AddLabel">
                @if (_shown.Count == 0) {
                    <div class="watch-pick-empty">No matches</div>
                }
                @for (var i = 0; i < _shown.Count; i++) {
                    var e = _shown[i];
                    <div class="watch-pick-opt @(i == _active ? "watch-pick-on" : "")" style="@e.BarStyle"
                         role="option" aria-selected="@(i == _active ? "true" : "false")"
                         @onmousedown:preventDefault="true" @onclick="() => Pin(e.Key)">
                        @if (e.IconUrl is { } icon) {
                            <FallbackImg Class="watch-pick-icon" Src="@icon" Alt=""/>
                        }
                        <span class="watch-pick-name">@e.Label</span>
                        @if (e.LastStart is { } ls) {
                            <span class="watch-pick-when"><TimeAgo At="@UnixSeconds.ToTime(ls)" Hover="false" Class="time-ago"/></span>
                        }
                    </div>
                }
            </div>
        </div>
    }
    @if (_note.Length > 0) {
        <div class="watch-note">@_note</div>
    } else if (_entries is null) {
        <div class="watch-note"><Icon Name="loader" Class="icon-sm text-muted"/> Training predictions...</div>
    } else if (Pinned.Count == 0) {
        <div class="watch-note">@EmptyNote</div>
    } else {
        <ul class="watch-rows">
            @foreach (var e in Pinned) {
                <WatchPinnedCard @key="e.Key" Entry="e" MinPct="_minPct" OnUnpin="Unpin"/>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = "";

    [Parameter, EditorRequired] public string PrefKey { get; set; } = "";

    [Parameter] public string AddLabel { get; set; } = "Pin";

    [Parameter] public string Placeholder { get; set; } = "name...";

    [Parameter] public string EmptyNote { get; set; } = "Nothing pinned.";

    List<WatchEntry>? _entries;
    List<string> _pinned = [];
    string _note = "";
    bool _prefsLoaded;
    bool _open;
    bool _ultra;
    int _minPct;
    string _query = "";
    int _active = -1;
    List<WatchEntry> _shown = [];

    bool HasUltra => _entries?.Any(e => e.Ultra) == true && _entries.Any(e => !e.Ultra);

    List<WatchEntry> Pinned =>
        _entries is null ? [] : [.. _pinned.Select(k => _entries.FirstOrDefault(e => e.Key == k)).OfType<WatchEntry>()];

    protected override async Task OnInitializedAsync() {
        if (Speculative) return;
        try {
            var res = await Client().GetAsync(Source);
            if ((int)res.StatusCode == 503) {
                _note = "Predictions need a database. This instance has none.";
                return;
            }

            if (!res.IsSuccessStatusCode) {
                _note = "Predictions could not be loaded.";
                return;
            }

            _entries = (await res.Content.ReadFromJsonAsync<WatchResponse>(JsonPresets.Web))?.Entries.ToList() ?? [];
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the watch list {Source} could not be loaded", Source);
            _note = "Predictions could not be loaded.";
        }
    }

    protected override void OnAfterRender(bool firstRender) {
        if (!firstRender || _prefsLoaded) return;
        _prefsLoaded = true;
        _pinned = Parse(Viewer.Get(PrefKey));
        if (int.TryParse(Viewer.Get(MinKey), System.Globalization.NumberStyles.Integer,
                System.Globalization.CultureInfo.InvariantCulture, out int min))
            _minPct = Math.Clamp(min, 0, 95);
        StateHasChanged();
    }

    string MinKey => PrefKey + ".min";

    void OnMin(int v) {
        _minPct = v;
        Viewer.Set(MinKey, _minPct.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    static List<string> Parse(string? raw) {
        if (string.IsNullOrWhiteSpace(raw)) return [];
        try {
            return JsonSerializer.Deserialize<List<string>>(raw) ?? [];
        } catch (JsonException) {
            return [];
        }
    }

    void Toggle() {
        if (_open) {
            Close();
            return;
        }

        _open = true;
        _query = "";
        Rebuild();
    }

    void Close() {
        _open = false;
        _query = "";
        _active = -1;
    }

    void OnQuery(string value) {
        _query = value;
        Rebuild();
    }

    void OnUltra(ChangeEventArgs e) {
        _ultra = e.Value is true;
        Rebuild();
    }

    void Rebuild() {
        var q = _query.Trim();
        _shown = [
            .. (_entries ?? [])
                .Where(e => !_pinned.Contains(e.Key))
                .Where(e => !HasUltra || e.Ultra == _ultra)
                .Where(e => q.Length == 0 || e.Label.Contains(q, StringComparison.OrdinalIgnoreCase) || e.Key.Contains(q, StringComparison.OrdinalIgnoreCase))
        ];
        _active = _shown.Count == 0 ? -1 : 0;
    }

    void OnKey(KeyboardEventArgs e) {
        switch (e.Key) {
            case "ArrowDown":
                if (_shown.Count > 0) _active = (_active + 1) % _shown.Count;
                break;
            case "ArrowUp":
                if (_shown.Count > 0) _active = (_active - 1 + _shown.Count) % _shown.Count;
                break;
            case "Enter":
                if (_active >= 0 && _active < _shown.Count) Pin(_shown[_active].Key);
                break;
            case "Escape":
            case "Tab":
                Close();
                break;
        }
    }

    void Pin(string key) {
        if (!_pinned.Contains(key)) _pinned = [.. _pinned, key];
        Rebuild();
        Save();
    }

    void Unpin(string key) {
        _pinned = [.. _pinned.Where(k => k != key)];
        Save();
    }

    void Save() => Viewer.Set(PrefKey, JsonSerializer.Serialize(_pinned));
}
