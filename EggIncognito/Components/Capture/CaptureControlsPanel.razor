<div class="ccp">
    @if (!ReadOnly) {
        <button type="button" class="@(Running ? "btn-mini btn-danger" : "btn-primary ccp-start")" disabled="@ToggleBusy" @onclick="OnToggleCapture">
            <Icon Name="@(Running ? "square" : "play")" Class="icon-sm"/>
            @(Running ? "Stop capture" : "Start capture")
        </button>
    }

    <Menu Class="settings-menu settings-menu-lg" AlignStart="MenusAlignLeft" TriggerClass="btn-mini"
          TriggerLabel="Capture view settings" CloseOnSelect="false">
        <Trigger>
            <Icon Name="settings" Class="icon-sm"/>
        </Trigger>
        <ChildContent>
            <div class="ccs">
                <div class="ccs-group">List</div>
                <label class="ccs-row">
                    <span class="ccs-k">Follow new requests</span>
                    <input type="checkbox" checked="@View.AutoScroll" @onchange="OnAutoScroll"/>
                </label>
                <label class="ccs-row">
                    <span class="ccs-k">Saved-endpoint tags</span>
                    <input type="checkbox" checked="@View.CompareToKnown" @onchange="OnCompare"/>
                </label>
                <div class="ccs-note">Marks each request as new, changed or matching against your saved endpoints.</div>

                <div class="ccs-group">Detail</div>
                <div class="ccs-row">
                    <span class="ccs-k">Player IDs</span>
                    <div class="segmented ccs-seg" role="radiogroup" aria-label="Player IDs">
                        <button type="button" class="segmented-opt @(View.RedactionMode == "off" ? "active" : "")" @onclick="@(() => SetMode("off"))">Show</button>
                        <button type="button" class="segmented-opt @(View.RedactionMode == "blur" ? "active" : "")" @onclick="@(() => SetMode("blur"))">Blur</button>
                        <button type="button" class="segmented-opt @(View.RedactionMode == "redact" ? "active" : "")" @onclick="@(() => SetMode("redact"))">Hide</button>
                    </div>
                </div>
                <label class="ccs-row">
                    <span class="ccs-k">HTTP headers</span>
                    <input type="checkbox" checked="@View.ShowHeaders" @onchange="OnShowHeaders"/>
                </label>
                <label class="ccs-row">
                    <span class="ccs-k">Open bodies as</span>
                    <select class="form-select ccs-select" value="@View.DefaultFormat" @onchange="OnDefaultFormat">
                        <option value="json-tree">JSON tree</option>
                        <option value="json">JSON</option>
                        <option value="yaml">YAML</option>
                        <option value="xml">XML</option>
                        <option value="js">JS object</option>
                        <option value="hex">Hex</option>
                        <option value="bin">Binary</option>
                    </select>
                </label>
            </div>
        </ChildContent>
    </Menu>

    @Notices

    @if (!ReadOnly && FlowCount > 0) {
        <Menu Class="settings-menu" AlignStart="MenusAlignLeft" TriggerClass="btn-mini btn-danger" CloseOnSelect="false" @ref="_clearMenu">
            <Trigger>Clear</Trigger>
            <ChildContent>
                <div class="settings-title">Clear list?</div>
                <div class="settings-hint">Removes the captured requests shown here. Saved endpoints, captured HAR(s), and exported files are kept.</div>
                <div class="settings-actions">
                    <button type="button" class="btn-mini" @onclick="CloseClear">Cancel</button>
                    <button type="button" class="btn-mini btn-danger" @onclick="ConfirmClear">Clear</button>
                </div>
            </ChildContent>
        </Menu>
        <a class="btn-mini" href="/api/capture/har" download>
            <Icon Name="download" Class="icon-sm"/>Export HAR
        </a>
    }
</div>

@code {
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool ToggleBusy { get; set; }
    [Parameter] public int FlowCount { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public EventCallback OnToggleCapture { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnViewChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool MenusAlignLeft { get; set; }
    [Parameter] public RenderFragment? Notices { get; set; }

    Menu? _clearMenu;

    Task CloseClear() {
        return _clearMenu?.CloseAsync() ?? Task.CompletedTask;
    }

    async Task SetMode(string mode) {
        View.RedactionMode = mode;
        await OnViewChanged.InvokeAsync();
    }

    async Task OnShowHeaders(ChangeEventArgs e) {
        View.ShowHeaders = e.Value is bool b && b;
        await OnViewChanged.InvokeAsync();
    }

    async Task OnAutoScroll(ChangeEventArgs e) {
        View.AutoScroll = e.Value is bool b && b;
        await OnViewChanged.InvokeAsync();
    }

    async Task OnCompare(ChangeEventArgs e) {
        View.CompareToKnown = e.Value is bool b && b;
        await OnViewChanged.InvokeAsync();
    }

    async Task OnDefaultFormat(ChangeEventArgs e) {
        View.DefaultFormat = e.Value?.ToString() ?? "json-tree";
        await OnViewChanged.InvokeAsync();
    }

    async Task ConfirmClear() {
        await CloseClear();
        await OnClear.InvokeAsync();
    }

}
