@* Capture controls side-column widget: start/stop, clear, HAR export, and view/redaction settings.
   View settings mutate the shared CaptureViewState and call OnViewChanged. One popover open at a time. *@

@if (_open is not null) {
    <div class="popover-backdrop" @onclick="@(() => _open = null)"></div>
}
<div class="capture-bar-group">
    @if (!ReadOnly) {
        <button type="button" class="@(Running ? "btn-mini btn-danger" : "btn-primary capture-start")" disabled="@ToggleBusy" @onclick="OnToggleCapture">
            <Icon Name="@(Running ? "square" : "play")" Class="icon-sm"/>
            @(Running ? "Stop capture" : "Start capture")
        </button>
    }

    <div class="settings-wrap">
        <button type="button" class="btn-mini" aria-label="Capture view settings"
                aria-haspopup="true" aria-expanded="@(_open == "settings" ? "true" : "false")" @onclick="@(() => Toggle("settings"))">
            <Icon Name="settings" Class="icon-sm"/>
        </button>
        <div class="settings-menu settings-menu-lg @(_open == "settings" ? "open" : "")">
            <div class="settings-title">Redaction</div>
            <div class="settings-hint">Hide user IDs and EIDs in the detail pane.</div>
            <div class="settings-seg" role="radiogroup" aria-label="Redaction mode">
                <button type="button" class="seg-btn @(View.RedactionMode == "off" ? "active" : "")" @onclick="@(() => SetMode("off"))">Off</button>
                <button type="button" class="seg-btn @(View.RedactionMode == "blur" ? "active" : "")" @onclick="@(() => SetMode("blur"))">Blur</button>
                <button type="button" class="seg-btn @(View.RedactionMode == "redact" ? "active" : "")" @onclick="@(() => SetMode("redact"))">Redact</button>
            </div>

            <div class="settings-title">Headers</div>
            <label class="settings-check"><input type="checkbox" checked="@View.ShowHeaders" @onchange="OnShowHeaders"/> Show captured headers</label>

            <div class="settings-title">List</div>
            <label class="settings-check"><input type="checkbox" checked="@View.AutoScroll" @onchange="OnAutoScroll"/> Auto-scroll to newest</label>

            <div class="settings-title">Comparison tags</div>
            <div class="settings-hint">Tag each capture against the saved endpoint set.</div>
            <label class="settings-check"><input type="checkbox" checked="@View.CompareToKnown" @onchange="OnCompare"/> Show comparison tags</label>

            <div class="settings-title">Default format</div>
            <div class="settings-hint">Format the data opens in.</div>
            <select class="data-format settings-select" value="@View.DefaultFormat" @onchange="OnDefaultFormat">
                <option value="json-tree">JSON (tree)</option>
                <option value="json">JSON (raw)</option>
                <option value="yaml">YAML</option>
                <option value="xml">XML</option>
                <option value="js">JS object</option>
                <option value="hex">Hex</option>
                <option value="bin">Binary</option>
            </select>
        </div>
    </div>

    @Notices

    @if (!ReadOnly && FlowCount > 0) {
        <div class="settings-wrap">
            <button type="button" class="btn-mini btn-danger"
                    aria-haspopup="true" aria-expanded="@(_open == "clear" ? "true" : "false")" @onclick="@(() => Toggle("clear"))">
                Clear
            </button>
            <div class="settings-menu confirm-menu @(_open == "clear" ? "open" : "")">
                <div class="settings-title">Clear list?</div>
                <div class="settings-hint">Removes the captured requests shown here. Saved endpoints, captured HAR(s), and exported files are kept.</div>
                <div class="confirm-actions">
                    <button type="button" class="btn-mini" @onclick="@(() => _open = null)">Cancel</button>
                    <button type="button" class="btn-mini btn-danger" @onclick="ConfirmClear">Clear</button>
                </div>
            </div>
        </div>
        <a class="btn-mini" href="/api/capture/har" download>
            <Icon Name="download" Class="icon-sm"/>Export HAR
        </a>
    }
</div>

@code {
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool ToggleBusy { get; set; }
    [Parameter] public int FlowCount { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public EventCallback OnToggleCapture { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnViewChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public RenderFragment? Notices { get; set; }

    string? _open;

    void Toggle(string which) {
        _open = _open == which ? null : which;
    }

    async Task SetMode(string mode) {
        View.RedactionMode = mode;
        await OnViewChanged.InvokeAsync();
    }

    async Task OnShowHeaders(ChangeEventArgs e) {
        View.ShowHeaders = e.Value is bool b && b;
        await OnViewChanged.InvokeAsync();
    }

    async Task OnAutoScroll(ChangeEventArgs e) {
        View.AutoScroll = e.Value is bool b && b;
        await OnViewChanged.InvokeAsync();
    }

    async Task OnCompare(ChangeEventArgs e) {
        View.CompareToKnown = e.Value is bool b && b;
        await OnViewChanged.InvokeAsync();
    }

    async Task OnDefaultFormat(ChangeEventArgs e) {
        View.DefaultFormat = e.Value?.ToString() ?? "json-tree";
        await OnViewChanged.InvokeAsync();
    }

    async Task ConfirmClear() {
        _open = null;
        await OnClear.InvokeAsync();
    }

}
