@using EggIncognito.Models.Contributions
@inject ToastService Toasts
@inject ILogger<ContributePanel> Logger

@if (_recorded > 0) {
    <div class="contribute-foot">
        <div class="contribute-row">
            <span class="meta-dots contribute-counts">
                <span class="contribute-stat"><b>@_recorded</b> unsent</span>
                <span class="contribute-stat"><b>@_submitted</b> awaiting review</span>
                <span class="contribute-stat"><b>@_approved</b> accepted</span>
            </span>
            <div class="contribute-actions">
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="Send">
                    <Icon Name="send" Class="icon-sm"/>@(_busy ? "Sending..." : $"Send {_recorded} for review")
                </button>
                <button type="button" class="btn-mini btn-danger" disabled="@_busy" @onclick="Discard">
                    Discard
                </button>
            </div>
        </div>
        <p class="contribute-hint">Unsent results stay on your account. Sent rows carry only the artifact, outcome and game version.</p>
    </div>
}

@code {
    [Parameter] public Func<HttpClient> ClientFactory { get; set; } = () => new HttpClient();

    int _recorded;
    int _submitted;
    int _approved;
    bool _busy;

    protected override async Task OnInitializedAsync() {
        await RefreshAsync();
    }

    public async Task RefreshAsync() {
        try {
            var summary = await ClientFactory().GetFromJsonAsync<ContributionSummaryDto>("/api/contributions/summary");
            if (summary is null) return;
            _recorded = summary.Recorded;
            _submitted = summary.Submitted;
            _approved = summary.Approved;
            StateHasChanged();
        }
        catch (Exception ex) {
            Logger.LogDebug(ex, "contribution summary refresh failed");
        }
    }

    async Task Send() {
        _busy = true;
        try {
            var res = await ClientFactory().PostAsync("/api/contributions/submit", null);
            if (res.IsSuccessStatusCode) {
                var body = await res.Content.ReadFromJsonAsync<ContributionSubmitResult>();
                var sent = body?.Submitted ?? _recorded;
                Toasts.Push(StatusNoteKind.Ok, $"Sent {sent} results for review.");
            } else {
                Toasts.Push(StatusNoteKind.Error, "Could not send right now. Your results are still saved.");
            }

            await RefreshAsync();
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "submitting contributions failed");
            Toasts.Push(StatusNoteKind.Error, "Could not send right now. Your results are still saved.");
        }
        finally {
            _busy = false;
            StateHasChanged();
        }
    }

    async Task Discard() {
        _busy = true;
        try {
            var res = await ClientFactory().PostAsync("/api/contributions/discard", null);
            if (res.IsSuccessStatusCode) Toasts.Push(StatusNoteKind.Ok, "Discarded your unsent results.");
            else Toasts.Push(StatusNoteKind.Error, "Could not discard right now.");
            await RefreshAsync();
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "discarding contributions failed");
            Toasts.Push(StatusNoteKind.Error, "Could not discard right now.");
        }
        finally {
            _busy = false;
            StateHasChanged();
        }
    }

}
