@using System.Text.Json
@* Hosted-capture connection card: the caller's per-user IPv6 proxy host, the port, and the CA install
   steps. The front door identifies the user by destination address, so the proxy uses no auth. *@
<div id="hostedSetupCard" class="capture-setup-strip">
    <div class="setup-strip">
        <span class="setup-strip-k">Server</span>
        <span class="code-chip" id="proxyHost">@(_proxyHost ?? "loading...")</span>
        <span class="setup-strip-k">Port</span>
        <span class="code-chip">@Port</span>
        <span class="setup-strip-k">Auth</span>
        <span class="code-chip">off</span>
        <span class="setup-strip-gap"></span>
        <button type="button" class="btn-mini" @onclick="Toggle">@(Expanded ? "Hide steps" : "Steps")</button>
    </div>

    @if (_rotated) {
        <p class="setup-note" id="rotatedNotice">
            New address issued. Update your device's proxy Server to the value above.
        </p>
    }

    @if (_caDmFailed) {
        <p class="setup-note" id="caDmFailedNotice">
            Could not DM you the CA. You may not be in the
            Discord server, or your member DMs are off (Settings &gt; Privacy &amp; Safety).
            @if (!string.IsNullOrWhiteSpace(InviteUrl)) {
                <span>Join: <a href="@InviteUrl" target="_blank" rel="noopener" class="text-accent underline">@InviteUrl</a>, enable DMs, then re-send the setup DM from the Requests toolbar.</span>
            } else {
                <span>Enable DMs, then re-send the setup DM from the Requests toolbar.</span>
            }
        </p>
    }

    @if (Limited) {
        <p class="setup-note" id="limitedNotice">
            Limited capture: crafting, consume and demote requests open in full. Other requests list their route and
            message types only. <a href="/#support">Supporters</a> get full capture.
        </p>
    }

    @if (Expanded) {
        <div class="setup-steps">
            <ol class="setup-list">
                <li>Set your Wi-Fi proxy to <strong>Manual</strong> using the Server + Port above (auth off).</li>
                <li>
                    Install + trust the DM'd CA:
                    <ul class="setup-sublist">
                        <li>
                            <strong>iOS</strong>: open the CA profile, install it, then full-trust under Settings &gt;
                            General &gt; About &gt; Certificate Trust Settings.
                        </li>
                        <li>
                            <strong>Android</strong>: needs a rooted phone with the CA in the system trust store (Android
                            7+ ignores user CAs), e.g. a Magisk cert module.
                        </li>
                    </ul>
                </li>
                <li>
                    Open Egg, Inc. Flows appear live below. Only Egg, Inc. traffic is decrypted; everything else
                    passes through untouched.
                </li>
            </ol>
        </div>
    }
</div>

@code {
    [Parameter] public int Port { get; set; }
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }

    [Parameter] public string? InviteUrl { get; set; }

    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    [Parameter] public bool Limited { get; set; }

    private Task Toggle() {
        return ExpandedChanged.InvokeAsync(!Expanded);
    }

    string? _proxyHost;
    bool _caDmFailed;
    bool _rotated;

    [Parameter] public string? HostOverride { get; set; }

    protected override void OnParametersSet() {
        if (!string.IsNullOrEmpty(HostOverride) && HostOverride != _proxyHost) {
            _proxyHost = HostOverride;
            _rotated = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || ClientFactory is null) return;
        try {
            var res = await ClientFactory().GetAsync("/api/capture/proxy-address");
            if (res.IsSuccessStatusCode) {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                _proxyHost = doc.RootElement.GetProperty("host").GetString();
                StateHasChanged();
            }
        }
        catch {
            /* address unavailable (no session / prerender); the placeholder stays */
        }

        try {
            var res = await ClientFactory().GetAsync("/api/capture/status");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("caDmFailed", out var f)
                && f.ValueKind == JsonValueKind.True) {
                _caDmFailed = true;
                StateHasChanged();
            }
        }
        catch {
            /* status unavailable (no session / prerender); the download button stays the fallback */
        }
    }

}
