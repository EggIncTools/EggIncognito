@using System.Text.Json
@inject ToastService Toasts
@* Hosted-capture connection card: the caller's per-user IPv6 proxy host, the port, and the CA install
   steps. The front door identifies the user by destination address, so the proxy uses no auth. *@
<div id="hostedSetupCard" class="capture-setup-strip">
    <div class="insp-disc setup-disc @(Expanded ? "" : "collapsed")">
        <div class="insp-disc-head setup-head" @onclick="Toggle">
            <button type="button" class="insp-disc-toggle" aria-expanded="@(Expanded ? "true" : "false")" aria-controls="setupSteps">
                <span class="ep-caret @(Expanded ? "ep-caret-open" : "")"></span>Setup
            </button>
            <span class="setup-strip-k">Server</span>
            <span class="code-chip" id="proxyHost">@(_proxyHost ?? "loading...")</span>
            <button type="button" class="btn-mini" disabled="@_rotateBusy" @onclick="RotateAddress" @onclick:stopPropagation="true">
                <Icon Name="refresh-cw" Class="icon-sm"/>New address
            </button>
            <span class="setup-strip-k">Port</span>
            <span class="code-chip">@Port</span>
            <span class="setup-strip-k">Auth</span>
            <span class="code-chip">off</span>
        </div>
        <div class="insp-disc-body" id="setupSteps">
            @if (_caDmFailed) {
                <p class="setup-note" id="caDmFailedNotice">
                    The setup DM could not be delivered.
                    @if (!string.IsNullOrWhiteSpace(InviteUrl)) {
                        <span>Join the Discord server at <a href="@InviteUrl" target="_blank" rel="noopener" class="text-accent underline">@InviteUrl</a>, allow member DMs under Settings &gt; Privacy &amp; Safety, then use Re-send setup DM in step 2.</span>
                    } else {
                        <span>Allow member DMs under Settings &gt; Privacy &amp; Safety, then use Re-send setup DM in step 2.</span>
                    }
                </p>
            }

            @if (Limited) {
                <p class="setup-note" id="limitedNotice">
                    Limited capture opens crafting, consume and demote requests in full and lists every other request by route and message types only.
                    <a href="/#support" class="underline">Supporters</a> get full capture.
                </p>
            }

            <ol class="setup-list">
                <li>On the phone, set the Wi-Fi proxy to Manual with the Server and Port shown above and authentication off.</li>
                <li>
                    <span class="setup-step-line">
                        Install and trust the CA certificate from the setup DM on Discord.
                        <button type="button" class="btn-mini" disabled="@_dmBusy" @onclick="SendConfig">
                            <Icon Name="send" Class="icon-sm"/>Re-send setup DM
                        </button>
                    </span>
                    <ul class="setup-sublist">
                        <li><strong>iOS</strong>: install the profile, then enable full trust under Settings &gt; General &gt; About &gt; Certificate Trust Settings.</li>
                        <li><strong>Android</strong>: the CA must sit in the system trust store, which needs a rooted phone (for example a Magisk certificate module).</li>
                    </ul>
                </li>
                <li>Open Egg, Inc. on the phone and its requests appear in the list below.</li>
            </ol>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Port { get; set; }
    [Parameter] public Func<HttpClient>? ClientFactory { get; set; }

    [Parameter] public string? InviteUrl { get; set; }

    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    [Parameter] public bool Limited { get; set; }

    string? _proxyHost;
    bool _caDmFailed;
    bool _dmBusy;
    bool _rotateBusy;

    Task Toggle() {
        return ExpandedChanged.InvokeAsync(!Expanded);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || ClientFactory is null) return;
        try {
            var res = await ClientFactory().GetAsync("/api/capture/proxy-address");
            if (res.IsSuccessStatusCode) {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                _proxyHost = doc.RootElement.GetProperty("host").GetString();
                StateHasChanged();
            }
        }
        catch {
            /* address unavailable (no session / prerender); the placeholder stays */
        }

        try {
            var res = await ClientFactory().GetAsync("/api/capture/status");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("caDmFailed", out var f)
                && f.ValueKind == JsonValueKind.True) {
                _caDmFailed = true;
                StateHasChanged();
            }
        }
        catch {
            /* status unavailable (no session / prerender); the download button stays the fallback */
        }
    }

    static bool Sent(string body) {
        try {
            using var doc = JsonDocument.Parse(body);
            return !doc.RootElement.TryGetProperty("sent", out var s) || s.GetBoolean();
        }
        catch (JsonException) {
            return true;
        }
    }

    static string Detail(string body) {
        try {
            using var doc = JsonDocument.Parse(body);
            return doc.RootElement.TryGetProperty("error", out var e) ? e.GetString() ?? "" : "";
        }
        catch (JsonException) {
            return "";
        }
    }

    async Task SendConfig() {
        if (ClientFactory is null) return;
        _dmBusy = true;
        try {
            var res = await ClientFactory().PostAsync("/api/capture/send-config", null);
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) {
                Toasts.Push(StatusNoteKind.Error, $"Could not send the setup DM (HTTP {(int)res.StatusCode}). {Detail(body)}");
            } else if (Sent(body)) {
                _caDmFailed = false;
                Toasts.Push(StatusNoteKind.Ok, "Setup DM sent.");
            } else {
                _caDmFailed = true;
                Toasts.Push(StatusNoteKind.Error, "Discord refused the DM. Allow member DMs, then try again.");
            }
        }
        catch (Exception ex) {
            Toasts.Push(StatusNoteKind.Error, $"Setup DM failed: {ex.Message}");
        }

        _dmBusy = false;
    }

    async Task RotateAddress() {
        if (ClientFactory is null) return;
        _rotateBusy = true;
        try {
            var res = await ClientFactory().PostAsync("/api/capture/proxy-address/rotate", null);
            if (res.IsSuccessStatusCode) {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                var host = doc.RootElement.GetProperty("host").GetString();
                if (host is not null) _proxyHost = host;
                Toasts.Push(StatusNoteKind.Ok, "New address issued. Update the proxy Server on your phone.");
            } else {
                Toasts.Push(StatusNoteKind.Error, $"New address failed (HTTP {(int)res.StatusCode}).");
            }
        }
        catch (Exception ex) {
            Toasts.Push(StatusNoteKind.Error, $"New address failed: {ex.Message}");
        }

        _rotateBusy = false;
    }

}
