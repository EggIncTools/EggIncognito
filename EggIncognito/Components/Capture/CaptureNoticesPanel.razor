<SettingsMenu Open="_open" OpenChanged="SetOpen" Wide="true" AlignLeft="true" MaxHeight="420px">
    <Trigger>
        <button type="button" class="btn-mini" aria-label="Notifications"
                aria-haspopup="true" aria-expanded="@(_open ? "true" : "false")" @onclick="ToggleOpen">
            <Icon Name="bell" Class="icon-sm"/>
            @if (Unread > 0) {
                <span>@Unread</span>
            }
        </button>
    </Trigger>
    <ChildContent>
        <div class="notices-head">
            <div class="settings-title">Notifications</div>
            @if (Notices.Count > 0) {
                <button type="button" class="btn-mini" @onclick="ClearAllNotices">Clear all</button>
            }
        </div>
        <div class="notif-list">
            @foreach (var n in Notices) {
                <div class="notif-item notif-@n.Severity">
                    <div class="notif-body">
                        <div class="notif-msg">@n.Message</div>
                        @if (!string.IsNullOrEmpty(n.Timestamp)) {
                            <div class="notif-time">@n.Timestamp</div>
                        }
                    </div>
                    <button class="notif-dismiss" aria-label="Dismiss notification"
                            @onclick="@(() => DismissNotice(n.Id))">
                        <Icon Name="x" Class="icon-sm"/>
                    </button>
                </div>
            }
            @if (Notices.Count == 0) {
                <div class="notif-empty">No notifications.</div>
            }
        </div>
    </ChildContent>
</SettingsMenu>

@code {
    [Parameter] public IReadOnlyList<Models.Capture.NoticeItem> Notices { get; set; } = [];
    [Parameter] public int Unread { get; set; }
    [Parameter] public EventCallback<int> OnDismissNotice { get; set; }
    [Parameter] public EventCallback OnClearNotices { get; set; }
    [Parameter] public EventCallback OnNoticesRead { get; set; }

    bool _open;

    async Task ToggleOpen() {
        _open = !_open;
        if (_open) await OnNoticesRead.InvokeAsync();
    }

    void SetOpen(bool open) {
        _open = open;
    }

    Task DismissNotice(int id) {
        return OnDismissNotice.InvokeAsync(id);
    }

    Task ClearAllNotices() {
        return OnClearNotices.InvokeAsync();
    }

}
