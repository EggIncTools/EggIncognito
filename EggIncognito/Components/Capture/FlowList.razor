@* The middle flow list: row construction (time, path, known dot, outcome tag, status badge, type
   chips), filters (group/path/type), select, and device-aware empty state. *@
@using System.Globalization
@using EggIncognito.Capture
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<FlowList> Logger

<section id="flowsPanel" class="panel flow-panel">
    <div class="flow-head">
        <h2>Requests (@Flows.Count)</h2>
        @if (Filtering && Flows.Count > 0) {
            <span class="flow-count">showing @ShownCount</span>
        }
        @if (Tools is not null) {
            <div class="flow-tools">@Tools</div>
        }
    </div>
    <CaptureFlowFilterBar Flows="Flows" @bind-Group="_group" @bind-PathFilter="_pathFilter" @bind-TypeFilter="_typeFilter" OnClear="ClearFilters"/>
    <div id="flowList" class="flow-wrap @(Flows.Count == 0 ? "flow-wrap-empty" : "")" @ref="_listRef">
        @if (Flows.Count == 0) {
            <EmptyState Icon="@(Connected ? "list" : "smartphone")" Fill="true"
                        Title="@(Connected ? "No requests captured yet." : "No device connected yet.")"
                        Hint="@(Connected
                                  ? "Open Egg, Inc. on the phone and its requests appear here."
                                  : "Set the phone's Wi-Fi proxy to the capture server address, then open Egg, Inc. The device only registers once an app sends a request through the proxy.")"/>
        } else {
            <table class="data-table flow-table">
                <thead>
                <tr>
                    <th class="fdelta">Gap</th>
                    <th>Path</th>
                    <th>Types</th>
                    <th class="fstatus">Status</th>
                </tr>
                </thead>
                <tbody>
                @{
                    TimeSpan? prevTime = null;
                    string? shownMinute = null;
                }
                @foreach (var run in FlowRunCollapser.Fold(Flows)) {
                    var head = run.First;
                    var t = ParseTime(head.Timestamp);
                    var minute = Minute(head.Timestamp);
                    if (!Filtering && minute is not null && minute != shownMinute) {
                        shownMinute = minute;
                        <tr class="flow-minute">
                            <td colspan="4">@minute</td>
                        </tr>
                    }

                    var delta = prevTime is { } p && t is { } cur ? Gap(p, cur) : (TimeSpan?)null;
                    if (!run.Folded) {
                        if (t is not null) prevTime = t;
                        @Row(head, delta)
                        continue;
                    }

                    var open = IsOpen(run);
                    @RunRow(run, delta, open)
                    if (open) {
                        var inner = t;
                        for (var i = run.Start; i < run.Start + run.Count; i++) {
                            var flow = Flows[i];
                            var ft = ParseTime(flow.Timestamp);
                            var fd = inner is { } ip && ft is { } fc ? Gap(ip, fc) : (TimeSpan?)null;
                            if (ft is not null) inner = ft;
                            @Row(flow, fd, true)
                        }
                    }

                    if (ParseTime(run.Last.Timestamp) is { } last) prevTime = last;
                }
                </tbody>
            </table>
        }
    </div>
    @Foot
</section>

@code {
    [Parameter] public IReadOnlyList<DashboardFlow> Flows { get; set; } = [];
    [Parameter] public long? SelectedId { get; set; }
    [Parameter] public bool Connected { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public EventCallback<long> OnSelect { get; set; }
    [Parameter] public Func<DashboardFlow, bool>? CanSelect { get; set; }
    [Parameter] public RenderFragment? Tools { get; set; }
    [Parameter] public RenderFragment? Foot { get; set; }

    static readonly TimeSpan IdleGap = TimeSpan.FromSeconds(3);

    readonly HashSet<long> _openRuns = [];
    string _group = "";
    string _pathFilter = "";
    string _typeFilter = "";

    bool Filtering => !string.IsNullOrEmpty(_group) || !string.IsNullOrEmpty(_pathFilter) || !string.IsNullOrEmpty(_typeFilter);

    int ShownCount => Flows.Count(Matches);

    static TimeSpan? ParseTime(string? ts) =>
        TimeSpan.TryParseExact(ts, @"hh\:mm\:ss", CultureInfo.InvariantCulture, out var t) ? t : null;

    static string? Minute(string? ts) => ts is { Length: >= 5 } ? ts[..5] : null;

    static TimeSpan Gap(TimeSpan prev, TimeSpan current) {
        var gap = current - prev;
        return gap < TimeSpan.Zero ? gap + TimeSpan.FromDays(1) : gap;
    }

    static string FormatDelta(TimeSpan? gap) {
        return gap is { } g ? $"+{Durations.Format(g)}" : "";
    }

    ElementReference _listRef;
    Dom? _dom;
    int _lastFlowCount;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        var count = Flows.Count;
        if (count > _lastFlowCount && View.AutoScroll) {
            _dom ??= new Dom(JS);
            if (!await _dom.ScrollToAsync(_listRef, int.MaxValue)) Logger.LogDebug("flow list auto-scroll failed");
        }

        _lastFlowCount = count;
    }

    public ValueTask DisposeAsync() => _dom?.DisposeAsync() ?? ValueTask.CompletedTask;

    void OnGroupChange(ChangeEventArgs e) => _group = e.Value?.ToString() ?? "";

    void ClearFilters() {
        _group = "";
        _pathFilter = "";
        _typeFilter = "";
    }

    bool Matches(DashboardFlow flow) {
        var path = (flow.Path ?? "").ToLowerInvariant();
        if (!string.IsNullOrEmpty(_group) && (flow.Path ?? "").Split('/')[0] != _group) return false;
        if (!string.IsNullOrEmpty(_pathFilter) && !path.Contains(_pathFilter.ToLowerInvariant())) return false;
        if (!string.IsNullOrEmpty(_typeFilter)) {
            var t = ((flow.RequestType ?? "") + " " + (flow.ResponseType ?? "")).ToLowerInvariant();
            if (!t.Contains(_typeFilter.ToLowerInvariant())) return false;
        }

        return true;
    }

    bool IsOpen(FlowRun run) {
        if (_openRuns.Contains(run.Id)) return true;
        if (SelectedId is not { } sel) return false;
        for (var i = run.Start; i < run.Start + run.Count; i++)
            if (Flows[i].Id == sel) return true;
        return false;
    }

    void ToggleRun(FlowRun run) {
        if (!_openRuns.Remove(run.Id)) _openRuns.Add(run.Id);
    }

    RenderFragment RunRow(FlowRun run, TimeSpan? delta, bool open) => @<tr class="flow-row flow-run @(open ? "flow-run-open" : "") @(Matches(run.First) ? "" : "filtered-out")"
                                                                             @onclick="@(() => ToggleRun(run))">
                                                                            @{
                                                                                var idle = delta is { } d && d >= IdleGap;
                                                                                var ok = run.First.Status is >= 200 and < 300;
                                                                                var span = ParseTime(run.First.Timestamp) is { } a && ParseTime(run.Last.Timestamp) is { } b ? Gap(a, b) : (TimeSpan?)null;
                                                                            }
                                                                            <td class="fdelta @(idle ? "fdelta-idle" : "")">@FormatDelta(delta)</td>
                                                                            <td class="fpath">
                                                                                <span class="flow-run-head">
                                                                                    <Icon Name="@(open ? "chevron-down" : "chevron-right")" Class="icon-sm"/>
                                                                                    <span class="flow-run-path">@run.First.Path</span>
                                                                                    <span class="flow-run-count">x@(run.Count)</span>
                                                                                </span>
                                                                            </td>
                                                                            <td class="ftypes">
                                                                                <span class="@(run.First.RequestType is null ? "unknown" : "")">@(run.First.RequestType ?? "?")</span>
                                                                                <Icon Name="arrow-right" Class="icon-sm"/>
                                                                                <span class="@(run.First.ResponseType is null ? "unknown" : "")">@(run.First.ResponseType ?? "?")</span>
                                                                            </td>
                                                                            <td class="fstatus">
                                                                                <span class="fstatus-in">
                                                                                    @if (span is { } s) {
                                                                                        <span class="fknown">over @FormatDelta(s).TrimStart('+')</span>
                                                                                    }
                                                                                    <span class="fcode">
                                                                                        <Icon Name="@(ok ? "circle-check" : "circle-x")" Class="icon-sm"/>@run.First.Status
                                                                                    </span>
                                                                                </span>
                                                                            </td>
                                                                        </tr>;

    RenderFragment Row(DashboardFlow flow, TimeSpan? delta, bool inRun = false) => Selectable(flow)
        ? @<tr class="flow-row @(inRun ? "flow-run-in" : "") @(SelectedId == flow.Id ? "active" : "") @(Matches(flow) ? "" : "filtered-out")"
               @onclick="@(() => OnSelect.InvokeAsync(flow.Id))">
              @RowBody(flow, delta)
          </tr>
        : @<tr class="flow-row flow-row-locked @(inRun ? "flow-run-in" : "") @(Matches(flow) ? "" : "filtered-out")">
              @RowBody(flow, delta)
          </tr>;

    bool Selectable(DashboardFlow flow) => CanSelect is null || CanSelect(flow);

    RenderFragment RowBody(DashboardFlow flow, TimeSpan? delta) => @<text>
                                                                        @{
                                                                            var noReqBody = string.IsNullOrEmpty(flow.RequestDataB64);
                                                                            var outcome = View.CompareToKnown ? CaptureHelpers.Outcome(flow.Outcome) : null;
                                                                            var reqType = flow.RequestType ?? (noReqBody ? "none" : "?");
                                                                            var respType = flow.ResponseType ?? "?";
                                                                            var idle = delta is { } d && d >= IdleGap;
                                                                            var ok = flow.Status is >= 200 and < 300;
                                                                        }
                                                                        <td class="fdelta @(idle ? "fdelta-idle" : "")">@FormatDelta(delta)</td>
                                                                        <td class="fpath">@flow.Path</td>
                                                                        <td class="ftypes">
                                                                            <span class="@(flow.RequestType is null ? "unknown" : "")">@reqType</span>
                                                                            <Icon Name="arrow-right" Class="icon-sm"/>
                                                                            <span class="@(flow.ResponseType is null ? "unknown" : "")">@respType</span>
                                                                        </td>
                                                                        <td class="fstatus">
                                                                            <span class="fstatus-in">
                                                                                @if (!Selectable(flow)) {
                                                                                    <Icon Name="lock" Class="icon-sm"/>
                                                                                }
                                                                                @if (flow.Known || flow.Saved) {
                                                                                    <span class="fknown">@(flow.Saved ? "saved" : "known")</span>
                                                                                }
                                                                                @if (outcome is not null) {
                                                                                    @OutcomeTag(flow, outcome)
                                                                                }
                                                                                <span class="fcode">
                                                                                    <Icon Name="@(ok ? "circle-check" : "circle-x")" Class="icon-sm"/>@flow.Status
                                                                                </span>
                                                                            </span>
                                                                        </td>
                                                                    </text>;

    RenderFragment OutcomeTag(DashboardFlow flow, CaptureHelpers.OutcomeMeta meta) => @<span class="outcome-text" title="@meta.Desc">
                                                                                          <Icon Name="@meta.Icon" Class="icon-sm"/>
                                                                                          @if (CaptureHelpers.HasDiffCounts(flow.Outcome, flow.DiffAdded, flow.DiffRemoved)) {
                                                                                              @if (flow.DiffAdded > 0) {
                                                                                                  <span class="diff-add">@("+" + flow.DiffAdded)</span>
                                                                                              }

                                                                                              @if (flow.DiffRemoved > 0) {
                                                                                                  <span class="diff-del">@("-" + flow.DiffRemoved)</span>
                                                                                              }
                                                                                          } else {
                                                                                              @meta.Label
                                                                                          }
                                                                                      </span>;

}
