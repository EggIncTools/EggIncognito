@using System.Text.Json
@using EggIncognito.Capture
@using EggIncognito.Core
@* The detail pane: header (path + status), the known-endpoint card or save-as-endpoint bar + type
   lines, then the Request and Response panes carrying the body (CodeFormats), URL params, and optional headers. *@

@if (Flow is not null) {
    <div class="detail-head">
        <span class="dpath">@Flow.Path</span>
        <span class="dstatus status-badge @CaptureHelpers.StatusClass(Flow.Status)">@Flow.Status</span>
        @if (Tools is not null) {
            <span class="detail-head-tools">@Tools</span>
        }
    </div>

    @if (Flow.Known) {
        @KnownCard()
    } else {
        <div class="detail-types">
            @TypeLine("Request type", Flow.RequestType)
            @TypeLine("Response type", Flow.ResponseType)
        </div>
        <div class="save-bar">
            @if (Flow.Saved) {
                <span class="save-result ok">Saved as endpoint</span>
                <button class="btn-mini" type="button" @onclick="Save">Save again</button>
                <span class="save-result @_saveCls">@_saveMsg</span>
            } else {
                <button id="saveBtn" type="button" @onclick="Save">Save as endpoint</button>
                <span class="save-result @_saveCls">@_saveMsg</span>
            }
        </div>
    }

    <div class="detail-panes">
        <div class="detail-pane">
            <div class="detail-pane-title">Request</div>
            @RequestPane()
        </div>
        <div class="detail-pane">
            <div class="detail-pane-title">Response</div>
            @ResponsePane()
        </div>
    </div>
}

@code {
    [Parameter] public DashboardFlow? Flow { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public Func<HttpClient> ClientFactory { get; set; } = default!;
    [Parameter] public RenderFragment? Tools { get; set; }

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    readonly Dictionary<string, string> _formatChoice = new();
    string _saveMsg = "";
    string _saveCls = "";

    readonly CodeRevealState _reveal = new();

    long _renderedFlowId = -1;

    protected override void OnParametersSet() {
        if (Flow is not null && Flow.Id != _renderedFlowId) {
            _renderedFlowId = Flow.Id;
            _saveMsg = "";
            _saveCls = "";
            _reveal.Clear();
        }
    }

    void ToggleReveal(string key) => _reveal.Toggle(key);

    string RevealCls(string key) => _reveal.IsRevealed(key) ? "revealed" : "";

    async Task Save() {
        if (Flow is null) return;
        _saveCls = "muted";
        _saveMsg = "Saving...";
        StateHasChanged();
        try {
            var res = await ClientFactory().PostAsJsonAsync("/api/capture/save-endpoint", new { id = Flow.Id }, JsonOpts);
            var data = await res.Content.ReadFromJsonAsync<Models.Capture.SaveResult>(JsonOpts);
            if (res.IsSuccessStatusCode && data?.Saved is not null) {
                _saveCls = "ok";
                _saveMsg = "Saved " + data.Saved;
            } else {
                _saveCls = "err";
                _saveMsg = data?.Error ?? "Save failed";
            }
        }
        catch (Exception ex) {
            _saveCls = "err";
            _saveMsg = "Save failed: " + ex.Message;
        }
    }

    RenderFragment TypeLine(string label, string? value) => @<div class="detail-type-line">
                                                                <span class="detail-type-label">@(label + ": ")</span>
                                                                <span class="detail-type-val @(value is null ? "unknown" : "")">@(value ?? "unknown")</span>
                                                            </div>;

    RenderFragment KnownCard() => @<div class="known-card">
                                      <div class="known-card-title">Known endpoint</div>
                                      @KnownRow("Request type", Flow!.RequestType ?? "none", Flow!.RequestType is null)
                                      @KnownRow("Response type", Flow!.ResponseType ?? "none", Flow!.ResponseType is null)
                                      @{ var meta = View.CompareToKnown ? CaptureHelpers.Outcome(Flow!.Outcome) : null; }
                                      @if (meta is not null) {
                                          <div class="known-card-line">
                                              <span class="known-card-label">Comparison</span>
                                              <span class="known-card-val outcome-text outcome-@meta.Kind">
                                                  @if (CaptureHelpers.HasDiffCounts(Flow!.Outcome, Flow!.DiffAdded, Flow!.DiffRemoved)) {
                                                      <text>@(meta.Label + " (")@DiffCounts(Flow!.DiffAdded, Flow!.DiffRemoved)@(")")</text>
                                                  } else {
                                                      @meta.Label
                                                  }
                                              </span>
                                          </div>
                                          <div class="known-card-explain muted">@meta.Desc</div>
                                      }
                                  </div>;

    RenderFragment KnownRow(string label, string value, bool unknown) => @<div class="known-card-line">
                                                                             <span class="known-card-label">@label</span>
                                                                             <span class="known-card-val @(unknown ? "unknown" : "")">@value</span>
                                                                         </div>;

    RenderFragment DiffCounts(int added, int removed) => @<text>
                                                              @if (added > 0) {
                                                                  <span class="diff-add">@("+" + added)</span>
                                                              }
                                                              @if (removed > 0) {
                                                                  <span class="diff-del">@("-" + removed)</span>
                                                              }
                                                          </text>;

    RenderFragment RequestPane() => builder => {
        var f = Flow!;
        var seq = 0;
        if (View.ShowHeaders) {
            var sec = BuildHeaders("request", f.RequestHeaders, f.RequestHeadersRaw);
            if (sec is not null) builder.AddContent(seq++, sec);
        }

        var paramsSection = BuildParams(f);
        if (paramsSection is not null) builder.AddContent(seq++, paramsSection);

        builder.AddContent(seq, RequestBodySection(f));
    };

    RenderFragment RequestBodySection(DashboardFlow f) {
        var hasBody = !string.IsNullOrEmpty(f.RequestJson)
                      || !string.IsNullOrEmpty(f.RequestJsonRaw)
                      || !string.IsNullOrEmpty(f.RequestDataB64);
        return @<text>
                    @if (hasBody) {
                        <CodeFormats Key="Request" ShowLabel="false"
                                     Json="@View.PickJson(f.RequestJson, f.RequestJsonRaw)"
                                     RawBase64="@f.RequestDataB64"
                                     EmptyNote="@(!string.IsNullOrEmpty(f.RequestDataB64) ? "(no decoded JSON)" : "No request body")"
                                     View="View" Choice="_formatChoice" Reveal="_reveal"/>
                    } else {
                        <div class="empty-box">No request body</div>
                    }
                </text>;
    }

    RenderFragment ResponsePane() => builder => {
        var f = Flow!;
        var seq = 0;
        if (View.ShowHeaders) {
            var hdr = BuildHeaders("response", f.ResponseHeaders, f.ResponseHeadersRaw);
            if (hdr is not null) builder.AddContent(seq++, hdr);
        }

        if (f.ResponseText is not null) builder.AddContent(seq, TextResponseSection(f.ResponseText, f.ResponseIsAck));
        else if (f.ResponseIsAck) {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "no-json");
            builder.AddContent(seq, "Acknowledgement - this endpoint returns a short non-protobuf ack.");
            builder.CloseElement();
        } else if (ImageMime(f) is { } mime && !string.IsNullOrEmpty(f.ResponseB64)) builder.AddContent(seq, ImageResponseSection(mime, f.ResponseB64));
        else {
            builder.OpenComponent<CodeFormats>(seq++);
            builder.AddComponentParameter(seq++, nameof(CodeFormats.Key), "Response");
            builder.AddComponentParameter(seq++, nameof(CodeFormats.ShowLabel), false);
            builder.AddComponentParameter(seq++, nameof(CodeFormats.Json), View.PickJson(f.ResponseJson, f.ResponseJsonRaw));
            builder.AddComponentParameter(seq++, nameof(CodeFormats.RawBase64), f.ResponseB64);
            builder.AddComponentParameter(seq++, nameof(CodeFormats.View), View);
            builder.AddComponentParameter(seq++, nameof(CodeFormats.Choice), _formatChoice);
            builder.AddComponentParameter(seq, nameof(CodeFormats.Reveal), _reveal);
            builder.CloseComponent();
        }
    };

    RenderFragment TextResponseSection(string text, bool isAck) => @<div class="text-body">
                                                                       @if (isAck) {
                                                                           <div class="section-head">
                                                                               <span class="ack-tag">acknowledgement</span>
                                                                           </div>
                                                                       }
                                                                       <CodeSurface Text="@text" Language="text"/>
                                                                   </div>;

    static string? ImageMime(DashboardFlow f) {
        var b64 = f.ResponseB64;
        if (string.IsNullOrEmpty(b64)) return null;
        Span<byte> head = stackalloc byte[12];

        var prefix = b64.Length >= 16 ? b64[..16] : b64;
        int n;
        try {
            if (!Convert.TryFromBase64String(prefix.PadRight((prefix.Length + 3) / 4 * 4, '='), head, out n)) return null;
        }
        catch {
            return null;
        }

        var b = head[..n];
        if (b.Length >= 8 && b[0] == 0x89 && b[1] == 0x50 && b[2] == 0x4E && b[3] == 0x47) return "image/png";
        if (b.Length >= 3 && b[0] == 0xFF && b[1] == 0xD8 && b[2] == 0xFF) return "image/jpeg";
        if (b.Length >= 6 && b[0] == 0x47 && b[1] == 0x49 && b[2] == 0x46) return "image/gif";
        if (b.Length >= 12 && b[0] == 0x52 && b[1] == 0x49 && b[2] == 0x46 && b[3] == 0x46
            && b[8] == 0x57 && b[9] == 0x45 && b[10] == 0x42 && b[11] == 0x50) return "image/webp";
        return null;
    }

    RenderFragment ImageResponseSection(string mime, string b64) => builder => {
        var seq = 0;
        var bytes = (b64.Length * 3) / 4;
        builder.OpenElement(seq++, "div");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "image-preview");
        builder.OpenElement(seq++, "img");
        builder.AddAttribute(seq++, "src", $"data:{mime};base64,{b64}");
        builder.AddAttribute(seq++, "alt", "response image");
        builder.AddAttribute(seq++, "loading", "lazy");
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "muted image-meta");
        builder.AddContent(seq, $"{mime}, ~{ByteFormat.Humanize(bytes, "0.#")}");
        builder.CloseElement();

        builder.CloseElement();
    };

    RenderFragment? BuildParams(DashboardFlow flow) {
        var parsed = ParseFlowUrl(flow);
        if (parsed is null) return null;
        var (path, query, pathParams) = parsed.Value;
        if (pathParams.Count == 0 && query.Count == 0) return null;

        var generalPath = "/" + (flow.Path ?? "").TrimStart('/');
        var basePath = StripPathParams(path, pathParams);
        var showPath = !string.Equals(basePath, generalPath, StringComparison.Ordinal);
        return @<div>
                   <div class="section-head">
                       <h3>Query</h3>
                   </div>
                   <div class="params-box">
                       @if (showPath) {
                           @ParamRow("path", PathFragment(basePath))
                       }
                       @foreach (var p in pathParams) {
                           @ParamRow("query", ParamValueFragment(p))
                       }
                       @foreach (var (k, v) in query) {
                           @ParamRow(k, ParamValueFragment(v))
                       }
                   </div>
               </div>;
    }

    RenderFragment ParamRow(string label, RenderFragment value) => @<div class="param-row">
                                                                       <span class="param-label">@label</span>
                                                                       <span class="param-val">@value</span>
                                                                   </div>;

    RenderFragment PathFragment(string path) => @<text>
                                                     @foreach (var (text, blur) in View.RenderRedactedPath(path)) {
                                                         if (blur) {
                                                             var key = "path:" + text;
                                                             <span class="blurred @RevealCls(key)" @onclick="() => ToggleReveal(key)">@text</span>
                                                         } else {
                                                             @text
                                                         }
                                                     }
                                                 </text>;

    RenderFragment ParamValueFragment(string value) => @<text>
                                                            @{ var (text, blur) = View.RedactParamValue(value); }
                                                            @if (blur) {
                                                                var key = "param:" + text;
                                                                <span class="blurred @RevealCls(key)" @onclick="() => ToggleReveal(key)">@text</span>
                                                            } else {
                                                                @text
                                                            }
                                                        </text>;

    static string StripPathParams(string path, List<string> pathParams) {
        var result = path;
        for (var i = pathParams.Count - 1; i >= 0; i--) {
            var suffix = "/" + pathParams[i];
            if (result.EndsWith(suffix, StringComparison.Ordinal))
                result = result[..^suffix.Length];
        }

        return result.Length == 0 ? "/" : result;
    }

    (string Path, List<(string, string)> Query, List<string> PathParams)? ParseFlowUrl(DashboardFlow flow) {
        var raw = flow.Url ?? "";
        if (string.IsNullOrEmpty(raw)) return null;
        var pathAndQuery = raw;
        var schemeIdx = raw.IndexOf("://", StringComparison.Ordinal);
        if (schemeIdx >= 0) {
            var rest = raw[(schemeIdx + 3)..];
            var slash = rest.IndexOf('/');
            pathAndQuery = slash >= 0 ? rest[slash..] : "/";
        }

        var path = pathAndQuery;
        var query = new List<(string, string)>();
        var qIdx = pathAndQuery.IndexOf('?');
        if (qIdx >= 0) {
            path = pathAndQuery[..qIdx];
            var qs = pathAndQuery[(qIdx + 1)..];
            foreach (var pair in qs.Split('&')) {
                if (pair.Length == 0) continue;
                var eq = pair.IndexOf('=');
                var k = eq >= 0 ? pair[..eq] : pair;
                var v = eq >= 0 ? pair[(eq + 1)..] : "";
                try {
                    query.Add((Uri.UnescapeDataString(k), Uri.UnescapeDataString(v)));
                }
                catch {
                    query.Add((k, v));
                }
            }
        }

        var pathParams = new List<string>();
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var known = (flow.Path ?? "").Split('/', StringSplitOptions.RemoveEmptyEntries);
        IEnumerable<string> extra = [];
        if (known.Length > 0 && segments.Length > known.Length)
            extra = segments.Skip(known.Length);
        else {
            var last = segments.Length > 0 ? segments[^1] : null;
            if (last is not null && CaptureViewState.EidRe.IsMatch(last)) extra = [last];
        }

        pathParams.AddRange(extra);

        return (path, query, pathParams);
    }

    RenderFragment? BuildHeaders(string keyPrefix, IReadOnlyList<DashboardHeader>? redacted, IReadOnlyList<DashboardHeader>? raw) {
        var headers = View.IsBlurMode || View.ShowRawHeaders ? raw ?? redacted ?? [] : redacted ?? [];
        if (headers.Count == 0) return null;

        return @<div class="headers-box">
                   @foreach (var h in headers) {
                       var blur = View.IsBlurMode && h.Sensitive;
                       var key = "hdr:" + keyPrefix + ":" + h.Name + ":" + h.Value;
                       <span class="h-name">@h.Name</span>
                       @if (blur) {
                           <span class="h-val blurred @RevealCls(key)"
                                 @onclick="() => ToggleReveal(key)">
                               @h.Value
                           </span>
                       } else {
                           <span class="h-val">@h.Value</span>
                       }
                   }
               </div>;
    }

}
