@rendermode @(RenderModes.InteractiveServer)
@implements IAsyncDisposable
@using System.Net
@using System.Text.Json
@using System.Text.Json.Nodes
@using EggIncognito.Components.Inspector
@using EggIncognito.Core
@using EggIncognito.Models.Data
@using EggIncognito.Models.Inspector
@using EggIncognito.Services.Api
@using EggIncognito.Services.Inspector
@using EggIncognito.Services.Routes
@inherits SelfCallComponentBase
@inject IRouteCatalog Catalog
@inject IRouteCatalogReport RouteReport
@inject IProtoReflection Reflection
@inject IAppMode AppMode
@inject ICurrentUser User
@inject ISealedProxy SealedProxy
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ApiWorkbenchState State
@inject ToastService Toasts
@inject ILogger<ApiWorkbenchModal> Logger

<WorkbenchModal Open="_open" Title="@("API & Data")" TitleId="apiWorkbenchTitle" Size="WorkbenchSize.Wide"
                CardClass="awb-card" OnClose="CloseAsync">
    <HeadTools>
        <WorkbenchModes Modes="State.Modes" Current="@State.Mode" CurrentChanged="SetMode" Disabled="ModeDisabled"
                        Label="Workbench mode"/>
    </HeadTools>
    <Rail>
        @if (State.Mode == ApiWorkbenchState.ModeDocs) {
            <WorkbenchRail HasFilter="true" Filter="@State.DocsFilter" FilterChanged="OnDocsFilter"
                           FilterLabel="Filter documentation">
                <DocsRail Filter="@State.DocsFilter" OnSelectSubject="SelectDocsSubject"/>
            </WorkbenchRail>
        } else if (State.Mode == ApiWorkbenchState.ModeApis) {
            <WorkbenchRail Class="wb-rail-popout" HasFilter="true" Filter="@State.RailFilter" FilterChanged="OnRailFilter"
                           FilterLabel="Filter endpoints">
                <InspectorRail Filter="@State.RailFilter" OnSelectEndpoint="SelectEndpointFromRail"
                               OnOpenSalt="OpenSalt"
                               ShowRouteCatalog="State.IsContributor" RouteCatalogSelected="@(State.Kind == ApiSelectionKind.Routes)"
                               OnOpenRouteCatalog="@(() => SelectSection(ApiSelectionKind.Routes))" RouteSummary="_routeSummary"
                               OnRestoreHistory="RestoreHistory" OnDeleteHistory="DeleteHistory"
                               OnClearHistory="ClearHistory"/>
            </WorkbenchRail>
        } else if (State.Mode == ApiWorkbenchState.ModeData) {
            <WorkbenchRail>
                @if (User.IsAuthenticated) {
                    <div class="awb-tools">
                        <button type="button" class="btn-mini" @onclick="@(() => State.KeysOpen = true)">
                            <Icon Name="key" Class="icon-sm"/> API keys
                        </button>
                    </div>
                }
                <WorkbenchLoad T="DataSourceRow" Items="@State.Sources" EmptyText="No data sources on this instance."
                               Context="sources">
                    @foreach (var group in DataGroups(sources)) {
                        <WorkbenchSection Label="@DataGroupLabel(group)">
                            @foreach (var root in DataRootsOf(sources, group)) {
                                <WorkbenchEntry @key="root.Url"
                                                Selected="@(State.Kind == ApiSelectionKind.Dataset && State.Sub is null && State.Group == root.Group && State.Id == root.Id)"
                                                OnClick="@(_ => SelectDataset(root, null))"
                                                Trail="@RowTrail(root)" MetaLine="@RowMeta(root)">
                                    <Name>@root.DisplayName</Name>
                                </WorkbenchEntry>
                                @if (root.Children is { Count: > 0 } children) {
                                    <div class="ds-children">
                                        @foreach (var child in children) {
                                            <WorkbenchEntry @key="child.Url"
                                                            Selected="@(State.Kind == ApiSelectionKind.Dataset && State.Sub == child.Id && State.Group == root.Group && State.Id == root.Id)"
                                                            OnClick="@(_ => SelectDataset(root, child))"
                                                            Trail="@RowTrail(child)" MetaLine="@RowMeta(child)">
                                                <Name>@child.DisplayName</Name>
                                            </WorkbenchEntry>
                                        }
                                    </div>
                                }
                            }
                        </WorkbenchSection>
                    }
                </WorkbenchLoad>
            </WorkbenchRail>
        }
    </Rail>
    <ChildContent>
        @switch (State.Kind) {
            case ApiSelectionKind.Docs:
                <DocsPane Subject="@State.Docs" OnSelectSubject="SelectDocsSubject"/>
                break;
            case ApiSelectionKind.Dataset:
                <DatasetPane Current="@State.CurrentDataset()"/>
                break;
            case ApiSelectionKind.Routes:
                <RouteCatalogPane OnChanged="ReloadRouteSummary"/>
                break;
            case ApiSelectionKind.Capture:
                <CapturePane/>
                break;
            default:
                <div class="awb-try">
                    <section class="panel insp-compose">
                        <div class="insp-compose-body">
                            <EnvironmentPanel Rows="State.EnvRows" OnChanged="OnEnvChanged"
                                              OnValidate="ValidateEnv" OnForceSave="ForceSaveEnv"/>
                            <PathParamRow Show="@(State.Selected?.PathParam == true)" Value="@State.PathParam"
                                          ValueChanged="OnPathParamChanged" RecentEids="State.RecentEids" OnForget="ForgetEids"/>
                            <RequestBodyEditor Route="State.Selected" Nodes="State.FieldNodes" Hosted="State.Hosted"
                                               RawMode="State.RawMode" RawModeChanged="ToggleRaw"
                                               RawJson="@State.RawJson" RawJsonChanged="OnRawJsonChanged"
                                               RawError="@State.RawError" OnTreeChanged="OnTreeChanged"/>
                        </div>

                        <div class="insp-compose-foot">
                            <SendBar Target="State.Target" TargetChanged="RequestTarget"
                                     CanBuild="State.CanBuild" CanSend="State.CanSend"
                                     LiveDisabled="State.LiveDisabled" SealedAvailable="State.SealedAvailable"
                                     Sealed="State.Sealed" SealedChanged="@(v => State.Sealed = v)"
                                     CustomTarget="@State.CustomTarget" CustomTargetChanged="OnCustomTargetChanged"
                                     OnBuild="Build" OnSend="Send"/>
                        </div>
                    </section>

                    <section class="panel insp-reader">
                        <div class="insp-reader-head">
                            @{ var sel = State.Selected; }
                            @if (sel is not null) {
                                <div class="insp-reader-subject">
                                    <span class="insp-route">@sel.Path</span>
                                    <RouteTypes Route="sel" OnSelectType="SelectMessageDocs"/>
                                </div>
                            } else {
                                <span class="text-xs text-muted">Pick an endpoint to see its transaction here.</span>
                            }
                            <button type="button" class="btn-mini insp-docs-btn" disabled="@(State.Selected is null)"
                                    @onclick="@(() => SelectDocsSubject(new DocSubjectRef(DocSubjectKind.Endpoint, State.Selected!.Path)))">
                                <Icon Name="scroll-text" Class="icon-sm"/> Docs
                            </button>
                        </div>
                        <div class="insp-reader-body">
                            <TransactionView Build="State.BuildStages" Response="State.Response" Diagnosis="State.Diagnosis"
                                             RootType="@State.Selected?.Response" IsAdmin="State.IsAdmin"
                                             FixBusy="_fixWrappedBusy" OnFixWrapped="FixWrapped" ClientFactory="Client"
                                             CanSaveDb="State.CanSaveDb" OnSaveToDb="SaveToDb"/>
                        </div>
                    </section>
                </div>
                break;
        }
    </ChildContent>
</WorkbenchModal>

<SaltDialog Open="_saltOpen" OnSave="SaveSalt" OnClose="@(() => _saltOpen = false)"/>
<LiveConsentDialog Open="_liveConsentOpen" OnAccept="AcceptLiveConsent" OnClose="@(() => _liveConsentOpen = false)"/>
<ApiKeysModal Open="State.KeysOpen" OnClose="@(() => State.KeysOpen = false)"/>

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    readonly Dictionary<string, SchemaMessage?> _schemaCache = new();

    bool _open;
    bool _storeLoaded;
    bool _hashWired;
    bool _saltOpen;
    bool _liveConsentOpen;
    bool _fixWrappedBusy;
    RouteCatalogSummary? _routeSummary;

    IJSObjectReference? _store;
    IJSObjectReference? _nav;
    IJSObjectReference? _navHandle;
    DotNetObjectReference<ApiWorkbenchModal>? _selfRef;

    protected override void OnInitialized() {
        base.OnInitialized();

        State.Hosted = AppMode.Mode == Services.AppMode.Hosted;
        State.LiveDisabled = State.Hosted && !User.IsAuthenticated;
        State.CanSaveDb = AppMode.Mode != Services.AppMode.Hosted || User.IsAtLeast(UserRole.Contributor);
        State.IsAdmin = User.IsAtLeast(UserRole.Admin);
        State.IsContributor = User.IsAtLeast(UserRole.Contributor);
        State.SealedAvailable = SealedProxy.IsConfigured && User.IsSupporter;
        State.Target = InspectorTarget.Mock;
        State.Sealed = false;
        State.SeedEnvRows();
        State.DocsRequested += OnDocsRequested;
    }

    void OnDocsRequested(DocSubjectRef subject) {
        _ = InvokeAsync(async () => {
            await SelectDocsSubject(subject);
            StateHasChanged();
        });
    }

    Task SelectMessageDocs(string name) {
        return SelectDocsSubject(new DocSubjectRef(DocSubjectKind.Message, name));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        try {
            _nav = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/hashnav.js"));
            _selfRef = DotNetObjectReference.Create(this);
            _navHandle = await _nav.InvokeAsync<IJSObjectReference>("listen", _selfRef);
            _hashWired = true;
            await ApplyHash(await _nav.InvokeAsync<string>("read"));
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "hash navigation could not be wired");
        }

        StateHasChanged();
    }

    async Task LoadStore() {
        if (_storeLoaded) return;
        _storeLoaded = true;
        try {
            _store = await JS.InvokeAsync<IJSObjectReference>(
                "import", InteropAsset.Url(Env, "./interop/inspectorStore.js"));
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "the inspector browser store could not be loaded");
            State.Notice = "Browser storage is unavailable, so salt, history and remembered EIDs are off for this session.";
        }

        State.Rinfo = (await ServerSeed()).OverlaidWith(await InvokeOr<RinfoSeed?>("getRinfoDefaults", null));
        State.HasSalt = !string.IsNullOrEmpty(await InvokeOr("getSalt", ""));
        State.CustomTarget = await InvokeOr("getCustomTarget", "");
        State.RecentEids = await InvokeOr("recentEids", Array.Empty<string>());
        State.History = await InvokeOr("getHistory", new List<InspectorHistoryEntry>());
        State.SeedEnvRows();
    }

    public async Task Open() {
        await LoadStore();
        _open = true;
        await LoadSources();
        LoadRouteSummary();
        await WriteHash(true);
        StateHasChanged();
    }

    public async Task OpenCapture() {
        await LoadStore();
        _open = true;
        await LoadSources();
        LoadRouteSummary();
        State.Kind = ApiSelectionKind.Capture;
        await WriteHash(true);
        StateHasChanged();
    }

    async Task CloseAsync() {
        _open = false;
        await WriteHash(true, true);
        StateHasChanged();
    }

    async Task LoadSources() {
        if (State.Sources is not null) return;
        var index = await Client().OneAsync<DataIndex>("/api/v1/data", Logger);
        State.Sources = index?.Sources ?? [];
        if (State.Sources.Count == 0) Toasts.Push(StatusNoteKind.Error, "The source catalog could not be read.");
    }

    void LoadRouteSummary() {
        if (_routeSummary is not null || !State.IsContributor) return;
        _routeSummary = RouteReport.Summary();
    }

    void ReloadRouteSummary() {
        _routeSummary = null;
        LoadRouteSummary();
        StateHasChanged();
    }

    void OnRailFilter(string value) {
        State.RailFilter = value;
    }

    async Task SelectDataset(DataSourceRow root, DataSourceRow? child) {
        State.SelectDataset(root.Group, root.Id, child?.Id);
        await WriteHash();
    }

    async Task SelectSection(ApiSelectionKind kind) {
        State.Kind = kind;
        await WriteHash();
    }

    async Task SelectDocsSubject(DocSubjectRef subject) {
        State.Docs = subject;
        State.Kind = ApiSelectionKind.Docs;
        await WriteHash(true);
    }

    void OnDocsFilter(string value) {
        State.DocsFilter = value;
    }

    bool ModeDisabled(string key) {
        return key == ApiWorkbenchState.ModeData && (State.Sources?.Count ?? 0) == 0;
    }

    async Task SetMode(string key) {
        var mode = State.NormalizeMode(key);
        if (mode == State.Mode || ModeDisabled(mode)) return;
        State.RememberSelection();
        if (!State.RestoreSelection(mode)) ApplyModeDefault(mode);
        await WriteHash();
    }

    void ApplyModeDefault(string mode) {
        if (mode == ApiWorkbenchState.ModeCapture) {
            State.Kind = ApiSelectionKind.Capture;
            return;
        }

        if (mode == ApiWorkbenchState.ModeDocs) {
            State.Kind = ApiSelectionKind.Docs;
            return;
        }

        if (mode != ApiWorkbenchState.ModeData) {
            State.Kind = ApiSelectionKind.Endpoint;
            return;
        }

        if (State.Sources?.FirstOrDefault() is not { } first) return;
        State.SelectDataset(first.Group, first.Id, null);
    }

    static IEnumerable<string> DataGroups(IReadOnlyCollection<DataSourceRow> sources) {
        return sources.Select(s => s.Group).Distinct(StringComparer.Ordinal);
    }

    static string DataGroupLabel(string key) {
        return key switch {
            "periodical" => "Periodical",
            "gamedata" => "Game data",
            "asset" => "Assets",
            _ => TitleCase(key)
        };
    }

    static List<DataSourceRow> DataRootsOf(IReadOnlyCollection<DataSourceRow> sources, string group) {
        return [.. sources.Where(s => string.Equals(s.Group, group, StringComparison.Ordinal))];
    }

    static RenderFragment? RowMeta(DataSourceRow r) {
        if (r.Bytes is not { } bytes) return null;
        return b => b.AddContent(0, ByteFormat.Compact(bytes));
    }

    static bool NeedsKey(DataSourceRow r) {
        return string.Equals(r.Access, "Authenticated", StringComparison.Ordinal);
    }

    static RenderFragment RowTrail(DataSourceRow r) {
        return @<span class="ds-trail">
                   <span title="@(NeedsKey(r) ? "API key" : "Public")">
                       <Icon Name="@(NeedsKey(r) ? "key" : "globe")" Class="icon-sm"/>
                   </span>
                   @if (NeedsKey(r)) {
                       <span title="Requires an API key">
                           <Icon Name="lock" Class="icon-sm"/>
                       </span>
                   }
                   @if (r.AcceptsName) {
                       <span title="Takes a name in the URL, no raw GET">
                           <Icon Name="link" Class="icon-sm"/>
                       </span>
                   }
               </span>;
    }

    static string TitleCase(string raw) {
        var words = raw.Split([' ', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return words.Length == 0
            ? raw
            : string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant()));
    }

    async Task<RinfoSeed> ServerSeed() {
        return await Client().OneAsync<RinfoSeed>("/api/inspector/rinfo-seed", Logger) ?? new RinfoSeed();
    }

    async Task<T> InvokeOr<T>(string fn, T fallback, params object?[] args) {
        if (_store is null) return fallback;
        try {
            return await _store.InvokeAsync<T>(fn, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "inspector store call {Function} failed", fn);
            return fallback;
        }
    }

    async Task InvokeVoid(string fn, params object?[] args) {
        if (_store is null) return;
        try {
            await _store.InvokeVoidAsync(fn, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "inspector store call {Function} failed", fn);
        }
    }

    async Task SelectEndpointFromRail(RouteInfo e) {
        await SelectEndpoint(e);
        await WriteHash(true);
    }

    async Task SelectEndpoint(RouteInfo e) {
        State.Kind = ApiSelectionKind.Endpoint;
        State.Selected = e;
        State.Notice = null;
        State.ClearTransaction();
        State.RawMode = false;
        State.RawJson = "{}";
        State.RawError = null;
        State.PathParam = "";
        if (e.PathParam) {
            var last = State.RecentEids.FirstOrDefault() ?? "";
            if (last.Length > 0) State.PathParam = last;
        }

        await BuildFieldTree();
    }

    SchemaMessage? Schema(string? typeName) {
        if (string.IsNullOrEmpty(typeName)) return null;
        if (!_schemaCache.TryGetValue(typeName, out var s)) {
            s = Reflection.Schema(typeName);
            _schemaCache[typeName] = s;
        }

        return s;
    }

    Task BuildFieldTree() {
        State.FieldNodes = null;
        var e = State.Selected;
        if (e is null || e.PathParamOnly || e.Request is null) return Task.CompletedTask;
        var s = Schema(e.Request);
        if (s is null) return Task.CompletedTask;
        State.FieldNodes = FieldTreeBuilder.Build(s, t => Schema(t));
        State.ApplyEnvLock();
        return Task.CompletedTask;
    }

    async Task OnEnvChanged(EnvRow row) {
        State.SyncRinfoFromRow(row);
        State.ApplyEnvLock();
        State.EnvValidated = false;
        State.EnvError = null;
        await InvokeVoid("setRinfoDefaults", State.Rinfo);
    }

    async Task ValidateEnv() {
        if (State.EnvValidating) return;
        State.EnvValidating = true;
        State.EnvError = null;
        try {
            var bad = State.EnvRows.Where(r => r.IsInvalid()).Select(r => r.Key).ToList();
            if (bad.Count > 0) {
                State.EnvValidated = false;
                State.EnvError = "These values do not fit their fields: " + string.Join(", ", bad);
                return;
            }

            var fields = EnvCollector.Collect(State.EnvRows.Where(r => !string.IsNullOrWhiteSpace(r.Value)));
            var res = await Client().PostAsJsonAsync("/api/inspector/build", new {
                path = "",
                requestType = "BasicRequestInfo",
                wrap = false,
                fields,
                env = (object?)null,
                salt = (string?)null
            }, JsonOpts);
            var data = await res.Content.ReadFromJsonAsync<BuildResponse>(JsonOpts);
            if (data?.Error is not null) {
                State.EnvValidated = false;
                State.EnvError = data.Error;
                return;
            }

            State.EnvValidated = true;
            State.EnvOpen = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            State.EnvValidated = false;
            State.EnvError = "validation failed: " + ex.Message;
        }
        finally {
            State.EnvValidating = false;
        }
    }

    void ForceSaveEnv() {
        State.EnvValidated = false;
        State.EnvError = null;
        State.EnvOpen = false;
    }

    void OnPathParamChanged(string value) {
        State.PathParam = value;
    }

    void OnRawJsonChanged(string value) {
        State.RawJson = value;
    }

    void OnCustomTargetChanged(string value) {
        State.CustomTarget = value;
        _ = InvokeVoid("setCustomTarget", value);
    }

    void OnTreeChanged() {
        State.RawError = null;
    }

    void ToggleRaw(bool on) {
        if (on) {
            State.RawError = null;
            State.RawMode = true;
            if (State.FieldNodes is not null) {
                State.RawJson = FieldTreeBuilder.Collect(State.FieldNodes)
                    .ToJsonString(new JsonSerializerOptions { WriteIndented = true });
            }

            return;
        }

        if (State.FieldNodes is not null) {
            try {
                var obj = JsonNode.Parse(string.IsNullOrWhiteSpace(State.RawJson) ? "{}" : State.RawJson) as JsonObject
                          ?? throw new FormatException("raw body must be a JSON object");
                FieldTreeBuilder.Apply(State.FieldNodes, obj);
                State.ApplyEnvLock();
            }
            catch (Exception ex) when (ex is JsonException or FormatException) {
                State.RawError = "Raw JSON does not parse, so it was not applied to the tree. Fix it or switch back: " + ex.Message;
                State.RawMode = true;
                return;
            }
        }

        State.RawError = null;
        State.RawMode = false;
    }

    void OpenSalt() {
        _saltOpen = true;
    }

    async Task SaveSalt(string salt) {
        await InvokeVoid("setSalt", salt);
        State.HasSalt = !string.IsNullOrEmpty(salt);
        _saltOpen = false;
    }

    async Task RequestTarget(InspectorTarget target) {
        if (target == InspectorTarget.Mock) {
            State.Target = target;
            return;
        }

        if (State.LiveDisabled) return;
        if (!await InvokeOr("getLiveConsent", false)) {
            _liveConsentOpen = true;
            return;
        }

        State.Target = target;
    }

    async Task AcceptLiveConsent() {
        await InvokeVoid("setLiveConsent");
        _liveConsentOpen = false;
        State.Target = InspectorTarget.LiveViaServer;
    }

    async Task Build() {
        if (State.Busy) return;
        State.Busy = true;
        try {
            await BuildCore();
        }
        finally {
            State.Busy = false;
        }
    }

    async Task Send() {
        if (State.Busy) return;
        State.Busy = true;
        try {
            await SendCore();
        }
        finally {
            State.Busy = false;
        }
    }

    async Task BuildCore() {
        var e = State.Selected;
        if (e is null) return;
        State.Response = null;
        State.Diagnosis = null;

        if (e.PathParamOnly) {
            State.LastBuild = new BuildResponse(null, "", "", false, null, null, null);
            State.BuildStages = null;
            return;
        }

        if (e.Request is null) {
            State.BuildStages = null;
            State.Response = new SendResponse(null, null, null, null,
                "no request type for this endpoint",
                State.Hosted
                    ? "An admin needs to map a `request:` type for this route before it can be built."
                    : "Add a `request:` type in routes.yaml before building.");
            return;
        }

        JsonNode? fields;
        try {
            fields = State.RawMode
                ? JsonNode.Parse(string.IsNullOrWhiteSpace(State.RawJson) ? "{}" : State.RawJson)
                : FieldTreeBuilder.Collect(State.FieldNodes ?? []);
        }
        catch (JsonException ex) {
            State.Response = new SendResponse(null, null, null, null, "invalid raw JSON: " + ex.Message, null);
            return;
        }

        var salt = await InvokeOr<string?>("getSalt", null);

        var body = new {
            path = e.Path,
            requestType = e.Request,
            wrap = e.RequestWrapped,
            fields,
            env = EnvCollector.Collect(State.EnvRows),
            salt
        };

        try {
            var res = await Client().PostAsJsonAsync("/api/inspector/build", body, JsonOpts);
            var data = await res.Content.ReadFromJsonAsync<BuildResponse>(JsonOpts);
            if (data?.Error is not null) {
                State.BuildStages = null;
                State.Response = new SendResponse(null, null, null, null, data.Error, data.Resolution);
                State.LastBuild = null;
                return;
            }

            State.LastBuild = data;
            State.BuildStages = data?.Stages;
            await SaveToHistory(e, fields);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            State.Response = new SendResponse(null, null, null, null, "build failed: " + ex.Message, null);
        }
    }

    async Task SaveToHistory(RouteInfo e, JsonNode? fields) {
        if (_store is null) return;
        var entry = new InspectorHistoryEntry(
            Guid.NewGuid().ToString("n"),
            e.Path,
            HistorySummary(e),
            EnvCollector.AsStrings(State.EnvRows),
            fields?.ToJsonString() ?? "{}",
            string.IsNullOrWhiteSpace(State.PathParam) ? null : State.PathParam.Trim(),
            State.Target,
            0);
        State.History = await InvokeOr("saveHistory", State.History, entry);
    }

    string HistorySummary(RouteInfo e) {
        var bits = new List<string>();
        if (e.PathParam && !string.IsNullOrWhiteSpace(State.PathParam)) bits.Add(State.PathParam.Trim());
        bits.Add(InspectorTargets.Label(State.Target));
        return string.Join(" / ", bits);
    }

    async Task RestoreHistory(InspectorHistoryEntry h) {
        var route = Catalog.All().FirstOrDefault(r => r.Path == h.Path);
        if (route is null) {
            State.Notice = $"The saved request points at {h.Path}, which this build no longer serves.";
            return;
        }

        await SelectEndpoint(route);

        foreach (var row in State.EnvRows) {
            if (h.Env.TryGetValue(row.Key, out var v)) {
                row.Value = v;
                State.SyncRinfoFromRow(row);
            }
        }

        if (!string.IsNullOrEmpty(h.PathParam)) State.PathParam = h.PathParam;

        if (State.FieldNodes is not null) {
            try {
                if (JsonNode.Parse(string.IsNullOrWhiteSpace(h.FieldsJson) ? "{}" : h.FieldsJson) is JsonObject obj)
                    FieldTreeBuilder.Apply(State.FieldNodes, obj);
            }
            catch (JsonException ex) {
                Logger.LogDebug(ex, "a saved request body did not parse; keeping the freshly seeded tree");
            }
        }

        State.ApplyEnvLock();
        await WriteHash(true);
    }

    async Task DeleteHistory(string id) {
        State.History = await InvokeOr("deleteHistory", State.History, id);
    }

    async Task ClearHistory() {
        State.History = await InvokeOr("clearHistory", new List<InspectorHistoryEntry>());
    }

    async Task SendCore() {
        var e = State.Selected;
        if (State.LastBuild is null || e is null) return;

        if (State.Target == InspectorTarget.LiveViaProxy) {
            await SendCustom(e);
            return;
        }

        var param = State.PathParam.Trim();
        if (e.PathParam && param.Length == 0) {
            State.Response = new SendResponse(null, null, null, null,
                "URL path parameter is required for this endpoint",
                "Enter the EID (or other path value) in the field above the Build button.");
            return;
        }

        var mockUrl = State.Target == InspectorTarget.Mock ? MockUrl(e, param) : null;

        await RememberEnteredEids();
        try {
            var res = await Client().PostAsJsonAsync("/api/inspector/send",
                new {
                    url = mockUrl,
                    path = mockUrl is null ? e.Path : null,
                    pathParam = mockUrl is null ? param : null,
                    formBody = State.LastBuild.FinalFormBody,
                    responseType = e.Response,
                    responseWrapped = e.ResponseWrapped,
                    @sealed = State.Target == InspectorTarget.LiveViaServer && State.Sealed
                }, JsonOpts);
            State.Response = await res.Content.ReadFromJsonAsync<SendResponse>(JsonOpts);
            await MaybeDiagnose();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            State.Response = new SendResponse(null, null, null, null, "send failed: " + ex.Message, null);
        }
    }

    string MockUrl(RouteInfo e, string param) {
        var url = $"{SelfBaseAddress}/{e.Path}";
        return param.Length == 0 ? url : url + "/" + Uri.EscapeDataString(param);
    }

    async Task MaybeDiagnose() {
        State.Diagnosis = null;
        if (State.Response?.Error is null || string.IsNullOrEmpty(State.Response.RawBase64)) return;
        try {
            var res = await Client().PostAsJsonAsync("/api/tools/diagnose",
                new { Base64 = State.Response.RawBase64, RootType = State.Selected?.Response }, JsonOpts);
            State.Diagnosis = await res.Content.ReadFromJsonAsync<DiagnoseDto>(JsonOpts);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Logger.LogDebug(ex, "the failed decode could not be diagnosed");
        }
    }

    async Task FixWrapped() {
        var e = State.Selected;
        if (e is null || State.Response is null) return;

        _fixWrappedBusy = true;
        try {
            if (RouteReport.Rows().FirstOrDefault(r => r.Path == e.Path) is not { } row) {
                State.Response = State.Response with { Error = $"failed to set responseWrapped: no catalog row for {e.Path}" };
                return;
            }

            var res = await Client().PutAsJsonAsync($"/api/admin/routes/{e.Path}",
                row.Draft() with { ResponseWrapped = true }, JsonOpts);
            if (!res.IsSuccessStatusCode) {
                State.Response = State.Response with { Error = $"failed to set responseWrapped: HTTP {(int)res.StatusCode}" };
                return;
            }

            var fresh = Catalog.Resolve(e.Path) ?? e;
            State.Selected = fresh;
            await RedecodeAfterFix(fresh);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            State.Response = State.Response with { Error = "failed to set responseWrapped: " + ex.Message };
        }
        finally {
            _fixWrappedBusy = false;
        }
    }

    async Task RedecodeAfterFix(RouteInfo e) {
        if (State.Response?.RawBase64 is null) return;
        try {
            var res = await Client().PostAsJsonAsync("/api/inspector/decode-response",
                new { rawBase64 = State.Response.RawBase64, responseType = e.Response, responseWrapped = (bool?)null }, JsonOpts);
            var dec = await res.Content.ReadFromJsonAsync<SendResponse>(JsonOpts);
            State.Response = State.Response with {
                Stages = dec?.Stages,
                Json = dec?.Json,
                Error = dec?.Error,
                WrappedMismatch = dec?.WrappedMismatch ?? false
            };
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            State.Response = State.Response with { Error = "redecode failed: " + ex.Message };
        }
    }

    async Task SendCustom(RouteInfo e) {
        if (string.IsNullOrEmpty(State.CustomTarget)) {
            State.Response = new SendResponse(null, null, null, null,
                "no custom proxy URL set", "Set your Custom proxy URL above first.");
            return;
        }

        var proxyUrl = State.CustomTarget.TrimEnd('/') + "/" + e.Path;
        if (e.PathParam) {
            var param = State.PathParam.Trim();
            if (param.Length == 0) {
                State.Response = new SendResponse(null, null, null, null,
                    "URL path parameter is required", "Enter the EID above Build.");
                return;
            }

            proxyUrl += "/" + Uri.EscapeDataString(param);
        }

        await RememberEnteredEids();

        if (_store is null) {
            State.Response = new SendResponse(null, null, null, null,
                "custom send needs the browser interop", "Reload the page and try again.");
            return;
        }

        string raw;
        try {
            raw = await _store.InvokeAsync<string>("postForm", proxyUrl, State.LastBuild!.FinalFormBody);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            State.Response = new SendResponse(null, null, null, null,
                $"direct request to your proxy failed: {ex.Message}",
                "Your proxy must be reachable from this browser and allow this origin (CORS).");
            return;
        }

        try {
            var res = await Client().PostAsJsonAsync("/api/inspector/decode-response",
                new { rawBase64 = raw, responseType = e.Response, responseWrapped = e.ResponseWrapped }, JsonOpts);
            var dec = await res.Content.ReadFromJsonAsync<SendResponse>(JsonOpts);
            State.Response = new SendResponse(200, raw, dec?.Stages, dec?.Json, dec?.Error, null, dec?.WrappedMismatch ?? false);
            await MaybeDiagnose();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            State.Response = new SendResponse(null, null, null, null, "decode failed: " + ex.Message, null);
        }
    }

    async Task RememberEnteredEids() {
        var candidates = new List<string?> { State.PathParam };
        candidates.AddRange(State.EnvRows.Select(r => r.Value));
        var present = candidates.Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!).ToArray();
        if (present.Length == 0) return;

        State.RecentEids = await InvokeOr("rememberEids", State.RecentEids, new object?[] { present });
    }

    async Task ForgetEids() {
        State.RecentEids = await InvokeOr("forgetEids", Array.Empty<string>());
        State.PathParam = "";
    }

    async Task SaveToDb() {
        var e = State.Selected;
        if (e is null || State.Response?.Json is null) {
            Toasts.Push(StatusNoteKind.Error, "Build and send a request first.");
            return;
        }

        try {
            using var doc = JsonDocument.Parse(State.Response.Json);
            var res = await Client().PostAsJsonAsync("/api/db/endpoint", new {
                path = e.Path,
                eid = string.IsNullOrWhiteSpace(State.PathParam) ? null : State.PathParam,
                responseJson = doc.RootElement,
                responseType = e.Response
            }, JsonOpts);
            if (res.IsSuccessStatusCode) {
                Toasts.Push(StatusNoteKind.Ok, $"Saved {e.Path}{(string.IsNullOrWhiteSpace(State.PathParam) ? "" : $" ({State.PathParam})")} to the shared DB.");
                return;
            }

            Toasts.Push(StatusNoteKind.Error, res.StatusCode == HttpStatusCode.Forbidden
                ? "Not authorized to write to the shared DB."
                : $"Save failed: HTTP {(int)res.StatusCode}");
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Toasts.Push(StatusNoteKind.Error, $"Request failed: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnHashChanged(string hash) {
        await ApplyHash(hash);
        StateHasChanged();
    }

    async Task ApplyHash(string hash) {
        if (!State.ApplyHash(hash)) {
            if (_open) {
                _open = false;
                StateHasChanged();
            }

            return;
        }

        _open = true;
        await LoadStore();
        await LoadSources();
        LoadRouteSummary();
        await ResolvePending();
        StateHasChanged();
    }

    async Task ResolvePending() {
        if (State.PendingEndpointPath is { Length: > 0 } path) {
            State.PendingEndpointPath = null;
            var route = Catalog.Resolve(path) ?? Catalog.All().FirstOrDefault(r => r.Path == path);
            if (route is null) State.Notice = $"The link points at endpoint {path}, which this build does not serve.";
            else if (State.Selected?.Path != route.Path) await SelectEndpoint(route);
        }

        if (State.PendingObjectName is { Length: > 0 } name) {
            State.PendingObjectName = null;
            if (Reflection.Schema(name) is null) {
                State.Notice = $"The link points at message type {name}, which this build does not know.";
            } else {
                State.Docs = new DocSubjectRef(DocSubjectKind.Message, name);
                State.Kind = ApiSelectionKind.Docs;
            }
        }

        if (State.Kind is ApiSelectionKind.Routes && !State.IsContributor) State.Kind = ApiSelectionKind.Endpoint;
    }

    async Task WriteHash(bool push = false, bool clear = false) {
        if (!_hashWired || _nav is null) return;
        var hash = clear ? "" : State.Hash() ?? "";
        try {
            await _nav.InvokeVoidAsync(push ? "push" : "write", hash);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "the workbench hash could not be updated");
        }
    }

    public async ValueTask DisposeAsync() {
        State.DocsRequested -= OnDocsRequested;
        await _navHandle.DisposeModuleAsync("dispose", Logger);
        await _nav.DisposeModuleAsync(logger: Logger);
        await _store.DisposeModuleQuietAsync(logger: Logger);
        _selfRef?.Dispose();
    }

}
