@using EggIdentity.Reports
@using EggIdentity.UI.Reports
@using EggIncognito.Services.Coverage
@inject ICurrentUser User
@inject ReportEngineRegistry Engines
@inject IReadOnlyList<IReportSource> Sources

<ReportExplorer Sources="Sources" Registry="Engines" @bind-Value="_definition" Presets="ConsumptionReportSource.Presets" Tier="Tier"/>

@code {
    private ReportDefinition _definition = ConsumptionReportSource.Presets[0].Definition;

    private ReportTier Tier => User.Current.IsAtLeast(UserRole.Admin) ? ReportTier.Live : ReportTier.Snapshot;
}
