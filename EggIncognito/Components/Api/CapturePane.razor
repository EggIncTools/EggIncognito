@implements IAsyncDisposable
@using System.Text.Json
@using System.Threading.Channels
@using EggIncognito.Capture
@using EggIncognito.Components.Capture
@using EggIncognito.Models.Capture
@inherits SelfCallComponentBase
@inject CaptureSessionManager Manager
@inject IAppMode AppMode
@inject ICurrentUser User
@inject HostedCaptureOptions HostedOptions
@inject IConfiguration Config
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ICaptureContributionKinds Kinds
@inject ToastService Toasts
@inject ILogger<CapturePane> Logger

@if (_hub is not null) {
    <div class="awb-pane h-full">
        @if (_session is not null && _hosted) {
            <HostedSetupCard Port="HostedOptions.FrontDoorPort"
                             ClientFactory="Client" InviteUrl="@Config["Discord:InviteUrl"]"
                             HostOverride="@_rotatedHost" Limited="_limited"
                             Expanded="SetupExpanded" ExpandedChanged="SetSetupExpanded"/>
        }

        <div class="capture-body grid gap-3 min-h-0">
            <FlowList Flows="_flows" SelectedId="_selectedId" Connected="_connected" View="_view" OnSelect="SelectFlow"
                      CanSelect="CanSelectFlow">
                <Tools>
                    <CaptureControlsPanel Running="_running" Port="_port" ToggleBusy="_toggleBusy" View="_view"
                                          OnToggleCapture="ToggleCapture" OnClear="Clear" OnViewChanged="OnViewChanged"
                                          Hosted="_hosted" ClientFactory="Client"
                                          OnAddressRotated="@(h => {
                                                                _rotatedHost = h;
                                                                StateHasChanged();
                                                            })"/>
                    <CaptureNoticesPanel Notices="_notices" Unread="_unread"
                                         OnDismissNotice="DismissNotice" OnClearNotices="ClearNotices" OnNoticesRead="MarkNoticesRead"/>
                </Tools>
                <Stats>
                    <StatsPanel Stats="_stats" FlowCount="_flows.Count" Running="_running" Port="_port"/>
                </Stats>
                <Foot>
                    @if (_hosted) {
                        <ContributePanel @ref="_contribute" ClientFactory="Client"/>
                    }
                </Foot>
            </FlowList>

            <section id="detailPanel" class="panel">
                <h2>Detail</h2>
                <DetailPane Flow="_selectedFlow" View="_view" ClientFactory="Client"/>
            </section>
        </div>
    </div>
} else if (AppMode.HostedCaptureEnabled) {
    <div class="awb-pane">
        <h4 class="awb-pane-title">Live capture</h4>
        @if (!_isAuthenticated) {
            <div class="panel" id="hostedLogin">
                <p class="text-muted text-sm mt-0 mb-3">
                    Log in to start a capture session. Any account can record crafting, consume and demote
                    results; supporters get full capture.
                </p>
                <LoginButton Label="Log in"/>
            </div>
        } else {
            <div class="panel" id="hostedCapacity">
                <p class="text-muted text-sm my-0">
                    All capture slots are in use right now. Try again in a few
                    minutes.
                </p>
            </div>
        }
    </div>
} else {
    <div class="awb-pane">
        <h4 class="awb-pane-title">Live capture</h4>
        <p class="text-muted text-sm mt-0 mb-3">Capture runs a local proxy + CA and writes to disk, so it cannot run on this hosted instance.</p>
        <LocalCaptureGuide/>
    </div>
}

@code {
    readonly List<DashboardFlow> _flows = [];
    readonly Dictionary<long, int> _flowIndex = new();
    long? _selectedId;
    DashboardFlow? _selectedFlow;

    CaptureStats? _stats;
    bool _running;
    int _port;
    bool _connected;
    bool _toggleBusy;

    readonly CaptureViewState _view = new();

    readonly List<NoticeItem> _notices = [];
    int _unread;
    int _nextNoticeId = 1;

    IDisposable? _subscription;
    CancellationTokenSource? _loopCts;
    Task? _loopTask;

    IJSObjectReference? _store;

    CaptureSession? _session;
    CaptureHub? _hub;
    bool _hosted;
    string? _rotatedHost;
    bool _isAuthenticated;
    bool _isSupporter;
    bool _isAdmin;
    string? _userId;
    bool _limited;
    bool _setupTouched;
    IReadOnlySet<string> _fullDetailRoutes = new HashSet<string>(StringComparer.Ordinal);
    ContributePanel? _contribute;

    protected override void OnInitialized() {
        base.OnInitialized();

        _isAuthenticated = User.IsAuthenticated;
        _isSupporter = User.IsSupporter;
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        _userId = User.DiscordId;

        ResolveSession();
        if (_hub is null) return;

        foreach (var f in _hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(_hub.StatsSnapshot());
    }

    void ResolveSession() {
        if (AppMode.CanCapture) {
            _session = Manager.GetOrCreate(CaptureSessionManager.LocalKey);
            _hub = _session.Hub;
            return;
        }

        if (!AppMode.HostedCaptureEnabled || !_isAuthenticated || string.IsNullOrEmpty(_userId)) return;
        _hosted = true;
        var tier = _isSupporter || _isAdmin ? CaptureTier.Full : CaptureTier.Limited;
        try {
            _session = Manager.GetOrCreate(_userId, tier);
            _session.ContributorUserId = User.UserId;
            _hub = _session.Hub;
            _limited = _session.Tier == CaptureTier.Limited;
            _fullDetailRoutes = Kinds.AllRoutes;
        }
        catch (CaptureCapacityException) {
            _session = null;
        }
    }

    bool CanSelectFlow(DashboardFlow flow) {
        return !_limited || _fullDetailRoutes.Contains(flow.Path);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || _hub is null) return;

        try {
            _store = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/captureStore.js"));
            _view.RedactionMode = await InvokeOr("getRedactionMode", _view.RedactionMode);
            _view.ShowHeaders = await InvokeOr("getShowHeaders", _view.ShowHeaders);
            _view.AutoScroll = await InvokeOr("getAutoScroll", _view.AutoScroll);
            _view.CompareToKnown = await InvokeOr("getCompareToKnown", _view.CompareToKnown);
            _view.DefaultFormat = await InvokeOr("getDefaultFormat", _view.DefaultFormat);
            _view.SetupExpanded = await InvokeOr("getSetupExpanded", _view.SetupExpanded);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            _store = null;
        }

        StartSubscription();
        StateHasChanged();
    }

    void StartSubscription() {
        if (_hub is null) return;
        var (reader, subscription) = _hub.Subscribe();
        _subscription = subscription;

        foreach (var f in _hub.Snapshot()) AddOrUpdateFlow(f);
        ApplyStats(_hub.StatsSnapshot());
        _loopCts = new CancellationTokenSource();
        var ct = _loopCts.Token;
        _loopTask = Task.Run(async () => {
            try {
                await foreach (var env in reader.ReadAllAsync(ct)) {
                    await InvokeAsync(() => ApplyEnvelope(env));
                }
            }
            catch (OperationCanceledException) {
                Logger.LogTrace("capture subscription cancelled");
            }
            catch (ChannelClosedException) {
                Logger.LogTrace("capture hub unsubscribed");
            }
        }, ct);
    }

    void ApplyEnvelope(CaptureEnvelope env) {
        switch (env.Kind) {
            case "flow" when env.Flow is not null:
                AddOrUpdateFlow(env.Flow);
                if (_hosted && _fullDetailRoutes.Contains(env.Flow.Path)) _ = RefreshContributionsAsync();
                break;
            case "stats" when env.Stats is not null:
                ApplyStats(env.Stats);
                break;
            case "notice" when env.Event is not null:
                PushNotice(env.Event);
                break;
        }

        StateHasChanged();
    }

    void AddOrUpdateFlow(DashboardFlow flow) {
        if (_flowIndex.TryGetValue(flow.Id, out var idx)) {
            _flows[idx] = flow;
            if (_selectedId == flow.Id) _selectedFlow = flow;
            return;
        }

        _flowIndex[flow.Id] = _flows.Count;
        _flows.Add(flow);
    }

    void ApplyStats(CaptureStats stats) {
        _stats = stats;
        _running = stats.Running;
        _port = stats.Port;
        _connected = stats.ActiveConnections > 0 || stats.DeviceCount > 0;
    }

    void SelectFlow(long id) {
        var flow = _flowIndex.TryGetValue(id, out var idx) ? _flows[idx] : null;
        if (flow is null || !CanSelectFlow(flow)) return;
        _selectedId = id;
        _selectedFlow = flow;
    }

    async Task RefreshContributionsAsync() {
        if (_contribute is null) return;
        try {
            await InvokeAsync(async () => {
                await _contribute.RefreshAsync();
                StateHasChanged();
            });
        }
        catch (Exception ex) {
            Logger.LogDebug(ex, "contribution panel refresh failed");
        }
    }

    async Task ToggleCapture() {
        _toggleBusy = true;
        var verb = _running ? "stop" : "start";
        try {
            var res = await Client().PostAsync($"/api/capture/{verb}", null);
            if (!res.IsSuccessStatusCode) {
                var detail = await ProblemDetailAsync(res);
                Logger.LogWarning("capture {Verb} failed: HTTP {Status} {Detail}", verb, (int)res.StatusCode, detail);
                Toasts.Push(StatusNoteKind.Error, $"Capture {verb} failed (HTTP {(int)res.StatusCode}). {detail}");
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "capture {Verb} request failed", verb);
            Toasts.Push(StatusNoteKind.Error, $"Capture {verb} failed: {ex.Message}");
        }
        finally {
            _toggleBusy = false;
            StateHasChanged();
        }
    }

    static async Task<string> ProblemDetailAsync(HttpResponseMessage res) {
        var body = (await res.Content.ReadAsStringAsync()).Trim();
        if (body.Length == 0) return res.ReasonPhrase ?? "";
        try {
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("detail", out var d) && d.GetString() is { Length: > 0 } detail) return detail;
            if (doc.RootElement.TryGetProperty("error", out var e) && e.GetString() is { Length: > 0 } error) return error;
        }
        catch (JsonException) {
            return body.Length > 200 ? body[..200] : body;
        }

        return body.Length > 200 ? body[..200] : body;
    }

    async Task Clear() {
        try {
            var res = await Client().PostAsync("/api/capture/clear", null);
            if (res.IsSuccessStatusCode) {
                _flows.Clear();
                _flowIndex.Clear();
                _selectedId = null;
                _selectedFlow = null;
                return;
            }

            Toasts.Push(StatusNoteKind.Error, $"Clear failed (HTTP {(int)res.StatusCode}). {await ProblemDetailAsync(res)}");
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "clearing the capture buffer failed");
            Toasts.Push(StatusNoteKind.Error, $"Clear failed: {ex.Message}");
        }
    }

    async Task OnViewChanged() {
        await InvokeVoid("setRedactionMode", _view.RedactionMode);
        await InvokeVoid("setShowHeaders", _view.ShowHeaders);
        await InvokeVoid("setAutoScroll", _view.AutoScroll);
        await InvokeVoid("setCompareToKnown", _view.CompareToKnown);
        await InvokeVoid("setDefaultFormat", _view.DefaultFormat);
        StateHasChanged();
    }

    bool SetupExpanded => _setupTouched ? _view.SetupExpanded : _view.SetupExpanded && !_running;

    async Task SetSetupExpanded(bool expanded) {
        _setupTouched = true;
        _view.SetupExpanded = expanded;
        await InvokeVoid("setSetupExpanded", expanded);
        StateHasChanged();
    }

    void PushNotice(CaptureEvent ev) {
        var severity = NoticeSeverity(ev.Kind);
        _notices.Insert(0, new NoticeItem(_nextNoticeId++, severity, ev.Message, ev.Timestamp));
        if (_notices.Count > 200) _notices.RemoveRange(200, _notices.Count - 200);
        _unread++;
        Toasts.Push(ToastKind(severity), ev.Message);
    }

    static string NoticeSeverity(string kind) {
        return kind switch {
            "decryptError" => "err",
            "certTrusted" => "ok",
            _ => "info"
        };
    }

    static StatusNoteKind ToastKind(string severity) {
        return severity switch {
            "err" => StatusNoteKind.Error,
            "ok" => StatusNoteKind.Ok,
            _ => StatusNoteKind.Info
        };
    }

    void DismissNotice(int id) {
        _notices.RemoveAll(n => n.Id == id);
    }

    void ClearNotices() {
        _notices.Clear();
        _unread = 0;
    }

    void MarkNoticesRead() {
        _unread = 0;
    }

    async Task<T> InvokeOr<T>(string fn, T fallback) {
        if (_store is null) return fallback;
        try {
            return await _store.InvokeAsync<T>(fn);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            return fallback;
        }
    }

    async Task InvokeVoid(string fn, params object?[] args) {
        if (_store is null) return;
        try {
            await _store.InvokeVoidAsync(fn, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "capture store call {Function} failed", fn);
        }
    }

    public async ValueTask DisposeAsync() {
        _loopCts?.Cancel();
        _subscription?.Dispose();
        if (_loopTask is not null) {
            try {
                await _loopTask;
            }
            catch (Exception ex) {
                Logger.LogDebug(ex, "capture event loop ended with an exception");
            }
        }

        _loopCts?.Dispose();
        await _store.DisposeModuleQuietAsync(logger: Logger);
    }

}
