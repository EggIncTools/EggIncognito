@using System.Text.Json
@using EggIncognito.Artifacts
@using EggIncognito.Core.Services.Devices
@using EggIncognito.GameData
@using EggIncognito.Models.Contributions
@using EggIncognito.Models.Coverage
@using EggIncognito.Services.Contributions
@using EggIncognito.Services.Coverage
@inherits SelfCallComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject IEnumerable<IDevicePanel> Panels
@inject IEnumerable<ICoverageInventory> Inventories
@inject ToastService Toasts
@inject ILogger<ConsumeCoveragePane> Logger
@inject ICurrentUser User

@if (User.Current.IsAtLeast(UserRole.Admin)) {
    <div class="cov">
        <PanelHead Title="Consume coverage">
            <Tools>
                @if (_map is { } m) {
                    <span class="cov-facts mono">@Pct(m.Validity) valid, @m.CellsComplete/@m.CellsInScope cells, @m.Items items, @m.Observations obs</span>
                    <button type="button" class="btn-mini" disabled="@(m.PendingObservations == 0 && !_pendingOpen)" @onclick="TogglePending">
                        @(_pendingOpen ? "Hide pending" : $"Pending {m.PendingObservations}")
                    </button>
                }
            </Tools>
        </PanelHead>

        @if (_noDb) {
            <StatusNote Kind="StatusNoteKind.Error">No database configured.</StatusNote>
        } else if (_map is null) {
            @if (_loaded) {
                <StatusNote Kind="StatusNoteKind.Error">The artifact catalog is not loaded.</StatusNote>
            }
        } else if (_pendingOpen) {
            <ToolBar Flat="true">
                <span class="tbar-group">
                    <span class="tbar-k">Pending</span>
                    <span class="cov-facts mono">@_pendingTotal row(s)</span>
                </span>
                <span class="tbar-group">
                    <button type="button" class="btn-mini" disabled="@(_busy || _checked.Count == 0)" @onclick="() => Review(true)">Approve @_checked.Count</button>
                    <button type="button" class="btn-mini btn-danger" disabled="@(_busy || _checked.Count == 0)" @onclick="() => Review(false)">Reject @_checked.Count</button>
                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="LoadPending">Reload</button>
                </span>
            </ToolBar>
            <TableScroll Class="cov-scroll">
                <table class="data-table cov-table">
                    <thead>
                    <tr>
                        <th><input type="checkbox" aria-label="Select all" checked="@AllChecked" @onchange="e => CheckAll(e.Value is true)"/></th>
                        <th>Contributor</th>
                        <th>Summary</th>
                        <th>Version</th>
                        <th>Recorded</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in _pending) {
                        <tr @key="r.Id" class="row-click" @onclick="() => Check(r.Id, !_checked.Contains(r.Id))">
                            <td><input type="checkbox" checked="@_checked.Contains(r.Id)" @onchange="e => Check(r.Id, e.Value is true)" @onclick:stopPropagation="true"/></td>
                            <td class="mono">@(r.ContributorName ?? r.ContributorUserId.ToString("N")[..8])</td>
                            <td>@r.Summary</td>
                            <td class="mono">@r.ClientVersion</td>
                            <td class="mono">@r.RecordedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </TableScroll>
        } else {
            @if (_sel is { } s) {
                <ToolBar Flat="true" Class="cov-sel">
                    <span class="tbar-group">
                        <span class="cov-disc bg-r-@s.Cell.AfxRarity"><img src="@IconSrc(s.Family, LevelOf(s))" alt="" loading="lazy"/></span>
                        <span class="tbar-k">@TierName(s)</span>
                    </span>
                    @foreach (var panel in CellPanels) {
                        <DynamicComponent @key="panel.Id" Type="panel.ComponentType" Parameters="CellPanelParameters(s)"/>
                    }
                </ToolBar>
            }

            <div class="cov-body">
            <TableScroll Class="cov-scroll">
                <table class="data-table cov-table">
                    <thead>
                    <tr>
                        <th>Family</th>
                        <th>Validity</th>
                        <th>Cells</th>
                        <th>Items</th>
                        <th>Obs</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var f in _map.Families) {
                        <tr class="row-click" @key="f.SpecName" @onclick="() => Toggle(f.SpecName)">
                            <td>
                                <span class="cov-fam">
                                    <Caret Open="Open(f)"/>
                                    @if (f.Tiers.Count > 0) {
                                        <img class="cov-fam-ico" src="@IconSrc(f.SpecName, f.Tiers[^1].AfxLevel)" alt="" loading="lazy"/>
                                    }
                                    @f.PluralName
                                </span>
                            </td>
                            <td class="cov-bar"><BarTrack Fraction="f.Validity"/></td>
                            <td class="mono">@f.CellsComplete/@f.CellsInScope</td>
                            <td class="mono">@f.Items</td>
                            <td class="mono">@f.Observations</td>
                        </tr>
                        @if (Open(f)) {
                            <tr class="cov-grid-row">
                                <td colspan="5">
                                    <div class="cov-grid">
                                        <span></span>
                                        @foreach (var head in RarityHeads) {
                                            <span class="cov-head">@head</span>
                                        }
                                        @if (_sel is { } fs && fs.Family == f.SpecName) {
                                            <span class="cov-settings" @onclick:stopPropagation="true">
                                                <button type="button" class="btn-mini" aria-label="Coverage target" title="Coverage target" @onclick="() => _targetOpen = !_targetOpen">
                                                    <Icon Name="settings" Class="icon-sm"/>
                                                </button>
                                                @if (_targetOpen) {
                                                    <div class="popover-backdrop" @onmousedown="() => _targetOpen = false"></div>
                                                    <div class="cov-pop">
                                                        <div class="cov-pop-row">
                                                            <span class="tbar-k">@TierName(fs)</span>
                                                            <span class="cov-facts mono">@fs.Cell.Items/@fs.Cell.ItemTarget items, @fs.Cell.Observations/@fs.Cell.ObservationTarget obs</span>
                                                        </div>
                                                        <div class="cov-pop-row">
                                                            <select class="field-input cov-scope" aria-label="Target scope" value="@_scope" @onchange="@(e => _scope = e.Value?.ToString() ?? "Cell")">
                                                                @foreach (var sc in ScopeNames) {
                                                                    <option value="@sc">@sc</option>
                                                                }
                                                            </select>
                                                            <label class="cov-num-label">items
                                                                <input type="number" min="1" class="field-input cov-num" aria-label="Item target" @bind="_itemTarget"/>
                                                            </label>
                                                            <label class="cov-num-label">obs
                                                                <input type="number" min="1" class="field-input cov-num" aria-label="Observation target" @bind="_obsTarget"/>
                                                            </label>
                                                        </div>
                                                        <div class="cov-pop-row">
                                                            <label class="form-check"><input type="checkbox" checked="@_enabled" @onchange="e => _enabled = e.Value is true"/>in scope</label>
                                                            <button type="button" class="btn-mini" disabled="@_busy" @onclick="Save">Save</button>
                                                            @if (_scope == "Cell" && fs.Cell.CellTargetId is { } id) {
                                                                <button type="button" class="btn-mini" disabled="@_busy" @onclick="() => Remove(id)">Reset</button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </span>
                                        } else {
                                            <span></span>
                                        }
                                        @foreach (var t in f.Tiers) {
                                            <span class="cov-tier">@t.Name</span>
                                            @for (int r = 0; r < RarityHeads.Length; r++) {
                                                var cell = t.Cells.FirstOrDefault(c => c.AfxRarity == r);
                                                if (cell is null) {
                                                    <span class="cov-cell-none"></span>
                                                    continue;
                                                }

                                                <button type="button" class="cov-cell @(cell.InScope ? "" : "cov-cell-off") @(Selected(f, t, cell) ? "cov-cell-sel" : "")"
                                                        style="@CellStyle(cell)" title="@ArtifactDefinitions.EffectText(f.SpecName, t.AfxLevel, cell.AfxRarity)"
                                                        @onclick="() => Select(f, t, cell)" @onclick:stopPropagation="true">
                                                    <span class="cov-disc bg-r-@cell.AfxRarity"><img src="@IconSrc(f.SpecName, t.AfxLevel)" alt="" loading="lazy"/></span>
                                                    <span class="cov-nk">@cell.Items/@cell.Observations</span>
                                                    @if (Held(f.SpecName, t.Level, cell.Rarity) is { } held) {
                                                        <span class="cov-held">@held.ToString("0")</span>
                                                    }
                                                </button>
                                            }
                                            <span></span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </TableScroll>
            @if (SidePanels.Any()) {
                <div class="cov-side">
                    @foreach (var panel in SidePanels) {
                        <DynamicComponent @key="panel.Id" Type="panel.ComponentType" Parameters="SidePanelParameters()"/>
                    }
                </div>
            }
            </div>
        }
    </div>
}

@code {
    [Parameter] public string? DeviceId { get; set; }

    [Parameter] public int? AndroidUserId { get; set; }

    static readonly string[] RarityHeads = ["Common", "Rare", "Epic", "Legendary"];
    static readonly string[] ScopeNames = ["Cell", "Tier", "Family", "Rarity", "Global"];
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    ConsumeCoverageMap? _map;
    bool _noDb;
    bool _loaded;
    bool _busy;
    bool _pendingOpen;
    bool _targetOpen;
    int _pendingTotal;
    int _reloadPending;
    List<ContributionPendingRowDto> _pending = [];
    readonly HashSet<long> _checked = [];
    readonly HashSet<string> _open = new(StringComparer.Ordinal);
    CoverageSelection? _sel;
    string _scope = "Cell";
    int _itemTarget;
    int _obsTarget;
    bool _enabled = true;

    bool AllChecked => _pending.Count > 0 && _pending.All(r => _checked.Contains(r.Id));

    protected override async Task OnInitializedAsync() {
        if (!User.Current.IsAtLeast(UserRole.Admin)) return;
        foreach (var inv in Inventories) inv.Changed += OnInventoryChanged;
        await LoadAsync();
    }

    void OnInventoryChanged() {
        if (Interlocked.Exchange(ref _reloadPending, 1) == 1) return;
        _ = InvokeAsync(async () => {
            try {
                await Task.Delay(750);
                await LoadAsync();
            } finally {
                Interlocked.Exchange(ref _reloadPending, 0);
            }

            StateHasChanged();
        });
    }

    public void Dispose() {
        foreach (var inv in Inventories) inv.Changed -= OnInventoryChanged;
    }

    async Task LoadAsync() {
        using var scope = Scopes.CreateScope();
        var svc = scope.ServiceProvider.GetService<ConsumeCoverageService>();
        if (svc is null) {
            _noDb = true;
            _loaded = true;
            return;
        }

        try {
            _map = await svc.MapAsync(CancellationToken.None);
        } catch (Exception ex) when (ex is JsonException or InvalidOperationException or GameDataSchemaException) {
            Logger.LogWarning(ex, "consume coverage could not be built");
            _map = null;
        }

        _loaded = true;
        if (_sel is { } s) Reselect(s);
    }

    async Task TogglePending() {
        _pendingOpen = !_pendingOpen;
        if (_pendingOpen) await LoadPending();
    }

    async Task LoadPending() {
        _busy = true;
        try {
            var page = await Client().GetFromJsonAsync<PendingPage>(
                $"/api/contributions/pending?kind={Uri.EscapeDataString(ArtifactContributionKind.KindName)}&skip=0&take=500", JsonOpts);
            _pending = page?.Rows ?? [];
            _pendingTotal = page?.Total ?? 0;
            _checked.RemoveWhere(id => _pending.All(r => r.Id != id));
        } catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Logger.LogWarning(ex, "pending contributions could not be read");
            Toasts.Push(StatusNoteKind.Error, "Pending rows could not be read.");
        } finally {
            _busy = false;
        }
    }

    void Check(long id, bool on) {
        if (on) _checked.Add(id);
        else _checked.Remove(id);
    }

    void CheckAll(bool on) {
        if (on) foreach (var r in _pending) _checked.Add(r.Id);
        else _checked.Clear();
    }

    async Task Review(bool approve) {
        var ids = _checked.ToList();
        await Write(c => c.PostAsJsonAsync("/api/contributions/review", new ContributionReviewRequest { Ids = ids, Approve = approve }, JsonOpts),
            approve ? $"Approved {ids.Count}." : $"Rejected {ids.Count}.");
        _checked.Clear();
        await LoadPending();
    }

    void Reselect(CoverageSelection s) {
        var cell = _map?.Families.FirstOrDefault(f => f.SpecName == s.Family)?.Tiers
            .FirstOrDefault(t => t.Level == s.Level)?.Cells.FirstOrDefault(c => c.Rarity == s.Rarity);
        _sel = cell is null ? null : s with { Cell = cell };
    }

    bool Open(CoverageFamily f) => _open.Contains(f.SpecName);

    void Toggle(string spec) {
        if (!_open.Remove(spec)) _open.Add(spec);
    }

    bool Selected(CoverageFamily f, CoverageTier t, CoverageCell c) =>
        _sel is { } s && s.Family == f.SpecName && s.Level == t.Level && s.Rarity == c.Rarity;

    void Select(CoverageFamily f, CoverageTier t, CoverageCell c) {
        _sel = new CoverageSelection(f.SpecName, t.Level, c.Rarity, c);
        _targetOpen = false;
        _scope = "Cell";
        _itemTarget = c.ItemTarget;
        _obsTarget = c.ObservationTarget;
        _enabled = c.InScope;
    }

    int LevelOf(CoverageSelection s) =>
        _map?.Families.FirstOrDefault(f => f.SpecName == s.Family)?.Tiers.FirstOrDefault(t => t.Level == s.Level)?.AfxLevel ?? 0;

    string TierName(CoverageSelection s) =>
        _map?.Families.FirstOrDefault(f => f.SpecName == s.Family)?.Tiers.FirstOrDefault(t => t.Level == s.Level)?.Name ?? s.Family;

    CoverageTargetRequest RequestFor(CoverageSelection s) => _scope switch {
        "Tier" => new(s.Family, s.Level, null, _itemTarget, _obsTarget, _enabled),
        "Family" => new(s.Family, null, null, _itemTarget, _obsTarget, _enabled),
        "Rarity" => new(null, null, s.Rarity, _itemTarget, _obsTarget, _enabled),
        "Global" => new(null, null, null, _itemTarget, _obsTarget, _enabled),
        _ => new(s.Family, s.Level, s.Rarity, _itemTarget, _obsTarget, _enabled)
    };

    async Task Save() {
        if (_sel is not { } s) return;
        await Write(c => c.PutAsJsonAsync("/api/admin/consume-coverage/targets", RequestFor(s), JsonOpts), "Target saved.");
    }

    async Task Remove(long id) =>
        await Write(c => c.DeleteAsync($"/api/admin/consume-coverage/targets/{id}"), "Target removed.");

    async Task Write(Func<HttpClient, Task<HttpResponseMessage>> call, string ok) {
        _busy = true;
        try {
            using var res = await call(Client());
            if (res.IsSuccessStatusCode) {
                Toasts.Push(StatusNoteKind.Ok, ok);
                await LoadAsync();
            } else {
                Toasts.Push(StatusNoteKind.Error, await ReadError(res));
            }
        } catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Logger.LogWarning(ex, "consume coverage write failed");
            Toasts.Push(StatusNoteKind.Error, "The change could not be saved.");
        } finally {
            _busy = false;
        }
    }

    static async Task<string> ReadError(HttpResponseMessage res) {
        try {
            var body = await res.Content.ReadFromJsonAsync<ApiError>(JsonOpts);
            if (body?.Error is { Length: > 0 } e) return e;
        } catch (JsonException) {
        }

        return $"failed ({(int)res.StatusCode})";
    }

    double? Held(string family, string level, string rarity) {
        foreach (var inv in Inventories) {
            if (inv.Held(DeviceId, family, level, rarity) is { } n) return n;
        }

        return null;
    }

    static string IconSrc(string spec, int level) => ArtifactAssets.IconPath(ArtifactAssets.KeyFor(spec), level + 1);

    static string CellStyle(CoverageCell c) => FormattableString.Invariant($"--v:{c.Validity:0.###};");

    static string Pct(double v) => FormattableString.Invariant($"{v * 100:0.#}%");

    IEnumerable<IDevicePanel> CellPanels =>
        Panels.Where(p => string.Equals(p.Shelf, DevicePanelShelves.CoverageCell, StringComparison.Ordinal));

    IEnumerable<IDevicePanel> SidePanels =>
        Panels.Where(p => string.Equals(p.Shelf, DevicePanelShelves.CoverageSide, StringComparison.Ordinal));

    Dictionary<string, object?> SidePanelParameters() => new() {
        ["DeviceId"] = DeviceId,
        ["AndroidUserId"] = AndroidUserId
    };

    Dictionary<string, object?> CellPanelParameters(CoverageSelection sel) => new() {
        ["DeviceId"] = DeviceId,
        ["AndroidUserId"] = AndroidUserId,
        ["Family"] = sel.Family,
        ["Level"] = sel.Level,
        ["Rarity"] = sel.Rarity,
        ["SuggestedBatch"] = sel.Cell.SuggestedBatch
    };

    sealed record PendingPage(int Total, List<ContributionPendingRowDto> Rows);
}
