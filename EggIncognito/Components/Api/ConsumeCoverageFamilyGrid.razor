@using EggSharp.GameData.Artifacts
@using EggSharp.GameData
@using EggIncognito.Models.Coverage
@using EggIncognito.Services.Assets

    @if (Family.Kind is ArtifactKind.Stone or ArtifactKind.Ingredient) {
        <div class="cov-grid cov-grid-line">
            @foreach (var t in Family.Tiers) {
                var cell = t.Cells.FirstOrDefault();
                <div class="cov-grid-line-col">
                    <Tooltip Text="@t.Name"><span class="cov-tier">T@(t.AfxLevel + 1)</span></Tooltip>
                    @if (cell is null) {
                        <span class="cov-cell-none"></span>
                    } else {
                        <button type="button" class="cov-cell @(cell.InScope ? "" : "cov-cell-off") @(Selected(t, cell) ? "cov-cell-sel" : "")"
                                style="@CellStyle(cell)"
                                @onclick="() => Select(t, cell)" @onclick:stopPropagation="true">
                            <Tooltip Text="@ArtifactDefinitions.EffectText(Family.SpecName, t.AfxLevel, cell.AfxRarity)">
                                <span class="cov-disc bg-r-@cell.AfxRarity"><img src="@IconSrc(Family.SpecName, t.AfxLevel)" alt="" loading="lazy"/></span>
                            </Tooltip>
                            <Tooltip Text="@($"{cell.Observations:N0} consumed")">
                                <span class="cov-nk">@Compact(cell.Observations)</span>
                            </Tooltip>
                        </button>
                    }
                </div>
            }
        </div>
    } else {
        <div class="cov-grid">
            <span></span>
            @for (int r = 0; r < RarityHeads.Length; r++) {
                <span class="cov-head cov-head-r-@r">
                    @RarityHeads[r]
                    @if (Annotation(Family, r) is { } note) {
                        <span class="cov-head-note">@note</span>
                    }
                </span>
            }
            <span></span>
            @foreach (var t in Family.Tiers) {
                <Tooltip Text="@t.Name"><span class="cov-tier">T@(t.AfxLevel + 1)</span></Tooltip>
                @for (int r = 0; r < RarityHeads.Length; r++) {
                    var cell = t.Cells.FirstOrDefault(c => c.AfxRarity == r);
                    if (cell is null) {
                        <span class="cov-cell-none"></span>
                        continue;
                    }

                    <button type="button" class="cov-cell @(cell.InScope ? "" : "cov-cell-off") @(Selected(t, cell) ? "cov-cell-sel" : "")"
                            style="@CellStyle(cell)"
                            @onclick="() => Select(t, cell)" @onclick:stopPropagation="true">
                        <Tooltip Text="@ArtifactDefinitions.EffectText(Family.SpecName, t.AfxLevel, cell.AfxRarity)">
                            <span class="cov-disc bg-r-@cell.AfxRarity"><img src="@IconSrc(Family.SpecName, t.AfxLevel)" alt="" loading="lazy"/></span>
                        </Tooltip>
                        <Tooltip Text="@($"{cell.Observations:N0} consumed")">
                            <span class="cov-nk">@Compact(cell.Observations)</span>
                        </Tooltip>
                    </button>
                }
                <span></span>
            }
        </div>
    }
    @if (Selection is { } ds && ds.Family == Family.SpecName) {
        <div class="cov-drops" @onclick:stopPropagation="true">
            <CoverageDrops Family="@ds.Family" Level="@ds.Level" Rarity="@ds.Rarity" Version="Version"/>
        </div>
    }

@code {
    [Parameter] public CoverageFamily Family { get; set; } = default!;

    [Parameter] public CoverageSelection? Selection { get; set; }

    [Parameter] public EventCallback<(CoverageTier Tier, CoverageCell Cell)> OnSelect { get; set; }

    [Parameter] public Func<CoverageFamily, int, string?> Annotation { get; set; } = default!;

    [Parameter] public int Version { get; set; }

    static readonly string[] RarityHeads = [
        .. Enum.GetValues<Ei.ArtifactSpec.Types.Rarity>().OrderBy(r => (int)r)
            .Select(r => EggIcons.Pretty(r.ToString()))
    ];

    bool Selected(CoverageTier t, CoverageCell c) =>
        Selection is { } s && s.Family == Family.SpecName && s.Level == t.Level && s.Rarity == c.Rarity;

    void Select(CoverageTier t, CoverageCell c) =>
        OnSelect.InvokeAsync((t, c));

    static string IconSrc(string spec, int level) => EggIncognito.Services.Artifacts.ArtifactTreeBuilder.Icon(spec, level);

    static string CellStyle(CoverageCell c) => FormattableString.Invariant($"--v:{c.Validity:0.###};");

    static string Compact(long n) => n switch {
        >= 1_000_000 => FormattableString.Invariant($"{n / 1_000_000d:0.#}M"),
        >= 1_000 => FormattableString.Invariant($"{n / 1_000d:0.#}k"),
        _ => n.ToString(System.Globalization.CultureInfo.InvariantCulture)
    };
}
