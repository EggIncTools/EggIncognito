@using EggIncognito.Components.Inspector
@using EggIncognito.Models.Inspector
@using EggIncognito.Services.Inspector
@inject IRouteCatalog Catalog

@{ var subject = Subject; }
@if (subject is null || subject.Key.Length == 0) {
    <div class="empty-state">
        No subject selected.
        <div class="empty-hint">Pick a message or endpoint in the rail to read and edit its documentation.</div>
    </div>
} else {
    switch (subject.Kind) {
        case DocSubjectKind.Message:
            <ObjectReference Name="@subject.Key" OnSelectEndpoint="OnJumpEndpoint" OnSelectMessage="OnJumpMessage"/>
            break;
        case DocSubjectKind.Endpoint:
            <EndpointReference Route="@ResolvedRoute" OnSelectObject="OnJumpMessage"/>
            break;
    }
}

@code {
    [Parameter] public DocSubjectRef? Subject { get; set; }
    [Parameter] public EventCallback<DocSubjectRef> OnSelectSubject { get; set; }

    RouteInfo? ResolvedRoute {
        get {
            if (Subject is not { Key.Length: > 0 } subject) return null;
            return Catalog.Resolve(subject.Key) ?? Catalog.All().FirstOrDefault(r => r.Path == subject.Key);
        }
    }

    Task OnJumpEndpoint(RouteInfo e) {
        return OnSelectSubject.InvokeAsync(new DocSubjectRef(DocSubjectKind.Endpoint, e.Path));
    }

    Task OnJumpMessage(string name) {
        return OnSelectSubject.InvokeAsync(new DocSubjectRef(DocSubjectKind.Message, name));
    }

}
