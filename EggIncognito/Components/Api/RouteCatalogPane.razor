@using System.Net
@using System.Text.Json
@using EggIncognito.Models.Inspector
@using EggIncognito.Models.Routes
@using EggIncognito.Services.Routes
@inherits SelfCallComponentBase
@inject IRouteCatalogReport RouteReport
@inject ToastService Toasts
@inject ILogger<RouteCatalogPane> Logger

<div class="awb-pane">
    <div class="routes-head">
        <h4 class="awb-pane-title">Route catalog</h4>
        <div class="routes-head-meta">
            @if (_binary is { } b && !string.IsNullOrWhiteSpace(b.BinaryVersion)) {
                <VersionLine App="@b.BinaryVersion"/>
            } else {
                <span class="text-muted">binary unknown</span>
            }
            @if (_binary?.LastRefresh is { } lr) {
                <span class="text-muted">last refresh <TimeAgo Value="@lr"/></span>
            } else {
                <span class="text-muted">never refreshed</span>
            }
            <button type="button" class="btn-mini" disabled="@(_refreshing || _binaryUnavailable)" @onclick="RefreshBinary">@(_refreshing ? "Refreshing..." : "Refresh")</button>
        </div>
    </div>
    @if (_binaryUnavailable) {
        <p class="text-muted text-xs m-0">Binary route status unavailable (no database).</p>
    }
    <div class="wbx-kpis routes-kpis">
        <div class="wbx-kpi">
            <span class="wbx-kpi-n">@Kpi(_binary?.Discovered)</span>
            <span class="wbx-kpi-k">discovered</span>
        </div>
        <div class="wbx-kpi @(_binary is { NewCount: > 0 } ? "wbx-kpi-warn" : "")">
            <span class="wbx-kpi-n">@Kpi(_binary?.NewCount)</span>
            <span class="wbx-kpi-k">new</span>
        </div>
        <div class="wbx-kpi @(_binary is { DriftCount: > 0 } ? "wbx-kpi-warn" : "")">
            <span class="wbx-kpi-n">@Kpi(_binary?.DriftCount)</span>
            <span class="wbx-kpi-k">drift</span>
        </div>
        <div class="wbx-kpi">
            <span class="wbx-kpi-n">@EditedCount</span>
            <span class="wbx-kpi-k">edited</span>
        </div>
    </div>

    <div class="routes-filter-row">
        <FilterInput Class="reg-filter-input" AriaLabel="Filter routes by path" @bind-Value="_filter"/>
        <div class="settings-seg routes-seg" role="radiogroup" aria-label="Route source">
            <button type="button" class="seg-btn @(_view == ViewAll ? "active" : "")" @onclick="() => _view = ViewAll">All</button>
            <button type="button" class="seg-btn @(_view == ViewEdited ? "active" : "")" @onclick="() => _view = ViewEdited">Edited</button>
            <button type="button" class="seg-btn @(_view == ViewDrift ? "active" : "")" @onclick="() => _view = ViewDrift">Drift</button>
            <button type="button" class="seg-btn @(_view == ViewOrphan ? "active" : "")" @onclick="() => _view = ViewOrphan">Orphan</button>
        </div>
    </div>

    @if (_loading) {
        <p class="text-muted text-sm m-0">Loading routes...</p>
    } else if (FilteredRows().Count == 0) {
        <p class="text-muted text-sm m-0">No routes match this filter.</p>
    } else {
        <div class="reg-wrap admin-routes-scroll">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Path</th><th>Request</th><th>Response</th><th>Flags</th><th>State</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in FilteredRows()) {
                    var drift = DriftFor(row.Path);
                    <tr class="reg-row cursor-pointer @(drift.Count > 0 ? "route-drift-row" : "")" @onclick="() => ToggleExpand(row)">
                        <td class="mono text-xs">@row.Path</td>
                        <td>@TypeCell(row.Effective?.Request, row.Effective?.RequestWrapped == true)</td>
                        <td>@TypeCell(row.Effective?.Response, row.Effective?.ResponseWrapped == true)</td>
                        <td class="text-muted text-xs">@(row.Effective?.PathParam == true ? "path param" : "")</td>
                        <td class="routes-state-cell">
                            @if (row.Override is not null) {
                                <span class="route-flag text-accent">edited</span>
                            }
                            @if (row.Source == "db") {
                                <span class="route-flag text-muted">db</span>
                            }
                            @if (row.Source == "orphan") {
                                <span class="route-flag text-err">orphan</span>
                            }
                            @if (BinaryPopulated && !IsInBinary(row.Path)) {
                                <span class="route-flag text-muted">no binary</span>
                            }
                            @if (drift.Count > 0) {
                                <span class="route-flag route-flag-warn">drift</span>
                            }
                        </td>
                    </tr>
                    @if (_expandedPath == row.Path) {
                        <tr class="reg-edit-row">
                            <td colspan="5">
                                <div class="routes-editor">
                                    <p class="text-muted text-xs m-0">@(row.Source == "orphan" ? "No matching route in routes.yaml or the binary catalog." : "Saved overrides persist to the database and win over routes.yaml.")</p>
                                    <div class="routes-editor-grid">
                                        <label class="routes-editor-field">
                                            Request type
                                            <select class="field-input" value="@(_draftRequest ?? "")" @onchange="OnDraftRequest">
                                                <option value="">(none)</option>
                                                @if (_draftRequest is { } dr && !KnownType(dr)) {
                                                    <option value="@dr">@dr (not in proto)</option>
                                                }
                                                <optgroup label="Request types">
                                                    @foreach (var m in _roles.Request) {
                                                        <option value="@m">@m</option>
                                                    }
                                                </optgroup>
                                                <optgroup label="Other messages">
                                                    @foreach (var m in _roles.RequestOthers) {
                                                        <option value="@m">@m</option>
                                                    }
                                                </optgroup>
                                            </select>
                                        </label>
                                        <label class="routes-editor-field">
                                            Response type
                                            <select class="field-input" value="@(_draftResponse ?? "")" @onchange="OnDraftResponse">
                                                <option value="">(none)</option>
                                                @if (_draftResponse is { } ds && !KnownType(ds)) {
                                                    <option value="@ds">@ds (not in proto)</option>
                                                }
                                                <optgroup label="Response types">
                                                    @foreach (var m in _roles.Response) {
                                                        <option value="@m">@m</option>
                                                    }
                                                </optgroup>
                                                <optgroup label="Other messages">
                                                    @foreach (var m in _roles.ResponseOthers) {
                                                        <option value="@m">@m</option>
                                                    }
                                                </optgroup>
                                            </select>
                                        </label>
                                    </div>
                                    <div class="routes-editor-checks">
                                        <label class="settings-check"><input type="checkbox" checked="@_draftRequestWrapped" @onchange="e => _draftRequestWrapped = e.Value is true"/> Request wrapped (AuthenticatedMessage)</label>
                                        <label class="settings-check"><input type="checkbox" checked="@_draftResponseWrapped" @onchange="e => _draftResponseWrapped = e.Value is true"/> Response wrapped (AuthenticatedMessage)</label>
                                        <label class="settings-check"><input type="checkbox" checked="@_draftPathParam" @onchange="e => _draftPathParam = e.Value is true"/> Path param</label>
                                    </div>
                                    @if (drift.Count > 0) {
                                        <div class="flex flex-col gap-1">
                                            @foreach (var d in drift) {
                                                <div class="routes-drift-row">
                                                    <span class="route-flag @(d.Reliable ? "route-flag-warn" : "text-muted")">@(d.Reliable ? "drift" : "advisory")</span>
                                                    <span class="text-muted">@d.Field: effective @(d.EffectiveValue ?? "-") vs binary @(d.BinaryValue ?? "-")</span>
                                                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="() => ApplyDrift(d)">Apply</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="flex gap-1">
                                        @if (row.Source != "orphan") {
                                            <button type="button" class="btn-mini" disabled="@_busy" @onclick="() => Save(row)">Save</button>
                                        }
                                        @if (row.Override is not null) {
                                            <button type="button" class="btn-mini btn-danger" disabled="@_busy" @onclick="() => Clear(row.Path)">Reset</button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }

</div>

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);
    const string ViewAll = "all";
    const string ViewEdited = "edited";
    const string ViewDrift = "drift";
    const string ViewOrphan = "orphan";

    IReadOnlyList<RouteRow> _rows = [];
    MessageRoles _roles = MessageRoles.Empty;
    RouteBinaryStatus? _binary;
    bool _binaryUnavailable;
    bool _loading = true;
    bool _busy;
    bool _refreshing;
    string _filter = "";
    string _view = ViewAll;
    string? _expandedPath;

    string? _draftRequest;
    string? _draftResponse;
    bool _draftRequestWrapped;
    bool _draftResponseWrapped;
    bool _draftPathParam;

    protected override async Task OnInitializedAsync() {
        await LoadRoles();
        LoadRoutes();
        LoadBinary();
    }

    RenderFragment TypeCell(string? name, bool locked) => @<span class="routes-type">
        @if (name is null) {
            <span class="text-muted">none</span>
        } else {
            <span class="mono">@name</span>
        }
        @if (locked) {
            <Icon Name="lock" Class="icon-sm"/>
        }
    </span>;

    static string Kpi(int? value) => value?.ToString() ?? "-";

    int EditedCount => _rows.Count(r => r.Override is not null);

    void OnDraftRequest(ChangeEventArgs e) {
        _draftRequest = Blank(e.Value?.ToString());
    }

    void OnDraftResponse(ChangeEventArgs e) {
        _draftResponse = Blank(e.Value?.ToString());
    }

    static string? Blank(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;

    bool KnownType(string name) =>
        _roles.Request.Contains(name) || _roles.Response.Contains(name) || _roles.Other.Contains(name);

    async Task Changed() {
        LoadRoutes();
        LoadBinary();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    List<RouteRow> FilteredRows() {
        IEnumerable<RouteRow> rows = _rows;
        if (!string.IsNullOrEmpty(_filter)) rows = rows.Where(r => r.Path.Contains(_filter, StringComparison.OrdinalIgnoreCase));
        rows = _view switch {
            ViewEdited => rows.Where(r => r.Override is not null),
            ViewDrift => rows.Where(r => DriftFor(r.Path).Count > 0),
            ViewOrphan => rows.Where(r => r.Source == "orphan"),
            _ => rows
        };
        return rows.ToList();
    }

    List<RouteDriftRow> DriftFor(string path) {
        if (_binary is null) return [];
        return _binary.Drift.Where(d => d.Path == path && d.Field != "new").ToList();
    }

    bool IsInBinary(string path) {
        return _binary?.Rows.Any(r => r.Path == path) ?? false;
    }

    bool BinaryPopulated => _binary is { Rows.Count: > 0 };

    void ToggleExpand(RouteRow row) {
        if (_expandedPath == row.Path) {
            _expandedPath = null;
            return;
        }

        _expandedPath = row.Path;
        SeedDrafts(row);
    }

    void SeedDrafts(RouteRow row) {
        var draft = row.Draft();
        _draftRequest = draft.Request;
        _draftResponse = draft.Response;
        _draftRequestWrapped = draft.RequestWrapped ?? false;
        _draftResponseWrapped = draft.ResponseWrapped ?? false;
        _draftPathParam = draft.PathParam ?? false;
    }

    async Task LoadRoles() {
        _roles = await Client().OneAsync<MessageRoles>("/api/inspector/message-roles", Logger) ?? MessageRoles.Empty;
    }

    void LoadRoutes() {
        _rows = RouteReport.Rows();
        _loading = false;
    }

    void LoadBinary() {
        _binary = RouteReport.Binary();
        _binaryUnavailable = _binary is null;
    }

    async Task RefreshBinary() {
        _refreshing = true;
        StateHasChanged();
        try {
            var res = await Client().PostAsync("/api/admin/routes/binary/refresh", null);
            if (res.StatusCode == HttpStatusCode.ServiceUnavailable) {
                Say(false, "refresh unavailable (no database)");
            } else if (res.IsSuccessStatusCode) {
                var d = await res.Content.ReadFromJsonAsync<EndpointRebuildResult>(JsonOpts);
                Say(true, d is null
                    ? "refresh complete"
                    : $"refresh complete: {d.Discovered} discovered, {d.New} new, {d.DriftCount} drift" +
                      (string.IsNullOrEmpty(d.Note) ? "" : $" ({d.Note})"));
            } else {
                Say(false, $"refresh failed: HTTP {(int)res.StatusCode}");
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Say(false, $"refresh failed: {ex.Message}");
        }

        await Changed();
        await LoadRoles();
        _refreshing = false;
    }

    async Task Save(RouteRow row) {
        var body = new UpsertRouteOverride(_draftRequest, _draftResponse, _draftRequestWrapped, _draftResponseWrapped, _draftPathParam);
        _busy = true;
        try {
            var res = await Client().PutAsJsonAsync($"/api/admin/routes/{row.Path}", body, JsonOpts);
            Say(res.IsSuccessStatusCode, res.IsSuccessStatusCode ? $"saved {row.Path}" : $"save failed: HTTP {(int)res.StatusCode}");
            if (res.IsSuccessStatusCode) _expandedPath = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Say(false, $"save failed: {ex.Message}");
        }

        await Changed();
        _busy = false;
    }

    async Task Clear(string path) {
        _busy = true;
        try {
            var res = await Client().DeleteAsync($"/api/admin/routes/{path}");
            Say(res.IsSuccessStatusCode, res.IsSuccessStatusCode ? $"cleared {path}" : $"clear failed: HTTP {(int)res.StatusCode}");
            if (res.IsSuccessStatusCode) _expandedPath = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Say(false, $"clear failed: {ex.Message}");
        }

        await Changed();
        _busy = false;
    }

    async Task ApplyDrift(RouteDriftRow d) {
        if (d.BinaryValue is null || !bool.TryParse(d.BinaryValue, out var value)) return;
        if (_rows.FirstOrDefault(r => r.Path == d.Path) is not { } row) return;
        _busy = true;
        var body = d.Field switch {
            "requestWrapped" => row.Draft() with { RequestWrapped = value },
            "responseWrapped" => row.Draft() with { ResponseWrapped = value },
            _ => row.Draft()
        };
        try {
            var res = await Client().PutAsJsonAsync($"/api/admin/routes/{d.Path}", body, JsonOpts);
            Say(res.IsSuccessStatusCode, res.IsSuccessStatusCode ? $"applied {d.Field} for {d.Path}" : $"apply failed: HTTP {(int)res.StatusCode}");
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Say(false, $"apply failed: {ex.Message}");
        }

        await Changed();
        if (_expandedPath == d.Path && _rows.FirstOrDefault(r => r.Path == d.Path) is { } fresh) {
            SeedDrafts(fresh);
        }

        _busy = false;
    }

    void Say(bool ok, string text) {
        Toasts.Push(ok ? StatusNoteKind.Ok : StatusNoteKind.Error, text);
    }

}
