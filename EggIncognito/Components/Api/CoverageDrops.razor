@using EggSharp.GameData.Artifacts
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Coverage
@inject DropStats Stats

<div class="table-scroll cdp">
    <table class="data-table cdp-table">
        <thead>
        <tr>
            <th>
                <span class="cdp-head">
                    <span>Drops</span>
                    @if (_summary is { } s) {
                        <span class="cdp-tick" title="Consumes observed"><Icon Name="scroll-text" Class="icon-sm text-muted"/><span class="mono">@s.Observations.ToString("N0")</span></span>
                    }
                </span>
            </th>
            <th class="cdp-fit">@(Certain ? "Count" : "Avg")</th>
            @if (!Certain) {
                <th class="cdp-fit">Chance</th>
                <th class="cdp-fit">Range</th>
                <th class="tools">
                    <label class="form-check cdp-toggle" title="Show the full count distribution under each drop">
                        <input type="checkbox" checked="@_detail" @onchange="e => _detail = e.Value is true"/>detail
                    </label>
                </th>
            }
        </tr>
        </thead>
        <tbody>
        @if (_summary is null) {
            <tr>
                <td colspan="@Columns" class="muted"><Icon Name="loader" Class="icon-sm text-muted"/></td>
            </tr>
        } else if (_summary.Rows.Count == 0 && _summary.Gold is null && _summary.Piggy is null) {
            <tr>
                <td colspan="@Columns" class="muted">No drops recorded for this cell.</td>
            </tr>
        } else {
            @if (_summary.Gold is { } gold) {
                <tr @key="@("gold")" class="@(ShowDetail ? "cdp-open" : "")">
                    <td>
                        <span class="cdp-drop">
                            <span class="cdp-disc bg-r-0">
                                <img src="@GoldIcon" alt="" loading="lazy"/>
                            </span>
                            <span>Golden eggs</span>
                        </span>
                    </td>
                    <td class="mono cdp-nowrap">@Avg(gold.Mean)</td>
                    @if (!Certain) {
                        <td class="mono cdp-nowrap">@NumberFormat.Percent(gold.Share)</td>
                        <td class="mono cdp-nowrap">
                            @if (gold.Min.Equals(gold.Max)) {
                                @Avg(gold.Min)
                            } else {
                                <span>@Avg(gold.Min)<span class="muted"> - </span>@Avg(gold.Max)</span>
                            }
                        </td>
                        <td></td>
                    }
                </tr>
                @if (ShowDetail && gold.Buckets.Count > 1) {
                        <CoverageDistributionBar TBucket="GoldBucket" @key="@("gold|bar")" Buckets="gold.Buckets" Total="_summary.Observations" Share="b => b.Share" Observations="b => b.Observations">
                            <SegmentText Context="b">
                                <span class="mono cdp-seg-text">@Avg(b.Amount)</span>
                            </SegmentText>
                            <Title Context="b">
                                <span class="tt-title">@Avg(b.Amount) golden eggs</span>
                            </Title>
                        </CoverageDistributionBar>
                }
            }
            @if (_summary.Piggy is { } piggy) {
                <tr @key="@("piggy")" class="@(ShowDetail ? "cdp-open" : "")">
                    <td>
                        <span class="cdp-drop">
                            <span class="cdp-disc bg-r-0">
                                <img src="@PiggyIcon" alt="" loading="lazy"/>
                            </span>
                            <span>Piggy fill</span>
                        </span>
                    </td>
                    <td class="mono cdp-nowrap">@Avg(piggy.Mean)</td>
                    @if (!Certain) {
                        <td class="mono cdp-nowrap">@NumberFormat.Percent(piggy.Share)</td>
                        <td class="mono cdp-nowrap">
                            @if (piggy.Min.Equals(piggy.Max)) {
                                @Avg(piggy.Min)
                            } else {
                                <span>@Avg(piggy.Min)<span class="muted"> - </span>@Avg(piggy.Max)</span>
                            }
                        </td>
                        <td></td>
                    }
                </tr>
                @if (ShowDetail && piggy.Buckets.Count > 1) {
                    <CoverageDistributionBar TBucket="GoldBucket" @key="@("piggy|bar")" Buckets="piggy.Buckets" Total="_summary.Observations" Share="b => b.Share" Observations="b => b.Observations">
                        <SegmentText Context="b">
                            <span class="mono cdp-seg-text">@Avg(b.Amount)</span>
                        </SegmentText>
                        <Title Context="b">
                            <span class="tt-title">@Avg(b.Amount) piggy fill</span>
                        </Title>
                    </CoverageDistributionBar>
                }
            }
            @foreach (var row in _summary.Rows) {
                <tr @key="Key(row)" class="@(ShowDetail ? "cdp-open" : "")">
                    <td>
                        <span class="cdp-drop">
                            <span class="cdp-disc @RarityTokens.Background(RarityIndex(row.Rarity))">
                                <img src="@Icon(row)" alt="" loading="lazy"/>
                            </span>
                            <span class="@RarityTokens.Text(RarityIndex(row.Rarity))">@Label(row)</span>
                        </span>
                    </td>
                    <td class="mono cdp-nowrap">@Avg(row.Mean)</td>
                    @if (!Certain) {
                        <td class="mono cdp-nowrap">@NumberFormat.Percent(row.Share)</td>
                        <td class="mono cdp-nowrap">
                            @if (row.Min == row.Max) {
                                @row.Min
                            } else {
                                <span>@row.Min<span class="muted"> - </span>@row.Max</span>
                            }
                        </td>
                        <td></td>
                    }
                </tr>
                @if (ShowDetail && row.Buckets.Count > 1) {
                    <CoverageDistributionBar TBucket="DropBucket" @key="@(Key(row) + "|bar")" Buckets="row.Buckets" Total="_summary.Observations" Share="b => b.Share" Observations="b => b.Observations">
                        <SegmentText Context="b">
                            <span class="mono cdp-seg-text">@b.Count</span>
                        </SegmentText>
                        <Title Context="b">
                            <span class="tt-title">@b.Count @(b.Count == 1 ? "drop" : "drops")</span>
                        </Title>
                    </CoverageDistributionBar>
                }
            }
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public string Family { get; set; } = "";

    [Parameter, EditorRequired] public string Level { get; set; } = "";

    [Parameter, EditorRequired] public string Rarity { get; set; } = "";

    [Parameter] public int Version { get; set; }

    const string Fragment = "_FRAGMENT";

    static readonly string[] RarityNames = [.. Enum.GetNames<Ei.ArtifactSpec.Types.Rarity>()];

    static readonly string[] LevelNames = [.. Enum.GetNames<Ei.ArtifactSpec.Types.Level>()];

    bool _detail;
    DropSummary? _summary;

    bool Certain => _summary is { } s
                    && (s.Gold is null || s.Gold.Share >= 1)
                    && (s.Piggy is null || s.Piggy.Share >= 1)
                    && s.Rows.All(r => r.Share >= 1);

    bool ShowDetail => _detail && !Certain;

    int Columns => Certain ? 2 : 5;
    string? _loadedKey;

    protected override async Task OnParametersSetAsync() {
        string key = $"{Family}|{Level}|{Rarity}|{Version}";
        if (key == _loadedKey) return;
        bool sameCell = _loadedKey?.StartsWith($"{Family}|{Level}|{Rarity}|", StringComparison.Ordinal) == true;
        _loadedKey = key;
        if (!sameCell) _summary = null;
        _summary = await Stats.ForCellAsync(Family, Level, Rarity, CancellationToken.None);
    }

    static readonly string? GoldIcon = EggIcons.Asset("icon", RewardIconMap.Stem(Ei.RewardType.Gold, null)!);

    static readonly string? PiggyIcon = EggIcons.Asset("icon", RewardIconMap.Stem(Ei.RewardType.PiggyFill, null)!);

    static string Key(DropRow r) => $"{r.Name}|{r.Level}|{r.Rarity}";

    static int RarityIndex(string rarity) => Math.Max(0, Array.FindIndex(RarityNames, n => n.Equals(rarity, StringComparison.OrdinalIgnoreCase)));

    static int LevelIndex(string level) => Math.Max(0, Array.FindIndex(LevelNames, n => n.Equals(level, StringComparison.OrdinalIgnoreCase)));

    static string Icon(DropRow r) => EggIncognito.Services.Artifacts.ArtifactTreeBuilder.Icon(r.Name, LevelIndex(r.Level));

    static string Label(DropRow r) {
        if (r.Name.EndsWith(Fragment, StringComparison.Ordinal))
            return EggIcons.Pretty(r.Name[..^Fragment.Length].Replace("_STONE", "")) + " Frag";
        bool stone = r.Name.EndsWith("_STONE", StringComparison.Ordinal);
        string name = EggIcons.Pretty(r.Name);
        return stone ? $"T{LevelIndex(r.Level) + 2} {name}" : name;
    }

    internal static string Avg(double v) => FormattableString.Invariant($"{v:0.##}");
}
