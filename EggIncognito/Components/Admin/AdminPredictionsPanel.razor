@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Services.Config
@using EggIncognito.Services.Events
@using EggIncognito.Services.Predictions.Training
@inherits AdminPaneBase

<AdminPaneHead Title="Predictions" Facts="@Stats"/>
<PaneNotice @ref="_notice"/>
<SubSectionHead>Horizons</SubSectionHead>
<FlexRow Gap="true">
    <label>Event days
        <input type="number" class="horizons-field" min="30" max="365" @bind="_eventDays" @bind:event="oninput"/>
    </label>
    <label>Contract weeks
        <input type="number" class="horizons-field" min="4" max="104" @bind="_contractWeeks" @bind:event="oninput"/>
    </label>
    <label>Step days
        <input type="number" class="horizons-field" min="1" @bind="_stepDays" @bind:event="oninput"/>
    </label>
    <label>Refresh hours
        <input type="number" class="horizons-field" min="1" @bind="_refreshHours" @bind:event="oninput"/>
    </label>
    <button type="button" class="btn-mini" disabled="@_savingHorizons" @onclick="SaveAndRetrain">Save and retrain</button>
</FlexRow>
<p class="muted horizons-steps">
    Events steps (days): @StepsLine(PredictionDomainKey.Events) &middot;
    Contracts steps (weeks): @StepsLine(PredictionDomainKey.Contracts)
</p>
@foreach (var csv in _statuses.Select(s => s.LastCsvTune).OfType<CsvTuneResult>()) {
    <p class="muted horizons-steps">
        Last CSV tune (@csv.Domain, @csv.Samples rows): @csv.Scoreboard[0].Strategy
        @if (csv.Colleggtibles is { Count: > 0 } c) {
            <text>, colleggtibles @c[0].Strategy</text>
        }
    </p>
}
<SubSectionHead>Training</SubSectionHead>
<TableScroll>
    <table class="data-table">
        <thead>
        <tr>
            <th>Domain</th>
            <th>State</th>
            <th>Progress</th>
            <th>Started</th>
            <th>Elapsed</th>
            <th>Version</th>
            <th>Horizons</th>
            <th>Strategy</th>
            <th>Runner-up delta</th>
            <th>Error</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var s in _statuses) {
            <tr>
                <td>@s.Domain</td>
                <td class="@StateClass(s.State)">@s.State</td>
                <td>
                    <div class="progress-meter">
                        <div class="progress-meter-fill" style="@MeterStyle(s)"></div>
                    </div>
                </td>
                <td class="mono">@(s.StartedAt is { } st ? FormatTime(st) : "-")</td>
                <td class="mono">@Elapsed(s)</td>
                <td class="mono">@s.Version</td>
                <td class="mono">@HorizonsText(s)</td>
                <td class="mono">@(s.Strategy ?? "-")</td>
                <td class="mono">@(s.RunnerUpDelta is { } d ? d.ToString("0.000") : "-")</td>
                <td class="muted">@(s.Error ?? "-")</td>
                <td>
                    <FlexRow Gap="true">
                        <button type="button" class="btn-mini" disabled="@IsBusy(s.Domain)" @onclick="@(() => Retrain(s.Domain))">Retrain</button>
                        <button type="button" class="btn-mini" disabled="@(IsBusy(s.Domain) || !CanCancel(s))" @onclick="@(() => Cancel(s.Domain))">Cancel</button>
                    </FlexRow>
                </td>
            </tr>
        }
        </tbody>
    </table>
</TableScroll>

@code {
    PaneNotice? _notice;
    TrainingStatus[] _statuses = [];
    readonly HashSet<PredictionDomainKey> _busy = [];

    int _eventDays = 183;
    int _contractWeeks = 52;
    int _stepDays = 30;
    int _refreshHours = 24;
    bool _horizonsLoaded;
    bool _savingHorizons;

    IEnumerable<string> Stats => _statuses.Length == 0
        ? []
        : [$"{_statuses.Count(s => s.State == TrainingState.Running)} running", $"{_statuses.Count(s => s.State == TrainingState.Failed)} failed"];

    protected override IReadOnlyList<string> Topics => [AdminTopics.Predictions];

    protected override async Task LoadAsync() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/v1/predictions/training");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _statuses = res.Json<TrainingStatus[]>() ?? [];
        if (!_horizonsLoaded && _statuses.Select(s => s.Horizons).FirstOrDefault(h => h is not null) is { } horizons) {
            _eventDays = horizons.EventDays;
            _contractWeeks = horizons.ContractWeeks;
            _stepDays = horizons.StepDays;
            _refreshHours = horizons.RefreshHours;
            _horizonsLoaded = true;
        }
    }

    string StepsLine(PredictionDomainKey domain) {
        var steps = _statuses.FirstOrDefault(s => s.Domain == domain)?.Steps;
        return steps is { Length: > 0 } ? string.Join(", ", steps) : "-";
    }

    static string HorizonsText(TrainingStatus s) =>
        s.Horizons is { } h ? $"{h.EventDays}d / {h.ContractWeeks}w / {h.StepDays}d step / {h.RefreshHours}h" : "-";

    async Task SaveAndRetrain() {
        if (Api is null) return;
        _savingHorizons = true;
        _notice?.Clear();

        var res = await Api.PutJsonAsync("/api/v1/predictions/horizons", new {
            eventDays = _eventDays, contractWeeks = _contractWeeks, stepDays = _stepDays, refreshHours = _refreshHours
        });
        bool ok = res.Ok;
        _notice?.Result(ok, ok ? "saved, retraining" : $"save failed: {res.Describe()}");
        _savingHorizons = false;
        await LoadAsync();
        if (ok) Notifier.Publish(AdminTopics.Predictions);
    }

    bool IsBusy(PredictionDomainKey domain) => _busy.Contains(domain);

    static bool CanCancel(TrainingStatus s) => s.State is TrainingState.Queued or TrainingState.Running;

    static string StateClass(TrainingState state) {
        return state switch {
            TrainingState.Running => "text-accent",
            TrainingState.Done => "text-ok",
            TrainingState.Failed => "text-err",
            _ => "muted"
        };
    }

    static string MeterStyle(TrainingStatus s) {
        var pct = Math.Clamp(s.Percent, 0, 100);
        return FormattableString.Invariant($"width: {pct:0}%;");
    }

    static string Elapsed(TrainingStatus s) {
        if (s.StartedAt is not { } started) return "-";
        var end = s.FinishedAt ?? DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var seconds = Math.Max(0, end - started);
        return FormattableString.Invariant($"{seconds:0}s");
    }

    string FormatTime(double startTimestamp) {
        return ViewerClock.At(Services, UnixSeconds.ToTime(startTimestamp)).ToString("yyyy-MM-dd HH:mm");
    }

    async Task Retrain(PredictionDomainKey domain) {
        if (Api is null) return;
        _busy.Add(domain);
        _notice?.Clear();
        var res = await Api.PostAsync($"/api/v1/predictions/training/{domain}/run?force=true", TimeSpan.FromMinutes(10));
        _notice?.Result(res.Ok, res.Ok ? "queued" : $"retrain failed: {res.Describe()}");
        _busy.Remove(domain);
        await LoadAsync();
        if (res.Ok) Notifier.Publish(AdminTopics.Predictions);
    }

    async Task Cancel(PredictionDomainKey domain) {
        if (Api is null) return;
        _busy.Add(domain);
        _notice?.Clear();
        var res = await Api.PostAsync($"/api/v1/predictions/training/{domain}/cancel", TimeSpan.FromMinutes(10));
        _notice?.Result(res.Ok, res.Ok ? "cancelled" : $"cancel failed: {res.Describe()}");
        _busy.Remove(domain);
        await LoadAsync();
        if (res.Ok) Notifier.Publish(AdminTopics.Predictions);
    }
}
