@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Events
@using EggIncognito.Services.Events
@inherits AdminPaneBase

<AdminPaneHead Title="Events" Facts="@Stats"/>
<PaneNotice @ref="_notice"/>
<SubSectionHead>Store</SubSectionHead>
<TableScroll>
    <table class="data-table">
        <tbody>
        <tr>
            <td>total</td><td class="mono">@(_stats?.Total ?? 0)</td>
        </tr>
        <tr>
            <td>device</td><td class="mono">@(_stats?.Device ?? 0)</td>
        </tr>
        <tr>
            <td>carpet</td><td class="mono">@(_stats?.Carpet ?? 0)</td>
        </tr>
        </tbody>
    </table>
</TableScroll>
@if (_latest.Count > 0) {
    <SubSectionHead>Recent</SubSectionHead>
    <TableScroll>
        <table class="data-table">
            <tbody>
            @foreach (var e in _latest) {
                <tr>
                    <td>@e.Type</td><td class="muted">@FormatStart(e.StartTimestamp)</td>
                </tr>
            }
            </tbody>
        </table>
    </TableScroll>
}
@if (_model is { } model) {
    <SubSectionHead>Model</SubSectionHead>
    <TableScroll>
        <table class="data-table">
            <thead>
            <tr>
                <th>Rule</th>
                <th>Type</th>
                <th>Evidence</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var rule in model.Rules) {
                <tr>
                    <td>@KindLabel(rule.Kind)</td>
                    <td class="mono">@(rule.Type ?? (rule.Ultra ? "ultra" : "pool"))</td>
                    <td class="muted">@rule.Summary</td>
                </tr>
            }
            </tbody>
        </table>
    </TableScroll>
    <SubSectionHead>Backtest, last @model.Sweep.Windows.Count windows of @EggIncognito.Services.Predictions.EventBacktest.SweepHorizonDays days</SubSectionHead>
    <TableScroll>
        <table class="data-table">
            <thead>
            <tr>
                <th>Rule</th>
                <th>Predicted</th>
                <th>Slot hit</th>
                <th>Type hit</th>
                <th>Top 3 hit</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var k in model.Sweep.Totals.Where(t => t.Predicted > 0)) {
                <tr>
                    <td>@KindLabel(k.Kind)</td>
                    <td class="mono">@k.Predicted</td>
                    <td class="mono">@Rate(k.SlotHit, k.Predicted)</td>
                    <td class="mono">@Rate(k.TypeHit, k.Predicted)</td>
                    <td class="mono">@Rate(k.Top3Hit, k.Predicted)</td>
                </tr>
            }
            </tbody>
        </table>
    </TableScroll>
}
<Note Small="true" Gap="true">Historical data courtesy of carpetsage/egg. Backfill tools live in the Maintenance pane.</Note>

@code {
    PaneNotice? _notice;
    EventStatsResponse? _stats;
    EventModelResponse? _model;
    List<GameEventDto> _latest = [];

    static string KindLabel(EventRuleKind kind) {
        return kind switch {
            EventRuleKind.WeekdayLane => "Weekday lane",
            EventRuleKind.Alternating => "Alternating lane",
            EventRuleKind.Periodic => "Periodic lane",
            EventRuleKind.Pool => "Weekday pool",
            _ => "Ultra cadence"
        };
    }

    static string Rate(int hit, int total) {
        return total == 0 ? "-" : $"{hit}/{total} ({hit * 100 / total}%)";
    }

    IEnumerable<string> Stats => _stats is null
        ? []
        : [$"{_stats.Total} total", $"{_stats.Device} device", $"{_stats.Carpet} carpet"];

    string FormatStart(double startTimestamp) {
        return ViewerClock.At(Services, UnixSeconds.ToTime(startTimestamp)).ToString("yyyy-MM-dd");
    }

    protected override IReadOnlyList<string> Topics => [AdminTopics.Events];

    protected override Task LoadAsync() {
        return Load();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/events/stats");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _stats = res.Json<EventStatsResponse>();

        var latestRes = await Api.GetAsync("/api/v1/events?limit=3");
        _latest = latestRes.Ok ? latestRes.Json<GameEventListResponse>()?.Events.ToList() ?? [] : [];

        var modelRes = await Api.GetAsync("/api/v1/events/model");
        _model = modelRes.Ok ? modelRes.Json<EventModelResponse>() : null;
    }

}
