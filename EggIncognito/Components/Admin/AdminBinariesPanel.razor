@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Core
@using EggIncognito.Models.AdminUi
@using EggIncognito.Models.Devices
@inherits AdminPaneBase

<AdminPaneHead Title="Stored binaries" Facts="@Stats">
    <Tools>
        <button type="button" class="btn-mini" disabled="@_busy" @onclick="PokeHarvest">Poke harvest</button>
        <button type="button" class="btn-mini" disabled="@_busy" @onclick="Load">Refresh</button>
    </Tools>
</AdminPaneHead>
<PaneNotice @ref="_notice"/>
@if (_rows.Count == 0) {
    <p class="text-muted text-sm m-0">No stored binaries. Pulled automatically on the device maintenance schedule when a new version is installed.</p>
} else {
    <div class="reg-wrap">
        <table class="data-table">
            <thead>
            <tr>
                <th>Version</th><th>Platform</th><th>SHA-256</th><th>Size</th><th>Symbols</th><th>Source</th><th>Pulled</th><th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var b in _rows) {
                <tr>
                    <td>
                        <VersionLine App="@b.Version"/>
                    </td>
                    <td>
                        <PlatformIcon Platform="@b.Platform"/>
                    </td>
                    <td class="mono text-xs">@ShaShort(b.Sha256)</td>
                    <td class="mono text-xs">@ByteFormat.Mb(b.ByteSize, "F1")</td>
                    <td class="mono text-xs">
                        @EffectiveSymbols(b).ToString("N0")
                        @if (b.EffectiveSymbols > b.NativeSymbols) {
                            <span class="text-muted"> (@b.NativeSymbols.ToString("N0") native + graft)</span>
                        }
                    </td>
                    <td class="text-xs">@b.Source</td>
                    <td class="text-muted text-xs">@b.PulledAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        <div class="flex gap-1 justify-end">
                            <button type="button" class="btn-mini btn-danger" disabled="@_busy" @onclick="() => Delete(b.Platform, b.Version)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="admin-panel-head mt-4">
    <div class="sub-section-head">Symbolized reference</div>
    <div class="flex gap-1 items-center">
        <span class="text-muted text-xs">@_refs.Count total</span>
        <button type="button" class="btn-mini" disabled="@_refBusy" @onclick="LoadRefs">Refresh</button>
    </div>
</div>
@if (_refs.Count == 0) {
    <p class="text-muted text-sm m-0">No symbolized reference stored. Upload a symbolized .ipa, or its Mach-O executable with a version, to graft names onto stripped builds.</p>
} else {
    <div class="reg-wrap">
        <table class="data-table">
            <thead>
            <tr>
                <th>Version</th><th>SHA-256</th><th>Size</th><th>Symbols</th><th>Uploaded</th><th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in _refs) {
                <tr>
                    <td>
                        <VersionLine App="@r.Version"/>
                    </td>
                    <td class="mono text-xs">@ShaShort(r.Sha256)</td>
                    <td class="mono text-xs">@ByteFormat.Mb(r.ByteSize, "F1")</td>
                    <td class="mono text-xs">@r.SymbolCount.ToString("N0")</td>
                    <td class="text-muted text-xs">@r.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        <div class="flex gap-1 justify-end">
                            <button type="button" class="btn-mini btn-danger" disabled="@_refBusy" @onclick="() => DeleteRef(r.Version)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<div class="flex gap-1 items-center flex-wrap mt-2">
    <InputFile id="@RefInputId" class="text-xs"/>
    <input class="reg-filter-input w-auto" placeholder="version (raw Mach-O only)" value="@_refVersion" @oninput="OnRefVersion"/>
    <button type="button" class="btn-mini" disabled="@_refBusy" @onclick="UploadRef">@(_refBusy ? "Working..." : "Upload")</button>
</div>

@code {
    const string RefInputId = "symRefFile";

    PaneNotice? _notice;

    List<StoredBinaryRow> _rows = [];
    bool _busy;

    List<SymbolizedReferenceRow> _refs = [];
    bool _refBusy;
    string _refVersion = "";
    IJSObjectReference? _upload;

    IEnumerable<string> Stats => [$"{_rows.Count} binaries", $"{_refs.Count} symbolized"];

    protected override IReadOnlyList<string> Topics => [AdminTopics.Binaries];

    protected override async Task LoadAsync() {
        await Load();
        await LoadRefs();
    }

    public override async ValueTask DisposeAsync() {
        await _upload.DisposeModuleQuietAsync();
        await base.DisposeAsync();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/decomp/stored-binaries");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _rows = res.Json<StoredBinaryList>()?.Binaries ?? [];
    }

    async Task PokeHarvest() {
        if (Api is null) return;
        _busy = true;
        _notice?.Say("queued a harvest on the device agent...");
        StateHasChanged();
        var res = await Api.PostAsync("/api/devices/poke-all");
        _notice?.Result(res.Ok, res.Ok
            ? "harvest queued; binaries land here once the agent finishes"
            : $"poke failed: {res.Describe()}");
        await Load();
        _busy = false;
    }

    async Task Delete(string platform, string version) {
        if (Api is null) return;
        _busy = true;
        _notice?.Clear();
        var res = await Api.DeleteAsync(
            $"/api/decomp/stored-binaries/{Uri.EscapeDataString(platform)}/{Uri.EscapeDataString(version)}");
        _notice?.Result(res.Ok, res.Ok ? $"deleted {platform} {version}" : $"delete failed: {res.Describe()}");
        await Load();
        _busy = false;
        if (res.Ok) Notifier.Publish(AdminTopics.Binaries);
    }

    void OnRefVersion(ChangeEventArgs e) {
        _refVersion = e.Value?.ToString() ?? "";
    }

    async Task LoadRefs() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/decomp/symbolized");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _refs = res.Json<List<SymbolizedReferenceRow>>() ?? [];
    }

    async Task UploadRef() {
        _refBusy = true;
        _notice?.Say("uploading...");
        StateHasChanged();
        try {
            _upload ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", InteropAsset.Url(Env, "./interop/fileUpload.js"));
            var url = string.IsNullOrWhiteSpace(_refVersion)
                ? "/api/decomp/symbolized"
                : $"/api/decomp/symbolized?version={Uri.EscapeDataString(_refVersion.Trim())}";
            var res = await _upload.InvokeAsync<InteropUploadResult?>(
                "upload", TimeSpan.FromMinutes(30), RefInputId, url);
            if (res is { Status: 200 }) {
                _notice?.Ok("stored symbolized reference");
                _refVersion = "";
                Notifier.Publish(AdminTopics.Binaries);
            } else {
                _notice?.Fail(res is null
                    ? "upload failed: no response from the browser"
                    : $"upload failed ({res.Status}): {Snippet(res.Body)}");
            }
        }
        catch (Exception ex) {
            _notice?.Fail($"upload failed: {ex.Message}");
        }
        finally {
            await LoadRefs();
            _refBusy = false;
        }
    }

    async Task DeleteRef(string version) {
        if (Api is null) return;
        _refBusy = true;
        _notice?.Clear();
        var res = await Api.DeleteAsync($"/api/decomp/symbolized/{Uri.EscapeDataString(version)}");
        _notice?.Result(res.Ok, res.Ok ? $"deleted {version}" : $"delete failed: {res.Describe()}");
        await LoadRefs();
        _refBusy = false;
        if (res.Ok) Notifier.Publish(AdminTopics.Binaries);
    }

    static string Snippet(string body) {
        var text = body.Trim();
        return text.Length > 300 ? text[..300] : text;
    }

    static string ShaShort(string sha) {
        return sha.Length >= 12 ? sha[..12] : sha;
    }

    static int EffectiveSymbols(StoredBinaryRow b) {
        return b.EffectiveSymbols > 0 ? b.EffectiveSymbols : b.NativeSymbols;
    }

}
