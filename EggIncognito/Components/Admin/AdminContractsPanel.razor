@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Contracts
@using EggIncognito.Services.Events
@inherits AdminPaneBase

<AdminPaneHead Title="Contracts" Facts="@Stats"/>
<PaneNotice @ref="_notice"/>
<SubSectionHead>Store</SubSectionHead>
<TableScroll>
    <table class="data-table">
        <tbody>
        <tr>
            <td>total</td><td class="mono">@(_stats?.Total ?? 0)</td>
        </tr>
        <tr>
            <td>device</td><td class="mono">@(_stats?.Device ?? 0)</td>
        </tr>
        <tr>
            <td>carpet</td><td class="mono">@(_stats?.Carpet ?? 0)</td>
        </tr>
        <tr>
            <td>latest</td><td class="mono">@(_stats?.Latest is { } l ? FormatStart(l) : "-")</td>
        </tr>
        </tbody>
    </table>
</TableScroll>
<SubSectionHead>Backfill</SubSectionHead>
<FlexRow>
    <button type="button" class="btn-mini" disabled="@_busy" @onclick="SweepSnapshots">Sweep snapshots</button>
</FlexRow>
<FlexRow Gap="true">
    <input class="reg-filter-input ac-input" placeholder="@CarpetPlaceholder" @bind="_carpetUrl"/>
    <button type="button" class="btn-mini" disabled="@_busy" @onclick="ImportCarpet">Import carpet</button>
</FlexRow>
@if (_model is { } model) {
    <SubSectionHead>Model</SubSectionHead>
    <TableScroll>
        <table class="data-table">
            <thead>
            <tr>
                <th>Slot</th>
                <th>Grid</th>
                <th>Pool</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var pool in model.Pools) {
                var grid = model.Grid.FirstOrDefault(g => g.Kind == pool.Kind);
                <tr>
                    <td>@KindLabel(pool.Kind)</td>
                    <td class="muted">@(grid?.Summary ?? "no weekday in the last 180 days")</td>
                    <td class="muted">@pool.Summary</td>
                </tr>
            }
            </tbody>
        </table>
    </TableScroll>
    <SubSectionHead>Backtest, last @model.Sweep.Windows.Count windows of @EggIncognito.Services.Predictions.ContractBacktest.SweepHorizonSlots slots</SubSectionHead>
    <TableScroll>
        <table class="data-table">
            <thead>
            <tr>
                <th>Slot</th>
                <th>Predicted</th>
                <th>Slot hit</th>
                <th>Top 1 hit</th>
                <th>Top 5 hit</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var k in model.Sweep.Totals.Where(t => t.Predicted > 0)) {
                <tr>
                    <td>@KindLabel(k.Kind)</td>
                    <td class="mono">@k.Predicted</td>
                    <td class="mono">@Rate(k.SlotHit, k.Predicted)</td>
                    <td class="mono">@Rate(k.Top1Hit, k.Predicted)</td>
                    <td class="mono">@Rate(k.Top5Hit, k.Predicted)</td>
                </tr>
            }
            </tbody>
        </table>
    </TableScroll>
}
<Note Small="true" Gap="true">Historical data courtesy of carpetsage/egg.</Note>

@code {
    PaneNotice? _notice;
    ContractStatsResponse? _stats;
    ContractModelResponse? _model;

    static string KindLabel(ContractSlotKind kind) {
        return kind switch {
            ContractSlotKind.NewContract => "New",
            ContractSlotKind.Leggacy => "Leggacy",
            ContractSlotKind.PeLeggacy => "PE leggacy",
            ContractSlotKind.PeLeggacyUltra => "PE leggacy, ultra only",
            _ => kind.ToString()
        };
    }

    static string Rate(int hit, int total) {
        return total == 0 ? "-" : $"{hit}/{total} ({hit * 100 / total}%)";
    }
    bool _busy;
    string _carpetUrl = "";

    IEnumerable<string> Stats => _stats is null
        ? []
        : [$"{_stats.Total} total", $"{_stats.Device} device", $"{_stats.Carpet} carpet"];

    static string CarpetPlaceholder =>
        "https://raw.githubusercontent.com/carpetsage/egg/master/periodicals/data/contracts.json";

    string FormatStart(double startTimestamp) {
        return ViewerClock.At(Services, UnixSeconds.ToTime(startTimestamp)).ToString("yyyy-MM-dd");
    }

    protected override IReadOnlyList<string> Topics => [AdminTopics.Contracts];

    protected override Task LoadAsync() {
        return Load();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/contracts/stats");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _stats = res.Json<ContractStatsResponse>();

        var modelRes = await Api.GetAsync("/api/v1/contracts/model");
        _model = modelRes.Ok ? modelRes.Json<ContractModelResponse>() : null;
    }

    async Task SweepSnapshots() {
        if (Api is null) return;
        _busy = true;
        _notice?.Clear();
        var res = await Api.PostAsync("/api/admin/contracts/sweep-snapshots", TimeSpan.FromMinutes(10));
        _notice?.Result(res.Ok,
            res.Ok ? SweepResultText(res.Json<ContractBackfillResult>()) : $"sweep failed: {res.Describe()}");
        await Load();
        _busy = false;
        if (res.Ok) Notifier.Publish(AdminTopics.Contracts);
    }

    async Task ImportCarpet() {
        if (Api is null) return;
        _busy = true;
        _notice?.Clear();
        var res = await Api.PostJsonAsync(
            "/api/admin/contracts/import-carpet", new ContractCarpetImportRequest(_carpetUrl), TimeSpan.FromMinutes(10));
        _notice?.Result(res.Ok,
            res.Ok ? SweepResultText(res.Json<ContractBackfillResult>()) : $"import failed: {res.Describe()}");
        await Load();
        _busy = false;
        if (res.Ok) Notifier.Publish(AdminTopics.Contracts);
    }

    static string SweepResultText(ContractBackfillResult? r) {
        return r is null
            ? "ok"
            : $"scanned {r.Scanned}, inserted {r.Inserted}, updated {r.Updated}, skipped {r.Skipped}";
    }

}
