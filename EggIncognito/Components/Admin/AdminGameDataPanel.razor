@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Admin
@inherits AdminPaneBase

<AdminPaneHead Title="Game data" Facts="@Stats">
    <Tools>
        <button type="button" class="btn-mini" disabled="@_busy" @onclick="Load">Refresh</button>
    </Tools>
</AdminPaneHead>
<PaneNotice @ref="_notice"/>
@if (_data is not null) {
    <div class="reg-wrap">
        <table class="data-table">
            <thead>
            <tr>
                <th>Id</th><th>Present</th><th>Updated</th><th>Bytes</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var d in _data.Documents) {
                <tr>
                    <td class="mono text-xs">@d.Id</td>
                    <td class="text-xs">@(d.Present ? "yes" : "no")</td>
                    <td class="text-xs">
                        @if (d.UpdatedAt is { } updated) {
                            <TimeAgo Value="@updated"/>
                        }
                    </td>
                    <td class="mono text-xs">@d.Bytes</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="sub-section-head">Rebuild</div>
<div class="flex gap-1 items-center">
    <label class="text-xs flex gap-1 items-center">
        <input type="checkbox" checked="@_force" @onchange="e => _force = e.Value is true"/>
        force
    </label>
    <button type="button" class="btn-mini" disabled="@_busy" @onclick="Rebuild">Rebuild</button>
</div>
@if (_rebuildResult is not null) {
    <pre class="result-pre">@RebuildLines()</pre>
}

<div class="sub-section-head">Import</div>
<div class="flex gap-1 items-center">
    <input class="reg-filter-input w-auto" placeholder="document id" @bind="_importId"/>
    <button type="button" class="btn-mini" disabled="@_busy" @onclick="Import">Import</button>
</div>
<textarea class="reg-filter-input w-full mono text-xs" rows="6" placeholder="{ }" @bind="_importJson"></textarea>

@code {
    PaneNotice? _notice;
    GameDataStatusResponse? _data;
    GameDataRebuildResponse? _rebuildResult;
    bool _force;
    bool _busy;
    string _importId = "";
    string _importJson = "";

    IEnumerable<string> Stats {
        get {
            if (_data is null) return [];
            var present = _data.Documents.Count(d => d.Present);
            return [$"{present}/{_data.Documents.Count} docs", $"{_data.Missing.Count} missing"];
        }
    }

    protected override IReadOnlyList<string> Topics => [AdminTopics.GameData];

    protected override Task LoadAsync() {
        return Load();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/gamedata");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _data = res.Json<GameDataStatusResponse>();
    }

    async Task Rebuild() {
        if (Api is null) return;
        _busy = true;
        _notice?.Clear();
        var res = await Api.PostAsync($"/api/admin/gamedata/rebuild?force={(_force ? "true" : "false")}", TimeSpan.FromMinutes(5));
        if (res.Ok) {
            _rebuildResult = res.Json<GameDataRebuildResponse>();
            _notice?.Ok(_rebuildResult is null
                ? "rebuild complete"
                : $"rebuild complete: {_rebuildResult.Results.Count} docs" +
                  (string.IsNullOrEmpty(_rebuildResult.Binary) ? "" : $" ({_rebuildResult.Binary})"));
        } else {
            _rebuildResult = null;
            _notice?.Fail($"rebuild failed: {res.Describe()}");
        }

        await Load();
        _busy = false;
        Notifier.Publish(AdminTopics.GameData);
        Notifier.Publish(AdminTopics.DataStatus);
    }

    string RebuildLines() {
        if (_rebuildResult is null) return "";
        return string.Join('\n', _rebuildResult.Results.Select(r =>
            $"{r.Id}: {r.Status} count={r.Count?.ToString() ?? "-"} bytes={r.Bytes?.ToString() ?? "-"}" +
            (string.IsNullOrEmpty(r.Note) ? "" : $" ({r.Note})")));
    }

    async Task Import() {
        if (Api is null || string.IsNullOrWhiteSpace(_importId)) return;
        _busy = true;
        _notice?.Clear();
        var res = await Api.SendAsync("POST", $"/api/admin/gamedata/{Uri.EscapeDataString(_importId.Trim())}", _importJson);
        _notice?.Result(res.Ok, res.Ok ? $"imported {_importId.Trim()}" : $"import failed: {res.Describe()}");
        await Load();
        _busy = false;
        if (res.Ok) {
            Notifier.Publish(AdminTopics.GameData);
            Notifier.Publish(AdminTopics.DataStatus);
        }
    }

}
