@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Admin
@inherits AdminPaneBase

<AdminPaneHead Title="Game data" Facts="@Stats">
    <Tools>
        <label class="form-check agd-force">
            <input type="checkbox" checked="@_force" @onchange="e => _force = e.Value is true"/>force
        </label>
        <button type="button" class="btn-mini" disabled="@_busy" @onclick="Rebuild">Rebuild</button>
        <button type="button" class="btn-mini" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
    </Tools>
</AdminPaneHead>
<PaneNotice @ref="_notice"/>
@if (_data is not null) {
    <SubSectionHead>Documents</SubSectionHead>
    <TableScroll>
        <table class="data-table">
            <thead>
            <tr>
                <th></th><th>Document</th><th class="agd-num">Rows</th><th class="agd-num">Size</th><th>Updated</th><th>Sources</th><th>Last rebuild</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var d in _data.Documents) {
                var state = DocState(d);
                <tr @key="d.Id" class="@(d.Present ? "" : "agd-row-off")">
                    <td><span class="agd-dot agd-dot-@state" title="@StateLabel(state)"></span></td>
                    <td class="mono">@d.Id</td>
                    <td class="mono agd-num">@(d.Count?.ToString("N0") ?? "")</td>
                    <td class="mono agd-num">@(d.Bytes is { } b ? Size(b) : "")</td>
                    <td class="small">
                        @if (d.UpdatedAt is { } updated) {
                            <TimeAgo At="@updated" Class="time-ago"/>
                        } else if (d.Unbuildable) {
                            <span class="agd-warn">no extraction pipeline</span>
                        } else {
                            <span class="muted">missing</span>
                        }
                    </td>
                    <td>
                        <span class="agd-sources">
                            @foreach (var s in d.Sources) {
                                <span class="agd-src agd-src-@s.Origin" title="@SourceTitle(s)">@s.Field<span class="agd-src-k">@s.Origin</span></span>
                            }
                        </span>
                    </td>
                    <td class="small muted">@RebuildNote(d.Id)</td>
                </tr>
            }
            </tbody>
        </table>
    </TableScroll>

    <SubSectionHead>Config</SubSectionHead>
    @if (_data.Config.Platforms.Count == 0) {
        <Note>No stored config.</Note>
    } else {
        <div class="agd-cards">
            @foreach (var p in _data.Config.Platforms) {
                <div class="agd-card" @key="p.Platform">
                    <PlatformIcon Platform="@p.Platform"/>
                    <span class="agd-card-k">@p.Platform</span>
                    <span class="mono">@Size(p.Bytes)</span>
                    <TimeAgo At="@p.SavedAt" Class="time-ago"/>
                </div>
            }
        </div>
    }

    var empty = _data.Fixtures.Where(f => f.Status != "ok").ToList();
    <SubSectionHead>Fixtures</SubSectionHead>
    <div class="agd-cards">
        <div class="agd-card"><span class="agd-card-k">served</span><span class="mono">@(_data.Fixtures.Count - empty.Count)</span></div>
        <div class="agd-card"><span class="agd-card-k">empty</span><span class="mono">@empty.Count</span></div>
    </div>
    <details class="agd-fixtures">
        <summary>All @_data.Fixtures.Count fixtures</summary>
        <TableScroll>
            <table class="data-table">
                <thead>
                <tr>
                    <th>Name</th><th class="agd-num">Size</th><th>Updated</th><th>Status</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var f in _data.Fixtures) {
                    <tr @key="f.Name">
                        <td class="mono">@f.Name</td>
                        <td class="mono agd-num">@Size(f.Bytes)</td>
                        <td class="small"><TimeAgo At="@f.UpdatedAt" Class="time-ago"/></td>
                        <td class="small @(f.Status == "ok" ? "" : "muted")">@f.Status</td>
                    </tr>
                }
                </tbody>
            </table>
        </TableScroll>
    </details>
}

<SubSectionHead>Import</SubSectionHead>
<FlexRow>
    <input class="reg-filter-input agd-input" placeholder="document id" @bind="_importId"/>
    <button type="button" class="btn-mini" disabled="@_busy" @onclick="Import">Import</button>
</FlexRow>
<textarea class="reg-filter-input agd-json" rows="6" placeholder="{ }" @bind="_importJson"></textarea>

@code {
    PaneNotice? _notice;
    GameDataStatusResponse? _data;
    GameDataRebuildResponse? _rebuildResult;
    bool _force;
    bool _busy;
    string _importId = "";
    string _importJson = "";

    IEnumerable<string> Stats {
        get {
            if (_data is null) return [];
            int present = _data.Documents.Count(d => d.Present);
            return [$"{present}/{_data.Documents.Count} documents", $"config {(_data.Config.Enabled ? "on" : "off")}"];
        }
    }

    protected override IReadOnlyList<string> Topics => [AdminTopics.GameData, AdminTopics.Binaries];

    protected override async Task LoadAsync() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/gamedata");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _data = res.Json<GameDataStatusResponse>();
    }

    static string DocState(GameDataDocRow d) => d.Present ? "ok" : d.Unbuildable ? "warn" : "err";

    static string StateLabel(string state) => state switch {
        "ok" => "Stored",
        "warn" => "No extraction pipeline yet",
        _ => "Missing"
    };

    static string SourceTitle(GameDataSourceRow s) =>
        string.Join(" / ", new[] { s.Origin, s.Locator, s.Method }.Where(x => !string.IsNullOrEmpty(x)));

    static string Size(long bytes) => bytes switch {
        >= 1_048_576 => FormattableString.Invariant($"{bytes / 1_048_576d:0.#} MB"),
        >= 1024 => FormattableString.Invariant($"{bytes / 1024d:0.#} KB"),
        _ => FormattableString.Invariant($"{bytes} B")
    };

    string RebuildNote(string id) {
        if (_rebuildResult?.Results.FirstOrDefault(r => r.Id == id) is not { } r) return "";
        return string.IsNullOrEmpty(r.Note) ? r.Status : $"{r.Status}: {r.Note}";
    }

    async Task Rebuild() {
        if (Api is null) return;
        _busy = true;
        _notice?.Clear();
        var res = await Api.PostAsync($"/api/admin/gamedata/rebuild?force={(_force ? "true" : "false")}", TimeSpan.FromMinutes(5));
        if (res.Ok) {
            _rebuildResult = res.Json<GameDataRebuildResponse>();
            int built = _rebuildResult?.Results.Count(r => r.Status == "built") ?? 0;
            _notice?.Ok($"rebuilt {built} document(s)" +
                        (string.IsNullOrEmpty(_rebuildResult?.Binary) ? "" : $" from {_rebuildResult.Binary}"));
        } else {
            _rebuildResult = null;
            _notice?.Fail($"rebuild failed: {res.Describe()}");
        }

        await LoadAsync();
        _busy = false;
        Notifier.Publish(AdminTopics.GameData);
    }

    async Task Import() {
        if (Api is null || string.IsNullOrWhiteSpace(_importId)) return;
        _busy = true;
        _notice?.Clear();
        var res = await Api.SendAsync("POST", $"/api/admin/gamedata/{Uri.EscapeDataString(_importId.Trim())}", _importJson);
        _notice?.Result(res.Ok, res.Ok ? $"imported {_importId.Trim()}" : $"import failed: {res.Describe()}");
        await LoadAsync();
        _busy = false;
        if (res.Ok) Notifier.Publish(AdminTopics.GameData);
    }

}
