@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Components.Protos
@using EggIncognito.Models.Notifications
@inherits AdminPaneBase

<AdminPaneHead Title="Notifications" Facts="[StatText]">
    <Tools>
        <button type="button" class="btn-mini" @onclick="OpenWorkbench">Manage subscriptions</button>
    </Tools>
</AdminPaneHead>
<PaneNotice @ref="_notice"/>
@if (_feed is { Total: > 0 } feed) {
    <div class="meta-dots text-xs text-muted mb-2">
        @foreach (var fact in Summary(feed)) {
            <span>@fact</span>
        }
    </div>
}
@if (_owners.Count > 0) {
    <div class="sub-section-head">Owners</div>
    <div class="reg-wrap">
        <table class="data-table">
            <tbody>
            @foreach (var owner in _owners) {
                <tr>
                    <td>@owner.Key</td><td class="mono">@owner.Value</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
} else {
    <div class="text-sm text-muted">no subscriptions</div>
}

<NotificationsWorkbenchModal AdminScope="true" @ref="_workbench"/>

@code {
    PaneNotice? _notice;
    AdminFeedListResponse? _feed;
    List<KeyValuePair<string, int>> _owners = [];
    NotificationsWorkbenchModal? _workbench;

    string StatText => _feed is { } feed ? $"{feed.Total} subs" : "";

    static IEnumerable<string> Summary(AdminFeedListResponse feed) {
        return [$"{feed.ActiveCount} active", $"{feed.Total - feed.ActiveCount} inactive", $"{feed.Owners} owners"];
    }

    protected override IReadOnlyList<string> Topics => [AdminTopics.Notifications];

    protected override Task LoadAsync() {
        return Load();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/admin/feed/subscriptions");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _notice?.Clear();
        _feed = res.Json<AdminFeedListResponse>();
        _owners = _feed is null
            ? []
            : _feed.Rows
                .GroupBy(r => r.OwnerUsername, StringComparer.OrdinalIgnoreCase)
                .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
                .OrderByDescending(p => p.Value)
                .ThenBy(p => p.Key, StringComparer.OrdinalIgnoreCase)
                .ToList();
    }

    Task OpenWorkbench() {
        return _workbench?.Open() ?? Task.CompletedTask;
    }

}
