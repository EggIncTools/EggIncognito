@rendermode @(RenderModes.InteractiveServer)
@using System.Text.Json
@using EggIncognito.Core.Services
@using EggIncognito.Models.AdminUi
@inherits AdminPaneBase

<AdminPaneHead Title="API console" Facts="[Stat]"/>
<PaneNotice @ref="_notice"/>
@if (_endpoints.Count == 0) {
    <Note>No endpoints available.</Note>
} else {
    <div class="console-layout">
        <div class="console-left">
            <input class="reg-filter-input console-search" placeholder="Search method, route, namespace…" @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKeyDown"/>
            <div class="console-chips">
                @foreach (var m in Methods) {
                    <button type="button" class="@($"console-chip console-{m.ToLower()}{(_activeMethods.Contains(m) ? " console-chip-active" : "")}")" @onclick="() => ToggleMethod(m)">@m</button>
                }
            </div>
            <div class="console-list">
                @{ var groups = Grouped().ToList(); }
                @if (groups.Count == 0) {
                    <div class="console-empty">No matches.</div>
                }
                @foreach (var group in groups) {
                    <div class="console-group-header">@group.Key <span class="console-group-count">@group.Count()</span></div>
                    @foreach (var e in group) {
                        <div class="console-row@(_selected == e ? " console-row-selected" : "")" @onclick="() => Select(e)">
                            <span class="console-method console-@(e.Method.ToLower())">@e.Method</span>
                            <span class="console-route">@e.Route</span>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="console-right">
            @if (_selected is null) {
                <Note>Select an endpoint to build a request.</Note>
            } else {
                <div class="console-line">
                    <span class="console-method console-@(_selected.Method.ToLower())">@_selected.Method</span>
                    <span class="console-route">@_selected.Route</span>
                </div>

                @foreach (var p in _selected.Query) {
                    <label class="console-param">
                        @p.Name <span class="console-param-meta">(@p.Source, @p.Type)</span>
                        <input class="reg-filter-input" @bind="_paramValues[p.Name]"/>
                    </label>
                }

                @if (_selected.HasFile) {
                    <div class="console-k">File</div>
                    <InputFile OnChange="OnFile" class="console-file"/>
                    @if (_fileName is not null) {
                        <div class="console-note">@_fileName (@(_fileBytes?.Length ?? 0) bytes)</div>
                    }
                }

                @if (_selected.HasBody) {
                    <div class="console-k">JSON body @(_selected.BodyType is not null ? $"({_selected.BodyType})" : "")</div>
                    <textarea class="reg-filter-input console-body" rows="4" @bind="_body" placeholder="{ }"></textarea>
                }

                <button class="btn-primary console-send" @onclick="Send" disabled="@_busy">@(_busy ? "Sending…" : "Send")</button>

                @if (_status is not null) {
                    @if (_isBinary) {
                        <div class="console-note">Binary response (@_respBytes bytes). <a href="@_blobUrl" download="@_downloadName">Download</a></div>
                    } else {
                        <pre class="result-pre console-out">@_response</pre>
                    }
                }
            }
        </div>
    </div>
}

@code {
    static readonly string[] Methods = ["GET", "POST", "PUT", "PATCH", "DELETE"];

    PaneNotice? _notice;
    List<ConsoleEndpoint> _endpoints = [];
    ConsoleEndpoint? _selected;
    string _search = "";
    readonly HashSet<string> _activeMethods = new(StringComparer.OrdinalIgnoreCase);

    string Stat => $"{_endpoints.Count} endpoints";

    readonly Dictionary<string, string?> _paramValues = new(StringComparer.Ordinal);
    string _body = "";
    byte[]? _fileBytes;
    string? _fileName;

    bool _busy, _isBinary;
    int? _status;
    string _response = "";
    long _respBytes;
    string? _blobUrl;
    string? _downloadName;

    protected override IReadOnlyList<string> Topics => [AdminTopics.Console];

    protected override async Task LoadAsync() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/console/endpoints");
        _endpoints = res.Ok ? res.Json<ConsoleEndpointList>()?.Endpoints?.ToList() ?? [] : [];
        if (_selected is null) return;
        var key = Key(_selected);
        _selected = _endpoints.FirstOrDefault(x => Key(x) == key);
    }

    IEnumerable<ConsoleEndpoint> Filtered() {
        var terms = _search.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return _endpoints.Where(e =>
            (_activeMethods.Count == 0 || _activeMethods.Contains(e.Method)) &&
            terms.All(t => e.Method.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                            e.Route.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                            Namespace(e).Contains(t, StringComparison.OrdinalIgnoreCase)));
    }

    IEnumerable<IGrouping<string, ConsoleEndpoint>> Grouped() {
        return Filtered().GroupBy(Namespace).OrderBy(g => g.Key, StringComparer.Ordinal);
    }

    static string Namespace(ConsoleEndpoint e) {
        var parts = e.Route.TrimStart('/').Split('/');
        return parts.Length >= 2 && parts[0] == "api" ? parts[1] : parts[0];
    }

    static string Key(ConsoleEndpoint e) {
        return $"{e.Method} {e.Route}";
    }

    void ToggleMethod(string m) {
        if (!_activeMethods.Add(m)) _activeMethods.Remove(m);
    }

    void OnSearchKeyDown(KeyboardEventArgs e) {
        if (e.Key != "Enter") return;
        var first = Filtered().FirstOrDefault();
        if (first is not null) Select(first);
    }

    void Select(ConsoleEndpoint? e) {
        _selected = e;
        _paramValues.Clear();
        if (e is not null)
            foreach (var p in e.Query)
                _paramValues[p.Name] = "";
        _body = "";
        _fileBytes = null;
        _fileName = null;
        _status = null;
        _notice?.Clear();
        _response = "";
        _isBinary = false;
        _blobUrl = null;
    }

    async Task OnFile(InputFileChangeEventArgs e) {
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(200_000_000).CopyToAsync(ms);
        _fileBytes = ms.ToArray();
        _fileName = e.File.Name;
    }

    async Task Send() {
        if (_selected is null || Api is null) return;
        _busy = true;
        _status = null;
        _notice?.Clear();
        _isBinary = false;
        _blobUrl = null;

        var route = _selected.Route;
        var query = new List<string>();
        foreach (var p in _selected.Query) {
            var v = _paramValues.GetValueOrDefault(p.Name) ?? "";
            if (p.Source == "Path") route = route.Replace($"{{{p.Name}}}", Uri.EscapeDataString(v));
            else if (!string.IsNullOrEmpty(v)) query.Add($"{Uri.EscapeDataString(p.Name)}={Uri.EscapeDataString(v)}");
        }

        if (query.Count > 0) route += "?" + string.Join("&", query);

        var res = _selected.HasFile && _fileBytes is not null
            ? await Api.SendFileAsync(_selected.Method, route, "file", _fileName ?? "file", _fileBytes)
            : await Api.SendAsync(_selected.Method, route,
                _selected.HasBody && !string.IsNullOrWhiteSpace(_body) ? _body : null);

        _status = res.Status;
        var line = res.Status == 0 ? res.Body : $"HTTP {res.Status} ({res.ContentType})";
        if (res.Ok) _notice?.Say(line);
        else _notice?.Fail(line);

        if (res.Binary) {
            _respBytes = res.ByteSize;
            _isBinary = true;
            _blobUrl = $"data:{res.ContentType};base64,{res.Body}";
            _downloadName = res.FileName ?? "response.bin";
        } else {
            _response = res.Status == 0 ? "" : Pretty(res.Body);
        }

        _busy = false;
    }

    static string Pretty(string json) {
        try {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, JsonPresets.Indented);
        } catch {
            return json;
        }
    }

}
