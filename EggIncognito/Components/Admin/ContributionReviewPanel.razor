@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Contributions
@inherits BrowserApiComponentBase

<div class="contrib-review">
    @if (_note is not null) {
        <div class="contribute-note" role="status">
            <span>@_note</span>
            <button type="button" class="icon-btn icon-btn-sm" aria-label="Dismiss" @onclick="@(() => _note = null)">
                <Icon Name="x"/>
            </button>
        </div>
    }

    <h4 class="contrib-sub">By contributor</h4>
    @if (_tallies.Count == 0) {
        <p class="text-muted text-sm my-0">Nothing awaiting review.</p>
    } else {
        <table class="data-table contrib-table">
            <thead>
            <tr>
                <th>Contributor</th>
                <th>Kind</th>
                <th class="num">Rows</th>
                <th>Oldest</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var t in _tallies) {
                <tr>
                    <td class="mono">@Who(t.ContributorName, t.ContributorUserId)</td>
                    <td class="mono">@t.Kind</td>
                    <td class="num">@t.Submitted</td>
                    <td>
                        <TimeAgo Value="@t.Oldest" Hover="false"/>
                    </td>
                    <td class="contrib-row-actions">
                        <button type="button" class="btn-mini" disabled="@_busy"
                                @onclick="@(() => ReviewContributor(t, true))">
                            Accept all
                        </button>
                        <button type="button" class="btn-mini" disabled="@_busy"
                                @onclick="@(() => ReviewContributor(t, false))">
                            Reject all
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

    <h4 class="contrib-sub">Rows @(_total > 0 ? $"({_shown} of {_total})" : "")</h4>
    @if (_rows.Count == 0) {
        <p class="text-muted text-sm my-0">No submitted rows.</p>
    } else {
        <div class="contrib-rows">
            @foreach (var r in _rows) {
                <div class="contrib-row">
                    <label class="contrib-pick">
                        <input type="checkbox" checked="@_picked.Contains(r.Id)"
                               @onchange="@(e => Pick(r.Id, e.Value is true))"/>
                    </label>
                    <span class="contrib-summary">@r.Summary</span>
                    <span class="contrib-meta">@(r.ClientVersion ?? "unknown")</span>
                    <span class="contrib-meta">@Who(r.ContributorName, r.ContributorUserId)</span>
                    <button type="button" class="btn-mini"
                            @onclick="@(() => _open = _open == r.Id ? null : r.Id)">
                        @(_open == r.Id ? "Hide" : "Payload")
                    </button>
                </div>
                @if (_open == r.Id) {
                    <pre class="contrib-payload">@r.Payload</pre>
                }
            }
        </div>

        <div class="contrib-actions">
            <button type="button" class="btn-mini" @onclick="PickAll">
                @(_picked.Count == _rows.Count ? "Clear all" : "Select all")
            </button>
            <button type="button" class="btn-primary" disabled="@(_busy || _picked.Count == 0)"
                    @onclick="@(() => ReviewPicked(true))">
                Accept @_picked.Count
            </button>
            <button type="button" class="btn-secondary" disabled="@(_busy || _picked.Count == 0)"
                    @onclick="@(() => ReviewPicked(false))">
                Reject @_picked.Count
            </button>
            @if (_shown < _total) {
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="LoadMore">Load more</button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    const int PageSize = 100;

    readonly List<ContributionPendingRowDto> _rows = [];
    readonly HashSet<long> _picked = [];
    List<ContributionTallyDto> _tallies = [];
    int _total;
    int _shown;
    long? _open;
    bool _busy;
    string? _note;

    protected override async Task OnApiReadyAsync() {
        await ReloadAsync();
    }

    public async Task ReloadAsync() {
        _rows.Clear();
        _picked.Clear();
        _shown = 0;
        await LoadTalliesAsync();
        await LoadPageAsync();
    }

    async Task LoadTalliesAsync() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/contributions/tallies");
        if (!res.Ok) return;
        var dto = res.Json<ContributionTalliesDto>();
        _tallies = dto is null ? [] : [.. dto.Tallies];
    }

    async Task LoadPageAsync() {
        if (Api is null) return;
        var res = await Api.GetAsync($"/api/contributions/pending?skip={_shown}&take={PageSize}");
        if (!res.Ok) return;
        var page = res.Json<ContributionPendingPageDto>();
        if (page is null) return;
        _total = page.Total;
        _rows.AddRange(page.Rows);
        _shown = _rows.Count;
    }

    async Task LoadMore() {
        _busy = true;
        try {
            await LoadPageAsync();
        }
        finally {
            _busy = false;
        }
    }

    void Pick(long id, bool on) {
        if (on) _picked.Add(id);
        else _picked.Remove(id);
    }

    void PickAll() {
        if (_picked.Count == _rows.Count) {
            _picked.Clear();
            return;
        }

        foreach (var r in _rows) _picked.Add(r.Id);
    }

    async Task ReviewPicked(bool approve) {
        if (Api is null || _picked.Count == 0) return;
        _busy = true;
        try {
            var res = await Api.PostJsonAsync("/api/contributions/review",
                new ContributionReviewRequest { Ids = [.. _picked], Approve = approve });
            _note = res.Ok
                ? $"{(approve ? "Accepted" : "Rejected")} {_picked.Count} rows."
                : "Review failed.";
            await ReloadAsync();
            await OnChanged.InvokeAsync();
        }
        finally {
            _busy = false;
        }
    }

    async Task ReviewContributor(ContributionTallyDto tally, bool approve) {
        if (Api is null) return;
        _busy = true;
        try {
            var res = await Api.PostJsonAsync("/api/contributions/review-contributor",
                new ContributionContributorReviewRequest {
                    ContributorUserId = tally.ContributorUserId,
                    Kind = tally.Kind,
                    Approve = approve
                });
            _note = res.Ok
                ? $"{(approve ? "Accepted" : "Rejected")} {tally.Submitted} rows."
                : "Review failed.";
            await ReloadAsync();
            await OnChanged.InvokeAsync();
        }
        finally {
            _busy = false;
        }
    }

    static string Who(string? name, Guid id) {
        return string.IsNullOrWhiteSpace(name) ? id.ToString("N")[..8] : name;
    }

}
