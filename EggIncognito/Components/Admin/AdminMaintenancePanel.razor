@rendermode @(RenderModes.InteractiveServer)
@using System.Text.Json
@using EggIncognito.Models.Admin
@using EggIncognito.Models.Events
@inherits AdminPaneBase

<AdminPaneHead Title="Maintenance" Facts="[Stat]"/>
<PaneNotice @ref="_notice"/>
<div class="reg-wrap">
    <table class="data-table">
        <tbody>
        <tr>
            <td>Backfill capture user ids</td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="BackfillCaptureUserIds">Run</button>
            </td>
            <td class="text-xs">@Result("backfill-capture")</td>
        </tr>
        <tr>
            <td>Backfill owner/author user ids</td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="BackfillOwnerAuthorUserIds">Run</button>
            </td>
            <td class="text-xs">@Result("backfill-owner")</td>
        </tr>
        <tr>
            <td>Proto realign</td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="RealignProtos">@(_realignArmed ? "Confirm realign" : "Run")</button>
            </td>
            <td class="text-xs">@Result("realign")</td>
        </tr>
        <tr>
            <td>Refresh endpoint catalog</td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="RefreshEndpoints">Run</button>
            </td>
            <td class="text-xs">@Result("refresh-endpoints")</td>
        </tr>
        <tr>
            <td>
                <div class="flex gap-1 items-center flex-wrap">
                    <span>Config refresh-live</span>
                    <select class="reg-filter-input w-auto" @bind="_livePlatform">
                        <option value="ios">ios</option>
                        <option value="android">android</option>
                    </select>
                </div>
            </td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="RefreshLive">Run</button>
            </td>
            <td class="text-xs">@Result("refresh-live")</td>
        </tr>
        <tr>
            <td>
                <div class="flex gap-1 items-center flex-wrap">
                    <span>Config ingest JSON</span>
                    <select class="reg-filter-input w-auto" @bind="_ingestPlatform">
                        <option value="ios">ios</option>
                        <option value="android">android</option>
                    </select>
                </div>
                <textarea class="reg-filter-input w-full mono text-xs" rows="3" placeholder="ConfigResponse JSON" @bind="_ingestJson"></textarea>
            </td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="IngestJson">Run</button>
            </td>
            <td class="text-xs">@Result("ingest-json")</td>
        </tr>
        <tr>
            <td>
                <div class="flex gap-1 items-center flex-wrap">
                    <span>Icon import</span>
                    <input class="reg-filter-input w-auto" placeholder="name" @bind="_iconName"/>
                    <InputFile OnChange="OnIconFile" class="text-xs"/>
                </div>
            </td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="ImportIcon">Run</button>
            </td>
            <td class="text-xs">@Result("icon-import")</td>
        </tr>
        <tr>
            <td>Sweep event snapshots</td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="SweepEvents">Run</button>
            </td>
            <td class="text-xs">@Result("event-sweep")</td>
        </tr>
        <tr>
            <td>
                <div class="flex gap-1 items-center flex-wrap">
                    <span>Import carpet events</span>
                    <input class="reg-filter-input w-auto" placeholder="@CarpetPlaceholder" @bind="_carpetUrl"/>
                </div>
            </td>
            <td>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="ImportCarpetEvents">Run</button>
            </td>
            <td class="text-xs">@Result("event-carpet")</td>
        </tr>
        </tbody>
    </table>
</div>

<div class="admin-panel-head mt-4">
    <div class="sub-section-head">Stored icons</div>
    <div class="flex gap-1 items-center">
        <span class="text-muted text-xs">@_icons.Count stored</span>
        <button type="button" class="btn-mini" disabled="@_iconBusy" @onclick="LoadIcons">Refresh</button>
    </div>
</div>
@if (_icons.Count == 0) {
    <p class="text-muted text-sm m-0">No stored icons. Import one above; the name is how the app asks for it.</p>
} else {
    <div class="reg-wrap">
        <table class="data-table">
            <thead>
            <tr>
                <th>Name</th><th>Platform</th><th>Type</th><th>Bytes</th><th>SHA-256</th><th>Updated</th><th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var icon in _icons) {
                <tr>
                    <td class="mono text-xs">@icon.Name</td>
                    <td class="text-xs">@icon.Platform</td>
                    <td class="text-xs">@icon.ContentType</td>
                    <td class="mono text-xs">@icon.Bytes.ToString("N0")</td>
                    <td class="mono text-xs">@ShaShort(icon.Sha256)</td>
                    <td class="text-muted text-xs">@icon.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        <div class="flex gap-1 justify-end">
                            <button type="button" class="btn-mini btn-danger" disabled="@_iconBusy" @onclick="() => DeleteIcon(icon.Name)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    const int ToolCount = 9;

    bool _busy;
    bool _realignArmed;
    string _livePlatform = "ios";
    string _ingestPlatform = "ios";
    string _ingestJson = "";
    string _carpetUrl = "";
    string _iconName = "";
    byte[]? _iconBytes;
    string? _iconFileName;
    List<IconRow> _icons = [];
    bool _iconBusy;
    PaneNotice? _notice;
    readonly Dictionary<string, string> _results = new(StringComparer.Ordinal);

    string Stat => $"{ToolCount} tools";

    protected override IReadOnlyList<string> Topics => [AdminTopics.Maintenance];

    protected override Task LoadAsync() {
        return LoadIcons();
    }

    string Result(string key) {
        return _results.GetValueOrDefault(key, "");
    }

    async Task<bool> Run(string key, Func<Task<BrowserResponse>> call) {
        if (Api is null) return false;
        _realignArmed = false;
        _busy = true;
        var res = await call();
        _results[key] = res.Ok ? "ok" : res.Describe();
        _busy = false;
        return res.Ok;
    }

    async Task RunConfig(string key, Func<Task<BrowserResponse>> call) {
        if (Api is null) return;
        _realignArmed = false;
        _busy = true;
        var res = await call();
        if (!res.Ok) {
            _results[key] = res.Describe();
        } else {
            var payload = res.Json<ConfigStoreResult>();
            _results[key] = payload is null || payload.Ok ? "ok" : payload.Diagnostics ?? "failed";
            Notifier.Publish(AdminTopics.DataStatus);
        }

        _busy = false;
    }

    Task BackfillCaptureUserIds() {
        return Run("backfill-capture", () => Api!.PostAsync("/api/admin/backfill-capture-user-ids", TimeSpan.FromMinutes(5)));
    }

    Task BackfillOwnerAuthorUserIds() {
        return Run("backfill-owner", () => Api!.PostAsync("/api/admin/backfill-owner-author-user-ids", TimeSpan.FromMinutes(5)));
    }

    async Task RealignProtos() {
        if (!_realignArmed) {
            _realignArmed = true;
            return;
        }

        await Run("realign", () => Api!.PostAsync("/api/admin/protos/realign?confirm=true", TimeSpan.FromMinutes(5)));
        _realignArmed = false;
    }

    async Task RefreshEndpoints() {
        var ok = await Run("refresh-endpoints",
            () => Api!.PostAsync("/api/config/refresh-endpoints", TimeSpan.FromMinutes(2)));
        if (ok) Notifier.Publish(AdminTopics.Console);
    }

    Task RefreshLive() {
        return RunConfig("refresh-live", () => Api!.PostAsync($"/api/config/{_livePlatform}/refresh-live", TimeSpan.FromMinutes(2)));
    }

    Task IngestJson() {
        var body = JsonSerializer.Serialize(new { json = _ingestJson });
        return RunConfig("ingest-json", () => Api!.SendAsync("POST", $"/api/config/{_ingestPlatform}/ingest-json", body));
    }

    static string CarpetPlaceholder =>
        "https://raw.githubusercontent.com/carpetsage/egg/master/periodicals/data/events.json";

    async Task RunEvents(string key, Func<Task<BrowserResponse>> call) {
        if (Api is null) return;
        _realignArmed = false;
        _busy = true;
        var res = await call();
        if (!res.Ok) {
            _results[key] = res.Describe();
        } else {
            var r = res.Json<EventBackfillResult>();
            _results[key] = r is null
                ? "ok"
                : $"scanned {r.Scanned}, inserted {r.Inserted}, updated {r.Updated}, skipped {r.Skipped}";
            Notifier.Publish(AdminTopics.Events);
        }

        _busy = false;
    }

    Task SweepEvents() {
        return RunEvents("event-sweep", () => Api!.PostAsync("/api/admin/events/sweep-snapshots", TimeSpan.FromMinutes(10)));
    }

    Task ImportCarpetEvents() {
        return RunEvents("event-carpet", () => Api!.PostJsonAsync(
            "/api/admin/events/import-carpet", new CarpetImportRequest(_carpetUrl), TimeSpan.FromMinutes(10)));
    }

    async Task OnIconFile(InputFileChangeEventArgs e) {
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(1_000_000).CopyToAsync(ms);
        _iconBytes = ms.ToArray();
        _iconFileName = e.File.Name;
    }

    async Task ImportIcon() {
        if (_iconBytes is null || string.IsNullOrWhiteSpace(_iconName)) {
            _results["icon-import"] = "select a name and file first";
            return;
        }

        var ok = await Run("icon-import", () => Api!.SendFileAsync(
            "POST", $"/api/admin/icons/{Uri.EscapeDataString(_iconName.Trim())}", "file", _iconFileName ?? "icon.png",
            _iconBytes));
        if (!ok) return;
        _iconName = "";
        _iconBytes = null;
        _iconFileName = null;
        await LoadIcons();
        Notifier.Publish(AdminTopics.Maintenance);
    }

    async Task LoadIcons() {
        if (Api is null) return;
        _iconBusy = true;
        var res = await Api.GetAsync("/api/admin/icons");
        if (res.Ok) {
            _icons = res.Json<IconList>()?.Icons?.ToList() ?? [];
        } else {
            _notice?.Fail($"icon load failed: {res.Describe()}");
        }

        _iconBusy = false;
    }

    async Task DeleteIcon(string name) {
        if (Api is null) return;
        _iconBusy = true;
        _notice?.Clear();
        var res = await Api.DeleteAsync($"/api/admin/icons/{Uri.EscapeDataString(name)}");
        _notice?.Result(res.Ok, res.Ok ? $"deleted {name}" : $"delete failed: {res.Describe()}");
        _iconBusy = false;
        await LoadIcons();
        if (res.Ok) Notifier.Publish(AdminTopics.Maintenance);
    }

    static string ShaShort(string sha) {
        return sha.Length >= 12 ? sha[..12] : sha;
    }

}
