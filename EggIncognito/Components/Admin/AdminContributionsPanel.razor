@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Contributions
@inherits AdminPaneBase

<AdminPaneHead Title="Contributions" Facts="@Stats()"/>
<ContributionReviewPanel @ref="_review" OnChanged="OnReviewed"/>

@code {
    ContributionCountsDto? _counts;
    ContributionReviewPanel? _review;

    protected override IReadOnlyList<string> Topics => [AdminTopics.Contributions];

    IEnumerable<string> Stats() {
        if (_counts is null) return [];
        return [$"{_counts.Submitted:N0} pending, {_counts.Approved:N0} accepted, {_counts.Rejected:N0} rejected"];
    }

    protected override Task LoadAsync() {
        return Load();
    }

    async Task Load() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/contributions/tallies");
        if (!res.Ok) return;
        var dto = res.Json<ContributionTalliesDto>();
        if (dto is null) return;
        _counts = dto.Counts;
    }

    async Task OnReviewed() {
        await Load();
        Notifier.Publish(AdminTopics.Contributions);
    }

}
