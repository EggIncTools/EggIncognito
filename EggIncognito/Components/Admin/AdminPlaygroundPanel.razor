@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Models.Playground
@inherits SelfCallComponentBase

<AdminPaneHead Title="Farm Playground" Facts="@Stats()">
    <Tools>
        <button type="button" class="btn-primary" @onclick="Open">Open playground</button>
    </Tools>
</AdminPaneHead>
@if (_failed) {
    <Note>design and showcase counts are unavailable</Note>
} else if (_designs == 0) {
    <Note>no farms saved yet</Note>
} else {
    <TableScroll>
        <table class="data-table">
            <thead>
            <tr>
                <th>Design</th><th>Updated</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var d in Recent()) {
                <tr>
                    <td class="apg-name">@d.Name</td>
                    <td class="muted">
                        <TimeAgo At="@d.UpdatedAt" Class="time-ago"/>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </TableScroll>
}

@code {
    [Parameter] public EventCallback OnOpen { get; set; }

    DesignRow[] _rows = [];
    int _designs;
    int _presets;
    bool _failed;
    bool _loaded;

    IEnumerable<string> Stats() {
        if (_failed) return [];
        return [$"{_designs} saved", $"{_presets} showcase"];
    }

    IEnumerable<DesignRow> Recent() {
        return _rows.OrderByDescending(r => r.UpdatedAt).Take(8);
    }

    Task Open() {
        return OnOpen.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || _loaded) return;
        _loaded = true;
        await LoadAsync();
        StateHasChanged();
    }

    async Task LoadAsync() {
        var ok = false;
        try {
            var designs = await Client().GetFromJsonAsync<DesignListResult>("/api/env/designs");
            _rows = designs?.Designs ?? [];
            _designs = _rows.Length;
            ok = true;
        } catch {
            _rows = [];
            _designs = 0;
        }

        try {
            var showcase = await Client().GetFromJsonAsync<ShowcaseResult>("/api/farm/showcase");
            _presets = showcase?.Count ?? 0;
            ok = true;
        } catch {
            _presets = 0;
        }

        _failed = !ok;
    }

}
