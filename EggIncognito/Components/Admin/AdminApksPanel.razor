@rendermode @(RenderModes.InteractiveServer)
@using EggIncognito.Core
@using EggIncognito.Models.Devices
@using EggIncognito.Services.Events
@inherits AdminPaneBase

<AdminPaneHead Title="Stored APKs" Facts="@Stats">
    <Tools>
        <button type="button" class="btn-mini" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
    </Tools>
</AdminPaneHead>
<PaneNotice @ref="_notice"/>
@if (_rows.Count == 0) {
    <p class="ap-note">No stored APKs. Splits land here from device harvest and from the install-app cookbook when it pulls off a physical android device.</p>
} else {
    <TableScroll>
        <table class="data-table apk-table">
            <thead>
            <tr>
                <th>Split</th><th>SHA-256</th><th>Size</th><th>Source</th><th>Captured</th><th></th>
            </tr>
            </thead>
            @foreach (var v in _rows) {
                <tbody>
                <tr class="row-open">
                    <td colspan="5">
                        <div class="apk-version-cell">
                            <PlatformIcon Platform="@v.Platform"/>
                            <VersionLine App="@v.AppVersion" Build="@v.Build"/>
                            <span class="mono muted">@v.Package</span>
                            <span class="apk-fact">@v.Splits.Count splits, @ByteFormat.Mb(v.ByteSize, "F1")</span>
                            @if (!v.Installable) {
                                <span class="apk-bad">no base split, not installable</span>
                            }
                        </div>
                    </td>
                    <td class="tools">
                        <button type="button" class="btn-mini btn-danger" disabled="@_busy" @onclick="() => Delete(v)">Delete</button>
                    </td>
                </tr>
                @foreach (var s in v.Splits) {
                    <tr>
                        <td class="mono apk-split-cell">@s.Split</td>
                        <td class="mono">@ShaShort(s.Sha256)</td>
                        <td class="mono">@ByteFormat.Mb(s.ByteSize, "F1")</td>
                        <td>@(s.SourceDeviceId ?? "unknown")</td>
                        <td class="muted">@ViewerClock.At(Services, s.CapturedAt).ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td></td>
                    </tr>
                }
                </tbody>
            }
        </table>
    </TableScroll>
}

@code {
    PaneNotice? _notice;

    List<StoredApkVersionRow> _rows = [];
    bool _busy;

    protected override IReadOnlyList<string> Topics => [AdminTopics.Apks];

    int SplitCount => _rows.Sum(r => r.Splits.Count);

    long TotalBytes => _rows.Sum(r => r.ByteSize);

    IEnumerable<string> Stats => [$"{_rows.Count} versions", $"{SplitCount} splits", ByteFormat.Mb(TotalBytes, "F1")];

    protected override async Task LoadAsync() {
        if (Api is null) return;
        var res = await Api.GetAsync("/api/apks");
        if (!res.Ok) {
            _notice?.Fail($"load failed: {res.Describe()}");
            return;
        }

        _rows = res.Json<StoredApkList>()?.Versions ?? [];
    }

    async Task Delete(StoredApkVersionRow v) {
        if (Api is null) return;
        _busy = true;
        _notice?.Clear();
        var url = $"/api/apks?platform={Uri.EscapeDataString(v.Platform)}"
                  + $"&package={Uri.EscapeDataString(v.Package)}"
                  + $"&appVersion={Uri.EscapeDataString(v.AppVersion)}"
                  + $"&build={Uri.EscapeDataString(v.Build)}";
        var res = await Api.DeleteAsync(url);
        _notice?.Result(res.Ok, res.Ok
            ? $"deleted {v.AppVersion} ({v.Build}), {v.Splits.Count} split(s)"
            : $"delete failed: {res.Describe()}");
        await LoadAsync();
        _busy = false;
        if (res.Ok) Notifier.Publish(AdminTopics.Apks);
    }

    static string ShaShort(string sha) {
        return sha.Length >= 12 ? sha[..12] : sha;
    }

}
