@using EggIncognito.Components.Calendar
@using EggIncognito.Models.Calendar
@using EggIncognito.Models.Contracts
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Calendar
@using EggIncognito.Services.Events
@inherits SelfCallComponentBase
@inject ILogger<PdContractsMiniCalendar> Logger
@inject IServiceProvider Services

<button type="button" class="pd-cal-title pd-cal-title-gap" @onclick="@(() => OnOpenContracts.InvokeAsync())">
    Contracts<Icon Name="chevron-right" Class="icon-sm"/>
</button>
@if (_nextLoading) {
    <div class="pd-next-contracts">
        <div class="pd-next-row muted"><Icon Name="loader" Class="icon-sm text-muted"/> Training predictions...</div>
    </div>
} else if (_next is { } next) {
    <div class="pd-next-contracts">
        <div class="pd-next-row">
            <span class="pd-next-label">Next non-PE</span>
            @NextRowContent(next.NonPe)
        </div>
        <div class="pd-next-row">
            <span class="pd-next-label">Next PE</span>
            @NextRowContent(next.Pe)
        </div>
        <div class="pd-next-row">
            <span class="pd-next-label">Next ultra PE</span>
            @NextRowContent(next.UltraPe)
        </div>
        @foreach (var c in next.Colleggtibles) {
            <div class="pd-next-row">
                <span class="pd-next-label">Next colleggtible</span>
                @NextRowContent(c)
            </div>
        }
    </div>
}
<MiniCalendar TItem="ContractCalendarItem" Load="LoadMiniContracts" EmptyNote="No contracts in the last week.">
    <Bar>
        @{ var c = context.Item.Release!; }
        <div class="evcal-bar-tip" style="@ContractBarStyle(context)">
            <Tooltip>
                <ChildContent>
                    <button type="button" class="@(CalendarBars.Css(context) + " evcal-bar-contract")"
                            @onclick="@(() => OnOpenContracts.InvokeAsync())">
                        @if (EggIcons.Url(c.Egg, c.CustomEggId) is { } eggUrl) {
                            <FallbackImg Class="evcal-bar-egg" Src="@eggUrl" Alt=""/>
                        }
                        <span class="evcal-bar-label">@c.Name</span>
                    </button>
                </ChildContent>
                <Content>
                    <span class="tt-title">@c.Name</span>
                    @if (c.UltraOnly) {
                        <span class="tt-ultra">ULTRA ONLY</span>
                    }

                    <span class="tt-line">@EggIcons.Label(c.Egg, c.CustomEggId)</span>
                    <span class="tt-line">@EventCountdown.Describe(c.StartTimestamp, c.EndTimestamp, DateTimeOffset.UtcNow)</span>
                </Content>
            </Tooltip>
        </div>
    </Bar>
</MiniCalendar>
<WatchList Source="/api/v1/contracts/predictions/watch" PrefKey="watch.contracts"
           AddLabel="Pin contract" Placeholder="contract name..." EmptyNote="Pin contracts to see their last release and next predicted leggacy."/>

@code {
    const int MiniFetchLimit = 500;

    [Parameter] public EventCallback OnOpenContracts { get; set; }

    NextContractsResponse? _next;
    bool _nextLoading;

    protected override async Task OnInitializedAsync() {
        if (Speculative) return;
        _nextLoading = true;
        try {
            _next = await Client().GetFromJsonAsync<NextContractsResponse>("/api/v1/contracts/predictions/next", JsonPresets.Web);
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the next contracts block could not be loaded");
        } finally {
            _nextLoading = false;
        }
    }

    RenderFragment NextRowContent(NextPick? pick) {
        if (pick is null) {
            return @<span class="pd-next-empty muted">none predicted</span>;
        }

        return
            @<text>
                @if (pick.IconUrl is { } iconUrl) {
                    <FallbackImg Class="pd-next-egg" Src="@iconUrl" Alt=""/>
                }
                <span class="pd-next-name">@pick.Name</span>
                <span class="pd-next-date muted">@FormatSlotTime(pick.SlotTime)</span>
                <span class="pd-next-prob mono">@((pick.Probability * 100).ToString("0"))%</span>
            </text>;
    }

    string FormatSlotTime(double slotTime) {
        return ViewerClock.At(Services, UnixSeconds.ToTime(slotTime))
            .ToString("ddd d MMM", System.Globalization.CultureInfo.InvariantCulture);
    }

    async Task<CalendarItemsLoad<ContractCalendarItem>> LoadMiniContracts(DateTimeOffset start, DateTimeOffset end) {
        if (Speculative) return CalendarItemsLoad.Ok<ContractCalendarItem>([]);
        var url = FormattableString.Invariant(
            $"/api/v1/contracts?after={UnixSeconds.FromTime(start):0}&before={UnixSeconds.FromTime(end):0}&limit={MiniFetchLimit}");
        try {
            var res = await Client().GetAsync(url);
            if ((int)res.StatusCode == 503) return CalendarItemsLoad.Failed<ContractCalendarItem>(await ApiErrors.ReadAsync(res));
            if (!res.IsSuccessStatusCode) return CalendarItemsLoad.Failed<ContractCalendarItem>("Contracts could not be loaded.");
            var body = await res.Content.ReadFromJsonAsync<ContractReleaseListResponse>(JsonPresets.Web);
            return CalendarItemsLoad.Ok<ContractCalendarItem>([.. (body?.Releases ?? []).Select(ContractCalendarItem.Of)]);
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the mini contract calendar could not be loaded");
            return CalendarItemsLoad.Failed<ContractCalendarItem>("Contracts could not be loaded.");
        }
    }

    static string ContractBarStyle(CalendarBar<ContractCalendarItem> bar) {
        return CalendarBars.PositionStyle(bar) + ContractPalette.BarStyle(bar.Item.Kind);
    }
}
