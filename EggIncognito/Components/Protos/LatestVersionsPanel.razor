@using EggIncognito.Core.Services.ProtoExtract
@using EggIncognito.Services.Protos
<div class="pd-vergroup">
    <div class="pd-vergroup-head">
        <span class="ds-state-k">Game version</span>
        @if (Updated is { } u) {
            <span class="verline-sep">|</span>
            <TimeAgo Value="@TimeAgo.FromUtc(u)"/>
        }
    </div>
    @if (_latest.Count == 0) {
        <span class="text-muted text-xs">none yet</span>
    }
    @foreach (var r in _latest) {
        <button type="button" class="pv-latest-row @(IsBehind(r) ? "pv-latest-row-behind" : "")"
                @onclick="@(() => OnOpen.InvokeAsync(r))">
            <VersionLine Platform="@r.Platform" App="@r.AppVersion" Build="@r.Build" Client="@r.ClientVersion"/>
        </button>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ProtoRegistryRow> Rows { get; set; } = [];
    [Parameter] public EventCallback<ProtoRegistryRow> OnOpen { get; set; }

    IReadOnlyList<ProtoRegistryRow> _latest = [];
    ProtoRegistryRow? _newest;

    protected override void OnParametersSet() {
        _latest = ProtoVersionOrdering.LatestByPlatform(Rows, r => r.Key());
        _newest = ProtoVersionOrdering.Latest(Rows, r => r.Key());
    }

    DateTime? Updated => _latest.Max(r => r.DetectedAt);

    bool IsBehind(ProtoRegistryRow r) {
        return _newest is { } n && !ReferenceEquals(n, r)
                                && !string.Equals(n.ProtoSha, r.ProtoSha, StringComparison.OrdinalIgnoreCase);
    }

}
