@inject ICurrentUser User
@inject AuthState Auth

@if (_open) {
    <ModalShell Title="Support the project" TitleId="supportModalTitle" Width="ModalWidth.Large" OnClose="Close">
        <div class="modal-body sm">
            <div class="sm-top">
                <div class="sm-pitch">
                    <p class="sm-lede">EggIncognito, EggIdentity and EggLedger are free and open source. Support pays for the servers and EggLedger's code-signing, and any amount unlocks the Supporter role.</p>
                    <ul class="sm-perks">
                        <li><Icon Name="send" Class="icon-sm"/><span><b>Higher API limits</b> on the data API, as soon as the role lands.</span></li>
                        <li><Icon Name="upload" Class="icon-sm"/><span><b>Hosted capture</b> on this server, with no local proxy to set up.</span></li>
                    </ul>
                </div>
                @if (Auth.Enabled) {
                    <div class="sm-account @(User.Current.IsSupporter ? "sm-account-on" : "")">
                        @if (User.Current.IsAuthenticated) {
                            <div class="sm-id">
                                @if (User.Current.AvatarUrl(Auth.IdentityHostUrl) is { Length: > 0 } avatar) {
                                    <img class="sm-avatar" src="@avatar" alt=""/>
                                } else {
                                    <span class="sm-avatar">@(User.Current.Name?.Substring(0, 1).ToUpper())</span>
                                }
                                <div class="sm-id-text">
                                    <span class="sm-name">@User.Current.Name</span>
                                    <span class="sm-state">@(User.Current.IsSupporter ? "Supporter" : "Not a supporter yet")</span>
                                </div>
                            </div>
                            <form method="post" action="/api/account/refresh-benefits">
                                <button type="submit" class="btn-mini">Refresh role</button>
                            </form>
                        } else {
                            <span class="sm-state">Log in with Discord so your role applies here.</span>
                            <LoginButton Label="Log in"/>
                        }
                    </div>
                }
            </div>

            <div class="sm-label">Support on</div>
            <div class="sm-rails">
                @foreach (var p in Platforms) {
                    <a class="sm-rail" href="@p.Url" target="_blank" rel="noopener">
                        <span class="sm-rail-name">@p.Name</span>
                        <span class="sm-rail-claim">@p.Claim</span>
                        <Icon Name="arrow-right" Class="icon-sm sm-rail-go"/>
                    </a>
                }
            </div>

            <div class="sm-label">Good to know</div>
            <dl class="sm-faq">
                <dt>One-off payments</dt>
                <dd>Count. The role stays for 31 days.</dd>
                <dt>If support lapses</dt>
                <dd>The role and its perks drop, and come back when you resume.</dd>
                <dt>Paid but no role</dt>
                <dd>Use Refresh role above, then ask in the Discord server.</dd>
            </dl>

            <p class="sm-legal">
                Payments go through the platforms above. See the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy &amp; Cookies</a>.
            </p>
        </div>
    </ModalShell>
}

@code {
    sealed record Platform(string Name, string Url, string Claim);

    static readonly Platform[] Platforms = [
        new("GitHub Sponsors", "https://github.com/sponsors/DavidArthurCole", "Run /link-github in Discord"),
        new("Patreon", "https://www.patreon.com/c/DavidArthurCole", "Link Discord on Patreon"),
        new("Buy Me a Coffee", "https://buymeacoffee.com/davidarthurcole", "Link Discord on BMAC")
    ];

    bool _open;

    public void Open() {
        _open = true;
        StateHasChanged();
    }

    void Close() {
        _open = false;
    }

}
