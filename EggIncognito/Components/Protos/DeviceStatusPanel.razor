@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject AdminNotifier Notifier
@using System.Globalization
@implements IDisposable

<div class="@(string.IsNullOrEmpty(Class) ? "panel pd-devices" : $"panel pd-devices {Class}")">
    <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold my-0">Devices</h3>
        @if (_isAdmin) {
            <button type="button" class="dropzone-open" aria-label="Open device workbench"
                    @onclick="@(() => OnManage.InvokeAsync(null))">
                <Icon Name="chevron-right" Class="icon-sm"/>
            </button>
        }
    </div>
    @if (_devices.Count == 0) {
        <p class="text-muted text-xs">No devices declared on this host.</p>
    } else {
        <div class="pd-devlist">
            @foreach (var d in _devices.OrderBy(x => x.Label, StringComparer.OrdinalIgnoreCase)) {
                <div class="pd-devrow @(_isAdmin ? "dwb-row-click" : "")"
                     @onclick="@(() => {
                                   if (_isAdmin) OnManage.InvokeAsync(d.Id);
                               })">
                    <span class="@(d.Reachable ? "text-ok" : "text-err") shrink-0">
                        <PlatformIcon Platform="@d.Platform"/>
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-medium truncate">@d.Label</span>
                            @if (DataChip(d) is { } chip) {
                                <span class="@chip.Color shrink-0 self-center inline-flex">
                                    <Icon Name="@chip.Icon" Class="icon-sm"/>
                                </span>
                            }
                        </div>
                        <div class="text-xs mt-0.5 flex items-center gap-2">
                            <VersionLine App="@d.InstalledAppVersion" Build="@d.InstalledBuild" Client="@ClientText(d)"/>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {

    [Parameter] public string? Class { get; set; }

    [Parameter] public EventCallback<string?> OnManage { get; set; }

    List<Models.Registry.DeviceStatus> _devices = [];

    static (string Icon, string Color)? DataChip(Models.Registry.DeviceStatus d) {
        if (!d.Reachable) return null;
        var icon = d.ClientVersion is null ? "info" : "check";
        if (d.Result == "new_version") return (icon, "text-accent");
        return d.ClientVersion is null ? (icon, "text-muted") : (icon, "text-ok");
    }

    static string? ClientText(Models.Registry.DeviceStatus d) {
        return d.ClientVersion?.ToString(CultureInfo.InvariantCulture);
    }

    bool _isAdmin;
    bool _disposed;
    bool _loading;
    bool _missed;
    IDisposable? _topics;

    protected override Task OnInitializedAsync() {
        _isAdmin = User.IsAtLeast(UserRole.Admin);
        return LoadAsync();
    }

    PageVisibility? _vis;

    PageVisibility Vis => _vis ??= new PageVisibility(JS, Env);

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        _topics ??= Notifier.Subscribe(OnTopic);
        await Vis.ListenAsync(OnVisibleAsync);
        KickReprobe();
    }

    void OnTopic(string topic) {
        if (_disposed || topic != AdminTopics.DeviceStatus) return;
        _ = InvokeAsync(TickAsync);
    }

    async Task OnVisibleAsync(bool visible) {
        if (_disposed || !visible || !_missed) return;
        _missed = false;
        await InvokeAsync(TickAsync);
    }

    async Task TickAsync() {
        if (_disposed || _loading) return;
        if (!await Vis.IsVisibleAsync()) {
            _missed = true;
            return;
        }

        _loading = true;
        try {
            await LoadAsync();
            KickReprobe();
        } finally {
            _loading = false;
        }
    }

    public async Task LoadAsync() {
        try {
            var rows = await Client().GetFromJsonAsync<List<Models.Registry.DeviceStatus>>("/api/devices/status");
            _devices = rows ?? [];
            StateHasChanged();
        } catch {
            /* transient; keep last good */
        }
    }

    static readonly TimeSpan ReprobeGap = TimeSpan.FromSeconds(60);

    bool _reprobing;
    DateTimeOffset _reprobedAt = DateTimeOffset.MinValue;

    void KickReprobe() {
        if (!_isAdmin || _reprobing || _disposed) return;
        var now = DateTimeOffset.UtcNow;
        if (now - _reprobedAt < ReprobeGap) return;
        _reprobedAt = now;
        _ = Task.Run(ReprobeStaleAsync);
    }

    async Task ReprobeStaleAsync() {
        if (!_isAdmin || _reprobing || _disposed) return;
        var stale = _devices.Where(d => !d.Reachable).Select(d => d.Id).ToList();
        if (stale.Count == 0) return;
        _reprobing = true;
        try {
            foreach (var id in stale) {
                try {
                    await Client().PostAsync($"/api/devices/{id}/refresh", null);
                } catch {
                    /* device still down; ignore */
                }
            }
        } finally {
            _reprobing = false;
        }
    }

    public void Dispose() {
        _disposed = true;
        _topics?.Dispose();
        _topics = null;
        _ = _vis?.DisposeAsync();
    }

}
