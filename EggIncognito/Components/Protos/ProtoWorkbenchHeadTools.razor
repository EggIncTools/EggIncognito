<button type="button" class="btn-mini pwb-split-btn @(SplitActive ? "active" : "")"
        aria-pressed="@(SplitActive ? "true" : "false")" @onclick="@(() => OnToggleSplit.InvokeAsync())">
    <Icon Name="layout-grid" Class="icon-sm"/> Split registry
</button>
@if (ShowAdmin) {
    <button type="button" class="btn-mini @(AdminOpen ? "active" : "")"
            @onclick="@(() => AdminOpenChanged.InvokeAsync(!AdminOpen))">
        Registry admin
    </button>
}
@if (OfferAllCount > 0) {
    <button type="button" class="btn-mini" disabled="@OfferBusy" @onclick="@(() => OnOfferAll.InvokeAsync())">
        <Icon Name="upload" Class="icon-sm"/> Offer all (@OfferAllCount)
    </button>
}

@code {
    [Parameter] public bool SplitActive { get; set; }

    [Parameter] public EventCallback OnToggleSplit { get; set; }

    [Parameter] public bool ShowAdmin { get; set; }

    [Parameter] public bool AdminOpen { get; set; }

    [Parameter] public EventCallback<bool> AdminOpenChanged { get; set; }

    [Parameter] public int OfferAllCount { get; set; }

    [Parameter] public bool OfferBusy { get; set; }

    [Parameter] public EventCallback OnOfferAll { get; set; }
}
