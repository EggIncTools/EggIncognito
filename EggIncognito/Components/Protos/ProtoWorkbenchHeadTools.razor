@if (OfferAllCount > 0) {
    <button type="button" class="btn-mini" disabled="@OfferBusy" @onclick="@(() => OnOfferAll.InvokeAsync())">
        <Icon Name="upload" Class="icon-sm"/> Offer all (@OfferAllCount)
    </button>
}

@code {
    [Parameter] public int OfferAllCount { get; set; }

    [Parameter] public bool OfferBusy { get; set; }

    [Parameter] public EventCallback OnOfferAll { get; set; }
}
