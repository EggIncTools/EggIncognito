@using System.Globalization
@using EggIdentity.Client
@using EggIdentity.UI.Suite
@using EggIncognito.Services.Events
@inject AuthState Auth
@inject ICurrentUser User
@inject IHttpContextAccessor HttpContextAccessor
@inject IServiceProvider Services
@implements IDisposable

<section class="panel pd-w-identity">
    <div class="pd-id-row">
        <div class="pd-brand">
            <img class="pd-brand-logo" src="/brand/logo.png" alt="EggIncognito"/>
            <div class="pd-serverline">
                <VersionLine App="@_version"/><span class="pd-sep">|</span><a class="pd-server-sha" href="@_commitUrl" target="_blank" rel="noopener">@_sha</a>
                @if (_builtAt is { } built) {
                    <span class="pd-sep">|</span>
                    <TimeAgo At="@built" Class="time-ago"/>
                }
            </div>
        </div>
        <SuiteSwitcher Placement="SuitePlacement.Inline"/>
    </div>
    <div class="pd-id-row">
        @if (Auth.Enabled || Auth.LocalIdentityActive) {
            <span class="auth-nav">
                @if (User.Current.IsAuthenticated) {
                    <AccountModal OnProfileChanged="LoadProfile"/>
                    @if (User.Current.IsAtLeast(UserRole.Admin)) {
                        <button type="button" class="auth-btn" @onclick="@(() => OnOpenAdmin.InvokeAsync())">Admin</button>
                    }
                }
                @if (Auth.Enabled) {
                    <SuiteAccount Placement="SuitePlacement.Inline"/>
                }
            </span>
        }
        @if (User.Current.IsAuthenticated) {
            <dl class="pd-identity-facts">
                <div>
                    <dt>Role</dt>
                    <dd>@User.Current.Role.ToString().ToLowerInvariant()@(User.Current.IsSupporter ? ", supporter" : "")</dd>
                </div>
                <div>
                    <dt>Local time</dt>
                    <dd>
                        <Tooltip Text="@(_timezone.Length == 0 ? "No time zone set" : _timezone)">@LocalTime()</Tooltip>
                    </dd>
                </div>
                <div>
                    <dt>Language</dt>
                    <dd>@(_language.Length == 0 ? "Not set" : LanguageLabel(_language))</dd>
                </div>
            </dl>
        }
        <div class="pd-brand-links">
            <Tooltip Text="Terms">
                <button type="button" class="pd-brand-link" aria-label="Terms"
                        @onclick="@(() => OnOpenTerms.InvokeAsync())">
                    <Icon Name="file-text"/>
                </button>
            </Tooltip>
            <Tooltip Text="Privacy and cookies">
                <button type="button" class="pd-brand-link" aria-label="Privacy and cookies"
                        @onclick="@(() => OnOpenPrivacy.InvokeAsync())">
                    <Icon Name="shield"/>
                </button>
            </Tooltip>
            <Tooltip Text="Support the project">
                <button type="button" class="pd-brand-link" aria-label="Support the project"
                        @onclick="@(() => OnOpenSupport.InvokeAsync())">
                    <Icon Name="heart"/>
                </button>
            </Tooltip>
            <Tooltip Text="EggIncognito on GitHub">
                <a class="pd-brand-link" href="https://github.com/EggIncTools/EggIncognito" target="_blank"
                   rel="noopener" aria-label="EggIncognito on GitHub">
                    <Icon Name="brand-github"/>
                </a>
            </Tooltip>
        </div>
    </div>
    <footer id="siteFooter" class="pd-id-row pd-id-foot">
        <span>Unofficial fan tool, not affiliated with Auxbrain Inc.</span>
        <span class="pd-sep">|</span>
        <a href="https://github.com/EggIncTools/EggIncognito/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
        <span class="pd-sep">|</span>
        <span>© 2026 David Cole</span>
    </footer>
</section>

@code {
    [Parameter] public EventCallback OnOpenSupport { get; set; }

    [Parameter] public EventCallback OnOpenTerms { get; set; }

    [Parameter] public EventCallback OnOpenPrivacy { get; set; }

    [Parameter] public EventCallback OnOpenAdmin { get; set; }

    string _timezone = "";
    string _language = "";
    string _sessionToken = "";
    string _version = "";
    string _sha = "";
    string _commitUrl = "";
    DateTimeOffset? _builtAt;
    Timer? _clock;

    protected override void OnAfterRender(bool firstRender) {
        if (!firstRender || !User.Current.IsAuthenticated) return;
        var untilMinute = TimeSpan.FromSeconds(60 - DateTimeOffset.UtcNow.Second);
        _clock = new Timer(_ => _ = InvokeAsync(StateHasChanged), null, untilMinute, TimeSpan.FromMinutes(1));
    }

    public void Dispose() => _clock?.Dispose();

    protected override async Task OnInitializedAsync() {
        var b = BuildInfo.FromAssembly("https://github.com/EggIncTools/EggIncognito");
        _version = $"v{b.Version}";
        _sha = b.ShortSha;
        _commitUrl = b.CommitUrl;
        _builtAt = DateTime.TryParse(b.BuildDate, CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var built)
            ? new DateTimeOffset(built, TimeSpan.Zero)
            : null;
        _sessionToken = HttpContextAccessor.HttpContext?.Request.Cookies[Auth.SessionCookieName] ?? "";
        await LoadProfile();
    }

    async Task LoadProfile() {
        if (!User.Current.IsAuthenticated || _sessionToken.Length == 0) return;
        if (Services.GetService(typeof(IdentityApiClient)) is not IdentityApiClient identity) return;
        ProfileResponse? profile;
        try {
            profile = await identity.GetProfileAsync(_sessionToken, CancellationToken.None);
        } catch (HttpRequestException) {
            return;
        }

        _timezone = profile?.Timezone ?? "";
        _language = profile?.Language ?? "";
    }

    string LocalTime() {
        var zone = ViewerZone.Parse(_timezone) ?? ViewerClock.ZoneOf(Services);
        return TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, zone).ToString("HH:mm", CultureInfo.InvariantCulture);
    }

    static string LanguageLabel(string code) {
        try {
            return CultureInfo.GetCultureInfo(code).EnglishName;
        } catch (CultureNotFoundException) {
            return code;
        }
    }

}
