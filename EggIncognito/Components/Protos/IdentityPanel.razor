@using System.Globalization
@using EggIdentity.Client
@inject AuthState Auth
@inject ICurrentUser User
@inject IHttpContextAccessor HttpContextAccessor
@inject IServiceProvider Services

<section class="panel pd-w-identity">
    @if (Auth.Enabled || Auth.LocalIdentityActive) {
        <span class="auth-nav">
            @if (User.IsAuthenticated) {
                <AccountModal OnProfileChanged="LoadProfile"/>
                @if (User.IsAtLeast(UserRole.Admin)) {
                    <button type="button" class="auth-btn" @onclick="@(() => OnOpenAdmin.InvokeAsync())">Admin</button>
                }

                @if (Auth.Enabled) {
                    <form method="post" action="/logout" style="margin:0;">
                        <button type="submit" class="auth-btn">Log out</button>
                    </form>
                }
            } else if (Auth.WidgetEnabled) {
                <LoginButton CssClass="auth-btn" Label="Log in"/>
            }
        </span>
    }
    @if (User.IsAuthenticated) {
        <dl class="pd-identity-facts">
            <div>
                <dt>Role</dt>
                <dd>@User.Role.ToString().ToLowerInvariant()@(User.IsSupporter ? ", supporter" : "")</dd>
            </div>
            <div>
                <dt>Local time</dt>
                <dd>
                    <Tooltip>
                        <ChildContent>@LocalTime()</ChildContent>
                        <Tip>
                            <span class="tt-line">@(_timezone.Length == 0 ? "No time zone set" : _timezone)</span>
                        </Tip>
                    </Tooltip>
                </dd>
            </div>
            <div>
                <dt>Language</dt>
                <dd>@(_language.Length == 0 ? "Not set" : LanguageLabel(_language))</dd>
            </div>
        </dl>
    }
    <div class="pd-brand-links">
        <Tooltip>
            <ChildContent>
                <button type="button" class="pd-brand-link" aria-label="Terms"
                        @onclick="@(() => OnOpenTerms.InvokeAsync())">
                    <Icon Name="file-text"/>
                </button>
            </ChildContent>
            <Tip>
                <span class="tt-line">Terms</span>
            </Tip>
        </Tooltip>
        <Tooltip>
            <ChildContent>
                <button type="button" class="pd-brand-link" aria-label="Privacy and cookies"
                        @onclick="@(() => OnOpenPrivacy.InvokeAsync())">
                    <Icon Name="shield"/>
                </button>
            </ChildContent>
            <Tip>
                <span class="tt-line">Privacy and cookies</span>
            </Tip>
        </Tooltip>
        <Tooltip>
            <ChildContent>
                <button type="button" class="pd-brand-link" aria-label="Support the project"
                        @onclick="@(() => OnOpenSupport.InvokeAsync())">
                    <Icon Name="heart"/>
                </button>
            </ChildContent>
            <Tip>
                <span class="tt-line">Support the project</span>
            </Tip>
        </Tooltip>
        <Tooltip>
            <ChildContent>
                <a class="pd-brand-link" href="https://github.com/EggIncTools/EggIncognito" target="_blank"
                   rel="noopener" aria-label="EggIncognito on GitHub">
                    <Icon Name="brand-github"/>
                </a>
            </ChildContent>
            <Tip>
                <span class="tt-line">EggIncognito on GitHub</span>
            </Tip>
        </Tooltip>
    </div>
</section>

@code {
    [Parameter] public EventCallback OnOpenSupport { get; set; }

    [Parameter] public EventCallback OnOpenTerms { get; set; }

    [Parameter] public EventCallback OnOpenPrivacy { get; set; }

    [Parameter] public EventCallback OnOpenAdmin { get; set; }

    string _timezone = "";
    string _language = "";
    string _sessionToken = "";

    protected override async Task OnInitializedAsync() {
        _sessionToken = HttpContextAccessor.HttpContext?.Request.Cookies[Auth.SessionCookieName] ?? "";
        await LoadProfile();
    }

    async Task LoadProfile() {
        if (!User.IsAuthenticated || _sessionToken.Length == 0) return;
        if (Services.GetService(typeof(IdentityApiClient)) is not IdentityApiClient identity) return;
        ProfileResponse? profile;
        try {
            profile = await identity.GetProfileAsync(_sessionToken, CancellationToken.None);
        } catch (HttpRequestException) {
            return;
        }

        _timezone = profile?.Timezone ?? "";
        _language = profile?.Language ?? "";
    }

    string LocalTime() {
        var now = DateTimeOffset.UtcNow;
        if (_timezone.Length == 0) return now.ToString("HH:mm 'UTC'", CultureInfo.InvariantCulture);
        try {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(_timezone);
            return TimeZoneInfo.ConvertTime(now, zone).ToString("HH:mm", CultureInfo.InvariantCulture);
        } catch (TimeZoneNotFoundException) {
            return now.ToString("HH:mm 'UTC'", CultureInfo.InvariantCulture);
        } catch (InvalidTimeZoneException) {
            return now.ToString("HH:mm 'UTC'", CultureInfo.InvariantCulture);
        }
    }

    static string LanguageLabel(string code) {
        try {
            return CultureInfo.GetCultureInfo(code).EnglishName;
        } catch (CultureNotFoundException) {
            return code;
        }
    }

}
