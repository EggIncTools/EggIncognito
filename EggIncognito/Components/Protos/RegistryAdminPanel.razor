@using System.Text.Json
@using EggIncognito.Models.Protos
@using EggIncognito.Models.Registry
@using EggIncognito.Services.Protos
@inherits SelfCallComponentBase
@inject ToastService Toasts

<section class="pwb-admin">
    <div class="pwb-admin-head">
        <h3 class="pwb-admin-title">Registry admin</h3>
        <div class="segmented pwb-admin-seg" role="radiogroup" aria-label="Registry admin action">
            <button type="button" class="segmented-opt @(_tab == TabReview ? "active" : "")"
                    @onclick="@(() => PickTab(TabReview))">
                Review
            </button>
            <button type="button" class="segmented-opt @(_tab == TabAdd ? "active" : "")"
                    @onclick="@(() => PickTab(TabAdd))">
                Add version
            </button>
            <button type="button" class="segmented-opt @(_tab == TabEdit ? "active" : "")"
                    @onclick="@(() => PickTab(TabEdit))">
                Edit version
            </button>
            @if (IsAdmin) {
                <button type="button" class="segmented-opt @(_tab == TabDeleted ? "active" : "")"
                        @onclick="@(() => PickTab(TabDeleted))">
                    Deleted
                </button>
            }
        </div>
        <button type="button" class="icon-btn icon-btn-sm pwb-admin-close" aria-label="Close registry admin"
                @onclick="@(() => OnClose.InvokeAsync())">
            <Icon Name="x"/>
        </button>
    </div>

    @if (_tab == TabReview) {
        <StagedReviewPanel @ref="_review" IsAdmin="IsAdmin" ShowEmpty="true"
                           EmptyText="Nothing is pending review." OnChanged="OnReviewChanged"/>
        @if (IsAdmin && _suggestions.Count > 0) {
            <SubSectionHead>
                <ChildContent>Suggested merges (@_suggestions.Count)</ChildContent>
                <Tools>
                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => AcceptSuggestions(_suggestions, $"merged {_suggestions.Count} suggestion groups"))">Merge all</button>
                </Tools>
            </SubSectionHead>
            <Note Small="true">Separate entries with the same proto SHA and client version, on any platform or app version. Merge links them under one entry.</Note>
            <TableScroll>
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Client</th>
                        <th>Proto SHA</th>
                        <th>Members</th>
                        <th class="tools pwb-admin-row-tools">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var s in _suggestions) {
                        <tr>
                            <td class="reg-num">@s.ClientVersion</td>
                            <td><span class="code-chip">@Short(s.ProtoSha)</span></td>
                            <td>
                                <span class="pwb-merge-members">
                                    @foreach (var member in s.Members) {
                                        <span class="pwb-merge-member">
                                            <PlatformIcon Platform="@member.Platform"/>
                                            <span class="reg-version">@member.AppVersion</span>
                                            <span class="reg-num">@member.Build</span>
                                        </span>
                                    }
                                </span>
                            </td>
                            <td class="pwb-admin-row-tools">
                                <button type="button" class="btn-mini" disabled="@_busy"
                                        @onclick="@(() => AcceptSuggestions([s], $"merged {s.Members.Count} entries sharing {Short(s.ProtoSha)}"))">
                                    Merge
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </TableScroll>
        }
    } else if (_tab == TabAdd) {
        <div class="pwb-admin-grid">
            <div class="pwb-field">
                <span class="pwb-field-label">Platform</span>
                <div class="segmented pwb-field-seg" role="radiogroup" aria-label="Platform">
                    <button type="button" class="segmented-opt @(_platform == PlatAndroid ? "active" : "")"
                            @onclick="@(() => SetPlatform(PlatAndroid))">
                        android
                    </button>
                    <button type="button" class="segmented-opt @(_platform == PlatIos ? "active" : "")"
                            @onclick="@(() => SetPlatform(PlatIos))">
                        ios
                    </button>
                </div>
            </div>
            <label class="pwb-field">
                <span class="pwb-field-label">App version<span class="pwb-field-req">*</span></span>
                <FilterInput Class="reg-filter-input" Placeholder="1.37.2" AriaLabel="App version" @bind-Value="_appVersion"/>
            </label>
            <label class="pwb-field">
                <span class="pwb-field-label">Build<span class="pwb-field-req">*</span></span>
                <FilterInput Class="reg-filter-input" Placeholder="137200" AriaLabel="Build" @bind-Value="_build"/>
            </label>
            <label class="pwb-field">
                <span class="pwb-field-label">Client version<span class="pwb-field-hint">optional</span></span>
                <FilterInput Class="reg-filter-input" Placeholder="" AriaLabel="Client version" @bind-Value="_client"/>
            </label>
            <label class="pwb-field">
                <span class="pwb-field-label">Source<span class="pwb-field-hint">optional</span></span>
                <FilterInput Class="reg-filter-input" Placeholder="" AriaLabel="Source" @bind-Value="_source"/>
            </label>
        </div>
        <label class="pwb-field pwb-field-block">
            <span class="pwb-field-label">Proto<span class="pwb-field-hint">optional</span></span>
            <textarea class="pwb-code-input" rows="6" spellcheck="false" aria-label="Proto" @bind="_proto"></textarea>
        </label>
        <div class="pwb-admin-foot">
            <span class="pwb-admin-foot-note">Platform, app version and build are required.</span>
            <button type="button" class="btn-primary" disabled="@_busy" @onclick="Add">@(_busy ? "Saving..." : "Save")</button>
        </div>
    } else if (_tab == TabDeleted) {
        <SubSectionHead>
            <ChildContent>Soft-deleted versions (@_deleted.Count)</ChildContent>
            <Tools>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="LoadDeleted">@(_busy ? "Loading..." : "Reload")</button>
                @if (_deleted.Count > 0) {
                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="PurgeAll">
                        @(_purgeArmed ? $"Confirm purge of {_deleted.Count}" : "Purge all")
                    </button>
                }
            </Tools>
        </SubSectionHead>
        @if (_deleted.Count == 0) {
            <Note Small="true">Nothing deleted.</Note>
        } else {
            <Note Small="true">Purge removes a row for good. The next extraction of that build recreates it from the archive.</Note>
            <TableScroll MaxHeight="60vh">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Platform</th>
                        <th>App version</th>
                        <th>Build</th>
                        <th>Client</th>
                        <th>Proto SHA</th>
                        <th>Deleted</th>
                        <th class="tools pwb-admin-row-tools">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in _deleted) {
                        <tr>
                            <td>
                                <PlatformIcon Platform="@d.Platform"/>
                            </td>
                            <td class="reg-version">@d.AppVersion</td>
                            <td class="reg-num">@d.Build</td>
                            <td class="reg-num">@d.ClientVersion</td>
                            <td>
                                @if (Short(d.ProtoSha) is { Length: > 0 } sha) {
                                    <span class="code-chip">@sha</span>
                                }
                            </td>
                            <td class="muted">
                                @if (d.DeletedAt is { } at) {
                                    <TimeAgo At="@at" Class="time-ago"/>
                                }
                            </td>
                            <td class="tools pwb-admin-row-tools">
                                <button type="button" class="btn-mini" disabled="@_busy"
                                        @onclick="@(() => Restore(d))">
                                    Restore
                                </button>
                                <button type="button" class="btn-mini" disabled="@_busy"
                                        @onclick="@(() => Purge(d))">
                                    Purge
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </TableScroll>
        }
    } else {
        <label class="pwb-field pwb-field-pick">
            <span class="pwb-field-label">Version</span>
            <select class="field-input" value="@_editKey" @onchange="OnPickVersion">
                <option value="">pick a version</option>
                @foreach (var r in EditableRows) {
                    <option value="@RowKey(r)">@r.Platform @r.AppVersion (@r.Build)</option>
                }
            </select>
        </label>
        @if (Picked is { } picked) {
            <ProtoEditDialog Targets="Targets(picked)" ProtoSha="@picked.ProtoSha"
                             ShaOrder="picked.SortOrder ?? 0" CanOrder="CanOrder"
                             Patch="PatchJson" Post="PostJson" FetchText="GetText"
                             OnChanged="OnChanged" OnClose="@(() => _editKey = string.Empty)"/>
        }
    }
</section>

@code {
    public const string TabReview = "review";
    public const string TabAdd = "add";
    const string TabEdit = "edit";
    const string TabDeleted = "deleted";
    const string PlatAndroid = "android";
    const string PlatIos = "ios";

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    [Parameter] public IReadOnlyList<ProtoRegistryRow> Rows { get; set; } = [];

    [Parameter] public bool CanOrder { get; set; }

    [Parameter] public bool IsAdmin { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public string Tab { get; set; } = TabReview;

    [Parameter] public EventCallback<string> TabChanged { get; set; }

    string _tab = TabReview;
    string _appliedTab = "";
    bool _busy;
    bool _purgeArmed;
    List<DeletedVersionRow> _deleted = [];
    List<MergeSuggestion> _suggestions = [];
    StagedReviewPanel? _review;
    string _platform = PlatAndroid;
    string _appVersion = "";
    string _build = "";
    string _client = "";
    string _source = "";
    string _proto = "";
    string _editKey = "";

    IEnumerable<ProtoRegistryRow> EditableRows => Rows.OrderByDescending(r => r.DetectedAt);

    ProtoRegistryRow? Picked =>
        _editKey.Length == 0 ? null : Rows.FirstOrDefault(r => RowKey(r) == _editKey);

    static string RowKey(ProtoRegistryRow r) {
        return $"{r.Platform}/{r.Build}";
    }

    static string Short(string? sha) {
        return string.IsNullOrEmpty(sha) ? "" : sha.Length <= 12 ? sha : sha[..12];
    }

    void SetPlatform(string platform) {
        _platform = platform;
    }

    protected override async Task OnParametersSetAsync() {
        if (Tab == _appliedTab) return;
        _appliedTab = Tab;
        await SetTab(Tab);
    }

    public async Task Refresh() {
        if (_tab != TabReview) return;
        if (_review is { } review) await review.Load();
        await LoadSuggestions();
        StateHasChanged();
    }

    async Task PickTab(string tab) {
        _appliedTab = tab;
        await SetTab(tab);
        await TabChanged.InvokeAsync(tab);
    }

    async Task SetTab(string tab) {
        _tab = tab;
        if (tab == TabDeleted) await LoadDeleted();
        if (tab == TabReview) await LoadSuggestions();
    }

    async Task LoadSuggestions() {
        if (!IsAdmin) {
            _suggestions = [];
            return;
        }

        try {
            _suggestions = await Client().GetFromJsonAsync<List<MergeSuggestion>>(
                "/api/protos/versions/merge-suggestions", JsonOpts) ?? [];
        } catch (Exception ex) when (ex is HttpRequestException or NotSupportedException or JsonException) {
            _suggestions = [];
        }
    }

    async Task AcceptSuggestions(IReadOnlyList<MergeSuggestion> picked, string okText) {
        var groups = picked.Where(s => s.Members.Count >= 2).Select(s => new {
            canonical = new { s.Members[0].Platform, s.Members[0].Build },
            aliases = s.Members.Skip(1).Select(m => new { m.Platform, m.Build }).ToList()
        }).ToList();
        if (groups.Count == 0) return;
        _busy = true;
        var ok = await PostJson("/api/protos/versions/merge-batch", new { groups });
        _busy = false;
        Say(ok, ok ? okText : "merge failed (admin only?)");
        if (!ok) return;
        await LoadSuggestions();
        await OnChanged.InvokeAsync();
    }

    async Task OnReviewChanged() {
        await LoadSuggestions();
        await OnChanged.InvokeAsync();
    }

    async Task LoadDeleted() {
        _busy = true;
        _purgeArmed = false;
        try {
            _deleted = await Client().GetFromJsonAsync<List<DeletedVersionRow>>(
                "/api/protos/versions/deleted", JsonOpts) ?? [];
        } catch (Exception ex) when (ex is HttpRequestException or NotSupportedException or JsonException) {
            _deleted = [];
            Toasts.Push(StatusNoteKind.Error, "could not load deleted versions");
        } finally {
            _busy = false;
        }
    }

    async Task Restore(DeletedVersionRow row) {
        _busy = true;
        var ok = await PostJson(
            $"/api/protos/versions/{Uri.EscapeDataString(row.Platform)}/{Uri.EscapeDataString(row.Build)}/restore",
            new { });
        _busy = false;
        Say(ok, ok ? $"restored {row.Platform} {row.Build}" : "restore failed (admin only?)");
        if (!ok) return;
        await LoadDeleted();
        await OnChanged.InvokeAsync();
    }

    async Task Purge(DeletedVersionRow row) {
        _busy = true;
        var ok = await DeleteUrl(
            $"/api/protos/versions/{Uri.EscapeDataString(row.Platform)}/{Uri.EscapeDataString(row.Build)}/purge");
        _busy = false;
        Say(ok, ok ? $"purged {row.Platform} {row.Build}" : "purge failed (admin only?)");
        if (!ok) return;
        await LoadDeleted();
        await OnChanged.InvokeAsync();
    }

    async Task PurgeAll() {
        if (!_purgeArmed) {
            _purgeArmed = true;
            return;
        }

        _purgeArmed = false;
        _busy = true;
        var count = _deleted.Count;
        var ok = await PostJson("/api/protos/versions/deleted/purge", new { });
        _busy = false;
        Say(ok, ok ? $"purged {count} soft-deleted versions" : "purge failed (admin only?)");
        if (!ok) return;
        await LoadDeleted();
        await OnChanged.InvokeAsync();
    }

    async Task<bool> DeleteUrl(string url) {
        try {
            return (await Client().DeleteAsync(url)).IsSuccessStatusCode;
        } catch (HttpRequestException) {
            return false;
        }
    }

    void OnPickVersion(ChangeEventArgs e) {
        _editKey = e.Value?.ToString() ?? "";
    }

    static List<ReleaseEditRow> Targets(ProtoRegistryRow r) {
        return [new ReleaseEditRow(r.Platform, r.Build, r.AppVersion ?? "", r.ClientVersion, r.Source ?? "")];
    }

    async Task Add() {
        if (string.IsNullOrWhiteSpace(_platform) || string.IsNullOrWhiteSpace(_appVersion) ||
            string.IsNullOrWhiteSpace(_build)) {
            Say(false, "platform, app version, build required");
            return;
        }

        _busy = true;
        var ok = await PostJson("/api/protos/versions", new {
            platform = _platform,
            appVersion = _appVersion,
            build = _build,
            clientVersion = string.IsNullOrWhiteSpace(_client) ? null : _client,
            source = string.IsNullOrWhiteSpace(_source) ? null : _source,
            proto = string.IsNullOrWhiteSpace(_proto) ? null : _proto
        });
        _busy = false;
        Say(ok, ok ? "saved" : "failed (contributor+? build taken?)");
        if (!ok) return;
        _appVersion = _build = _client = _source = _proto = "";
        await OnChanged.InvokeAsync();
    }

    void Say(bool ok, string text) {
        Toasts.Push(ok ? StatusNoteKind.Ok : StatusNoteKind.Error, text);
    }

    async Task<bool> PostJson(string url, object body) {
        try {
            return (await Client().PostAsJsonAsync(url, body, JsonOpts)).IsSuccessStatusCode;
        } catch (HttpRequestException) {
            return false;
        }
    }

    async Task<bool> PatchJson(string url, object body) {
        try {
            return (await Client().PatchAsJsonAsync(url, body, JsonOpts)).IsSuccessStatusCode;
        } catch (HttpRequestException) {
            return false;
        }
    }

    async Task<string?> GetText(string url) {
        try {
            var res = await Client().GetAsync(url);
            return res.IsSuccessStatusCode ? await res.Content.ReadAsStringAsync() : "";
        } catch (HttpRequestException) {
            return "";
        }
    }

}
