@using EggIncognito.Models.Periodicals
<section class="panel pd-w-workbench">
    <PanelHead Title="Workbenches">
        <Tools>
            <button type="button" class="btn-mini" @onclick="@(() => OnOpenNotifications.InvokeAsync())">Notifications</button>
            <button type="button" class="btn-mini" @onclick="@(() => OnOpenApiWorkbench.InvokeAsync())">API &amp; Data</button>
        </Tools>
    </PanelHead>
    @if (Summary is { } s) {
        var sets = s.Extracted.Where(x => x.Count > 0).OrderByDescending(x => x.Count).ToList();
        var total = sets.Sum(x => x.Count);
        <div class="wbx-row">
            <span class="wbx-k">Extracted</span>
            @if (ExtractVersion(s) is { Length: > 0 } bin) {
                <VersionLine App="@bin"/>
            }
            <span class="wbx-n">@total rows</span>
        </div>
        @if (sets.Count > 0) {
            <div class="wbx-stack" role="img" aria-label="@string.Join(", ", sets.Select(x => $"{x.Key} {x.Count}"))">
                @for (var i = 0; i < sets.Count; i++) {
                    <span class="wbx-seg wbx-seg-@(i % 4)" style="flex-grow: @sets[i].Count"></span>
                }
            </div>
            <div class="wbx-legend">
                @for (var i = 0; i < sets.Count; i++) {
                    <span class="wbx-leg"><span class="wbx-dot wbx-seg-@(i % 4)"></span>@sets[i].Key <span class="wbx-n">@sets[i].Count</span></span>
                }
            </div>
        }

        <div class="wbx-row wbx-row-gap">
            <span class="wbx-k">Feeds</span>
            @foreach (var f in s.Feeds) {
                <span class="wbx-feed @(f.Present ? "wbx-feed-ok" : "wbx-feed-missing")">
                    <span class="wbx-dot"></span>@f.Name
                    @if (f.UpdatedAt is { } at) {
                        <TimeAgo At="@at" Class="time-ago"/>
                    }
                </span>
            }
        </div>

        @if (s.Config.Platforms.Count > 0) {
            <div class="wbx-row wbx-row-gap">
                <span class="wbx-k">Config</span>
                @foreach (var p in s.Config.Platforms) {
                    <span class="wbx-feed wbx-feed-ok">
                        <PlatformIcon Platform="@p.Platform"/>
                        <TimeAgo At="@p.SavedAt" Class="time-ago"/>
                    </span>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter] public PeriodicalsSummary? Summary { get; set; }

    [Parameter] public EventCallback OnOpenNotifications { get; set; }

    [Parameter] public EventCallback OnOpenApiWorkbench { get; set; }

    static string? ExtractVersion(PeriodicalsSummary s) {
        return s.Extracted.Select(x => x.BinaryVersion).FirstOrDefault(v => !string.IsNullOrEmpty(v));
    }

}
