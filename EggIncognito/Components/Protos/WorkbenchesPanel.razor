@using System.Text.Json
@using EggSharp.GameData
@using EggIncognito.Models.Coverage
@using EggIncognito.Models.Periodicals
@using EggIncognito.Services.Coverage
@inject IServiceScopeFactory Scopes
@inject ILogger<WorkbenchesPanel> Logger
<section class="panel pd-w-workbench">
    <PanelHead Title="Workbenches">
        <Tools>
            <button type="button" class="btn-mini" @onclick="@(() => OnOpenNotifications.InvokeAsync())">Notifications</button>
            <button type="button" class="btn-mini" @onclick="@(() => OnOpenApis.InvokeAsync())">APIs</button>
            <button type="button" class="btn-mini" @onclick="@(() => OnOpenData.InvokeAsync())">Data</button>
            <button type="button" class="btn-mini" @onclick="@(() => OnOpenArtifacts.InvokeAsync())">Artifacts</button>
        </Tools>
    </PanelHead>
    @if (Summary is { } s) {
        <div class="wbx-row wbx-row-top">
            <span class="wbx-k">Feeds</span>
            <div class="wbx-feeds">
                @foreach (var f in s.Feeds) {
                    <button type="button" class="wbx-feed wbx-feed-link @(f.Present ? "wbx-feed-ok" : "wbx-feed-missing")" @key="f.Name"
                            @onclick="@(() => OnOpenFeed.InvokeAsync(f.Name))">
                        <span class="wbx-dot"></span><span class="wbx-feed-name">@f.Name</span>
                        @if (f.UpdatedAt is { } at) {
                            <TimeAgo At="@at" Class="time-ago"/>
                        }
                    </button>
                }
            </div>
        </div>

        @if (s.Config.Platforms.Count > 0) {
            <div class="wbx-row wbx-row-gap">
                <span class="wbx-k">Config</span>
                @foreach (var p in s.Config.Platforms) {
                    <span class="wbx-feed wbx-feed-ok">
                        <PlatformIcon Platform="@p.Platform"/>
                        <TimeAgo At="@p.SavedAt" Class="time-ago"/>
                    </span>
                }
            </div>
        }
    }
    @if (_coverage is { } m) {
        <div class="wbx-row wbx-row-gap">
            <span class="wbx-k">Coverage</span>
            <button type="button" class="wbx-feed wbx-feed-link wbx-cov" @onclick="@(() => OnOpenCoverage.InvokeAsync())">
                <span class="wbx-feed-name mono" style="@RatioStyle.Var(m.Validity)">@NumberFormat.Percent(m.Validity)</span>
                <span class="wbx-n"><Icon Name="layout-grid" Class="icon-sm"/>@m.CellsComplete/@m.CellsInScope</span>
                <span class="wbx-n"><Icon Name="database" Class="icon-sm"/>@NumberFormat.Compact(m.Observations)</span>
            </button>
        </div>
        <div class="wbx-covbar" role="img" aria-label="@($"{NumberFormat.Percent(m.Validity)} valid")">
            <span class="wbx-covfill" style="@RatioStyle.Var(m.Validity)"></span>
        </div>
    }
</section>

@code {
    [Parameter] public PeriodicalsSummary? Summary { get; set; }

    [Parameter] public EventCallback OnOpenNotifications { get; set; }

    [Parameter] public EventCallback OnOpenApis { get; set; }

    [Parameter] public EventCallback OnOpenData { get; set; }

    [Parameter] public EventCallback OnOpenArtifacts { get; set; }

    [Parameter] public EventCallback<string> OnOpenFeed { get; set; }

    [Parameter] public EventCallback OnOpenCoverage { get; set; }

    ConsumeCoverageMap? _coverage;

    protected override async Task OnInitializedAsync() {
        using var scope = Scopes.CreateScope();
        if (scope.ServiceProvider.GetService<ConsumeCoverageCache>() is not { } cache) return;
        try {
            _coverage = await cache.GetAsync(CancellationToken.None);
        } catch (Exception ex) when (ex is JsonException or InvalidOperationException or GameDataSchemaException) {
            Logger.LogDebug(ex, "consume coverage summary could not be built");
        }
    }


}
