@inherits SelfCallComponentBase
@using System.Globalization
@using System.Text.Json
@using EggIncognito.Models.Events
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Events
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ICurrentUser User
@inject IServiceProvider Services
@inject ILogger<EventsMiniCalendar> Logger

@if (_note.Length > 0) {
    <div class="evcal-note">@_note</div>
} else {
    <div class="evcal-mini-scroll" @ref="_scroller">
        <div class="evcal-shell evcal-view-week evcal-mini" style="@ShellStyle">
            <div class="evcal-scale">
                @foreach (var cell in _days) {
                    <span class="evcal-scale-label" style="@TickStyle(cell.LeftPercent)">@DayLabel(cell)</span>
                }
            </div>
            <div class="evcal-canvas">
                @foreach (var row in _rows) {
                    <div class="evcal-row" style="@RowStyle(row)">
                        @foreach (var cell in row.Cells) {
                            if (cell.LeftPercent > 0) {
                                <div class="evcal-grid" style="@TickStyle(cell.LeftPercent)"></div>
                            }
                        }
                        @if (row.NowPercent is { } nowPercent) {
                            <div class="evcal-now" style="@TickStyle(nowPercent)"></div>
                        }
                        <div class="evcal-lanes">
                            @foreach (var lane in row.Lanes) {
                                <div class="evcal-lane">
                                    @foreach (var bar in lane) {
                                        var e = bar.Item.Event!;
                                        <Tooltip Class="evcal-bar-tip" Style="@BarStyle(bar)">
                                            <ChildContent>
                                                <button type="button" class="@BarCss(bar)"
                                                        @onclick="@(() => OnOpen.InvokeAsync())">
                                                    @if (EventPalette.IconUrl(e.Type, e.Ultra) is { } iconUrl) {
                                                        <img class="evcal-bar-icon" src="@iconUrl" alt="" loading="lazy"
                                                             data-fallback/>
                                                    }

                                                    <span class="evcal-bar-label">@EventMagnitude.Scalar(e)</span>
                                                </button>
                                            </ChildContent>
                                            <Tip>
                                                <span class="tt-title">@Label(e)</span>
                                                @if (e.Ultra) {
                                                    <span class="tt-ultra">ULTRA ONLY</span>
                                                }

                                                <span class="tt-line">@Countdown(e)</span>
                                            </Tip>
                                        </Tooltip>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    const int HistoryDays = 21;
    const int FetchLimit = 500;

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    [Parameter] public EventCallback OnOpen { get; set; }

    ElementReference _scroller;
    IJSObjectReference? _scroll;
    IJSObjectReference? _tz;
    IReadOnlyList<EventCalendarRow> _rows = [];
    IReadOnlyList<EventCalendarCell> _days = [];
    IReadOnlyList<CalendarItem> _items = [];
    TimeZoneInfo _zone = ViewerZone.Fallback;
    bool _zoneFromProfile;
    DateTimeOffset _start;
    DateTimeOffset _end;
    string _note = "";
    bool _scrolled;

    int DayCount => Math.Max(1, (int)Math.Round((_end - _start).TotalDays));

    string ShellStyle => FormattableString.Invariant(
        $"--evcal-days:{DayCount};--evcal-gap:{EventCalendarLayout.GapPercent(_start, _end):0.###}%;");

    protected override async Task OnInitializedAsync() {
        var profileId = await ViewerZone.ProfileIdAsync(Services, User, CancellationToken.None);
        if (ViewerZone.Parse(profileId) is { } profileZone) {
            _zone = profileZone;
            _zoneFromProfile = true;
        }

        var now = DateTimeOffset.UtcNow;
        SetWindow(now);
        await Load(now);
    }

    void SetWindow(DateTimeOffset now) {
        (_, _end) = EventCalendarLayout.Window(now, EventCalendarZoom.Week, _zone);
        _start = _end.AddDays(-HistoryDays);
    }

    async Task Load(DateTimeOffset now) {
        var url = FormattableString.Invariant(
            $"/api/v1/events?after={UnixSeconds.FromTime(_start):0}&before={UnixSeconds.FromTime(_end.AddDays(1)):0}&limit={FetchLimit}");
        IReadOnlyList<GameEventDto> events;
        try {
            var res = await Client().GetAsync(url);
            if ((int)res.StatusCode == 503) {
                _note = "Event history needs a database. This instance has none.";
                return;
            }

            if (!res.IsSuccessStatusCode) {
                _note = "Events could not be loaded.";
                return;
            }

            var body = await res.Content.ReadFromJsonAsync<GameEventListResponse>(JsonOpts);
            events = body?.Events ?? [];
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the mini event calendar could not be loaded");
            _note = "Events could not be loaded.";
            return;
        }

        _items = [.. events.Select(Item)];
        Relayout(now);
        if (_rows.All(r => r.Lanes.Count == 0)) _note = "No events in the last three weeks.";
    }

    void Relayout(DateTimeOffset now) {
        _rows = EventCalendarLayout.Rows(_items, _start, _end, EventCalendarZoom.Week, now, _zone);
        _days = _rows.Count > 0 ? _rows[0].Cells : [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) await ResolveBrowserZone();
        if (_scrolled || _rows.Count == 0 || _note.Length > 0) return;
        _scrolled = true;
        try {
            _scroll ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", InteropAsset.Url(Env, "./interop/scroll.js"));
            await _scroll.InvokeVoidAsync("centerOnFraction", _scroller, NowFraction);
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException) {
        }
    }

    async Task ResolveBrowserZone() {
        if (_zoneFromProfile || _note.Length > 0) return;
        string? id;
        try {
            _tz = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/timezone.js"));
            id = await _tz.InvokeAsync<string>("read");
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException) {
            Logger.LogDebug(ex, "the browser time zone could not be read");
            return;
        }

        if (ViewerZone.Parse(id) is not { } zone || zone.Id == _zone.Id) return;
        _zone = zone;
        var now = DateTimeOffset.UtcNow;
        SetWindow(now);
        Relayout(now);
        StateHasChanged();
    }

    double NowFraction => _rows.Count > 0 && _rows[0].NowPercent is { } percent ? percent / 100 : 1;

    static string Countdown(GameEventDto e) {
        return EventCountdown.Describe(e.StartTimestamp, e.EndTimestamp, DateTimeOffset.UtcNow);
    }

    static string DayLabel(EventCalendarCell cell) {
        return cell.LocalDate.ToString("d/M", CultureInfo.InvariantCulture);
    }

    static string BarCss(EventCalendarBar bar) {
        var css = bar.Active ? "evcal-bar evcal-bar-active" : bar.Past ? "evcal-bar evcal-bar-past" : "evcal-bar";
        if (bar.ContinuesLeft) css += " evcal-bar-cut-l";
        if (bar.ContinuesRight) css += " evcal-bar-cut-r";
        return css;
    }

    static string BarStyle(EventCalendarBar bar) {
        var e = bar.Item.Event!;
        return FormattableString.Invariant($"--bar-start:{bar.LeftPercent:0.###};--bar-size:{bar.WidthPercent:0.###};")
               + EventPalette.BarStyle(e.Type, e.Ultra);
    }

    static CalendarItem Item(GameEventDto e) {
        return new CalendarItem(
            FormattableString.Invariant($"{e.Id}@{e.StartTimestamp:0}"),
            e.StartTimestamp,
            e.EndTimestamp,
            CalendarItemKind.Event,
            e,
            null,
            null,
            null);
    }

    static string TickStyle(double leftPercent) {
        return FormattableString.Invariant($"--tick-pos:{leftPercent:0.###};");
    }

    static string RowStyle(EventCalendarRow row) {
        return FormattableString.Invariant($"--row-weight:{Math.Max(1, row.Lanes.Count)};");
    }

    static string Label(GameEventDto e) {
        return string.IsNullOrWhiteSpace(e.Message) ? Pretty(e.Type) : e.Message;
    }

    static string Pretty(string raw) {
        var words = raw.Replace('-', ' ').Replace('_', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant()));
    }

    public async ValueTask DisposeAsync() {
        await _scroll.DisposeModuleAsync(logger: Logger);
        await _tz.DisposeModuleAsync(logger: Logger);
    }

}
