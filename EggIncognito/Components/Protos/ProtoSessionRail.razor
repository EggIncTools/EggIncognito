@using EggIncognito.Models.Registry
@using EggIncognito.Services.Protos

@{ var hasSession = Entries.Count > 0; }
<div class="wb-rail-slot pwb-rail-sess @(hasSession ? "" : "pwb-rail-sess-empty")">
    <WorkbenchSection Label="Session">
        <label id="wbRailDrop" class="pwb-drop" for="wbFile">
            <DropZonePrompt Prompt="Drop .ipa, .apk or bundle files"/>
        </label>
        @if (hasSession) {
            <FilterList TItem="StagedEntry" Schema="SessionFilter.Schema" Items="Entries"
                        Query="Query" QueryChanged="@(q => QueryChanged.InvokeAsync(q))"
                        Sections="SessionSections" FilterLabel="Filter session files" Class="pwb-sess-list">
                <Row Context="e">
                    @CardTemplate(e, null, false)
                </Row>
                <SectionBody Context="section">
                    @if (section.Key == SessionFilter.Analysed) {
                        @AnalysedBodyTemplate(section.Items)
                    } else {
                        @foreach (var e in section.Items) {
                            @CardTemplate(e, null, false)
                        }
                    }
                </SectionBody>
            </FilterList>
        }
    </WorkbenchSection>
</div>

@code {
    const int PendingOpenLimit = 3;

    [Parameter] public IReadOnlyList<StagedEntry> Entries { get; set; } = [];

    [Parameter] public ListQuery Query { get; set; } = ListQuery.Empty;

    [Parameter] public EventCallback<ListQuery> QueryChanged { get; set; }

    [Parameter] public Func<StagedEntry, OfferGroup?, bool, RenderFragment> CardTemplate { get; set; } = null!;

    [Parameter] public Func<IReadOnlyList<StagedEntry>, RenderFragment> AnalysedBodyTemplate { get; set; } = null!;

    static IReadOnlyList<FilterListSection<StagedEntry>> SessionSections(IReadOnlyList<StagedEntry> listed) {
        var sections = new List<FilterListSection<StagedEntry>>();
        var pending = listed.Where(e => SessionFilter.StateOf(e) == SessionFilter.Pending).ToList();
        var failed = listed.Where(e => SessionFilter.StateOf(e) == SessionFilter.Failed).ToList();
        var analysed = listed.Where(e => SessionFilter.StateOf(e) == SessionFilter.Analysed).ToList();
        if (pending.Count > 0) {
            var running = pending.Count(e => e.Status != "queued");
            sections.Add(new(SessionFilter.Pending, running > 0 ? $"Pending ({running} running)" : "Pending", pending,
                pending.Count > PendingOpenLimit, "warn"));
        }

        if (failed.Count > 0) sections.Add(new(SessionFilter.Failed, "Failed", failed, Tone: "bad"));
        if (analysed.Count > 0) sections.Add(new(SessionFilter.Analysed, "Analysed", analysed));
        return sections;
    }
}
