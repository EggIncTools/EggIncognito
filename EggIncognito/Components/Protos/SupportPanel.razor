@inject IAppMode AppMode
@inject ICurrentUser User

<section class="panel pd-w-support">
    <div class="sp-head">
        <span class="sp-badge"><Icon Name="heart"/></span>
        <div class="sp-head-text">
            <h3 class="sp-title">Support</h3>
            <span class="sp-sub">Free, open source, no ads</span>
        </div>
    </div>
    <ul class="sp-projects">
        @foreach (var project in Projects) {
            <li class="sp-project">@project</li>
        }
    </ul>
    <p class="sp-lede">Hosting and storage are paid for out of pocket. Support covers those costs and nothing else is locked behind it.</p>
    <div class="sp-actions">
        <button type="button" class="btn-primary sp-btn" @onclick="@(() => OnOpenSupport.InvokeAsync())">
            <Icon Name="heart" Class="icon-sm"/><span>Support the project</span>
        </button>
        @if (_canCapture) {
            <button type="button" class="btn-secondary sp-btn" @onclick="@(() => OnOpenCapture.InvokeAsync())">
                <Icon Name="upload" Class="icon-sm"/><span>Open capture</span>
            </button>
        }
    </div>
</section>

@code {
    [Parameter] public EventCallback OnOpenCapture { get; set; }

    [Parameter] public EventCallback OnOpenSupport { get; set; }

    static readonly string[] Projects = ["EggIncognito", "EggIdentity", "EggLedger"];

    bool _canCapture;

    protected override void OnInitialized() {
        _canCapture = AppMode.CanCapture || User.Current.IsSupporter || User.Current.IsAtLeast(UserRole.Admin);
    }

}
