@using EggIncognito.Models.Periodicals
@inherits SelfCallComponentBase
@inject ILogger<PeriodicalsPanel> Logger

<div class="pd-widgets">
    <div class="pd-wcol">
        <DeviceStatusPanel Class="pd-w-devices" OnManage="OnManageDevices"/>
        <WorkbenchesPanel Summary="_summary" OnOpenNotifications="OnOpenNotifications"
                          OnOpenApis="OnOpenApis" OnOpenData="OnOpenData" OnOpenArtifacts="OnOpenArtifacts"
                          OnOpenFeed="OnOpenFeed" OnOpenCoverage="OnOpenCoverage"/>
        <PdColleggtiblesPanel Summary="_summary"/>
    </div>

    <div class="pd-wcol">
        <div class="pd-wrow">
            <PdSeasonPanel/>
            <SupportPanel OnOpenCapture="OnOpenCapture" OnOpenSupport="OnOpenSupport"/>
        </div>

        <section class="panel pd-w-calendar">
            <PdEventsMiniCalendar OnOpenEvents="OnOpenEvents"/>
            <PdContractsMiniCalendar OnOpenContracts="OnOpenContracts"/>
        </section>

        @if (!_loaded) {
            <section class="panel pd-w-note">Loading…</section>
        }
    </div>
</div>

@code {
    bool _loaded;
    PeriodicalsSummary? _summary;

    [Parameter] public EventCallback<string?> OnManageDevices { get; set; }

    [Parameter] public EventCallback OnOpenNotifications { get; set; }

    [Parameter] public EventCallback OnOpenApis { get; set; }

    [Parameter] public EventCallback OnOpenData { get; set; }

    [Parameter] public EventCallback OnOpenArtifacts { get; set; }

    [Parameter] public EventCallback<string> OnOpenFeed { get; set; }

    [Parameter] public EventCallback OnOpenCoverage { get; set; }

    [Parameter] public EventCallback OnOpenEvents { get; set; }

    [Parameter] public EventCallback OnOpenContracts { get; set; }

    [Parameter] public EventCallback OnOpenCapture { get; set; }

    [Parameter] public EventCallback OnOpenSupport { get; set; }

    protected override async Task OnInitializedAsync() {
        if (Speculative) return;
        try {
            var fetched = await Client().GetFromJsonAsync<PeriodicalsSummary>("/api/periodicals/summary", JsonPresets.Web);
            if (fetched is not null) _summary = fetched;
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the periodicals summary could not be loaded");
        }

        _loaded = true;
    }
}
