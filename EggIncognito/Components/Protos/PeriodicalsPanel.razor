@using System.Globalization
@using System.Text
@using System.Text.Json
@using EggIncognito.Components.Calendar
@using EggIncognito.Models.Calendar
@using EggIncognito.Models.Contracts
@using EggIncognito.Models.Events
@using EggIncognito.Models.Periodicals
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Calendar
@using EggIncognito.Services.Events
@inherits SelfCallComponentBase
@inject IServiceProvider Services
@inject ILogger<PeriodicalsPanel> Logger

<div class="pd-widgets">
    <div class="pd-wcol">
        <DeviceStatusPanel Class="pd-w-devices" OnManage="OnManageDevices"/>
        <WorkbenchesPanel Summary="_summary" OnOpenNotifications="OnOpenNotifications"
                          OnOpenApiWorkbench="OnOpenApiWorkbench" OnOpenFeed="OnOpenFeed" OnOpenCoverage="OnOpenCoverage"/>

        @if (_summary?.Colleggtibles is { } c) {
            <section class="panel pd-w-cegg">
                <div class="cegg-head">
                    <h3 class="cegg-title">Colleggtibles</h3>
                    <a class="icon-btn icon-btn-sm" href="/api/v1/data/periodical/get_periodicals/colleggtibles" download="colleggtibles.json" aria-label="Download JSON">
                        <Icon Name="download"/>
                    </a>
                </div>
                @{
                    var tierCount = Math.Max(1, c.Eggs.Select(e => e.TierValues.Count).DefaultIfEmpty(0).Max());
                }
                <table class="data-table cegg-table">
                    <thead>
                    <tr>
                        <th class="cegg-icon-col" rowspan="2"></th>
                        <th class="cegg-name-col" rowspan="2">Name</th>
                        <th rowspan="2">Dimension</th>
                        <th class="cegg-tier-group cegg-tier-first" colspan="@tierCount">Tier</th>
                    </tr>
                    <tr>
                        @for (var t = 1; t <= tierCount; t++) {
                            <th class="@TierCellClass(t - 1)">@t</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var e in c.Eggs) {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(e.Icon)) {
                                    <FallbackImg Class="cegg-icon" Src="@e.Icon" Alt="@e.Identifier">
                                        <Fallback><span class="cegg-none">-</span></Fallback>
                                    </FallbackImg>
                                } else {
                                    <span class="cegg-none">-</span>
                                }
                            </td>
                            <td class="cegg-name">@EggName(e)</td>
                            @if (e.TierValues.Count == 0) {
                                <td class="cegg-dim" colspan="@(tierCount + 1)">not yet published</td>
                            } else {
                                <td class="cegg-dim">
                                    <span class="cegg-chip"><span class="cegg-chip-unit">@TierUnit(e.TierValues)</span>@TitleCase(e.Dimension)</span>
                                </td>
                                @for (var t = 0; t < tierCount; t++) {
                                    <td class="mono @TierCellClass(t)">@(t < e.TierValues.Count ? TierMagnitude(e.TierValues[t]) : "")</td>
                                }
                            }
                        </tr>
                    }
                    </tbody>
                </table>
                @{ var used = c.Eggs.Where(e => e.TierValues.Count > 0).Select(e => e.Dimension).ToHashSet(StringComparer.OrdinalIgnoreCase); }
                <div class="cegg-legend">
                    <span class="cegg-legend-k">Possible dimensions</span>
                    <ul class="cegg-legend-list">
                        @foreach (var dim in ProtoDimensions) {
                            <li class="cegg-legend-chip @(used.Contains(dim) ? "cegg-legend-on" : "")">@TitleCase(dim)</li>
                        }
                    </ul>
                </div>
            </section>
        }
    </div>

    <div class="pd-wcol">
        <section class="panel pd-w-calendar">
            <button type="button" class="pd-cal-title" @onclick="@(() => OnOpenEvents.InvokeAsync())">
                Events<Icon Name="chevron-right" Class="icon-sm"/>
            </button>
            <MiniCalendar TItem="EventCalendarItem" Load="LoadMiniEvents" EmptyNote="No events in the last three weeks.">
                <Bar>
                    @{ var e = context.Item.Event!; }
                    <div class="evcal-bar-tip" style="@EventBarStyle(context)">
                        <Tooltip>
                            <ChildContent>
                                <button type="button" class="@CalendarBars.Css(context)" @onclick="@(() => OnOpenEvents.InvokeAsync())">
                                    @if (EventPalette.IconUrl(e.Type, e.Ultra) is { } iconUrl) {
                                        <FallbackImg Class="evcal-bar-icon" Src="@iconUrl" Alt=""/>
                                    }

                                    <span class="evcal-bar-label">@EventMagnitude.Scalar(e)</span>
                                </button>
                            </ChildContent>
                            <Content>
                                <span class="tt-title">@EventLabel(e)</span>
                                @if (e.Ultra) {
                                    <span class="tt-ultra">ULTRA ONLY</span>
                                }

                                <span class="tt-line">@EventCountdown.Describe(e.StartTimestamp, e.EndTimestamp, DateTimeOffset.UtcNow)</span>
                            </Content>
                        </Tooltip>
                    </div>
                </Bar>
            </MiniCalendar>
            <button type="button" class="pd-cal-title pd-cal-title-gap" @onclick="@(() => OnOpenContracts.InvokeAsync())">
                Contracts<Icon Name="chevron-right" Class="icon-sm"/>
            </button>
            <MiniCalendar TItem="ContractCalendarItem" Load="LoadMiniContracts" EmptyNote="No contracts in the last three weeks.">
                <Bar>
                    @{ var c = context.Item.Release!; }
                    <div class="evcal-bar-tip" style="@ContractBarStyle(context)">
                        <Tooltip>
                            <ChildContent>
                                <button type="button" class="@(CalendarBars.Css(context) + " evcal-bar-contract")"
                                        @onclick="@(() => OnOpenContracts.InvokeAsync())">
                                    @if (EggIcons.Url(c.Egg, c.CustomEggId) is { } eggUrl) {
                                        <FallbackImg Class="evcal-bar-egg" Src="@eggUrl" Alt=""/>
                                    }
                                    <span class="evcal-bar-label">@c.Name</span>
                                </button>
                            </ChildContent>
                            <Content>
                                <span class="tt-title">@c.Name</span>
                                @if (c.UltraOnly) {
                                    <span class="tt-ultra">ULTRA ONLY</span>
                                }

                                <span class="tt-line">@EggIcons.Label(c.Egg, c.CustomEggId)</span>
                                <span class="tt-line">@EventCountdown.Describe(c.StartTimestamp, c.EndTimestamp, DateTimeOffset.UtcNow)</span>
                            </Content>
                        </Tooltip>
                    </div>
                </Bar>
            </MiniCalendar>
            @if (_seasons is { Count: > 0 } seasonList) {
                var season = seasonList[Math.Clamp(_seasonIx, 0, seasonList.Count - 1)];
                var grades = season.GradeGoals.Where(g => g.Goals.Count > 0).ToList();
                <div class="season-top">
                    <SubSectionHead>Season</SubSectionHead>
                    <div class="season-nav">
                        <button type="button" class="icon-btn icon-btn-sm season-nav-btn"
                                disabled="@(_seasonIx >= seasonList.Count - 1)"
                                aria-label="Older season" @onclick="() => MoveSeason(1)">
                            <Icon Name="chevron-left"/>
                        </button>
                        <button type="button" class="icon-btn icon-btn-sm season-nav-btn"
                                disabled="@(_seasonIx <= 0)"
                                aria-label="Newer season" @onclick="() => MoveSeason(-1)">
                            <Icon Name="chevron-right"/>
                        </button>
                    </div>
                </div>
                <div class="season-head">
                    <div class="season-id">
                        <div class="season-date">
                            <div class="season-date-m">@StartDate(season).ToString("MMM")</div>
                            <div class="season-date-d">@StartDate(season).Day</div>
                        </div>
                        <div class="season-id-body">
                            <div class="season-name">@season.Name</div>
                            @if (IsActive(season)) {
                                <div class="season-sub">Next season ~@NextStartLabel(season)</div>
                                <div class="season-sub">@ContractsLeftLabel(season)</div>
                            } else {
                                <div class="season-sub">@StartLabel(season)</div>
                            }
                        </div>
                    </div>
                    @if (season.Colleggtibles is { Count: > 0 } ceggs) {
                        <div class="season-ceggs">
                            <div class="season-ceggs-title">@(ceggs.Count == 1 ? "Season Colleggtible" : "Season Colleggtibles")</div>
                            <div class="season-cegg-list">
                                @foreach (var egg in ceggs) {
                                    <div class="season-cegg">
                                        @if (egg.Icon is not null) {
                                            <FallbackImg Class="season-cegg-icon" Src="@egg.Icon" Alt="@egg.Id"/>
                                        }
                                        <div class="season-cegg-body">
                                            <div class="season-cegg-name">@TitleCase(egg.Id)</div>
                                            @if (egg.Contracts is { Count: > 0 } cnames) {
                                                <div class="season-cegg-contracts">@string.Join(", ", cnames)</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (grades.Count > 0) {
                    var goalCount = grades.Max(g => g.Goals.Count);
                    <table class="data-table season-table" @key="season.Id">
                        <thead>
                        <tr>
                            <th>Goal</th>
                            @foreach (var g in grades) {
                                <th>
                                    @if (!string.IsNullOrEmpty(g.GradeIcon)) {
                                        <FallbackImg Class="season-grade-icon" Src="@g.GradeIcon" Alt="@GradeLabel(g.Grade)">
                                            <Fallback>@GradeLabel(g.Grade)</Fallback>
                                        </FallbackImg>
                                    } else {
                                        @GradeLabel(g.Grade)
                                    }
                                </th>
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var goalIx in Enumerable.Range(0, goalCount)) {
                            <tr>
                                <td class="season-goal-ix">@(goalIx + 1)</td>
                                @foreach (var g in grades) {
                                    <td>
                                        @if (goalIx < g.Goals.Count) {
                                            var goal = g.Goals[goalIx];
                                            <Tooltip>
                                                <ChildContent>
                                                    <span class="season-goal">
                                                        <span class="season-goal-cs">
                                                            @FormatAmount(goal.Cxp)<span class="season-goal-unit">CS</span>
                                                        </span>
                                                        <span class="season-goal-reward">
                                                            @if (!string.IsNullOrEmpty(goal.Icon)) {
                                                                <FallbackImg Class="season-goal-img" Src="@goal.Icon" Alt=""/>
                                                            }

                                                            @if (goal.RewardAmount != 1) {
                                                                <span class="season-goal-amt">@($"x{FormatAmount(goal.RewardAmount)}")</span>
                                                            }
                                                        </span>
                                                    </span>
                                                </ChildContent>
                                                <Content>
                                                    <span class="tt-title">@RewardFullName(goal)</span>
                                                    <span class="tt-line">@goal.RewardAmount.ToString("N0") @RewardFullNoun(goal)</span>
                                                    @if (BoostInfo(goal) is { } bi) {
                                                        @if (bi.Duration is { } bd) {
                                                            <span class="tt-line">Lasts @bd</span>
                                                        }

                                                        @if (bi.Effect is { } be) {
                                                            <span class="tt-line">@be</span>
                                                        }
                                                    }
                                                </Content>
                                            </Tooltip>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                } else {
                    <div class="season-none">No reward data captured for this season.</div>
                }
            }
        </section>

        <SupportPanel OnOpenCapture="OnOpenCapture" OnOpenSupport="OnOpenSupport"/>

        @if (!_loaded) {
            <section class="panel pd-w-note">Loading…</section>
        }
    </div>
</div>

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    bool _loaded;
    PeriodicalsSummary? _summary;
    List<Models.Periodicals.Season>? _seasons;
    int _seasonIx;

    [Parameter] public EventCallback<string?> OnManageDevices { get; set; }

    [Parameter] public EventCallback OnOpenNotifications { get; set; }

    [Parameter] public EventCallback OnOpenApiWorkbench { get; set; }

    [Parameter] public EventCallback<string> OnOpenFeed { get; set; }

    [Parameter] public EventCallback OnOpenCoverage { get; set; }

    [Parameter] public EventCallback OnOpenEvents { get; set; }

    [Parameter] public EventCallback OnOpenContracts { get; set; }

    [Parameter] public EventCallback OnOpenCapture { get; set; }

    [Parameter] public EventCallback OnOpenSupport { get; set; }

    protected override async Task OnInitializedAsync() {
        try {
            var fetched = await Client().GetFromJsonAsync<PeriodicalsSummary>("/api/periodicals/summary", JsonOpts);
            if (fetched is not null) _summary = fetched;
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the periodicals summary could not be loaded");
        }

        try {
            var seasonsRes = await Client().GetFromJsonAsync<SeasonsResponse>("/api/periodicals/seasons", JsonOpts);
            if (seasonsRes?.Seasons is { Count: > 0 } ls) {
                _seasons = ls;
                var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                var ix = ls.FindIndex(s => s.StartTime <= now);
                _seasonIx = ix < 0 ? 0 : ix;
            }
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the periodicals season list could not be loaded");
        }

        await LoadBoostCatalog();
        _loaded = true;
    }

    const int MiniFetchLimit = 500;

    async Task<CalendarItemsLoad<EventCalendarItem>> LoadMiniEvents(DateTimeOffset start, DateTimeOffset end) {
        var url = FormattableString.Invariant(
            $"/api/v1/events?after={UnixSeconds.FromTime(start):0}&before={UnixSeconds.FromTime(end):0}&limit={MiniFetchLimit}");
        try {
            var res = await Client().GetAsync(url);
            if ((int)res.StatusCode == 503) return CalendarItemsLoad.Failed<EventCalendarItem>("Event history needs a database. This instance has none.");
            if (!res.IsSuccessStatusCode) return CalendarItemsLoad.Failed<EventCalendarItem>("Events could not be loaded.");
            var body = await res.Content.ReadFromJsonAsync<GameEventListResponse>(JsonOpts);
            return CalendarItemsLoad.Ok<EventCalendarItem>([.. (body?.Events ?? []).Select(EventCalendarItem.Of)]);
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the mini event calendar could not be loaded");
            return CalendarItemsLoad.Failed<EventCalendarItem>("Events could not be loaded.");
        }
    }

    async Task<CalendarItemsLoad<ContractCalendarItem>> LoadMiniContracts(DateTimeOffset start, DateTimeOffset end) {
        var url = FormattableString.Invariant(
            $"/api/v1/contracts?after={UnixSeconds.FromTime(start):0}&before={UnixSeconds.FromTime(end):0}&limit={MiniFetchLimit}");
        try {
            var res = await Client().GetAsync(url);
            if ((int)res.StatusCode == 503) return CalendarItemsLoad.Failed<ContractCalendarItem>("Contract history needs a database. This instance has none.");
            if (!res.IsSuccessStatusCode) return CalendarItemsLoad.Failed<ContractCalendarItem>("Contracts could not be loaded.");
            var body = await res.Content.ReadFromJsonAsync<ContractReleaseListResponse>(JsonOpts);
            return CalendarItemsLoad.Ok<ContractCalendarItem>([.. (body?.Releases ?? []).Select(ContractCalendarItem.Of)]);
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the mini contract calendar could not be loaded");
            return CalendarItemsLoad.Failed<ContractCalendarItem>("Contracts could not be loaded.");
        }
    }

    static string EventBarStyle(CalendarBar<EventCalendarItem> bar) {
        var e = bar.Item.Event!;
        return CalendarBars.PositionStyle(bar) + EventPalette.BarStyle(e.Type, e.Ultra);
    }

    static string ContractBarStyle(CalendarBar<ContractCalendarItem> bar) {
        return CalendarBars.PositionStyle(bar) + ContractPalette.BarStyle(bar.Item.Kind);
    }

    static string EventLabel(GameEventDto e) {
        return string.IsNullOrWhiteSpace(e.Message) ? TitleCase(e.Type) : e.Message;
    }

    void MoveSeason(int delta) {
        if (_seasons is null) return;
        _seasonIx = Math.Clamp(_seasonIx + delta, 0, _seasons.Count - 1);
    }

    DateTimeOffset StartDate(Models.Periodicals.Season s) {
        return ViewerClock.At(Services, DateTimeOffset.FromUnixTimeSeconds((long)s.StartTime));
    }

    string StartLabel(Models.Periodicals.Season s) {
        var d = StartDate(s);
        var verb = d <= DateTimeOffset.UtcNow ? "Started" : "Starts";
        var derived = s.StartDerived ? " (derived)" : "";
        return $"{verb} {d.ToString("MMMM d, yyyy")}{derived}";
    }

    static bool IsActive(Models.Periodicals.Season s) {
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        return s.StartTime <= now && now < s.NextStartTime;
    }

    string NextStartLabel(Models.Periodicals.Season s) {
        return ViewerClock.At(Services, DateTimeOffset.FromUnixTimeSeconds((long)s.NextStartTime)).ToString("MMMM d");
    }

    string ContractsLeftLabel(Models.Periodicals.Season s) {
        var nextLocal = ViewerClock.At(Services, DateTimeOffset.FromUnixTimeSeconds((long)s.NextStartTime));
        var mondays = MondaysBetween(ViewerClock.At(Services, DateTimeOffset.UtcNow), nextLocal);
        return $"{mondays} {(mondays == 1 ? "contract" : "contracts")} left";
    }

    static int MondaysBetween(DateTimeOffset nowLocal, DateTimeOffset endLocal) {
        var count = 0;
        for (var d = nowLocal.Date.AddDays(1); d < endLocal.Date; d = d.AddDays(1)) {
            if (d.DayOfWeek == DayOfWeek.Monday) count++;
        }

        return count;
    }

    static string GradeLabel(string grade) {
        if (grade.StartsWith("GRADE_", StringComparison.Ordinal)) return grade["GRADE_".Length..];
        if (grade.StartsWith("Grade", StringComparison.Ordinal)) return grade["Grade".Length..].ToUpperInvariant();
        return grade;
    }

    static string FormatAmount(double n) {
        if (n >= 1e9) return (n / 1e9).ToString("0.##") + "B";
        if (n >= 1e6) return (n / 1e6).ToString("0.##") + "M";
        if (n >= 1e3) return (n / 1e3).ToString("0.##") + "K";
        return n.ToString("N0");
    }

    static string RewardName(string rewardType, string? subType, bool plural) {
        return rewardType switch {
            "Gold" => "GE",
            "SoulEggs" => plural ? "Soul Eggs" : "Soul Egg",
            "EggsOfProphecy" => "PE",
            "ShellScript" => "Tickets",
            "PiggyMultiplier" => plural ? "Piggy Multipliers" : "Piggy Multiplier",
            "PiggyLevelBump" => plural ? "Piggy Level Bumps" : "Piggy Level Bump",
            "Boost" => Pretty(subType ?? ""),
            "EpicResearchItem" => Pretty(subType ?? ""),
            "BoostToken" => plural ? "Boost Tokens" : "Boost Token",
            "Artifact" => plural ? "Artifacts" : "Artifact",
            "ArtifactCase" => "Artifacts",
            "Chicken" => plural ? "Chicken Boxes" : "Chicken Box",
            "VirtueGem" => plural ? "Virtue Gems" : "Virtue Gem",
            "Cash" => "Cash",
            _ => Pretty(rewardType)
        };
    }

    readonly Dictionary<string, Models.Periodicals.BoostMeta> _boosts = new(StringComparer.Ordinal);

    BoostMeta? BoostInfo(GoalRow g) {
        if (g.RewardType != "Boost" || string.IsNullOrEmpty(g.RewardSubType)) return null;
        if (_boosts.TryGetValue(g.RewardSubType, out var meta)) return meta;
        var bare = g.RewardSubType.EndsWith("_v2", StringComparison.Ordinal)
            ? g.RewardSubType[..^3]
            : g.RewardSubType;
        return _boosts.GetValueOrDefault(bare);
    }

    static string FormatDuration(double seconds) {
        if (seconds >= 3600) return $"{seconds / 3600:0.#}h";
        if (seconds >= 60) return $"{seconds / 60:0.#}m";
        return $"{seconds:0}s";
    }

    async Task LoadBoostCatalog() {
        try {
            var res = await Client().GetAsync("/api/v1/data/gamedata/boost-catalog");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (!doc.RootElement.TryGetProperty("boosts", out var arr)) return;
            foreach (var b in arr.EnumerateArray()) {
                var id = b.TryGetProperty("id", out var idEl) ? idEl.GetString() : null;
                if (string.IsNullOrEmpty(id)) continue;
                var dn = b.TryGetProperty("displayName", out var dnEl) ? dnEl.GetString() : null;
                var dur = b.TryGetProperty("durationSeconds", out var duEl)
                          && duEl.TryGetDouble(out var ds) && ds > 0
                    ? FormatDuration(ds)
                    : null;
                string? eff = null;
                if (b.TryGetProperty("magnitude", out var mgEl) && mgEl.TryGetDouble(out var mg) && mg > 0) {
                    var tgt = b.TryGetProperty("target", out var tEl) ? tEl.GetString() ?? "" : "";
                    eff = tgt.Length > 0
                        ? $"{FormatAmount(mg)}x {Pretty(tgt.StartsWith("bd-", StringComparison.Ordinal) ? tgt[3..] : tgt)}"
                        : $"{FormatAmount(mg)}x";
                }

                _boosts[id] = new BoostMeta(string.IsNullOrEmpty(dn) ? TitleCase(id) : dn, dur, eff);
            }
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the boost catalog could not be loaded");
        }
    }

    string RewardFullName(GoalRow g) {
        return g.RewardType switch {
            "Gold" => "Golden Eggs",
            "EggsOfProphecy" => "Prophecy Eggs",
            "ShellScript" => "Shell Tickets",
            "PiggyFill" => "Piggy Fill",
            "ArtifactCase" => "Artifacts",
            "Boost" => TitleCase(BoostInfo(g)?.DisplayName ?? Pretty(g.RewardSubType)),
            "EpicResearchItem" => Pretty(g.RewardSubType),
            _ => RewardName(g.RewardType, g.RewardSubType, true)
        };
    }

    static string RewardFullNoun(GoalRow g) {
        var one = g.RewardAmount == 1;
        return g.RewardType switch {
            "Gold" => one ? "golden egg" : "golden eggs",
            "EggsOfProphecy" => one ? "prophecy egg" : "prophecy eggs",
            "ShellScript" => one ? "shell ticket" : "shell tickets",
            "PiggyFill" => "added to the piggy bank",
            "ArtifactCase" => one ? "artifact" : "artifacts",
            "Boost" => one ? "boost" : "boosts",
            "EpicResearchItem" => one ? "level" : "levels",
            "BoostToken" => one ? "boost token" : "boost tokens",
            "SoulEggs" => one ? "soul egg" : "soul eggs",
            "VirtueGem" => one ? "virtue gem" : "virtue gems",
            "Chicken" => one ? "chicken box" : "chicken boxes",
            _ => ""
        };
    }

    static string TitleCase(string raw) {
        return string.Join(' ', raw.Split([' ', '_', '-'], StringSplitOptions.RemoveEmptyEntries).Select(TitleWord));
    }

    static string TitleWord(string word) {
        return word.Contains('.', StringComparison.Ordinal)
            ? word
            : char.ToUpperInvariant(word[0]) + word[1..].ToLowerInvariant();
    }

    static string EggName(EggRow e) {
        return TitleCase(string.IsNullOrWhiteSpace(e.Name) ? e.Identifier : e.Name);
    }

    static string TierMagnitude(double value) {
        var magnitude = Math.Abs(value - 1) * 100;
        var digits = magnitude >= 10 ? "0.#" : "0.##";
        return magnitude.ToString(digits, CultureInfo.InvariantCulture);
    }

    static string TierUnit(IReadOnlyList<double> values) {
        return values.All(v => v < 1) ? "-%" : "+%";
    }

    static readonly IReadOnlyList<string> ProtoDimensions = [
        .. EggIncognito.GameData.ColleggtibleCatalog.DimensionCodes.Where(kv => kv.Value > 0).OrderBy(kv => kv.Value).Select(kv => kv.Key)
    ];

    static string TierCellClass(int tierIx) {
        return tierIx == 0 ? "cegg-tier cegg-tier-first" : "cegg-tier";
    }

    static string Pretty(string raw) {
        var words = raw.Replace('-', '_').Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length > 1 || raw.Contains('_')) return string.Join(' ', words.Select(w => w.Length > 0 ? char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant() : w));

        var sb = new StringBuilder();
        foreach (var ch in raw) {
            if (char.IsUpper(ch) && sb.Length > 0) sb.Append(' ');
            sb.Append(ch);
        }

        return sb.ToString();
    }

}
