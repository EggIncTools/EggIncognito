@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ToastService Toasts
@using System.Text
@using System.Text.Json
@implements IAsyncDisposable

@* Only render when there is something to review, unless the host asked for an explicit empty state. *@
@if (_rows.Count == 0 && ShowEmpty) {
    <section class="panel sr-panel">
        <div class="sr-empty">@EmptyText</div>
    </section>
} else if (_rows.Count > 0) {
    var fresh = _rows;
    <section class="panel sr-panel">
        <div class="sr-head">
            <div class="sr-title">Staged submissions (@_rows.Count)</div>
            @if (fresh.Any(r => r.IsIncomplete)) {
                <button type="button" class="btn-mini" @onclick="CopyAllMissing">
                    Copy Missing Info (@fresh.Count(r => r.IsIncomplete))
                </button>
            }
        </div>

        @if (_selected.Count > 0) {
            <div class="sr-bulk">
                <span class="sr-bulk-count">@_selected.Count selected</span>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="BulkApprove">Approve selected</button>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="BulkReject">Reject selected</button>
                <button type="button" class="btn-mini" @onclick="ClearSelection">Clear</button>
            </div>
        }

        @if (fresh.Count > 0) {
            <div class="sr-sec">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th class="sr-pick">
                            <input type="checkbox" checked="@AllSelectedIn(fresh)" @onchange="@(e => ToggleAllIn(fresh, e))"/>
                        </th>
                        <th>Source</th>
                        <th>Platform</th>
                        <th>App Version</th>
                        <th>Build</th>
                        <th>Client</th>
                        <th>Proto SHA</th>
                        <th>Origin</th>
                        <th class="sr-actions-col">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in fresh) {
                        <tr>
                            <td @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@_selected.Contains(r.Id)" @onchange="@(() => ToggleRow(r.Id))"/>
                            </td>
                            <td>
                                <span class="code-chip">@r.Source</span>
                            </td>
                            <td>
                                <input class="protos-filter sr-in sr-in-sm" @bind="r.Platform"/>
                            </td>
                            <td>
                                <input class="protos-filter sr-in sr-in-md" placeholder="-" @bind="r.AppVersion"/>
                            </td>
                            <td>
                                <input class="protos-filter sr-in sr-in-lg" placeholder="-" @bind="r.Build"/>
                            </td>
                            <td>
                                <input class="protos-filter sr-in sr-in-xs" placeholder="-" @bind="r.ClientVersion"/>
                            </td>
                            <td class="sr-sha">@Short(r.ProtoSha)</td>
                            <td class="sr-origin">
                                @if (r.OriginRepo is not null) {
                                    <span>@r.OriginRepo</span>
                                    @if (r.Confidence is { } c) {
                                        <span class="@ConfClass(c)"> (@c)</span>
                                    }
                                }
                            </td>
                            <td @onclick:stopPropagation="true">
                                <div class="sr-actions">
                                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => Approve(r))">Approve</button>
                                    <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => Reject(r))">Reject</button>
                                    @if (r.IsIncomplete) {
                                        <button type="button" class="btn-mini" @onclick="@(() => CopyOne(r))">
                                            Copy
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    List<Models.Staging.StagedRow> _rows = [];
    readonly HashSet<int> _selected = [];
    bool _busy;

    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public bool ShowEmpty { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No pending submissions.";

    protected override async Task OnInitializedAsync() {
        await Load();
    }

    public async Task Load() {
        try {
            _rows = await Client().GetFromJsonAsync<List<Models.Staging.StagedRow>>("/api/protos/staged", JsonOpts) ?? [];
        } catch {
            _rows = [];
        }

        _selected.IntersectWith(_rows.Select(r => r.Id));
        StateHasChanged();
    }

    void ToggleRow(int id) {
        if (!_selected.Add(id)) _selected.Remove(id);
    }

    void ClearSelection() {
        _selected.Clear();
    }

    bool AllSelectedIn(IReadOnlyList<Models.Staging.StagedRow> rows) {
        return rows.Count > 0 && rows.All(r => _selected.Contains(r.Id));
    }

    void ToggleAllIn(IReadOnlyList<Models.Staging.StagedRow> rows, ChangeEventArgs e) {
        var on = e.Value is true;
        foreach (var r in rows) {
            if (on) _selected.Add(r.Id);
            else _selected.Remove(r.Id);
        }
    }

    static string Short(string? sha) {
        return string.IsNullOrEmpty(sha) ? "" : sha.Length <= 12 ? sha : sha[..12];
    }

    static string ConfClass(string c) {
        return c switch {
            "version-file" => "text-accent",
            "subject" => "muted",
            _ => "text-err"
        };
    }

    static object ApproveBody(Models.Staging.StagedRow r) {
        return new { platform = r.Platform, appVersion = r.AppVersion, build = r.Build, clientVersion = r.ClientVersion };
    }

    async Task Approve(Models.Staging.StagedRow r) {
        _busy = true;
        try {
            var resp = await Client().PostAsJsonAsync($"/api/protos/staged/{r.Id}/approve", ApproveBody(r), JsonOpts);
            if (resp.IsSuccessStatusCode) Ok("approved");
            else Err(await ErrorText(resp) ?? $"approve failed ({(int)resp.StatusCode})");
        } catch (Exception ex) {
            Err($"approve error: {ex.Message}");
        } finally {
            _busy = false;
        }

        await Load();
        await OnChanged.InvokeAsync();
    }

    async Task Reject(Models.Staging.StagedRow r) {
        _busy = true;
        try {
            var resp = await Client().PostAsJsonAsync($"/api/protos/staged/{r.Id}/reject", new { note = (string?)null }, JsonOpts);
            if (resp.IsSuccessStatusCode) Ok("rejected");
            else Err($"reject failed ({(int)resp.StatusCode})");
        } catch (Exception ex) {
            Err($"reject error: {ex.Message}");
        } finally {
            _busy = false;
        }

        await Load();
        await OnChanged.InvokeAsync();
    }

    async Task BulkApprove() {
        if (_selected.Count == 0) return;
        _busy = true;
        try {
            var items = _rows.Where(r => _selected.Contains(r.Id)).Select(r => new {
                id = r.Id, platform = r.Platform, appVersion = r.AppVersion, build = r.Build, clientVersion = r.ClientVersion
            }).ToList();
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/bulk-approve", new { items }, JsonOpts);
            if (resp.IsSuccessStatusCode) {
                var r = await resp.Content.ReadFromJsonAsync<Models.Staging.BulkApproveResp>(JsonOpts);
                if (r is null) Ok("approved");
                else if (r.Failed > 0) Err(BulkSummary(r));
                else Ok(BulkSummary(r));
            } else {
                Err($"bulk approve failed ({(int)resp.StatusCode})");
            }
        } catch (Exception ex) {
            Err($"bulk approve error: {ex.Message}");
        } finally {
            _busy = false;
        }

        ClearSelection();
        await Load();
        await OnChanged.InvokeAsync();
    }

    async Task BulkReject() {
        if (_selected.Count == 0) return;
        _busy = true;
        try {
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/bulk-reject",
                new { ids = _selected.ToList(), note = (string?)null }, JsonOpts);
            if (resp.IsSuccessStatusCode) {
                var r = await resp.Content.ReadFromJsonAsync<Models.Staging.BulkRejectResp>(JsonOpts);
                Ok(r is null ? "rejected" : $"rejected {r.Rejected}");
            } else {
                Err($"bulk reject failed ({(int)resp.StatusCode})");
            }
        } catch (Exception ex) {
            Err($"bulk reject error: {ex.Message}");
        } finally {
            _busy = false;
        }

        ClearSelection();
        await Load();
        await OnChanged.InvokeAsync();
    }

    IJSObjectReference? _copy;

    static string MissingReport(IEnumerable<Models.Staging.StagedRow> rows) {
        var sb = new StringBuilder();
        sb.AppendLine("# Staged proto rows with missing version info");
        sb.AppendLine();
        foreach (var r in rows) {
            sb.AppendLine($"- id={r.Id} sha={r.ProtoSha} source={r.Source} platform={r.Platform}");
            sb.AppendLine($"  have: appVersion={Or(r.AppVersion)} build={Or(r.Build)} clientVersion={Or(r.ClientVersion)}");
            sb.AppendLine($"  MISSING: {string.Join(", ", r.Missing)}");
            if (r.OriginRepo is not null)
                sb.AppendLine($"  origin: repo={r.OriginRepo} commit={Or(r.OriginCommit)} date={r.OriginDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-"} confidence={Or(r.Confidence)}");
            sb.AppendLine();
        }

        return sb.ToString();

        static string Or(string? s) {
            return string.IsNullOrWhiteSpace(s) ? "-" : s;
        }
    }

    async Task CopyAndClear(IReadOnlyList<Models.Staging.StagedRow> rows) {
        if (rows.Count == 0) return;
        _busy = true;
        try {
            _copy ??= await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/copy.js"));
            await _copy.InvokeAsync<bool>("writeText", MissingReport(rows));
        } catch (Exception ex) {
            Err($"copy failed (rows kept): {ex.Message}");
            _busy = false;
            StateHasChanged();
            return;
        }

        try {
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/bulk-reject",
                new { ids = rows.Select(r => r.Id).ToList(), note = "set aside: missing version data (copied for audit)" }, JsonOpts);
            var n = resp.IsSuccessStatusCode ? (await resp.Content.ReadFromJsonAsync<Models.Staging.BulkRejectResp>(JsonOpts))?.Rejected ?? 0 : 0;
            Ok($"copied {rows.Count} to clipboard, set aside {n} (returns if re-surfaced with more data)");
        } catch (Exception ex) {
            Err($"copied, but clear failed: {ex.Message}");
        } finally {
            _busy = false;
        }

        ClearSelection();
        await Load();
        await OnChanged.InvokeAsync();
    }

    Task CopyAllMissing() {
        return CopyAndClear([.. _rows.Where(r => r.IsIncomplete)]);
    }

    static async Task<string?> ErrorText(HttpResponseMessage resp) {
        try {
            var body = await resp.Content.ReadFromJsonAsync<ErrorResp>(JsonOpts);
            return string.IsNullOrWhiteSpace(body?.Error) ? null : body.Error;
        } catch (Exception ex) when (ex is HttpRequestException or NotSupportedException or JsonException) {
            return null;
        }
    }

    sealed record ErrorResp(string? Error);

    Task CopyOne(Models.Staging.StagedRow r) {
        return CopyAndClear([r]);
    }

    public ValueTask DisposeAsync() {
        return _copy.DisposeModuleQuietAsync();
    }

    void Ok(string t) {
        Toasts.Push(StatusNoteKind.Ok, t);
    }

    void Err(string t) {
        Toasts.Push(StatusNoteKind.Error, t);
    }

    static string BulkSummary(Models.Staging.BulkApproveResp r) {
        var sb = new StringBuilder();
        sb.Append(r.Approved).Append(" approved");
        if (r.Skipped > 0) sb.Append(", ").Append(r.Skipped).Append(" skipped");
        if (r.Failed > 0) sb.Append(", ").Append(r.Failed).Append(" failed");
        return sb.ToString();
    }

}
