@using EggIncognito.Core
@using EggIncognito.Models.Registry
@using EggIncognito.Services.Protos
@inject ICurrentUser User

<div class="pwb-status">
    <span class="pwb-file" title="@Sel.FileName">@Sel.FileName</span>
    @if (Sel.Status == "error") {
        <span class="pwb-tag pwb-err" title="@Sel.Error">failed</span>
    } else if (!Sel.IsDone) {
        <span class="pwb-tag" aria-busy="true" title="@Sel.Step">@Sel.Status</span>
    } else if (Sel.Result is { } r) {
        <span class="pwb-mono-note" title="Messages, proto sha">@(r.Messages.Count) msg @Sha12(r.ProtoSha)</span>
        @if (SelGroup is { Conflict: true }) {
            <span class="pwb-tag pwb-err" title="Pick the file to offer in the rail.">conflict</span>
        } else if (SelGroup?.Status is { Rejected: true }) {
            <span class="pwb-tag pwb-warn" title="A reviewer rejected this proto. Resubmit with more version data to reopen it.">rejected</span>
        } else if (SelGroup?.Status is { Known: true, ShaDiffers: true }) {
            <span class="pwb-tag pwb-warn" title="This build is registered with another proto. The archive text replaces it.">proto differs</span>
        } else if (SelGroup?.Status is { Known: true, MetaDiffers: true }) {
            <span class="pwb-tag pwb-warn" title="This build is registered with a different app or client version. The extracted values replace them.">version differs</span>
        } else if (SelGroup?.Status is { Archived: true }) {
            <span class="pwb-tag pwb-ok">archive flagged</span>
        } else if (SelGroup?.Status is { Known: true }) {
            <span class="pwb-tag pwb-ok">in registry</span>
        } else if (SelGroup?.Status is { Failed: true }) {
            <span class="pwb-tag pwb-err">check failed</span>
            <button type="button" class="btn-mini" aria-label="Retry check" title="Retry check"
                    @onclick="@(() => OnRetryCheck.InvokeAsync())">
                <Icon Name="refresh-cw" Class="icon-sm"/>
            </button>
        } else if (SelGroup?.Status is { Pending: true } or { Offered: true }) {
            @if (User.Current.IsAtLeast(UserRole.Contributor)) {
                <button type="button" class="pwb-pending-btn @(AdminOpen && IsReviewTab ? "active" : "")"
                        @onclick="OnToggleQueue">
                    pending review
                </button>
            } else {
                <span class="pwb-tag pwb-warn">pending review</span>
            }
        } else if (SelGroup?.Status is { Offerable: true } offerable) {
            <span class="pwb-tag" title="@(User.Current.IsAuthenticated ? null : "Log in to offer this version to the registry.")">
                @(offerable.InRegistry ? "known sha, new build" : "offerable")
            </span>
        }

        @if (SelGroup is { } sg && CanOffer(sg)) {
            <button type="button" class="btn-mini" disabled="@OfferBusy"
                    @onclick="@(() => OnOfferOne.InvokeAsync())">
                @if (CanFlag(sg)) {
                    <Icon Name="shield-check" Class="icon-sm"/> <text>@(sg.Status is { ShaDiffers: true } ? "Replace" : sg.Status is { MetaDiffers: true } ? "Correct" : "Flag archive")</text>
                } else {
                    <Icon Name="upload" Class="icon-sm"/> <text>Offer</text>
                }
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public StagedEntry Sel { get; set; } = null!;

    [Parameter] public OfferGroup? SelGroup { get; set; }

    [Parameter] public bool OfferBusy { get; set; }

    [Parameter] public bool AdminOpen { get; set; }

    [Parameter] public bool IsReviewTab { get; set; }

    [Parameter] public Func<OfferGroup, bool> CanOffer { get; set; } = null!;

    [Parameter] public Func<OfferGroup, bool> CanFlag { get; set; } = null!;

    [Parameter] public EventCallback OnOfferOne { get; set; }

    [Parameter] public EventCallback OnRetryCheck { get; set; }

    [Parameter] public EventCallback OnToggleQueue { get; set; }

    static string Sha12(string? sha) {
        return Hashes.Short(sha, 7);
    }
}
