@using EggIncognito.Core
@using EggIncognito.Models.Registry
@using EggIncognito.Services.Protos
@inject ICurrentUser User

<div class="pwb-status">
    <span class="pwb-file">@Sel.FileName</span>
    @if (Sel.Status == "error") {
        <span class="pwb-note-inline pwb-err">@(Sel.Error ?? "failed")</span>
    } else if (!Sel.IsDone) {
        <span class="pwb-dim-note">@Sel.Status@(Sel.Step is { Length: > 0 } ? $": {Sel.Step}" : "")...</span>
    } else if (Sel.Result is { } r) {
        <span class="pwb-mono-note">@(r.Messages.Count) - @Sha12(r.ProtoSha)</span>
        @if (SelGroup is { Conflict: true }) {
            <span class="pwb-note-inline pwb-err">conflict</span>
            <span class="pwb-dim-note">Pick the file to offer in the rail.</span>
        } else if (SelGroup?.Status is { Rejected: true }) {
            <span class="pwb-note-inline pwb-warn">rejected before</span>
            <span class="pwb-dim-note">A reviewer rejected this proto. Resubmit with more version data to reopen it.</span>
        } else if (SelGroup?.Status is { Known: true, ShaDiffers: true }) {
            <span class="pwb-note-inline pwb-warn">in registry, proto differs</span>
            <span class="pwb-dim-note">This build is registered with another proto. The archive text replaces it.</span>
        } else if (SelGroup?.Status is { Known: true, MetaDiffers: true }) {
            <span class="pwb-note-inline pwb-warn">in registry, version data differs</span>
            <span class="pwb-dim-note">This build is registered with a different app or client version. The extracted values replace them.</span>
        } else if (SelGroup?.Status is { Archived: true }) {
            <span class="pwb-note-inline pwb-ok">archive flagged</span>
        } else if (SelGroup?.Status is { Known: true }) {
            <span class="pwb-note-inline pwb-ok">in registry</span>
        } else if (SelGroup?.Status is { Failed: true }) {
            <span class="pwb-note-inline pwb-err">check failed</span>
            <button type="button" class="btn-mini" aria-label="Retry check"
                    @onclick="@(() => OnRetryCheck.InvokeAsync())">
                <Icon Name="refresh-cw" Class="icon-sm"/> Retry
            </button>
        } else if (SelGroup?.Status is { Pending: true } or { Offered: true }) {
            @if (User.Current.IsAtLeast(UserRole.Contributor)) {
                <button type="button" class="pwb-pending-btn @(AdminOpen && IsReviewTab ? "active" : "")"
                        @onclick="OnToggleQueue">
                    pending review
                </button>
            } else {
                <span class="pwb-note-inline pwb-warn">pending review</span>
            }
        } else if (SelGroup?.Status is { Offerable: true }) {
            @if (SelGroup.Status.InRegistry) {
                <span class="pwb-note-inline">new build of a known sha</span>
            }
            @if (User.Current.IsAuthenticated) {
                <span class="pwb-note-inline">offerable</span>
            } else {
                <span class="pwb-dim-note">Log in to offer this version to the registry.</span>
            }
        }

        @if (SelGroup is { } sg && CanOffer(sg)) {
            <button type="button" class="btn-mini" disabled="@OfferBusy"
                    @onclick="@(() => OnOfferOne.InvokeAsync())">
                @if (CanFlag(sg)) {
                    <Icon Name="shield-check" Class="icon-sm"/> <text>@(sg.Status is { ShaDiffers: true } ? "Replace with archive" : sg.Status is { MetaDiffers: true } ? "Correct from archive" : "Flag archive")</text>
                } else {
                    <Icon Name="upload" Class="icon-sm"/> <text>Offer</text>
                }
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public StagedEntry Sel { get; set; } = null!;

    [Parameter] public OfferGroup? SelGroup { get; set; }

    [Parameter] public bool OfferBusy { get; set; }

    [Parameter] public bool AdminOpen { get; set; }

    [Parameter] public bool IsReviewTab { get; set; }

    [Parameter] public Func<OfferGroup, bool> CanOffer { get; set; } = null!;

    [Parameter] public Func<OfferGroup, bool> CanFlag { get; set; } = null!;

    [Parameter] public EventCallback OnOfferOne { get; set; }

    [Parameter] public EventCallback OnRetryCheck { get; set; }

    [Parameter] public EventCallback OnToggleQueue { get; set; }

    static string Sha12(string? sha) {
        return Hashes.Short(sha, 7);
    }
}
