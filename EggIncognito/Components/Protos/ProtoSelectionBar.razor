@using EggIncognito.Models.Registry
@inject ToastService Toasts

<div class="pwb-selbar">
    <div class="pwb-selbar-row">
        <span class="pwb-selbar-count">@Selected.Count selected</span>

        <button type="button" class="btn-mini" disabled="@_busy" @onclick="ArmDelete">Delete</button>

        @if (Selected.Count >= 2) {
            <button type="button" class="btn-mini" disabled="@_busy" @onclick="MergeSelected">Merge</button>
        }

        <button type="button" class="btn-mini" @onclick="@(() => OnClear.InvokeAsync())">Clear</button>
    </div>
    @if (_armed) {
        <StatusNote Kind="StatusNoteKind.Info" OnDismiss="Disarm">
            <ChildContent>
                Delete @Selected.Count @(Selected.Count == 1 ? "version" : "versions")?
                They stay restorable from Registry admin, Deleted.
            </ChildContent>
            <Actions>
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="DeleteSelected">Confirm delete</button>
            </Actions>
        </StatusNote>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SelectionKey> Selected { get; set; } = [];
    [Parameter] public Func<string, object, Task<bool>> Post { get; set; } = (_, _) => Task.FromResult(false);
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    bool _busy;
    bool _armed;
    int _armedCount;

    protected override void OnParametersSet() {
        if (_armed && Selected.Count != _armedCount) Disarm();
    }

    void ArmDelete() {
        if (Selected.Count == 0) return;
        _armed = true;
        _armedCount = Selected.Count;
    }

    void Disarm() {
        _armed = false;
        _armedCount = 0;
    }

    async Task DeleteSelected() {
        Disarm();
        _busy = true;
        var count = Selected.Count;
        var ok = await Post("/api/protos/versions/delete", new { versions = Selected });
        Say(ok, ok ? $"deleted {count}, restore from Registry admin" : "delete failed (admin only?)");
        _busy = false;
        if (ok) await OnChanged.InvokeAsync();
    }

    async Task MergeSelected() {
        Disarm();
        _busy = true;
        var ordered = Selected
            .OrderBy(k => k.Platform, StringComparer.OrdinalIgnoreCase)
            .ThenBy(k => k.Build, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var canonical = ordered[0];
        var aliases = ordered.Skip(1).ToList();
        var ok = await Post("/api/protos/versions/merge", new { canonical, aliases });
        Say(ok, ok ? $"merged {Selected.Count} builds into one release" : "merge failed (admin only?)");
        _busy = false;
        if (ok) await OnChanged.InvokeAsync();
    }

    void Say(bool ok, string text) {
        Toasts.Push(ok ? StatusNoteKind.Ok : StatusNoteKind.Error, text);
    }

}
