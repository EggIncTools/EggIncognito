    async Task Offer(OfferGroup g) {
        var proto = g.Winner?.Result?.Proto;
        var sha = g.Winner?.Result?.ProtoSha;
        if (proto is not { Length: > 0 } || sha is not { Length: > 0 }) return;
        _offerBusy = true;
        try {
            var body = new {
                platform = g.Platform,
                appVersion = string.IsNullOrWhiteSpace(g.AppVersion) ? null : g.AppVersion,
                build = string.IsNullOrWhiteSpace(g.Build) ? null : g.Build,
                clientVersion = string.IsNullOrWhiteSpace(g.ClientVersionText) ? null : g.ClientVersionText,
                package = (string?)null,
                protoSha = sha,
                protoText = proto,
                messageIndex = (string?)null
            };
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/offer", body, SelfCallJson.Web);
            if (!resp.IsSuccessStatusCode) return;
            var outcome = await resp.Content.ReadFromJsonAsync<OfferResp>(SelfCallJson.Web);
            await InvokeAsync(() => {
                if (g.StatusKey is { } sk) State.GroupStatuses[sk] = StatusOf(outcome?.Result);
            });
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "offering the extracted proto for {Platform} failed", g.Platform);
        }
        finally {
            _offerBusy = false;
        }
    }

    static GroupStatus StatusOf(string? offerResult) {
        return offerResult switch {
            "alreadyinregistry" => new GroupStatus(true, false, false, false, true),
            "alreadypending" => new GroupStatus(false, true, false),
            _ => new GroupStatus(false, true, true)
        };
    }

    List<ProtoRegistryRow> _regItems = [];
    IReadOnlyList<ProtoRegistryRow>? _regSource;
    string _regItemsKey = "";

    List<ProtoRegistryRow> RegistryItems() {
        var key = State.Query.Signature();
        if (ReferenceEquals(_regSource, State.Registry) && _regItemsKey == key) return _regItems;
        _regSource = State.Registry;
        _regItemsKey = key;
        _regItems = [
            .. ProtoVersionOrdering.SortByRelease(
                State.Registry.Where(r => RegistryFilter.Matches(r, State.Query)), r => r.Key())
        ];
        return _regItems;
    }

