    static string ModeOrDefault(string? mode, ProtoRef? b) {
        if (mode is { Length: > 0 }
            && ProtoRefParser.Modes.FirstOrDefault(m => m.Equals(mode, StringComparison.OrdinalIgnoreCase)) is { } known) {
            return known;
        }

        return b is null ? "text" : "split";
