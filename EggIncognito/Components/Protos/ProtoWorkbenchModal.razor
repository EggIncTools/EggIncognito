    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!_open || _dropWired) return;
        try {
            var mod = await StripModule();
            if (mod is null) return;
            var body = await mod.InvokeAsync<bool>("wireDrop", "wbDrop", "wbFile");
            var rail = await mod.InvokeAsync<bool>("wireDrop", "wbRailDrop", "wbFile");
            _dropWired = body && rail;
        } catch (JSDisconnectedException ex) {
            Logger.LogDebug(ex, "drop wiring skipped, the circuit is already gone");
        }
    }

    async Task<IJSObjectReference?> StripModule() {
        if (_strip is not null) return _strip;
        try {
            return _strip = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/protoStrip.js"));
        } catch (JSDisconnectedException ex) {
            Logger.LogDebug(ex, "proto strip module import skipped, the circuit is already gone");
            return null;
        }
    }

    async Task OnFilesSelected(InputFileChangeEventArgs e) {
        List<StashedFile> stashed;
        try {
            var mod = await StripModule();
            if (mod is null) return;
            stashed = await mod.InvokeAsync<List<StashedFile>>("stashFiles", "wbFile");
        } catch (JSDisconnectedException ex) {
            Logger.LogDebug(ex, "file stash skipped, the circuit is already gone");
            return;
        }

        if (!_open) _dropWired = false;
        _open = true;
        foreach (var s in stashed) {
            var entry = new StagedEntry { Token = s.Token, FileName = s.Name, Size = s.Size };
            entry.Platform = PlatformFor(s.Name);
            State.Entries.Add(entry);
            State.SelectedId ??= entry.Id;
            _ = ProcessAsync(entry);
        }
    }

    async Task ProcessAsync(StagedEntry entry) {
        try {
            await _gate.WaitAsync();
        } catch (ObjectDisposedException) {
            return;
        }

        try {
            await InvokeAsync(() => {
                entry.Status = "extracting";
                StateHasChanged();
            });
            _selfRef ??= DotNetObjectReference.Create(this);
            var mod = await StripModule();
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(15));
            var r = mod is null
                ? null
                : await mod.InvokeAsync<ExtractResult>("analyzeStored", cts.Token,
                    [entry.Token, "/api/tools/extract-proto", _selfRef]);
            if (r is null or { Ok: false }) {
                await InvokeAsync(() => {
                    entry.Status = "error";
                    entry.Error = r?.Diagnostics ?? "no response";
                    StateHasChanged();
                });
                return;
            }

            var dropped = false;
            await InvokeAsync(() => {
                entry.Result = r with { FileName = entry.FileName };
                entry.Status = "done";
                entry.Step = null;
                if (entry.Result?.FileSha is { Length: > 0 } sha
                    && State.Entries.FirstOrDefault(x => x != entry && x.Result?.FileSha == sha) is { } dup) {
                    State.Entries.Remove(entry);
                    if (State.SelectedId == entry.Id) State.SelectedId = dup.Id;
                    dropped = true;
                }

                StateHasChanged();
            });
            if (dropped) {
                await DiscardToken(entry.Token);
                return;
            }

            await AfterDone(entry);
        } catch (Exception ex) {
            await InvokeAsync(() => {
                entry.Status = "error";
                entry.Error = ex.Message;
                StateHasChanged();
            });
        } finally {
            try {
                _gate.Release();
            } catch (ObjectDisposedException ex) {
                Logger.LogDebug(ex, "analysis gate was disposed before the slot was released");
            }

            await DiscardToken(entry.Token);
            await Rerender();
        }
    }

    async Task AfterDone(StagedEntry entry) {
        await InvokeAsync(() => {
            entry.Platform = PlatformFor(entry.FileName);
            entry.AppVersion = entry.Result?.AppVersion ?? "";
            entry.Build = entry.Result?.Build ?? "";
            entry.ClientVersionText = entry.Result?.ClientVersion?.ToString(CultureInfo.InvariantCulture) ?? "";
        });
        await InvokeAsync(async () => {
            if (State.SelectedId != entry.Id || SessionRef(entry) is not { } sref) return;
            State.TextCache.Remove(CacheKey(sref));
            State.TextCache.Remove(RawCacheKey(sref));
            if (SameRef(State.A, sref)) await AfterSelection();
            else await SetA(sref);
        });
        await CheckGroups();
    }

    async Task DiscardToken(int token) {
        try {
            var mod = await StripModule();
            if (mod is null) return;
            await mod.InvokeVoidAsync("discard", token);
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "stashed upload {Token} could not be discarded", token);
        }
    }

    [JSInvokable]
    public async Task AnalyzeStep(int token, string step) {
        var entry = State.Entries.FirstOrDefault(e => e.Token == token);
        if (entry is null) return;
        await InvokeAsync(() => {
            entry.Step = step;
            if (step.StartsWith("uploading", StringComparison.Ordinal)) entry.Status = "uploading";
            StateHasChanged();
        });
    }

    Task Rerender() {
        return InvokeAsync(StateHasChanged);
    }

    async Task Select(StagedEntry e, MouseEventArgs args) {
        State.SelectedId = e.Id;
        if (SessionRef(e) is not { } sref) return;
        await (args.ShiftKey ? SetB(sref) : SetA(sref));
    }

    async Task Remove(StagedEntry e) {
        var sref = SessionRef(e);
        State.Entries.Remove(e);
        foreach (var k in State.GroupWinners.Where(kv => kv.Value == e.Id).Select(kv => kv.Key).ToList()) State.GroupWinners.Remove(k);

        if (State.SelectedId == e.Id) State.SelectedId = State.Entries.FirstOrDefault()?.Id;
        if (sref is not null) {
            State.TextCache.Remove(CacheKey(sref));
            _legacy.Remove(CacheKey(sref));
            if (SameRef(State.B, sref)) await SetB(null);
            if (SameRef(State.A, sref)) await SetA(FirstSessionRef());
        }

        await DiscardToken(e.Token);
        await CheckGroups();
    }

    static string KeyOf(StagedEntry e) {
        return $"{e.Platform}|{e.AppVersion}|{e.Build}|{e.ClientVersionText}";
    }

    List<OfferGroup> Groups() {
        var groups = new List<OfferGroup>();
        foreach (var e in State.Entries.Where(x => x.IsAnalyzed)) {
            var key = KeyOf(e);
            var g = groups.FirstOrDefault(x => x.Key == key);
            if (g is null) {
                g = new OfferGroup {
                    Key = key, Platform = e.Platform, AppVersion = e.AppVersion,
                    Build = e.Build, ClientVersionText = e.ClientVersionText
                };
                groups.Add(g);
            }

            g.Members.Add(e);
        }

        foreach (var g in groups) {
            var shas = g.Members.Select(m => m.Result?.ProtoSha ?? "").Where(s => s.Length > 0).Distinct().ToList();
            g.MultiSha = shas.Count > 1;
            g.Winner = g.MultiSha
                ? State.GroupWinners.TryGetValue(g.Key, out var wid) ? g.Members.FirstOrDefault(m => m.Id == wid) : null
                : g.Members.FirstOrDefault(m => m.Result?.ProtoSha is { Length: > 0 });
            g.Status = g.StatusKey is { } sk && State.GroupStatuses.TryGetValue(sk, out var st) ? st : null;
        }

        return groups;
    }

    bool CanOffer(OfferGroup g) {
        if (!User.IsAuthenticated || g.Conflict || g.Winner is null) return false;
        return g.Status is { Offerable: true } || CanFlag(g);
    }

    bool CanFlag(OfferGroup g) {
        return User.IsAtLeast(UserRole.Admin) && g.Status is { Flaggable: true };
    }

    static string GroupStatusText(OfferGroup g) {
        if (g.Conflict) return "conflict";
        return g.Status switch {
            { Failed: true } => "check failed",
            { Rejected: true } => "rejected before",
            { Known: true, ShaDiffers: true } => "in registry, proto differs",
            { Archived: true } => "archive flagged",
            { Known: true } => "in registry",
            { Pending: true } or { Offered: true } => "pending",
            { InRegistry: true } => "offerable (known sha)",
            { Offerable: true } => "offerable",
            _ => "checking"
        };
    }

    static string GroupStatusTone(OfferGroup g) {
        if (g.Conflict) return "pwb-err";
        return g.Status switch {
            { Failed: true } => "pwb-err",
            { Rejected: true } => "pwb-warn",
            { Known: true, ShaDiffers: true } => "pwb-warn",
            { Archived: true } => "pwb-ok",
            { Known: true } => "pwb-ok",
            { Pending: true } or { Offered: true } => "pwb-warn",
            _ => ""
        };
    }

    static WorkbenchTone CardTone(StagedEntry e) {
        return e.Status == "error" ? WorkbenchTone.Bad : WorkbenchTone.Normal;
    }

    static WorkbenchStatusKind CardStatus(StagedEntry e) {
        return e.Status switch {
            "queued" => WorkbenchStatusKind.Queued,
            "done" => WorkbenchStatusKind.Done,
            "error" => WorkbenchStatusKind.Error,
            _ => WorkbenchStatusKind.Running
        };
    }

    async Task PickWinner(OfferGroup g, StagedEntry e) {
        State.GroupWinners[g.Key] = e.Id;
        Invalidate(g.Key);
        await CheckGroups();
    }

    void Invalidate(string key) {
        foreach (var k in State.GroupStatuses.Keys.Where(k => k.StartsWith(key + "|", StringComparison.Ordinal)).ToList()) State.GroupStatuses.Remove(k);
    }

    async Task CheckGroups() {
        List<(OfferGroup Group, string Key)> todo = [];
        await InvokeAsync(() => {
            foreach (var g in Groups()) {
                if (g.StatusKey is { } sk && !State.GroupStatuses.ContainsKey(sk) && _checking.Add(sk)) todo.Add((g, sk));
            }
        });
        if (todo.Count == 0) {
            await Rerender();
            return;
        }

        try {
            var items = todo.Select(t => new {
                protoSha = t.Group.Sha ?? "", platform = t.Group.Platform, appVersion = t.Group.AppVersion,
                build = t.Group.Build, clientVersion = t.Group.ClientVersionText
            }).ToList();
            List<CheckResp>? rows = null;
            try {
                var resp = await Client().PostAsJsonAsync("/api/protos/staged/check-batch", new { items }, SelfCallJson.Web);
                if (resp.IsSuccessStatusCode) rows = await resp.Content.ReadFromJsonAsync<List<CheckResp>>(SelfCallJson.Web);
            } catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
                Logger.LogDebug(ex, "batch registry check failed");
            }

            await InvokeAsync(() => {
                for (var i = 0; i < todo.Count; i++) {
                    var r = rows is { } list && i < list.Count ? list[i] : null;
                    State.GroupStatuses[todo[i].Key] = r is not null
                        ? new GroupStatus(r.KnownCombination, r.Pending, false, false, r.InRegistry, r.Archived, r.ShaDiffers)
                        : new GroupStatus(false, false, false, true);
                }
            });
        } finally {
            await InvokeAsync(() => {
                foreach (var t in todo) _checking.Remove(t.Key);
            });
        }

        await Rerender();
    }

    async Task RetryCheck(OfferGroup g) {
        if (g.StatusKey is { } sk) State.GroupStatuses.Remove(sk);
        await CheckGroups();
    }

    Task OfferAll(List<OfferGroup> groups) {
        return OfferBatch([.. groups.Where(CanOffer)]);
    }

    Task Offer(OfferGroup g) {
        return OfferBatch([g]);
    }

    async Task OfferBatch(List<OfferGroup> groups) {
        var ready = groups.Where(g => g.Winner?.Result is { Proto.Length: > 0 } or { FileSha.Length: > 0 }).ToList();
        if (ready.Count == 0) return;
        _offerBusy = true;
        try {
            var items = ready.Select(g => new {
                platform = g.Platform,
                appVersion = string.IsNullOrWhiteSpace(g.AppVersion) ? null : g.AppVersion,
                build = string.IsNullOrWhiteSpace(g.Build) ? null : g.Build,
                clientVersion = string.IsNullOrWhiteSpace(g.ClientVersionText) ? null : g.ClientVersionText,
                package = (string?)null,
                fileSha = g.Winner?.Result?.FileSha,
                protoText = g.Winner?.Result?.Proto
            }).ToList();
            var resp = await Client().PostAsJsonAsync("/api/protos/staged/offer-batch", new { items }, SelfCallJson.Web);
            if (!resp.IsSuccessStatusCode) {
                Toasts.Push(StatusNoteKind.Error, $"offer failed ({(int)resp.StatusCode})");
                return;
            }

            var outcome = await resp.Content.ReadFromJsonAsync<OfferBatchResp>(SelfCallJson.Web);
            var results = outcome?.Results ?? [];
            await InvokeAsync(() => {
                foreach (var r in results) {
                    if (r.Index < 0 || r.Index >= ready.Count || ready[r.Index].StatusKey is not { } sk) continue;
                    State.GroupStatuses[sk] = StatusOf(r.Result, ready[r.Index].Status);
                }
            });
            if (results.FirstOrDefault(r => r.Error is { Length: > 0 }) is { } bad)
                Toasts.Push(StatusNoteKind.Error, $"offer rejected: {bad.Error}");
            if (results.Any(r => r.Result is "staged")) await RefreshQueue();
            await OnChanged.InvokeAsync();
        } catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException) {
            Logger.LogWarning(ex, "offering {Count} extracted protos failed", ready.Count);
        } finally {
            _offerBusy = false;
        }
    }

    static GroupStatus StatusOf(string? offerResult, GroupStatus? prior) {
        return offerResult switch {
            "archiveflagged" or "alreadyarchived" or "published" => new GroupStatus(true, false, false, false, true, Archived: true),
            "alreadyinregistry" => new GroupStatus(true, false, false, false, true),
            "alreadypending" => new GroupStatus(false, true, false, false, prior?.InRegistry ?? false),
            "rejected" => new GroupStatus(false, false, false, false, prior?.InRegistry ?? false, Rejected: true),
            "staged" => new GroupStatus(false, true, true),
            _ => new GroupStatus(false, false, false, true)
        };
    }

    static ProtoRef RegistryRef(ProtoRegistryRow row) {
        return new ProtoRef(ProtoRefSource.Registry, row.Platform, row.Build, null);
    }

    static ProtoRef? SessionRef(StagedEntry e) {
        var sha = Sha12(e.Result?.FileSha);
        return sha.Length > 0 ? new ProtoRef(ProtoRefSource.Session, ProtoRefParser.SessionPlatform, sha, sha) : null;
    }

    static bool SameRef(ProtoRef? x, ProtoRef? y) {
        if (x is null || y is null) return x is null && y is null;
        return x.Source == y.Source
               && string.Equals(x.Platform, y.Platform, StringComparison.OrdinalIgnoreCase)
               && string.Equals(x.Build, y.Build, StringComparison.OrdinalIgnoreCase);
    }

    static string CacheKey(ProtoRef value) {
        return value.Source == ProtoRefSource.Session
            ? $"session:{value.Build}"
            : $"registry:{value.Platform}:{value.Build}";
    }

    static string RawCacheKey(ProtoRef value) {
        return CacheKey(value) + "#raw";
    }

    string FormOf(ProtoRef value) {
        return State.TextForms.GetValueOrDefault(CacheKey(value), ProtoDisplayForm.Canonical);
    }

    void SyncFormNotice() {
        if (State.A is not { } a) return;
        var formA = FormOf(a);
        if (State.Mode == "text" || State.B is not { } b) {
            if (formA == ProtoDisplayForm.Raw) Toasts.Push(StatusNoteKind.Info, "Normalization failed, raw proto text is shown.");
            return;
        }

        var formB = FormOf(b);
        if (formA != ProtoDisplayForm.Raw && formB != ProtoDisplayForm.Raw) return;
        var mixed = formA == ProtoDisplayForm.Canonical && RawFailed(a) || formB == ProtoDisplayForm.Canonical && RawFailed(b);
        if (mixed) Toasts.Push(StatusNoteKind.Error, "Raw text could not be fetched for one side, so the diff mixes canonical and raw forms.");
        else Toasts.Push(StatusNoteKind.Info, "Normalization failed, raw proto text is shown.");
    }

    bool RawFailed(ProtoRef value) {
        return State.TextCache.TryGetValue(RawCacheKey(value), out var cached) && cached == MissingText;
    }

    string RefMark(ProtoRef? value) {
        if (value is null) return "";
        if (SameRef(State.A, value)) return "A";
        return SameRef(State.B, value) ? "B" : "";
    }

    string RowClass(ProtoRegistryRow row) {
        var value = RegistryRef(row);
        var css = "";
        if (SameRef(State.A, value)) css += " pwb-sel-a";
        if (SameRef(State.B, value)) css += " pwb-sel-b";
        if (!HasText(row)) css += " pwb-dim";
        return css.TrimStart();
    }

    bool HasText(ProtoRegistryRow row) {
        if (string.IsNullOrEmpty(row.ProtoSha)) return false;
        return HasTextFor(RegistryRef(row));
    }

    bool HasTextFor(ProtoRef value) {
        return !State.TextCache.TryGetValue(CacheKey(value), out var cached) || cached != MissingText;
    }

    StagedEntry? FindSession(ProtoRef value) {
        return State.Entries.FirstOrDefault(x =>
            x.Result?.FileSha is { Length: > 0 } sha
            && sha.StartsWith(value.Build, StringComparison.OrdinalIgnoreCase));
    }

    string RefLabel(ProtoRef? value) {
        if (value is null) return "none";
        if (value.Source == ProtoRefSource.Session) {
            return FindSession(value) is { } entry
                ? PlainVersion(entry.Platform, entry.AppVersion, entry.Build, entry.ClientVersionText)
                : $"file {value.Build}";
        }

        var row = RegistryRow(value);
        return row is null
            ? $"{value.Platform} {value.Build}"
            : PlainVersion(row.Platform, row.AppVersion, row.Build, row.ClientVersion);
    }

    static string PlainVersion(string platform, string? app, string? build, string? client) {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(app)) parts.Add(app);
        if (!string.IsNullOrWhiteSpace(build)) parts.Add(build);
        if (!string.IsNullOrWhiteSpace(client)) parts.Add(client);
        return parts.Count > 0 ? $"{platform} {string.Join(" ", parts)}" : platform;
    }

    string SlotClass(ProtoRef? value) {
        return value is not null && !HasTextFor(value) ? "pwb-slot pwb-dim" : "pwb-slot";
    }

    IReadOnlyList<VersionComboItem> ComboItems(ProtoRef? exclude) {
        var items = new List<VersionComboItem>();
        foreach (var e in State.Entries.Where(x => x.IsAnalyzed)) {
            if (SessionRef(e) is not { } sref) continue;
            if (exclude is not null && SameRef(exclude, sref)) continue;
            items.Add(new VersionComboItem(sref.Format(), e.Platform, e.AppVersion, e.Build,
                e.ClientVersionText, Sha12(e.Result?.ProtoSha), false, "session upload"));
        }

        foreach (var row in OrderedRegistry()) {
            var value = RegistryRef(row);
            if (exclude is not null && SameRef(exclude, value)) continue;
            var hasText = HasText(row);
            items.Add(new VersionComboItem(value.Format(), row.Platform, row.AppVersion, row.Build,
                row.ClientVersion, Sha12(row.ProtoSha), !hasText, hasText ? null : "no stored proto text"));
        }

        return items;
    }

    Task OnPickA(string? value) {
        return SetA(value is { Length: > 0 } ? ProtoRefParser.Parse(value).A : null);
    }

    Task OnPickB(string? value) {
        return SetB(value is { Length: > 0 } ? ProtoRefParser.Parse(value).A : null);
    }

    Task RegistryRowClick(ProtoRegistryRow row, MouseEventArgs args) {
        var value = RegistryRef(row);
        return args.ShiftKey ? SetB(value) : SetA(value);
    }

    readonly List<SelectionKey> _selected = [];

    bool IsSelected(ProtoRegistryRow row) {
        return _selected.Any(k => k.Platform == row.Platform && k.Build == row.Build);
    }

    void ToggleRow(ProtoRegistryRow row) {
        var existing = _selected.FirstOrDefault(k => k.Platform == row.Platform && k.Build == row.Build);
        if (existing is not null) _selected.Remove(existing);
        else _selected.Add(new SelectionKey(row.Platform, row.Build));
        if (_selected.Count > 0) _adminOpen = true;
    }

    void ToggleAll(IReadOnlyList<ProtoRegistryRow> rows, bool on) {
        _selected.Clear();
        if (on) _selected.AddRange(rows.Select(r => new SelectionKey(r.Platform, r.Build)));
        if (_selected.Count > 0) _adminOpen = true;
    }

    void ClearSelection() {
        _selected.Clear();
    }

    async Task OnSelectionMutated() {
        ClearSelection();
        await OnAdminChanged();
    }

    async Task<bool> PostJson(string url, object body) {
        try {
            return (await Client().PostAsJsonAsync(url, body, SelfCallJson.Web)).IsSuccessStatusCode;
        } catch (HttpRequestException) {
            return false;
        }
    }

    async Task SetA(ProtoRef? value) {
        if (SameRef(State.A, value)) return;
        State.A = value;
        await AfterSelection();
    }

    async Task SetB(ProtoRef? value) {
        if (SameRef(State.B, value)) return;
        State.B = value;
        if (value is null) State.Mode = "text";
        await AfterSelection();
    }

    Task ClearB() {
        return SetB(null);
    }

    async Task SwapRefs() {
        (State.A, State.B) = (State.B, State.A);
        await AfterSelection();
    }

    async Task AfterSelection() {
        State.Cached = null;
        State.CachedKey = null;
        _hunk = 0;
        await ResolvePair();
        await RaiseRefChanged();
    }

    Task RaiseRefChanged() {
        return OnRefChanged.HasDelegate
            ? OnRefChanged.InvokeAsync(new WorkbenchRef(State.A, State.B, State.Mode))
            : Task.CompletedTask;
    }

    async Task ResolvePair() {
        await ResolveText(State.A);
        await ResolveText(State.B);
        await FallbackMissing();
        await EnsureBundle();
        SyncFormNotice();
        await Rerender();
        _ = CheckCanonical(State.A);
        _ = CheckCanonical(State.B);
    }

    async Task FallbackMissing() {
        if (State.B is { } b && IsUnknown(b)) {
            Toasts.Push(StatusNoteKind.Info, $"{RefLabel(b)} is not available.");
            State.B = null;
            State.Mode = "text";
        }

        if (State.A is not { } a || !IsUnknown(a)) return;
        Toasts.Push(StatusNoteKind.Info, $"{RefLabel(a)} is not available.");
        State.A = FallbackFor(a);
        if (State.A is not null) await ResolveText(State.A);
    }

    bool IsUnknown(ProtoRef value) {
        return value.Source == ProtoRefSource.Session
            ? FindSession(value) is null
            : State.Registry.Count > 0 && RegistryRow(value) is null;
    }

    ProtoRef? FallbackFor(ProtoRef value) {
        if (value.Source == ProtoRefSource.Session) return FirstSessionRef();
        var row = ProtoVersionOrdering.LatestFor(value.Platform, State.Registry, r => r.Key());
        return row is null ? null : RegistryRef(row);
    }

    ProtoRef? FirstSessionRef() {
        foreach (var e in State.Entries) {
            if (SessionRef(e) is { } value) return value;
        }

        return null;
    }

    async Task<string?> ResolveText(ProtoRef? value) {
        if (value is null) return null;
        var key = CacheKey(value);
        if (State.TextCache.TryGetValue(key, out var cached)) return cached == MissingText ? null : cached;
        if (value.Source == ProtoRefSource.Session) {
            var staged = FindSession(value)?.Result?.Proto;
            if (staged is not { Length: > 0 }) {
                await InvokeAsync(() => State.TextCache[key] = MissingText);
                return null;
            }

            var normalized = await Task.Run(() => ProtoCanonicalForm.Normalize(staged));
            var text = normalized is { Ok: true, Text: { Length: > 0 } canonText } ? canonText : staged;
            await InvokeAsync(() => {
                State.TextCache[key] = text;
                State.TextForms[key] = normalized is { Ok: true } ? ProtoDisplayForm.Canonical : ProtoDisplayForm.Raw;
                if (normalized is { Ok: true, Sha: { Length: > 0 } sha }) State.CanonicalShas[key] = sha;
            });
            return text;
        }

        try {
            var resp = await Client().GetAsync(
                $"/api/protos/versions/{Uri.EscapeDataString(value.Platform)}/{Uri.EscapeDataString(value.Build)}/proto");
            if (!resp.IsSuccessStatusCode) {
                await InvokeAsync(() => State.TextCache[key] = MissingText);
                return null;
            }

            var body = await resp.Content.ReadAsStringAsync();
            await InvokeAsync(() => {
                State.TextCache[key] = body;
                if (resp.Headers.TryGetValues("X-Proto-Form", out var forms) && forms.FirstOrDefault() is { Length: > 0 } form) {
                    State.TextForms[key] = form;
                }

                if (resp.Headers.TryGetValues("X-Proto-Canonical-Sha", out var shas) && shas.FirstOrDefault() is { Length: > 0 } sha) {
                    State.CanonicalShas[key] = sha;
                }
            });
            return body;
        } catch (Exception ex) {
            Logger.LogWarning(ex, "proto text for {Platform} {Build} could not be loaded", value.Platform, value.Build);
            await InvokeAsync(() => State.TextCache[key] = MissingText);
            return null;
        }
    }

    async Task<string?> ResolveRawText(ProtoRef value) {
        var key = RawCacheKey(value);
        if (State.TextCache.TryGetValue(key, out var cached)) return cached == MissingText ? null : cached;
        if (value.Source == ProtoRefSource.Session) {
            var staged = FindSession(value)?.Result?.Proto;
            await InvokeAsync(() => State.TextCache[key] = staged ?? MissingText);
            return staged;
        }

        try {
            var resp = await Client().GetAsync(
                $"/api/protos/versions/{Uri.EscapeDataString(value.Platform)}/{Uri.EscapeDataString(value.Build)}/proto?form=raw");
            if (!resp.IsSuccessStatusCode) {
                await InvokeAsync(() => State.TextCache[key] = MissingText);
                return null;
            }

            var body = await resp.Content.ReadAsStringAsync();
            await InvokeAsync(() => State.TextCache[key] = body);
            return body;
        } catch (Exception ex) {
            Logger.LogWarning(ex, "raw proto text for {Platform} {Build} could not be loaded", value.Platform, value.Build);
            await InvokeAsync(() => State.TextCache[key] = MissingText);
            return null;
        }
    }

    async Task SetMode(string mode) {
        if (ModeDisabled(mode) || State.Mode == mode) return;
        State.Mode = mode;
        _hunk = 0;
        await EnsureBundle();
        SyncFormNotice();
        await RaiseRefChanged();
    }

    bool ModeDisabled(string mode) {
        if (State.A is not { } a) return true;
        if (mode == "text") return false;
        if (State.B is not { } b) return true;
        return mode != "meta" && (!HasTextFor(a) || !HasTextFor(b));
    }

    string FilterKey() {
        if (State.A is not { } a) return "";
        if (State.Mode == "text") return CacheKey(a);
        return State.B is { } b ? $"{CacheKey(a)}|{CacheKey(b)}|{State.Mode}" : "";
    }

    string ViewFilter {
        get {
            var key = FilterKey();
            return key.Length > 0 && State.ViewFilters.TryGetValue(key, out var value) ? value : "";
        }
    }

    void OnLineFilterChanged(string value) {
        var key = FilterKey();
        if (key.Length == 0) return;
        if (value.Length == 0) {
            State.ViewFilters.Remove(key);
        } else {
            State.ViewFilters[key] = value;
        }
    }

    bool IsDiffMode() {
        return State.Mode is "split" or "unified" or "struct";
    }

    async Task EnsureBundle() {
        if (State.A is not { } a || State.B is not { } b) {
            State.Cached = null;
            State.CachedKey = null;
            AdoptBundle();
            return;
        }

        var pairForm = FormOf(a) == ProtoDisplayForm.Canonical && FormOf(b) == ProtoDisplayForm.Canonical
            ? ProtoDisplayForm.Canonical
            : ProtoDisplayForm.Raw;
        var key = $"{CacheKey(a)}|{CacheKey(b)}|{_context}|{pairForm}";
        if (State.CachedKey == key) {
            AdoptBundle();
            return;
        }

        if (Identical()) {
            State.Cached = null;
            State.CachedKey = key;
            AdoptBundle();
            return;
        }

        if (TextOf(a) is not { Length: > 0 } cachedA || TextOf(b) is not { Length: > 0 } cachedB) {
            State.Cached = null;
            State.CachedKey = null;
            AdoptBundle();
            return;
        }

        var textA = cachedA;
        var textB = cachedB;
        if (pairForm == ProtoDisplayForm.Raw) {
            var formA = FormOf(a);
            var formB = FormOf(b);
            var canonA = formA == ProtoDisplayForm.Canonical ? cachedA : null;
            var canonB = formB == ProtoDisplayForm.Canonical ? cachedB : null;
            var rawA = formA == ProtoDisplayForm.Canonical ? await ResolveRawText(a) ?? cachedA : cachedA;
            var rawB = formB == ProtoDisplayForm.Canonical ? await ResolveRawText(b) ?? cachedB : cachedB;
            (textA, textB, _) = ProtoDisplayForm.Pair(canonA, rawA, canonB, rawB);
        }

        var context = _context;
        var labelA = LabelOf(a);
        var labelB = LabelOf(b);
        var bundle = await Task.Run(() => BuildBundle(textA, textB, context, labelA, labelB));
        await InvokeAsync(() => {
            State.Cached = bundle;
            State.CachedKey = key;
            _hunk = 0;
            AdoptBundle();
            StateHasChanged();
        });
    }

    static DiffBundle BuildBundle(string textA, string textB, int context, string labelA, string labelB) {
        var aLines = UnifiedDiffWriter.SplitLines(textA);
        var bLines = UnifiedDiffWriter.SplitLines(textB);
        var ops = MyersDiff.Compute(aLines, bLines);
        var structural = ProtoDiff.Compute(textA, textB);
        return new DiffBundle(
            ops,
            SideBySideDiffBuilder.Build(aLines, bLines, ops),
            UnifiedDiffWriter.Write(aLines, bLines, ops, new UnifiedDiffOptions(context, LabelA: labelA, LabelB: labelB)),
            structural,
            ProtoDiffSummary.From(structural, ops));
    }

    void AdoptBundle() {
        _unifiedHunks = [];
        _degraded = false;
        if (State.Cached is not { } bundle) return;
        var lines = bundle.Unified.Split('\n');
        for (var i = 0; i < lines.Length; i++) {
            if (lines[i].StartsWith("@@", StringComparison.Ordinal)) _unifiedHunks.Add(i);
        }

        var changed = bundle.LineOps.Where(o => o.Kind != DiffOpKind.Equal).ToList();
        _degraded = changed.Count is > 0 and <= 2
                    && changed.Sum(o => o.ALength + o.BLength) > MyersDiff.GuardBudget;
        if (_hunk >= HunkCount()) _hunk = 0;
    }

    bool Identical() {
        if (State.A is not { } a || State.B is not { } b) return false;
        var shaA = ShaOf(a);
        var shaB = ShaOf(b);
        if (shaA is { Length: > 0 } && shaB is { Length: > 0 }) return SameSha(shaA, shaB);
        var textA = TextOf(a);
        var textB = TextOf(b);
        return textA is not null && textB is not null && string.Equals(textA, textB, StringComparison.Ordinal);
    }

    async Task ToggleContext() {
        _context = _context == FullContext ? DefaultContext : FullContext;
        State.CachedKey = null;
        await EnsureBundle();
        SyncFormNotice();
    }

    void OnHunkPicked(int index) {
        _hunk = index;
    }

    int HunkCount() {
        if (State.Mode == "unified") return _unifiedHunks.Count;
        return State.Mode == "split" ? State.Cached?.Split.HunkStarts.Count ?? 0 : 0;
    }

    int HunkRow(int index) {
        if (index < 0) return -1;
        if (State.Mode == "unified") return index < _unifiedHunks.Count ? _unifiedHunks[index] : -1;
        if (State.Cached?.Split.HunkStarts is not { } starts) return -1;
        return index < starts.Count ? starts[index] : -1;
    }

    async Task StepHunk(int delta) {
        var count = HunkCount();
        if (count == 0) return;
        _hunk = ((_hunk + delta) % count + count) % count;
        await ScrollToHunk();
    }

    async Task ScrollToHunk() {
        if (ViewFilter.Length > 0) return;
        var row = HunkRow(_hunk);
        if (row < 0) return;
        IJSObjectReference? element = null;
        try {
            element = await JS.InvokeAsync<IJSObjectReference>("document.querySelector", "#pwbView .code-scroll");
            if (element is not null) {
                await element.InvokeVoidAsync("scrollTo", new { top = row * CodeMetrics.RowHeightPx, left = 0 });
            }
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "hunk scroll failed");
        } finally {
            await element.DisposeModuleQuietAsync(logger: Logger);
        }
    }

    IReadOnlyList<ProtoRegistryRow> OrderedRegistry() {
        if (ReferenceEquals(_optionSource, State.Registry)) return _options;
        _optionSource = State.Registry;
        _options = ProtoVersionOrdering.SortByRelease(State.Registry, r => r.Key());
        return _options;
    }

    IReadOnlyList<ProtoRegistryRow> _options = [];
    IReadOnlyList<ProtoRegistryRow>? _optionSource;

    ProtoRegistryRow? RegistryRow(ProtoRef value) {
        return State.Registry.FirstOrDefault(r =>
            string.Equals(r.Platform, value.Platform, StringComparison.OrdinalIgnoreCase)
            && string.Equals(r.Build, value.Build, StringComparison.OrdinalIgnoreCase));
    }

    ProtoRef? StepRef(int direction) {
        if (State.A is not { Source: ProtoRefSource.Registry } a || RegistryRow(a) is not { } row) return null;
        var target = direction > 0
            ? ProtoVersionOrdering.Previous(row, State.Registry, r => r.Key())
            : ProtoVersionOrdering.Next(row, State.Registry, r => r.Key());
        return target is null ? null : RegistryRef(target);
    }

    ProtoRef? LatestRef() {
        var platform = State.A is { Source: ProtoRefSource.Session } session
            ? FindSession(session)?.Platform ?? ""
            : State.A?.Platform ?? "";
        var row = platform.Length > 0
            ? ProtoVersionOrdering.LatestFor(platform, State.Registry, r => r.Key())
            : null;
        row ??= ProtoVersionOrdering.Latest(State.Registry, r => r.Key());
        if (row is null) return null;
        var value = RegistryRef(row);
        return SameRef(State.A, value) || SameRef(State.B, value) ? null : value;
    }

    string SourcePlatform() {
        return State.A is { Source: ProtoRefSource.Session } session
            ? FindSession(session)?.Platform ?? ""
            : State.A?.Platform ?? "";
    }

    IReadOnlyList<string> CounterpartTargets() {
        return ProtoCounterparts.Targets(SourcePlatform());
    }

    IReadOnlyList<ProtoCounterpart> CounterpartLinks() {
        var source = State.A is { Source: ProtoRefSource.Registry } a ? RegistryRow(a) : null;
        return ProtoCounterparts.For(source, State.Registry);
    }

    static ProtoCounterpart? TierOf(IReadOnlyList<ProtoCounterpart> links, ProtoRef? value) {
        return value is null ? null : links.FirstOrDefault(l => l.Row is { } row && SameRef(value, RegistryRef(row)));
    }

    async Task SetCounterpart(ProtoCounterpart? link) {
        if (link is null) return;
        if (link.Row is not { } row) {
            Toasts.Push(StatusNoteKind.Info, $"No {link.Platform} counterpart for {RefLabel(State.A)}. "
                                             + $"Nothing stored for {link.Platform} shares its release, proto sha, app version or client version.");
            return;
        }

        await SetB(RegistryRef(row));
    }

    string? TextOf(ProtoRef? value) {
        if (value is null) return null;
        return State.TextCache.TryGetValue(CacheKey(value), out var cached) && cached != MissingText ? cached : null;
    }

    string? ShaOf(ProtoRef? value) {
        if (value is null) return null;
        return value.Source == ProtoRefSource.Session
            ? FindSession(value)?.Result?.ProtoSha
            : RegistryRow(value)?.ProtoSha;
    }

    string LabelOf(ProtoRef value) {
        var sha = Sha12(ShaOf(value));
        return sha.Length > 0 ? $"{value.Platform} {value.Build} {sha}" : $"{value.Platform} {value.Build}";
    }

    bool ShowStatus(StagedEntry e) {
        return !e.IsAnalyzed || SameRef(State.A, SessionRef(e));
    }

    bool IsLegacySha(ProtoRef value) {
        return _legacy.TryGetValue(CacheKey(value), out var legacy) && legacy;
    }

    Task CheckCanonical(ProtoRef? value) {
        if (value is null) return Task.CompletedTask;
        var key = CacheKey(value);
        if (_legacy.ContainsKey(key)) return Task.CompletedTask;
        if (ShaOf(value) is not { Length: > 0 } stored) return Task.CompletedTask;
        if (!State.CanonicalShas.TryGetValue(key, out var canonical) || canonical is not { Length: > 0 }) return Task.CompletedTask;

        _legacy[key] = !SameSha(canonical, stored);
        StateHasChanged();
        return Task.CompletedTask;
    }

    static IReadOnlyList<string> SummaryParts(ProtoDiffSummary s) {
        var parts = new List<string>();
        if (s.MessagesAdded > 0) parts.Add($"{s.MessagesAdded} msg added");
        if (s.MessagesRemoved > 0) parts.Add($"{s.MessagesRemoved} msg removed");
        if (s.MessagesRenamed > 0) parts.Add($"{s.MessagesRenamed} msg renamed");
        if (s.MessagesModified > 0) parts.Add($"{s.MessagesModified} msg modified");
        if (s.FieldsAdded > 0) parts.Add($"{s.FieldsAdded} field added");
        if (s.FieldsRemoved > 0) parts.Add($"{s.FieldsRemoved} field removed");
        if (s.FieldsChanged > 0) parts.Add($"{s.FieldsChanged} field changed");
        if (s.EnumValuesChanged > 0) parts.Add($"{s.EnumValuesChanged} enum value changed");
        return parts;
    }

    RefMeta MetaOf(ProtoRef? value) {
        if (value is null) return new RefMeta("", null, null, null, null, null, null, null);
        if (value.Source == ProtoRefSource.Session) {
            var entry = FindSession(value);
            return new RefMeta(entry?.Platform ?? value.Platform, entry?.AppVersion, entry?.Build,
                entry?.ClientVersionText, "session upload", null, null, entry?.Result?.ProtoSha);
        }

        var row = RegistryRow(value);
        return new RefMeta(value.Platform, row?.AppVersion, row?.Build ?? value.Build, row?.ClientVersion,
            row?.Source, row?.Package,
            row?.DetectedAt is { } seen
                ? ViewerClock.At(Services, TimeAgo.FromUtc(seen)).ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
                : null,
            row?.ProtoSha,
            row?.ArchiveSourced);
    }

    IReadOnlyList<ProtoMetaRow> MetaRows() {
        var a = MetaOf(State.A);
        var b = MetaOf(State.B);
        List<ProtoMetaRow> rows = [
            new ProtoMetaRow("Platform", Dash(a.Platform), Dash(b.Platform)),
            new ProtoMetaRow("App version", Dash(a.AppVersion), Dash(b.AppVersion)),
            new ProtoMetaRow("Build", Dash(a.Build), Dash(b.Build)),
            new ProtoMetaRow("Client version", Dash(a.ClientVersion), Dash(b.ClientVersion)),
            new ProtoMetaRow("Source", Dash(a.Source), Dash(b.Source)),
            new ProtoMetaRow("Package", Dash(a.Package), Dash(b.Package)),
            new ProtoMetaRow("Detected", Dash(a.Detected), Dash(b.Detected)),
            new ProtoMetaRow("Proto SHA", Dash(a.Sha), Dash(b.Sha))
        ];
        rows.Add(new ProtoMetaRow("Archive sourced", Dash(YesNo(a.Archived)), Dash(YesNo(b.Archived))));
        return rows;
    }

    static string? YesNo(bool? value) {
        return value switch { true => "yes", false => "no", null => null };
    }

    string ViewText() {
        if (State.Mode == "meta") return string.Join("\n", MetaRows().Select(r => $"{r.Key}\t{r.A}\t{r.B}"));
        if (State.Mode == "text" || State.Cached is not { } bundle) return TextOf(State.A) ?? "";
        return State.Mode == "struct" ? StructuralJson(bundle) : bundle.Unified;
    }

    string Permalink() {
        var hash = ProtoRefParser.Format(new WorkbenchRef(State.A, State.B, State.Mode));
        var page = Nav.ToAbsoluteUri("/protos").ToString();
        return hash.Length == 0 ? page : $"{page}#{hash}";
    }

    static string StructuralJson(DiffBundle bundle) {
        return JsonSerializer.Serialize(
            new { entries = bundle.Structural.Entries, summary = bundle.Summary }, SelfCallJson.Web);
    }

    static string ProtoUrl(ProtoRef value) {
        return $"/api/protos/versions/{Uri.EscapeDataString(value.Platform)}/{Uri.EscapeDataString(value.Build)}/proto";
    }

    string? ApiPair() {
        if (State.A is not { Source: ProtoRefSource.Registry } a) return null;
        if (State.B is not { Source: ProtoRefSource.Registry } b) return null;
        if (!string.Equals(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase)) return null;
        return $"from={Uri.EscapeDataString(a.Build)}&to={Uri.EscapeDataString(b.Build)}"
               + $"&platform={Uri.EscapeDataString(a.Platform)}&context={_context}";
    }

    static string FileLabel(ProtoRef value) {
        return SafeName($"{value.Platform}-{value.Build}");
    }

    static string SafeName(string value) {
        var sb = new StringBuilder(value.Length);
        foreach (var c in value) sb.Append(char.IsAsciiLetterOrDigit(c) || c is '.' or '-' or '_' ? c : '-');

        return sb.Length == 0 ? "proto" : sb.ToString();
    }

    string PairName(string extension) {
        var a = State.A is { } refA ? FileLabel(refA) : "a";
        var b = State.B is { } refB ? FileLabel(refB) : "b";
        return $"ei-{a}..{b}.{extension}";
    }

    async Task DownloadProto(ProtoRef value) {
        _menu = null;
        var text = TextOf(value) ?? await ResolveText(value);
        if (text is not { Length: > 0 }) return;
        await DownloadText($"{FileLabel(value)}.proto", text);
    }

    async Task DownloadUnified(DiffBundle bundle) {
        _menu = null;
        await DownloadText(PairName("diff"), bundle.Unified);
    }

    async Task DownloadJson(DiffBundle bundle) {
        _menu = null;
        await DownloadText(PairName("json"), StructuralJson(bundle));
    }

    async Task DownloadText(string fileName, string content) {
        try {
            _download ??= await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/download.js"));
            await _download.InvokeVoidAsync("text", fileName, content);
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "download of {FileName} failed", fileName);
        }
    }

    static bool SameSha(string? a, string? b) {
        return a is { Length: > 0 } && b is { Length: > 0 } && string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    }

    static string Sha12(string? sha) {
        if (sha is not { Length: > 0 }) return "";
        return sha.Length > 12 ? sha[..12] : sha;
    }

    static string Dash(string? value) {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    static string PlatformFor(string? fileName) {
        var n = fileName ?? "";
        var android = n.EndsWith(".apk", StringComparison.OrdinalIgnoreCase)
                      || n.EndsWith(".apkm", StringComparison.OrdinalIgnoreCase)
                      || n.EndsWith(".xapk", StringComparison.OrdinalIgnoreCase);
        return android ? "android" : "ios";
    }

    public async ValueTask DisposeAsync() {
        await _strip.DisposeModuleAsync(logger: Logger);
        await _download.DisposeModuleAsync(logger: Logger);
        _selfRef?.Dispose();
        _gate.Dispose();
    }

