    string? TextOf(ProtoRef? value) {
        if (value is null) return null;
        return State.TextCache.TryGetValue(CacheKey(value), out var cached) && cached != MissingText ? cached : null;
    }

    string? ShaOf(ProtoRef? value) {
        if (value is null) return null;
        return value.Source == ProtoRefSource.Session
            ? FindSession(value)?.Result?.ProtoSha
            : RegistryRow(value)?.ProtoSha;
    }

    string LabelOf(ProtoRef value) {
        var sha = Sha12(ShaOf(value));
        return sha.Length > 0 ? $"{value.Platform} {value.Build} {sha}" : $"{value.Platform} {value.Build}";
    }

    bool ShowStatus(StagedEntry e) {
        return !e.IsAnalyzed || SameRef(State.A, SessionRef(e));
    }

    bool IsLegacySha(ProtoRef value) {
        return _legacy.TryGetValue(CacheKey(value), out var legacy) && legacy;
    }

    Task CheckCanonical(ProtoRef? value) {
        if (value is null) return Task.CompletedTask;
        var key = CacheKey(value);
        if (_legacy.ContainsKey(key)) return Task.CompletedTask;
        if (ShaOf(value) is not { Length: > 0 } stored) return Task.CompletedTask;
        if (!State.CanonicalShas.TryGetValue(key, out var canonical) || canonical is not { Length: > 0 }) {
            return Task.CompletedTask;
        }

        _legacy[key] = !SameSha(canonical, stored);
        StateHasChanged();
        return Task.CompletedTask;
    }

    static IReadOnlyList<string> SummaryParts(ProtoDiffSummary s) {
        var parts = new List<string>();
        if (s.MessagesAdded > 0) parts.Add($"{s.MessagesAdded} msg added");
        if (s.MessagesRemoved > 0) parts.Add($"{s.MessagesRemoved} msg removed");
        if (s.MessagesRenamed > 0) parts.Add($"{s.MessagesRenamed} msg renamed");
        if (s.MessagesModified > 0) parts.Add($"{s.MessagesModified} msg modified");
        if (s.FieldsAdded > 0) parts.Add($"{s.FieldsAdded} field added");
        if (s.FieldsRemoved > 0) parts.Add($"{s.FieldsRemoved} field removed");
        if (s.FieldsChanged > 0) parts.Add($"{s.FieldsChanged} field changed");
        if (s.EnumValuesChanged > 0) parts.Add($"{s.EnumValuesChanged} enum value changed");
        return parts;
    }

    RefMeta MetaOf(ProtoRef? value) {
        if (value is null) return new RefMeta("", null, null, null, null, null, null, null);
        if (value.Source == ProtoRefSource.Session) {
            var entry = FindSession(value);
            return new RefMeta(entry?.Platform ?? value.Platform, entry?.AppVersion, entry?.Build,
                entry?.ClientVersionText, "session upload", null, null, entry?.Result?.ProtoSha);
        }

        var row = RegistryRow(value);
        return new RefMeta(value.Platform, row?.AppVersion, row?.Build ?? value.Build, row?.ClientVersion,
            row?.Source, row?.Package,
            row?.DetectedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture),
            row?.ProtoSha);
    }

    IReadOnlyList<ProtoMetaRow> MetaRows() {
        var a = MetaOf(State.A);
        var b = MetaOf(State.B);
        return [
            new ProtoMetaRow("Platform", Dash(a.Platform), Dash(b.Platform)),
            new ProtoMetaRow("App version", Dash(a.AppVersion), Dash(b.AppVersion)),
            new ProtoMetaRow("Build", Dash(a.Build), Dash(b.Build)),
            new ProtoMetaRow("Client version", Dash(a.ClientVersion), Dash(b.ClientVersion)),
            new ProtoMetaRow("Source", Dash(a.Source), Dash(b.Source)),
            new ProtoMetaRow("Package", Dash(a.Package), Dash(b.Package)),
            new ProtoMetaRow("Detected", Dash(a.Detected), Dash(b.Detected)),
            new ProtoMetaRow("Proto SHA", Dash(a.Sha), Dash(b.Sha))
        ];
    }

    string ViewText() {
        if (State.Mode == "meta") return string.Join("\n", MetaRows().Select(r => $"{r.Key}\t{r.A}\t{r.B}"));
        if (State.Mode == "text" || State.Cached is not { } bundle) return TextOf(State.A) ?? "";
        return State.Mode == "struct" ? StructuralJson(bundle) : bundle.Unified;
    }

    string Permalink() {
        var hash = ProtoRefParser.Format(new WorkbenchRef(State.A, State.B, State.Mode));
        var page = Nav.ToAbsoluteUri("/protos").ToString();
        return hash.Length == 0 ? page : $"{page}#{hash}";
    }

    static string StructuralJson(DiffBundle bundle) {
        return JsonSerializer.Serialize(
            new { entries = bundle.Structural.Entries, summary = bundle.Summary }, SelfCallJson.Web);
    }

    static string ProtoUrl(ProtoRef value) {
        return $"/api/protos/versions/{Uri.EscapeDataString(value.Platform)}/{Uri.EscapeDataString(value.Build)}/proto";
    }

    string? ApiPair() {
        if (State.A is not { Source: ProtoRefSource.Registry } a) return null;
        if (State.B is not { Source: ProtoRefSource.Registry } b) return null;
        if (!string.Equals(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase)) return null;
        return $"from={Uri.EscapeDataString(a.Build)}&to={Uri.EscapeDataString(b.Build)}"
               + $"&platform={Uri.EscapeDataString(a.Platform)}&context={_context}";
    }

    static string FileLabel(ProtoRef value) {
        return SafeName($"{value.Platform}-{value.Build}");
    }

    static string SafeName(string value) {
        var sb = new StringBuilder(value.Length);
        foreach (var c in value) {
            sb.Append(char.IsAsciiLetterOrDigit(c) || c is '.' or '-' or '_' ? c : '-');
        }

        return sb.Length == 0 ? "proto" : sb.ToString();
    }

    string PairName(string extension) {
        var a = State.A is { } refA ? FileLabel(refA) : "a";
        var b = State.B is { } refB ? FileLabel(refB) : "b";
        return $"ei-{a}..{b}.{extension}";
    }

