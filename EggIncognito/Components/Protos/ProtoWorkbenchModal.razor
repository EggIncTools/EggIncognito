    async Task FallbackMissing() {
        if (State.B is { } b && IsUnknown(b)) {
            Toasts.Push(StatusNoteKind.Info, $"{RefLabel(b)} is not available.");
            State.B = null;
            State.Mode = "text";
        }

        if (State.A is not { } a || !IsUnknown(a)) return;
        Toasts.Push(StatusNoteKind.Info, $"{RefLabel(a)} is not available.");
        State.A = FallbackFor(a);
        if (State.A is not null) await ResolveText(State.A);
    }

    bool IsUnknown(ProtoRef value) {
        return value.Source == ProtoRefSource.Session
            ? FindSession(value) is null
            : State.Registry.Count > 0 && RegistryRow(value) is null;
    }

    ProtoRef? FallbackFor(ProtoRef value) {
        if (value.Source == ProtoRefSource.Session) return FirstSessionRef();
        var row = ProtoVersionOrdering.LatestFor(value.Platform, State.Registry, r => r.Key());
        return row is null ? null : RegistryRef(row);
    }

    ProtoRef? FirstSessionRef() {
        foreach (var e in State.Entries) {
            if (SessionRef(e) is { } value) return value;
        }

        return null;
    }

    async Task<string?> ResolveText(ProtoRef? value) {
        if (value is null) return null;
        var key = CacheKey(value);
        if (State.TextCache.TryGetValue(key, out var cached)) return cached == MissingText ? null : cached;
        if (value.Source == ProtoRefSource.Session) {
            var staged = FindSession(value)?.Result?.Proto;
            if (staged is not { Length: > 0 }) {
                await InvokeAsync(() => State.TextCache[key] = MissingText);
                return null;
            }

            var normalized = await Task.Run(() => ProtoCanonicalForm.Normalize(staged));
            var text = normalized is { Ok: true, Text: { Length: > 0 } canonText } ? canonText : staged;
            await InvokeAsync(() => {
                State.TextCache[key] = text;
                State.TextForms[key] = normalized is { Ok: true } ? ProtoDisplayForm.Canonical : ProtoDisplayForm.Raw;
                if (normalized is { Ok: true, Sha: { Length: > 0 } sha }) State.CanonicalShas[key] = sha;
            });
            return text;
        }

        try {
            var resp = await Client().GetAsync(
                $"/api/protos/versions/{Uri.EscapeDataString(value.Platform)}/{Uri.EscapeDataString(value.Build)}/proto");
            if (!resp.IsSuccessStatusCode) {
                await InvokeAsync(() => State.TextCache[key] = MissingText);
                return null;
            }

            var body = await resp.Content.ReadAsStringAsync();
            await InvokeAsync(() => {
                State.TextCache[key] = body;
                if (resp.Headers.TryGetValues("X-Proto-Form", out var forms) && forms.FirstOrDefault() is { Length: > 0 } form) {
                    State.TextForms[key] = form;
                }

                if (resp.Headers.TryGetValues("X-Proto-Canonical-Sha", out var shas) && shas.FirstOrDefault() is { Length: > 0 } sha) {
                    State.CanonicalShas[key] = sha;
                }
            });
            return body;
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "proto text for {Platform} {Build} could not be loaded", value.Platform, value.Build);
            await InvokeAsync(() => State.TextCache[key] = MissingText);
            return null;
        }
    }

    async Task<string?> ResolveRawText(ProtoRef value) {
        var key = RawCacheKey(value);
        if (State.TextCache.TryGetValue(key, out var cached)) return cached == MissingText ? null : cached;
        if (value.Source == ProtoRefSource.Session) {
            var staged = FindSession(value)?.Result?.Proto;
            await InvokeAsync(() => State.TextCache[key] = staged ?? MissingText);
            return staged;
        }

        try {
            var resp = await Client().GetAsync(
                $"/api/protos/versions/{Uri.EscapeDataString(value.Platform)}/{Uri.EscapeDataString(value.Build)}/proto?form=raw");
            if (!resp.IsSuccessStatusCode) {
                await InvokeAsync(() => State.TextCache[key] = MissingText);
                return null;
            }

            var body = await resp.Content.ReadAsStringAsync();
            await InvokeAsync(() => State.TextCache[key] = body);
            return body;
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "raw proto text for {Platform} {Build} could not be loaded", value.Platform, value.Build);
            await InvokeAsync(() => State.TextCache[key] = MissingText);
            return null;
        }
    }

    async Task SetMode(string mode) {
        if (ModeDisabled(mode) || State.Mode == mode) return;
        State.Mode = mode;
        _hunk = 0;
        await EnsureBundle();
        SyncFormNotice();
        await RaiseRefChanged();
    }

    bool ModeDisabled(string mode) {
        if (State.A is not { } a) return true;
        if (mode == "text") return false;
        if (State.B is not { } b) return true;
        return mode != "meta" && (!HasTextFor(a) || !HasTextFor(b));
    }

    string FilterKey() {
        if (State.A is not { } a) return "";
        if (State.Mode == "text") return CacheKey(a);
        return State.B is { } b ? $"{CacheKey(a)}|{CacheKey(b)}|{State.Mode}" : "";
    }

    string ViewFilter {
        get {
            var key = FilterKey();
            return key.Length > 0 && State.ViewFilters.TryGetValue(key, out var value) ? value : "";
        }
    }

    void OnLineFilterChanged(string value) {
        var key = FilterKey();
        if (key.Length == 0) return;
        if (value.Length == 0) {
            State.ViewFilters.Remove(key);
        } else {
            State.ViewFilters[key] = value;
        }
    }

    bool IsDiffMode() {
        return State.Mode is "split" or "unified" or "struct";
    }

    async Task EnsureBundle() {
        if (State.A is not { } a || State.B is not { } b) {
            State.Cached = null;
            State.CachedKey = null;
            AdoptBundle();
            return;
        }

        var pairForm = FormOf(a) == ProtoDisplayForm.Canonical && FormOf(b) == ProtoDisplayForm.Canonical
            ? ProtoDisplayForm.Canonical
            : ProtoDisplayForm.Raw;
        var key = $"{CacheKey(a)}|{CacheKey(b)}|{_context}|{pairForm}";
        if (State.CachedKey == key) {
            AdoptBundle();
            return;
        }

        if (Identical()) {
            State.Cached = null;
            State.CachedKey = key;
            AdoptBundle();
            return;
        }

        if (TextOf(a) is not { Length: > 0 } cachedA || TextOf(b) is not { Length: > 0 } cachedB) {
            State.Cached = null;
            State.CachedKey = null;
            AdoptBundle();
            return;
        }

        var textA = cachedA;
        var textB = cachedB;
        if (pairForm == ProtoDisplayForm.Raw) {
            var formA = FormOf(a);
            var formB = FormOf(b);
            var canonA = formA == ProtoDisplayForm.Canonical ? cachedA : null;
            var canonB = formB == ProtoDisplayForm.Canonical ? cachedB : null;
            var rawA = formA == ProtoDisplayForm.Canonical ? await ResolveRawText(a) ?? cachedA : cachedA;
            var rawB = formB == ProtoDisplayForm.Canonical ? await ResolveRawText(b) ?? cachedB : cachedB;
            (textA, textB, _) = ProtoDisplayForm.Pair(canonA, rawA, canonB, rawB);
        }

        var context = _context;
        var labelA = LabelOf(a);
        var labelB = LabelOf(b);
        var bundle = await Task.Run(() => BuildBundle(textA, textB, context, labelA, labelB));
        await InvokeAsync(() => {
            State.Cached = bundle;
            State.CachedKey = key;
            _hunk = 0;
            AdoptBundle();
            StateHasChanged();
        });
    }

    static DiffBundle BuildBundle(string textA, string textB, int context, string labelA, string labelB) {
        var aLines = UnifiedDiffWriter.SplitLines(textA);
        var bLines = UnifiedDiffWriter.SplitLines(textB);
        var ops = MyersDiff.Compute(aLines, bLines);
        var structural = ProtoDiff.Compute(textA, textB);
        return new DiffBundle(
            ops,
            SideBySideDiffBuilder.Build(aLines, bLines, ops),
            UnifiedDiffWriter.Write(aLines, bLines, ops, new UnifiedDiffOptions(context, LabelA: labelA, LabelB: labelB)),
            structural,
            ProtoDiffSummary.From(structural, ops));
    }

    void AdoptBundle() {
        _unifiedHunks = [];
        _degraded = false;
        if (State.Cached is not { } bundle) return;
        var lines = bundle.Unified.Split('\n');
        for (var i = 0; i < lines.Length; i++) {
            if (lines[i].StartsWith("@@", StringComparison.Ordinal)) _unifiedHunks.Add(i);
        }

        var changed = bundle.LineOps.Where(o => o.Kind != DiffOpKind.Equal).ToList();
        _degraded = changed.Count is > 0 and <= 2
                    && changed.Sum(o => o.ALength + o.BLength) > MyersDiff.GuardBudget;
        if (_hunk >= HunkCount()) _hunk = 0;
    }

    bool Identical() {
        if (State.A is not { } a || State.B is not { } b) return false;
        var shaA = ShaOf(a);
        var shaB = ShaOf(b);
        if (shaA is { Length: > 0 } && shaB is { Length: > 0 }) return SameSha(shaA, shaB);
        var textA = TextOf(a);
        var textB = TextOf(b);
        return textA is not null && textB is not null && string.Equals(textA, textB, StringComparison.Ordinal);
    }

    async Task ToggleContext() {
        _context = _context == FullContext ? DefaultContext : FullContext;
        State.CachedKey = null;
        await EnsureBundle();
        SyncFormNotice();
    }

    void OnHunkPicked(int index) {
        _hunk = index;
    }

    int HunkCount() {
        if (State.Mode == "unified") return _unifiedHunks.Count;
        return State.Mode == "split" ? State.Cached?.Split.HunkStarts.Count ?? 0 : 0;
    }

    int HunkRow(int index) {
        if (index < 0) return -1;
        if (State.Mode == "unified") return index < _unifiedHunks.Count ? _unifiedHunks[index] : -1;
        if (State.Cached?.Split.HunkStarts is not { } starts) return -1;
        return index < starts.Count ? starts[index] : -1;
    }

    async Task StepHunk(int delta) {
        var count = HunkCount();
        if (count == 0) return;
        _hunk = ((_hunk + delta) % count + count) % count;
        await ScrollToHunk();
    }

    async Task ScrollToHunk() {
        if (ViewFilter.Length > 0) return;
        var row = HunkRow(_hunk);
        if (row < 0) return;
        IJSObjectReference? element = null;
        try {
            element = await JS.InvokeAsync<IJSObjectReference>("document.querySelector", "#pwbView .code-scroll");
            if (element is not null) {
                await element.InvokeVoidAsync("scrollTo", new { top = row * CodeMetrics.RowHeightPx, left = 0 });
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "hunk scroll failed");
        }
        finally {
            await element.DisposeModuleQuietAsync(logger: Logger);
        }
    }

    IReadOnlyList<ProtoRegistryRow> OrderedRegistry() {
        if (ReferenceEquals(_optionSource, State.Registry)) return _options;
        _optionSource = State.Registry;
        _options = ProtoVersionOrdering.SortByRelease(State.Registry, r => r.Key());
        return _options;
    }

    IReadOnlyList<ProtoRegistryRow> _options = [];
    IReadOnlyList<ProtoRegistryRow>? _optionSource;

    ProtoRegistryRow? RegistryRow(ProtoRef value) {
        return State.Registry.FirstOrDefault(r =>
            string.Equals(r.Platform, value.Platform, StringComparison.OrdinalIgnoreCase)
            && string.Equals(r.Build, value.Build, StringComparison.OrdinalIgnoreCase));
    }

    ProtoRef? StepRef(int direction) {
        if (State.A is not { Source: ProtoRefSource.Registry } a || RegistryRow(a) is not { } row) return null;
        var target = direction > 0
            ? ProtoVersionOrdering.Previous(row, State.Registry, r => r.Key())
            : ProtoVersionOrdering.Next(row, State.Registry, r => r.Key());
        return target is null ? null : RegistryRef(target);
    }

    ProtoRef? LatestRef() {
        var platform = State.A is { Source: ProtoRefSource.Session } session
            ? FindSession(session)?.Platform ?? ""
            : State.A?.Platform ?? "";
        var row = platform.Length > 0
            ? ProtoVersionOrdering.LatestFor(platform, State.Registry, r => r.Key())
            : null;
        row ??= ProtoVersionOrdering.Latest(State.Registry, r => r.Key());
        if (row is null) return null;
        var value = RegistryRef(row);
        return SameRef(State.A, value) || SameRef(State.B, value) ? null : value;
    }

    string SourcePlatform() {
        return State.A is { Source: ProtoRefSource.Session } session
            ? FindSession(session)?.Platform ?? ""
            : State.A?.Platform ?? "";
    }

    IReadOnlyList<string> CounterpartTargets() {
        return ProtoCounterparts.Targets(SourcePlatform());
    }

    IReadOnlyList<ProtoCounterpart> CounterpartLinks() {
        var source = State.A is { Source: ProtoRefSource.Registry } a ? RegistryRow(a) : null;
        return ProtoCounterparts.For(source, State.Registry);
    }

    static ProtoCounterpart? TierOf(IReadOnlyList<ProtoCounterpart> links, ProtoRef? value) {
        return value is null ? null : links.FirstOrDefault(l => l.Row is { } row && SameRef(value, RegistryRef(row)));
    }

