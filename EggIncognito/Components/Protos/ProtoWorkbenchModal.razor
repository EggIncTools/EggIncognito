    IReadOnlyList<ConditionLine> ConditionLines() {
        var lines = new List<ConditionLine>();
        for (var g = 0; g < State.Query.Groups.Count; g++) {
            var conditions = State.Query.Groups[g].Conditions;
            for (var i = 0; i < conditions.Count; i++) {
                lines.Add(new ConditionLine(g, i, ConditionText(conditions[i])));
            }
        }

        return lines;
    }

    static string ConditionText(FilterCondition condition) {
        var label = RegistryFilter.Field(condition.Field)?.Label ?? condition.Field;
        var op = RegistryFilter.OpLabel(condition.Field, condition.Op);
        if (condition.Op is FilterOp.True or FilterOp.False) return $"{label} is {op}";
        return $"{label} {op} {condition.Value}";
    }

    void RemoveCondition(int groupIndex, int index) {
        if (groupIndex < 0 || groupIndex >= State.Query.Groups.Count) return;
        var groups = State.Query.Groups.Select(g => g.Conditions.ToList()).ToList();
        if (index < 0 || index >= groups[groupIndex].Count) return;
        groups[groupIndex].RemoveAt(index);
        var kept = groups.Where(c => c.Count > 0).Select(c => new FilterGroup(c)).ToList();
        State.Query = RegistryFilter.Prune(State.Query with { Groups = kept });
    }

    static ProtoRef RegistryRef(ProtoRegistryRow row) {
        return new ProtoRef(ProtoRefSource.Registry, row.Platform, row.Build, null);
    }

    static ProtoRef? SessionRef(StagedEntry e) {
        var sha = Sha12(e.Result?.FileSha);
        return sha.Length > 0 ? new ProtoRef(ProtoRefSource.Session, ProtoRefParser.SessionPlatform, sha, sha) : null;
    }

    static bool SameRef(ProtoRef? x, ProtoRef? y) {
        if (x is null || y is null) return x is null && y is null;
        return x.Source == y.Source
               && string.Equals(x.Platform, y.Platform, StringComparison.OrdinalIgnoreCase)
               && string.Equals(x.Build, y.Build, StringComparison.OrdinalIgnoreCase);
    }

    static string CacheKey(ProtoRef value) {
        return value.Source == ProtoRefSource.Session
            ? $"session:{value.Build}"
            : $"registry:{value.Platform}:{value.Build}";
    }

    static string RawCacheKey(ProtoRef value) {
        return CacheKey(value) + "#raw";
    }

    string FormOf(ProtoRef value) {
        return State.TextForms.GetValueOrDefault(CacheKey(value), ProtoDisplayForm.Canonical);
    }

    void SyncFormNotice() {
        if (State.A is not { } a) return;
        var formA = FormOf(a);
        if (State.Mode == "text" || State.B is not { } b) {
            if (formA == ProtoDisplayForm.Raw) Toasts.Push(StatusNoteKind.Info, "Normalization failed, raw proto text is shown.");
            return;
        }

        var formB = FormOf(b);
        if (formA != ProtoDisplayForm.Raw && formB != ProtoDisplayForm.Raw) return;
        var mixed = formA == ProtoDisplayForm.Canonical && RawFailed(a) || formB == ProtoDisplayForm.Canonical && RawFailed(b);
        if (mixed) Toasts.Push(StatusNoteKind.Error, "Raw text could not be fetched for one side, so the diff mixes canonical and raw forms.");
        else Toasts.Push(StatusNoteKind.Info, "Normalization failed, raw proto text is shown.");
    }

    bool RawFailed(ProtoRef value) {
        return State.TextCache.TryGetValue(RawCacheKey(value), out var cached) && cached == MissingText;
    }

    string RefMark(ProtoRef? value) {
        if (value is null) return "";
        if (SameRef(State.A, value)) return "A";
        return SameRef(State.B, value) ? "B" : "";
    }

    string RowClass(ProtoRegistryRow row) {
        var value = RegistryRef(row);
        var css = "";
        if (SameRef(State.A, value)) css += " pwb-sel-a";
        if (SameRef(State.B, value)) css += " pwb-sel-b";
        if (!HasText(row)) css += " pwb-dim";
        return css.TrimStart();
    }

    bool HasText(ProtoRegistryRow row) {
        if (string.IsNullOrEmpty(row.ProtoSha)) return false;
        return HasTextFor(RegistryRef(row));
    }

    bool HasTextFor(ProtoRef value) {
        return !State.TextCache.TryGetValue(CacheKey(value), out var cached) || cached != MissingText;
    }

    StagedEntry? FindSession(ProtoRef value) {
        return State.Entries.FirstOrDefault(x =>
            x.Result?.FileSha is { Length: > 0 } sha
            && sha.StartsWith(value.Build, StringComparison.OrdinalIgnoreCase));
    }

    string RefLabel(ProtoRef? value) {
        if (value is null) return "none";
        if (value.Source == ProtoRefSource.Session) {
            return FindSession(value) is { } entry
                ? PlainVersion(entry.Platform, entry.AppVersion, entry.Build, entry.ClientVersionText)
                : $"file {value.Build}";
        }

        var row = RegistryRow(value);
        return row is null
            ? $"{value.Platform} {value.Build}"
            : PlainVersion(row.Platform, row.AppVersion, row.Build, row.ClientVersion);
    }

    static string PlainVersion(string platform, string? app, string? build, string? client) {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(app)) parts.Add(app);
        if (!string.IsNullOrWhiteSpace(build)) parts.Add(build);
        if (!string.IsNullOrWhiteSpace(client)) parts.Add(client);
        return parts.Count > 0 ? $"{platform} {string.Join(" ", parts)}" : platform;
    }

    string SlotClass(ProtoRef? value) {
        return value is not null && !HasTextFor(value) ? "pwb-slot pwb-dim" : "pwb-slot";
    }

    IReadOnlyList<VersionComboItem> ComboItems(ProtoRef? exclude) {
        var items = new List<VersionComboItem>();
        foreach (var e in State.Entries.Where(x => x.IsAnalyzed)) {
            if (SessionRef(e) is not { } sref) continue;
            if (exclude is not null && SameRef(exclude, sref)) continue;
            items.Add(new VersionComboItem(sref.Format(), e.Platform, e.AppVersion, e.Build,
                e.ClientVersionText, Sha12(e.Result?.ProtoSha), false, "session upload"));
        }

        foreach (var row in OrderedRegistry()) {
            var value = RegistryRef(row);
            if (exclude is not null && SameRef(exclude, value)) continue;
            var hasText = HasText(row);
            items.Add(new VersionComboItem(value.Format(), row.Platform, row.AppVersion, row.Build,
                row.ClientVersion, Sha12(row.ProtoSha), !hasText, hasText ? null : "no stored proto text"));
        }

        return items;
    }

