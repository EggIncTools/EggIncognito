@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ICurrentUser User
@inject NavigationManager Nav
@inject ProtoWorkbenchState State
@inject ToastService Toasts
@inject ILogger<ProtoWorkbenchModal> Logger
@inject IServiceProvider Services
@using System.Globalization
@using System.Text
@using System.Text.Json
@using EggIncognito.Core
@using EggIncognito.Core.Services.ProtoExtract
@using EggIncognito.Models.Registry
@using EggIncognito.Models.Tools
@using EggIncognito.Services.Events
@using EggIncognito.Services.Protos
@using Microsoft.AspNetCore.Components.Web.Virtualization
@implements IAsyncDisposable

<InputFile id="wbFile" accept=".ipa,.apk,.apkm,.xapk" multiple hidden OnChange="OnFilesSelected"/>

@if (_open) {
    var groups = Groups();
    var offerAllCount = groups.Count(CanOffer);
    var counterparts = CounterpartLinks();
    <WorkbenchModal Open="true" Title="Proto workbench" Size="WorkbenchSize.Wide" CardClass="@CardCss(groups)"
                    BodyId="wbDrop" OnClose="Close">
    <HeadTools>
        <button type="button" class="btn-mini pwb-split-btn @(State.SplitQuery is not null ? "active" : "")"
                aria-pressed="@(State.SplitQuery is not null ? "true" : "false")" @onclick="ToggleSplit">
            <Icon Name="layout-grid" Class="icon-sm"/> Split registry
        </button>
        @if (User.IsAtLeast(UserRole.Contributor)) {
            <button type="button" class="btn-mini @(_adminOpen ? "active" : "")"
                    @onclick="@(() => _adminOpen = !_adminOpen)">
                Registry admin
            </button>
        }
        @if (offerAllCount > 0) {
            <button type="button" class="btn-mini" disabled="@_offerBusy" @onclick="@(() => OfferAll(groups))">
                <Icon Name="upload" Class="icon-sm"/> Offer all (@offerAllCount)
            </button>
        }
    </HeadTools>
    <Rail>
        <WorkbenchRail Class="wb-rail-popout">
            @{ var hasSession = State.Entries.Count > 0; }
            <div class="wb-rail-slot pwb-rail-sess @(hasSession ? "" : "pwb-rail-sess-empty")">
                <WorkbenchSection Label="Session" Scroll="@hasSession">
                    <label id="wbRailDrop" class="pwb-drop" for="wbFile">
                        <DropZonePrompt Prompt="Drop .ipa, .apk or bundle files"/>
                    </label>
                    @foreach (var e in State.Entries.Where(x => !x.IsAnalyzed)) {
                        @Card(e, null, false)
                    }
                    @foreach (var g in groups) {
                        @if (g.Members.Count > 1) {
                            <div class="pwb-group @(g.Conflict ? "pwb-group-conflict" : "")">
                                <div class="pwb-group-head">
                                    <VersionLine App="@g.AppVersion" Build="@g.Build" Client="@g.ClientVersionText"/>
                                    @if (g is { Conflict: false, Status.Offerable: true }) {
                                        <span class="pwb-offer">
                                            <Icon Name="upload" Class="icon-sm"/>
                                        </span>
                                    } else {
                                        <span class="pwb-note-inline @GroupStatusTone(g)">@GroupStatusText(g)</span>
                                    }
                                    @if (g.Status is { Failed: true }) {
                                        <button type="button" class="btn-mini pwb-retry" aria-label="Retry check"
                                                @onclick="@(() => RetryCheck(g))">
                                            <Icon Name="refresh-cw" Class="icon-sm"/> Retry
                                        </button>
                                    }
                                </div>
                                <div class="pwb-group-body">
                                    @foreach (var e in g.Members) {
                                        @Card(e, g, true)
                                    }
                                </div>
                            </div>
                        } else {
                            @Card(g.Members[0], g, false)
                        }
                    }
                </WorkbenchSection>
            </div>
            @if (State.SplitQuery is { } split) {
                <div class="wb-rail-slot pwb-rail-reg">
                    <WorkbenchSection Label="Registry (split)">
                        <Tools>
                            <button type="button" class="pwb-x" aria-label="Close split registry" @onclick="ToggleSplit">
                                <Icon Name="x" Class="icon-sm"/>
                            </button>
                        </Tools>
                        <ChildContent>
                            <RegistryPane Query="split" QueryChanged="@(q => State.SplitQuery = q)" Rows="State.Registry"
                                          IsAdmin="@User.IsAtLeast(UserRole.Admin)" RowClass="RowClass" IsSelected="IsSelected"
                                          OnRowClick="@(t => RegistryRowClick(t.Row, t.Args))" OnToggleRow="ToggleRow"
                                          OnToggleAll="@(t => ToggleAll(t.Rows, t.On))"/>
                        </ChildContent>
                    </WorkbenchSection>
                </div>
            }
            <div class="wb-rail-slot pwb-rail-reg">
                <WorkbenchSection Label="Registry">
                    <RegistryPane @ref="_registryPane" Query="State.Query" QueryChanged="@(q => State.Query = q)" Rows="State.Registry"
                                  IsAdmin="@User.IsAtLeast(UserRole.Admin)" RowClass="RowClass" IsSelected="IsSelected"
                                  OnRowClick="@(t => RegistryRowClick(t.Row, t.Args))" OnToggleRow="ToggleRow"
                                  OnToggleAll="@(t => ToggleAll(t.Rows, t.On))"/>
                </WorkbenchSection>
            </div>
        </WorkbenchRail>
    </Rail>
    <ChildContent>
        @if (User.IsAtLeast(UserRole.Contributor)) {
            <button type="button" class="pwb-drawer-tab @(_adminOpen ? "pwb-drawer-tab-open" : "") @(_selected.Count > 0 ? "pwb-drawer-tab-hot" : "")"
                    aria-label="@(_adminOpen ? "Close registry admin" : "Open registry admin")" aria-expanded="@(_adminOpen ? "true" : "false")"
                    @onclick="@(() => _adminOpen = !_adminOpen)">
                <Icon Name="@(_adminOpen ? "chevron-right" : "chevron-left")" Class="icon-sm"/>
                <span class="pwb-drawer-tab-label">@(_selected.Count > 0 ? $"{_selected.Count} selected" : "Registry admin")</span>
            </button>
            <aside class="pwb-drawer @(_adminOpen ? "pwb-drawer-open" : "")" aria-hidden="@(_adminOpen ? "false" : "true")">
                @if (_adminOpen) {
                    @if (_selected.Count > 0 && User.IsAtLeast(UserRole.Admin)) {
                        <ProtoSelectionBar Selected="_selected" Post="PostJson" OnChanged="OnSelectionMutated" OnClear="ClearSelection"/>
                    }
                    <RegistryAdminPanel @ref="_adminPanel" Rows="State.Registry" CanOrder="@User.IsAtLeast(UserRole.Admin)"
                                        IsAdmin="@User.IsAtLeast(UserRole.Admin)" Tab="@_adminTab"
                                        TabChanged="@(t => _adminTab = t)"
                                        OnChanged="OnAdminChanged" OnClose="@(() => _adminOpen = false)"/>
                }
            </aside>
        }
        <div class="pwb-slots">
            <div class="@SlotClass(State.A)">
                <VersionCombo Label="A" Items="ComboItems(null)" Selected="@State.A?.Format()"
                              SelectedChanged="OnPickA"/>
                @if (State.A is { } refA && IsLegacySha(refA)) {
                    <span class="pwb-slot-note pwb-warn">
                        legacy sha
                    </span>
                }
            </div>
            <button type="button" class="pwb-swap" aria-label="Swap A and B"
                    disabled="@(State.B is null)" @onclick="SwapRefs">
                <Icon Name="arrow-left-right" Class="icon-sm"/>
            </button>
            <div class="@SlotClass(State.B)">
                <VersionCombo Label="B" Items="ComboItems(State.A)" Selected="@State.B?.Format()"
                              SelectedChanged="OnPickB" AllowClear="true"/>
                @if (State.B is { } refB && IsLegacySha(refB)) {
                    <span class="pwb-slot-note pwb-warn">
                        legacy sha
                    </span>
                }
                @if (TierOf(counterparts, State.B) is { } tier) {
                    <span class="pwb-slot-note pwb-tier-note @(tier.Weak ? "pwb-warn" : "")">
                        @tier.Reason
                    </span>
                }
            </div>
        </div>
        @{
            var selGroup = Selected is { } current
                ? groups.FirstOrDefault(x => x.Members.Any(m => m.Id == current.Id))
                : null;
        }
        @if (Selected is { } sel && ShowStatus(sel)) {
            <div class="pwb-status">
                <span class="pwb-file">@sel.FileName</span>
                @if (sel.Status == "error") {
                    <span class="pwb-note-inline pwb-err">@(sel.Error ?? "failed")</span>
                } else if (!sel.IsDone) {
                    <span class="pwb-dim-note">@sel.Status@(sel.Step is { Length: > 0 } ? $": {sel.Step}" : "")...</span>
                } else if (sel.Result is { } r) {
                    <span class="pwb-mono-note">@(r.Messages.Count) - @Sha12(r.ProtoSha)</span>
                    @if (selGroup is { Conflict: true }) {
                        <span class="pwb-note-inline pwb-err">conflict</span>
                        <span class="pwb-dim-note">Pick the file to offer in the rail.</span>
                    } else if (selGroup?.Status is { Rejected: true }) {
                        <span class="pwb-note-inline pwb-warn">rejected before</span>
                        <span class="pwb-dim-note">A reviewer rejected this proto. Resubmit with more version data to reopen it.</span>
                    } else if (selGroup?.Status is { Known: true, ShaDiffers: true }) {
                        <span class="pwb-note-inline pwb-warn">in registry, proto differs</span>
                        <span class="pwb-dim-note">This build is registered with another proto. The archive text replaces it.</span>
                    } else if (selGroup?.Status is { Archived: true }) {
                        <span class="pwb-note-inline pwb-ok">archive flagged</span>
                    } else if (selGroup?.Status is { Known: true }) {
                        <span class="pwb-note-inline pwb-ok">in registry</span>
                    } else if (selGroup?.Status is { Failed: true }) {
                        <span class="pwb-note-inline pwb-err">check failed</span>
                        <button type="button" class="btn-mini" aria-label="Retry check"
                                @onclick="@(() => RetryCheck(selGroup))">
                            <Icon Name="refresh-cw" Class="icon-sm"/> Retry
                        </button>
                    } else if (selGroup?.Status is { Pending: true } or { Offered: true }) {
                        @if (User.IsAtLeast(UserRole.Contributor)) {
                            <button type="button" class="pwb-pending-btn @(_adminOpen && _adminTab == RegistryAdminPanel.TabReview ? "active" : "")"
                                    @onclick="ToggleQueue">
                                pending review
                            </button>
                        } else {
                            <span class="pwb-note-inline pwb-warn">pending review</span>
                        }
                    } else if (selGroup?.Status is { Offerable: true }) {
                        @if (selGroup.Status.InRegistry) {
                            <span class="pwb-note-inline">new build of a known sha</span>
                        }
                        @if (User.IsAuthenticated) {
                            <span class="pwb-note-inline">offerable</span>
                        } else {
                            <span class="pwb-dim-note">Log in to offer this version to the registry.</span>
                        }
                    }

                    @if (selGroup is { } sg && CanOffer(sg)) {
                        <button type="button" class="btn-mini" disabled="@_offerBusy"
                                @onclick="@(() => Offer(sg))">
                            @if (CanFlag(sg)) {
                                <Icon Name="shield-check" Class="icon-sm"/> <text>@(sg.Status is { ShaDiffers: true } ? "Replace with archive" : "Flag archive")</text>
                            } else {
                                <Icon Name="upload" Class="icon-sm"/> <text>Offer</text>
                            }
                        </button>
                    }
                }
            </div>
        }
        <div class="pwb-head">
            <WorkbenchModes Modes="State.Modes" Current="@State.Mode" CurrentChanged="SetMode" Disabled="ModeDisabled"/>
            <button type="button" class="btn-mini" aria-label="Older version"
                    disabled="@(StepRef(1) is null)" @onclick="@(() => SetA(StepRef(1)))">
                <Icon Name="chevron-left" Class="icon-sm"/>
            </button>
            <button type="button" class="btn-mini" aria-label="Newer version"
                    disabled="@(StepRef(-1) is null)" @onclick="@(() => SetA(StepRef(-1)))">
                <Icon Name="chevron-right" Class="icon-sm"/>
            </button>
            <div class="pwb-menu-wrap">
                <button type="button" class="pwb-menu-btn" aria-haspopup="true" disabled="@(State.A is null)"
                        aria-expanded="@(_menu == "file" ? "true" : "false")" @onclick="@(() => ToggleMenu("file"))">
                    File
                </button>
                @if (_menu == "file") {
                    <div class="popover-backdrop" @onmousedown="CloseMenu" @onwheel="CloseMenu"></div>
                    <div class="pwb-menu">
                        <div class="pwb-menu-label">Download</div>
                        @if (State.A is { } dlA) {
                            @DownloadItem(dlA, "A")
                        }
                        @if (State.B is { } dlB) {
                            @DownloadItem(dlB, "B")
                        }
                        @if (State.Cached is { } dlBundle) {
                            @if (ApiPair() is { Length: > 0 } api) {
                                <a class="pwb-menu-item" href="@($"/api/protos/diff?{api}&format=unified&download=1")"
                                   target="_blank" rel="noopener" @onclick="CloseMenu">
                                    unified .diff
                                </a>
                                <a class="pwb-menu-item" href="@($"/api/protos/diff?{api}&format=json&download=1")"
                                   target="_blank" rel="noopener" @onclick="CloseMenu">
                                    structural .json
                                </a>
                            } else {
                                <button type="button" class="pwb-menu-item"
                                        @onclick="@(() => DownloadUnified(dlBundle))">
                                    unified .diff
                                </button>
                                <button type="button" class="pwb-menu-item"
                                        @onclick="@(() => DownloadJson(dlBundle))">
                                    structural .json
                                </button>
                            }
                        }
                        <div class="pwb-menu-sep"></div>
                        <div class="pwb-menu-label">Clipboard</div>
                        <CopyButton GetText="ViewText" ButtonClass="pwb-menu-item" IconClass="icon-sm"
                                    Label="Copy view text" CopiedLabel="Copied"/>
                        <CopyButton GetText="Permalink" ButtonClass="pwb-menu-item" IconClass="icon-sm"
                                    Label="Copy permalink" CopiedLabel="Copied"/>
                    </div>
                }
            </div>
            <div class="pwb-menu-wrap">
                <button type="button" class="pwb-menu-btn" aria-haspopup="true" disabled="@(State.A is null)"
                        aria-expanded="@(_menu == "compare" ? "true" : "false")"
                        @onclick="@(() => ToggleMenu("compare"))">
                    Compare
                </button>
                @if (_menu == "compare") {
                    <div class="popover-backdrop" @onmousedown="CloseMenu" @onwheel="CloseMenu"></div>
                    <div class="pwb-menu">
                        <button type="button" class="pwb-menu-item" disabled="@(StepRef(1) is null)"
                                @onclick="@(() => MenuDo(() => SetB(StepRef(1))))">
                            vs previous
                        </button>
                        <button type="button" class="pwb-menu-item" disabled="@(LatestRef() is null)"
                                @onclick="@(() => MenuDo(() => SetB(LatestRef())))">
                            vs latest
                        </button>
                        @foreach (var target in CounterpartTargets()) {
                            var link = counterparts.FirstOrDefault(l => l.Platform == target);
                            <button type="button" class="pwb-menu-item" disabled="@(link is null)"
                                    @onclick="@(() => MenuDo(() => SetCounterpart(link)))">
                                vs @target
                            </button>
                        }
                        <div class="pwb-menu-sep"></div>
                        <button type="button" class="pwb-menu-item" disabled="@(State.B is null)"
                                @onclick="@(() => MenuDo(SwapRefs))">
                            Swap A and B
                        </button>
                        <button type="button" class="pwb-menu-item" disabled="@(State.B is null)"
                                @onclick="@(() => MenuDo(ClearB))">
                            Clear B
                        </button>
                    </div>
                }
            </div>
            @if (IsDiffMode() && State.Cached is { } sumBundle) {
                <span class="pwb-sum">
                    <span class="pwb-sum-add">+@sumBundle.Summary.LinesAdded</span>
                    <span class="pwb-sum-rem">-@sumBundle.Summary.LinesRemoved</span>
                    @foreach (var part in SummaryParts(sumBundle.Summary)) {
                        <span class="pwb-sum-k">@part</span>
                    }
                </span>
            }
        </div>
        <div class="pwb-view" id="pwbView">
            @if (State.A is not { } viewA) {
                <CodeSurface Text="" AllowEmpty="true" Language="proto" Gutter="CodeGutter.None"
                             MinHeight="22.5rem" MaxHeight="48vh" ShowToolbar="false"/>
            } else if (State.Mode == "meta") {
                <table class="data-table">
                    <thead>
                    <tr>
                        <th></th><th>@RefLabel(State.A)</th><th>@RefLabel(State.B)</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in MetaRows()) {
                        <tr class="@(row.Same ? "" : "pwb-meta-diff")">
                            <td class="pwb-key">@row.Key</td>
                            <td class="pwb-wrap">@row.A</td>
                            <td class="pwb-wrap">@row.B</td>
                        </tr>
                    }
                    </tbody>
                </table>
            } else if (State.Mode == "text") {
                @if (!HasTextFor(viewA)) {
                    <div class="pwb-note">No stored proto text for this version.</div>
                } else if (TextOf(viewA) is { Length: > 0 } textA) {
                    <CodeSurface Text="@textA" Language="proto" Gutter="CodeGutter.Numbers" MaxHeight="48vh"
                                 ShowLanguagePicker="false" Filter="@ViewFilter">
                        <Tools>@LineFilter()</Tools>
                    </CodeSurface>
                } else {
                    <div class="pwb-dim-note">loading...</div>
                }
            } else if (State.B is not { } viewB) {
                <div class="pwb-note">Pick a B side in the rail to diff against.</div>
            } else if (!HasTextFor(viewA) || !HasTextFor(viewB)) {
                <div class="pwb-note">No stored proto text for @(HasTextFor(viewA) ? "B" : "A").</div>
            } else if (Identical()) {
                <div class="pwb-note pwb-note-ok">A and B are the same proto (matching sha). Nothing to diff.</div>
            } else if (State.Cached is { } bundle) {
                @if (_degraded) {
                    <div class="pwb-note pwb-note-warn">These files are too large to diff line by line, so the whole changed region is shown as one block.</div>
                }

                @if (State.Mode == "split") {
                    <CodeDiff Mode="CodeDiffMode.Split" Split="bundle.Split" Language="proto" Filter="@ViewFilter"
                              MaxHeight="48vh" ShowLanguagePicker="false" OnHunk="OnHunkPicked">
                        <Tools>@LineFilter()</Tools>
                        <Actions>@LineTools()</Actions>
                    </CodeDiff>
                } else if (State.Mode == "unified") {
                    <CodeDiff Mode="CodeDiffMode.Unified" Unified="@bundle.Unified" Language="proto"
                              Filter="@ViewFilter" MaxHeight="48vh" ShowLanguagePicker="false">
                        <Tools>@LineFilter()</Tools>
                        <Actions>@LineTools()</Actions>
                    </CodeDiff>
                } else {
                    <CodeDiff Mode="CodeDiffMode.Structured" Structural="bundle.Structural" Language="proto"
                              EmptyText="No structural differences."/>
                }
            } else {
                <div class="pwb-dim-note">comparing...</div>
            }
        </div>
    </ChildContent>
    </WorkbenchModal>
}

@code {
    const string MissingText = "\u0000";

    const int DefaultContext = 3;

    const int FullContext = 100_000;

    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public EventCallback<WorkbenchRef> OnRefChanged { get; set; }

    [Parameter] public EventCallback OnClosed { get; set; }

    bool _open;
    bool _adminOpen;
    string _adminTab = RegistryAdminPanel.TabReview;
    RegistryAdminPanel? _adminPanel;
    bool _dropWired;
    bool _offerBusy;
    string? _menu;
    RegistryPane? _registryPane;
    IJSObjectReference? _strip;
    IJSObjectReference? _download;
    DotNetObjectReference<ProtoWorkbenchModal>? _selfRef;
    readonly SemaphoreSlim _gate = new(2, 2);
    readonly HashSet<string> _checking = [];
    readonly Dictionary<string, bool> _legacy = [];
    bool _degraded;
    int _context = DefaultContext;
    int _hunk;
    List<int> _unifiedHunks = [];

    StagedEntry? Selected => State.Find(State.SelectedId);

    RenderFragment Card(StagedEntry e, OfferGroup? g, bool grouped) => @<WorkbenchEntry @key="e.Id"
                                                                                        Selected="@(State.SelectedId == e.Id || RefMark(SessionRef(e)) == "A")"
                                                                                        Compare="@(RefMark(SessionRef(e)) == "B")"
                                                                                        Tone="@CardTone(e)" Status="@CardStatus(e)"
                                                                                        OnClick="@(args => Select(e, args))">
                                                                           <Lead>
                                                                               @if (g is { MultiSha: true } grp) {
                                                                                   <input type="radio" class="pwb-radio" name="@("wbg-" + grp.Key)"
                                                                                          checked="@(grp.Winner?.Id == e.Id)"
                                                                                          @onclick:stopPropagation="true"
                                                                                          @onkeydown:stopPropagation="true"
                                                                                          @onchange="@(() => PickWinner(grp, e))"/>
                                                                               }
                                                                           </Lead>
                                                                           <Name>
                                                                               @if (!grouped && e.IsAnalyzed) {
                                                                                   <VersionLine App="@e.AppVersion" Build="@e.Build" Client="@e.ClientVersionText"/>
                                                                               } else if (!e.IsAnalyzed) {
                                                                                   <span class="pwb-size">@ByteFormat.Mb(e.Size, culture: CultureInfo.InvariantCulture)</span>
                                                                               }
                                                                           </Name>
                                                                           <Trail>
                                                                               <button type="button" class="pwb-x" aria-label="Remove"
                                                                                       @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"
                                                                                       @onclick="@(() => Remove(e))">
                                                                                   <Icon Name="x" Class="icon-sm"/>
                                                                               </button>
                                                                           </Trail>
                                                                           <MetaLine>
                                                                               @if (Sha12(e.Result?.ProtoSha) is { Length: > 0 } sha) {
                                                                                   @sha
                                                                               }
                                                                           </MetaLine>
                                                                           <Foot>
                                                                               @if (!e.IsDone && e.Step is { Length: > 0 } step) {
                                                                                   <span class="pwb-step">@step</span>
                                                                               }
                                                                               @if (!grouped && g is { Conflict: false, Status.Offerable: true }) {
                                                                                   <span class="pwb-offer">
                                                                                       <Icon Name="upload" Class="icon-sm"/>
                                                                                   </span>
                                                                               }
                                                                               <Icon Name="clock" Class="icon-sm"/>
                                                                               <PlatformIcon Platform="@e.Platform"/>
                                                                           </Foot>
                                                                       </WorkbenchEntry>;

    RenderFragment LineFilter() => @<FilterInput Class="code-filter" AriaLabel="Filter lines"
                                                 Value="@ViewFilter" ValueChanged="OnLineFilterChanged"/>;

    RenderFragment LineTools() => @<text>
                                       <button type="button" class="btn-mini @(_context == FullContext ? "code-toggle-on" : "")"
                                               @onclick="ToggleContext">
                                           @(_context == FullContext ? "all" : "3") ctx
                                       </button>
                                       @if (HunkCount() > 0) {
                                           <span class="pwb-hunk">
                                               <button type="button" class="btn-mini" aria-label="Previous hunk"
                                                       @onclick="@(() => StepHunk(-1))">
                                                   &uarr;
                                               </button>
                                               <span class="pwb-hunk-at">@(_hunk + 1)/@HunkCount()</span>
                                               <button type="button" class="btn-mini" aria-label="Next hunk"
                                                       @onclick="@(() => StepHunk(1))">
                                                   &darr;
                                               </button>
                                           </span>
                                       }
                                   </text>;

    RenderFragment DownloadItem(ProtoRef value, string side) => @<text>
                                                                     @if (value.Source == ProtoRefSource.Registry) {
                                                                         <a class="pwb-menu-item" href="@ProtoUrl(value)" download="@($"{FileLabel(value)}.proto")"
                                                                            target="_blank" rel="noopener" @onclick="CloseMenu">
                                                                             @side .proto
                                                                         </a>
                                                                     } else {
                                                                         <button type="button" class="pwb-menu-item" @onclick="@(() => DownloadProto(value))">@side .proto</button>
                                                                     }
                                                                 </text>;

    public void Open() {
        _open = true;
        _dropWired = false;
        StateHasChanged();
    }

    public void OpenAdd() {
        OpenAdmin(RegistryAdminPanel.TabAdd);
    }

    public void OpenReview() {
        OpenAdmin(RegistryAdminPanel.TabReview);
    }

    void OpenAdmin(string tab) {
        _adminTab = tab;
        _adminOpen = User.IsAtLeast(UserRole.Contributor);
        Open();
    }

    public async Task RefreshReview() {
        if (!_open || _adminPanel is not { } panel) return;
        await panel.Refresh();
    }

    async Task OnAdminChanged() {
        foreach (var k in State.GroupStatuses.Keys.ToList()) State.GroupStatuses.Remove(k);
        await CheckGroups();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    async Task ToggleQueue() {
        bool reviewing = _adminOpen && _adminTab == RegistryAdminPanel.TabReview;
        if (reviewing) _adminOpen = false;
        else OpenAdmin(RegistryAdminPanel.TabReview);
        await RefreshQueue();
    }

    async Task RefreshQueue() {
        await Rerender();
        await RefreshReview();
    }

    public void OpenAt(ProtoRef a, ProtoRef? b, string? mode) {
        State.A = a;
        State.B = b;
        State.Mode = ModeOrDefault(mode, b);
        State.Cached = null;
        State.CachedKey = null;
        _hunk = 0;
        Open();
        _ = ResolvePair();
    }

    public void OpenGroup(string protoSha) {
        if (string.IsNullOrWhiteSpace(protoSha)) return;
        State.Query = RegistryQuery.Empty with {
            Groups = [new FilterGroup([new FilterCondition("sha", FilterOp.Is, protoSha)])]
        };
        Open();
        var match = ProtoVersionOrdering.SortByRelease(
            State.Registry.Where(r => RegistryFilter.Matches(r, State.Query)), r => r.Key()).FirstOrDefault();
        if (match is not null) _ = SetA(RegistryRef(match));
    }

