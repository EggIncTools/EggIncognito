    async Task ResolvePair() {
        await ResolveText(State.A);
        await ResolveText(State.B);
        await FallbackMissing();
        await EnsureBundle();
        SyncFormNotice();
        await Rerender();
        _ = CheckCanonical(State.A);
        _ = CheckCanonical(State.B);
