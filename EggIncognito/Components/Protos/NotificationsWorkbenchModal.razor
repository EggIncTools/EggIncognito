@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject NotificationsWorkbenchState State
@inject ToastService Toasts
@inject ILogger<NotificationsWorkbenchModal> Logger
@using System.Text.Json
@using EggIncognito.Components.Shared.Editor
@using EggIncognito.Models.Notifications
@using EggIncognito.Models.Protos
@using EggIncognito.Services.Feed
@using EggIncognito.Services.Notifications
@implements IAsyncDisposable

<WorkbenchModal Open="_open" Title="Notifications" TitleId="notificationsWorkbenchTitle" CardClass="nwb-card"
                OnClose="CloseAsync">
    <HeadTools>
        @if (AdminScope) {
            @if (_admin is { } summary) {
                <span class="text-xs text-muted">@AdminHeadLine(summary)</span>
            }
        } else if (State.Creating) {
            <button type="button" class="btn-primary nwb-act"
                    disabled="@(_busy || !User.IsAuthenticated || State.NewDraft.Url.Trim().Length == 0)"
                    @onclick="Create">
                @CreateLabel
            </button>
        } else if (Current is { } cur && User.IsAuthenticated) {
            @if (_armed) {
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => SendTest(cur.Id))">
                    Confirm, post to @cur.UrlMasked
                </button>
                <button type="button" class="btn-mini" @onclick="@(() => _armed = false)">Cancel</button>
            } else {
                <button type="button" class="btn-mini" disabled="@(_busy || PreviewKey() is null)"
                        @onclick="@(() => _armed = true)">
                    Send test
                </button>
            }

            <button type="button" class="btn-mini" disabled="@_busy" @onclick="@(() => DeleteRow(cur.Id))">Delete</button>
            <button type="button" class="btn-primary nwb-act" disabled="@_busy" @onclick="@(() => Save(cur.Id))">
                @(_busy ? "Saving..." : "Save")
            </button>
        }
    </HeadTools>
    <Rail>
        @if (AdminScope) {
            <WorkbenchRail HasFilter="true" Filter="@_adminFilter" FilterChanged="OnAdminFilter"
                           FilterLabel="Filter notifications">
                <WorkbenchLoad T="AdminFeedRow" Items="@AdminFilteredOrNull" EmptyText="@AdminEmptyRailText"
                               Context="rows">
                    @foreach (var g in rows.GroupBy(r => r.OwnerUsername, StringComparer.OrdinalIgnoreCase)) {
                        <WorkbenchSection Label="@g.Key">
                            @foreach (var r in g) {
                                <WorkbenchEntry @key="r.Id" Selected="@(_adminSelectedId == r.Id)"
                                                Status="@HealthStatus(r)" OnClick="@(_ => AdminSelect(r))">
                                    <Name>@AdminRowLabel(r)</Name>
                                    <MetaLine>@r.TargetMasked</MetaLine>
                                    <Foot>@Health(r)</Foot>
                                </WorkbenchEntry>
                            }
                        </WorkbenchSection>
                    }
                </WorkbenchLoad>
            </WorkbenchRail>
        } else {
            <WorkbenchRail HasFilter="true" Filter="@State.RailFilter" FilterChanged="OnRailFilter"
                           FilterLabel="Filter notifications">
                <WorkbenchEntry Selected="@State.Creating" OnClick="@(_ => SelectNew())">
                    <Name>New notification</Name>
                </WorkbenchEntry>
                @if (User.IsAuthenticated) {
                    <WorkbenchLoad T="NotificationRow" Items="@FilteredOrNull" EmptyText="@EmptyRailText" Context="rows">
                        @foreach (var g in rows.GroupBy(s => s.EventKind).OrderBy(g => g.Key, StringComparer.Ordinal)) {
                            <WorkbenchSection Label="@KindLabel(g.Key)">
                                @foreach (var s in g) {
                                    <WorkbenchEntry @key="s.Id" Selected="@(!State.Creating && State.SelectedId == s.Id)"
                                                    Status="@HealthStatus(s)" OnClick="@(_ => Select(s))">
                                        <Name>@s.UrlMasked</Name>
                                        <MetaLine>@TriggerLabel(s.EventKind, s.Trigger)</MetaLine>
                                        <Foot>@Health(s)</Foot>
                                    </WorkbenchEntry>
                                }
                            </WorkbenchSection>
                        }
                    </WorkbenchLoad>
                }
            </WorkbenchRail>
        }
    </Rail>
    <ChildContent>
        <div class="nwb-pane">
            @if (AdminScope) {
                @AdminDetail()
            } else if (State.Creating) {
                @Config(State.NewDraft, null)
            } else if (Current is { } row) {
                @Config(State.Draft(row.Id), row)
            } else {
                <div class="text-muted text-sm">Select a notification, or start a new one.</div>
            }
        </div>
    </ChildContent>
</WorkbenchModal>

@code {
    const int PreviewDebounceMs = 500;

    static readonly AdminFeedListResponse EmptyAdmin = new(0, 0, 0, []);

    [Parameter] public bool AdminScope { get; set; }

    bool _open;
    bool _busy;
    bool _armed;
    bool _json;
    bool _hashWired;

    AdminFeedListResponse? _admin;
    int? _adminSelectedId;
    string _adminFilter = "";
    bool _confirmDelete;
    bool _confirmTest;

    IJSObjectReference? _nav;
    IJSObjectReference? _navHandle;
    DotNetObjectReference<NotificationsWorkbenchModal>? _selfRef;
    CancellationTokenSource? _debounce;
    int _previewSeq;

    List<KindInfo> _kinds = [];
    List<NotificationRow>? _rows;
    List<PreviewRow>? _preview;

    readonly Dictionary<int, List<FeedActivityRow>> _activity = [];
    readonly HashSet<int> _activityOpen = [];

    NotificationRow? Current => State.Creating ? null : _rows?.FirstOrDefault(s => s.Id == State.SelectedId);

    string CreateLabel => _busy ? "Creating..." : User.IsAuthenticated ? "Create" : "Log in to save";

    List<NotificationRow>? FilteredOrNull {
        get {
            if (_rows is null) return null;
            var f = State.RailFilter.Trim();
            if (f.Length == 0) return _rows;
            return _rows.Where(s =>
                Has(s.UrlMasked, f) || Has(s.Label, f) || Has(KindLabel(s.EventKind), f) ||
                Has(TriggerLabel(s.EventKind, s.Trigger), f)).ToList();
        }
    }

    string EmptyRailText => _rows is { Count: > 0 } ? "No match." : "No notifications yet.";

    static bool Has(string? value, string needle) {
        return value is not null && value.Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    AdminFeedRow? AdminCurrent => _admin?.Rows.FirstOrDefault(r => r.Id == _adminSelectedId);

    IReadOnlyCollection<AdminFeedRow>? AdminFilteredOrNull {
        get {
            if (_admin is null) return null;
            var f = _adminFilter.Trim();
            if (f.Length == 0) return _admin.Rows;
            return _admin.Rows.Where(r =>
                Has(r.OwnerUsername, f) || Has(r.TargetMasked, f) || Has(r.Label, f) ||
                Has(KindLabel(r.EventKind), f) || Has(TriggerLabel(r.EventKind, r.Trigger), f)).ToList();
        }
    }

    string AdminEmptyRailText => _admin is { Total: > 0 } ? "No match." : "No notifications yet.";

    string AdminRowLabel(AdminFeedRow r) {
        return string.IsNullOrWhiteSpace(r.Label) ? KindLabel(r.EventKind) : r.Label;
    }

    static string AdminHeadLine(AdminFeedListResponse a) {
        return $"{a.Total} subscriptions, {a.ActiveCount} active, {a.Owners} owners";
    }

    static string AdminList(string[] values) {
        return values.Length == 0 ? "none" : string.Join(", ", values);
    }

    static string AdminStamp(DateTimeOffset? at) {
        return at is { } value ? value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never";
    }

    KindInfo? KindOf(string? key) {
        return _kinds.FirstOrDefault(k => k.Key == key);
    }

    string KindLabel(string? key) {
        return KindOf(key)?.Label ?? key ?? "";
    }

    string TriggerLabel(string? kind, string trigger) {
        return KindOf(kind)?.Triggers.FirstOrDefault(t => t.Value == trigger)?.Label ?? trigger;
    }

    IReadOnlyList<TriggerOpt> TriggersOf(string? kind) {
        return KindOf(kind)?.Triggers ?? [];
    }

    IReadOnlyList<FilterOpt> FiltersOf(string? kind) {
        return KindOf(kind)?.Filters ?? [];
    }

    IReadOnlyList<FeedVarInfo> VarsOf(string? kind) {
        return KindOf(kind)?.Vars ?? [];
    }

    static string Health(NotificationRow s) {
        return Health(s.Active, s.FailCount, s.LastDeliveryAt);
    }

    static string Health(AdminFeedRow r) {
        return Health(r.Active, r.FailCount, r.LastDeliveryAt);
    }

    static string Health(bool active, int failCount, DateTimeOffset? lastDelivery) {
        if (!active) return "paused";
        return failCount > 0 ? $"{failCount} failed" : lastDelivery is null ? "no sends yet" : "healthy";
    }

    static WorkbenchStatusKind HealthStatus(NotificationRow s) {
        return HealthStatus(s.Active, s.FailCount, s.LastDeliveryAt);
    }

    static WorkbenchStatusKind HealthStatus(AdminFeedRow r) {
        return HealthStatus(r.Active, r.FailCount, r.LastDeliveryAt);
    }

    static WorkbenchStatusKind HealthStatus(bool active, int failCount, DateTimeOffset? lastDelivery) {
        if (!active) return WorkbenchStatusKind.Muted;
        if (failCount > 0) return WorkbenchStatusKind.Error;
        return lastDelivery is null ? WorkbenchStatusKind.Muted : WorkbenchStatusKind.Done;
    }

    static bool FiltersApply(NotificationDraft d) {
        return d.Trigger != "suspect";
    }

    string? PreviewBody() {
        return _preview?.FirstOrDefault(p => p.Body is { Length: > 0 })?.Body;
    }

    string? PreviewKey() {
        return _preview?.FirstOrDefault(p => p.Body is { Length: > 0 })?.Key;
    }

    RenderFragment Config(NotificationDraft d, NotificationRow? row) => @<text>
                                                                             <div class="nwb-surface">
                                                                                 <div class="nwb-row">
                                                                                     <span class="nwb-k">Webhook</span>
                                                                                     @if (row is null) {
                                                                                         <input class="nwb-field font-mono" aria-label="Discord webhook URL"
                                                                                                placeholder="https://discord.com/api/webhooks/..."
                                                                                                @bind="d.Url" @bind:event="oninput"/>
                                                                                     } else {
                                                                                         <span class="nwb-static font-mono">@row.UrlMasked</span>
                                                                                     }
                                                                                 </div>
                                                                                 <div class="nwb-row">
                                                                                     <span class="nwb-cell">
                                                                                         <span class="nwb-k">Event</span>
                                                                                         @if (row is null) {
                                                                                             <select class="nwb-field" aria-label="Event" @bind="d.EventKind"
                                                                                                     @bind:after="@(() => OnKindChanged(d))">
                                                                                                 @foreach (var k in _kinds) {
                                                                                                     <option value="@k.Key">@k.Label</option>
                                                                                                 }
                                                                                             </select>
                                                                                         } else {
                                                                                             <span class="nwb-static">@KindLabel(d.EventKind)</span>
                                                                                         }
                                                                                     </span>
                                                                                     <span class="nwb-cell">
                                                                                         <span class="nwb-k">Trigger</span>
                                                                                         <select class="nwb-field" aria-label="Trigger" @bind="d.Trigger"
                                                                                                 @bind:after="RefreshPreview">
                                                                                             @foreach (var t in TriggersOf(d.EventKind)) {
                                                                                                 <option value="@t.Value">@t.Label</option>
                                                                                             }
                                                                                         </select>
                                                                                     </span>
                                                                                     @if (KindOf(d.EventKind)?.PlatformScoped == true) {
                                                                                         <label class="nwb-toggle">
                                                                                             <input type="checkbox" class="nwb-toggle-input" @bind="d.Android"
                                                                                                    @bind:after="RefreshPreview"/>
                                                                                             <PlatformIcon Platform="android"/>
                                                                                             <span class="nwb-toggle-text">Android</span>
                                                                                         </label>
                                                                                         <label class="nwb-toggle">
                                                                                             <input type="checkbox" class="nwb-toggle-input" @bind="d.Ios"
                                                                                                    @bind:after="RefreshPreview"/>
                                                                                             <PlatformIcon Platform="ios"/>
                                                                                             <span class="nwb-toggle-text">iOS</span>
                                                                                         </label>
                                                                                     }
                                                                                     @if (row is not null) {
                                                                                         <label class="nwb-toggle">
                                                                                             <input type="checkbox" class="nwb-toggle-input" @bind="d.Active"/>
                                                                                             <span class="nwb-toggle-text">Active</span>
                                                                                         </label>
                                                                                     }
                                                                                 </div>
                                                                                 @if (FiltersOf(d.EventKind).Count > 0) {
                                                                                     <div class="nwb-row">
                                                                                         <span class="nwb-k">Filters</span>
                                                                                         @foreach (var f in FiltersOf(d.EventKind)) {
                                                                                             <label class="nwb-toggle">
                                                                                                 <input type="checkbox" class="nwb-toggle-input"
                                                                                                        disabled="@(!FiltersApply(d))"
                                                                                                        checked="@d.Filters.Contains(f.Key)"
                                                                                                        @onchange="@(e => ToggleFilter(d, f.Key, e))"/>
                                                                                                 <span class="nwb-toggle-text">@f.Label</span>
                                                                                             </label>
                                                                                         }
                                                                                     </div>
                                                                                 }
                                                                             </div>
                                                                             <TemplateEditor Label="Message" Hint="Leave empty to use defaults"
                                                                                             Value="@d.MessageTemplate"
                                                                                             ValueChanged="@(v => OnTemplateChanged(d, v))"
                                                                                             Tokens="@VarsOf(d.EventKind)" Rows="4"/>
                                                                             @Preview()
                                                                             @if (row is not null) {
                                                                                 @Activity(row.Id, d.EventKind)
                                                                             }
                                                                         </text>;

    RenderFragment Preview() => @<div class="nwb-preview">
                                    <div class="nwb-preview-head">
                                        <span class="nwb-k">Preview</span>
                                        <button type="button" class="@(_json ? "nwb-view on" : "nwb-view")"
                                                aria-pressed="@(_json ? "true" : "false")" @onclick="@(() => _json = !_json)">
                                            JSON
                                        </button>
                                    </div>
                                    <div class="nwb-preview-body">
                                        <WorkbenchLoad T="PreviewRow" Items="_preview" Class="nwb-empty"
                                                       EmptyText="No sample event for this kind.">
                                            @if (PreviewBody() is { Length: > 0 } body) {
                                                @if (_json) {
                                                    <CodeSurface Text="@Pretty(body)" Language="json" ShowToolbar="false" MaxHeight="18rem"/>
                                                } else {
                                                    <DiscordEmbedPreview Payload="@body"/>
                                                }
                                            } else {
                                                <div class="nwb-empty">Nothing would be sent with these settings.</div>
                                            }
                                        </WorkbenchLoad>
                                    </div>
                                </div>;

    RenderFragment Activity(int id, string? kind) => @<div class="nwb-preview">
                                                         <div class="nwb-preview-head">
                                                             <span class="nwb-k">Activity</span>
                                                             <button type="button"
                                                                     class="@(_activityOpen.Contains(id) ? "nwb-view on" : "nwb-view")"
                                                                     aria-expanded="@(_activityOpen.Contains(id) ? "true" : "false")"
                                                                     @onclick="@(() => ToggleActivity(id))">
                                                                 @(_activityOpen.Contains(id) ? "Hide" : "History")
                                                             </button>
                                                         </div>
                                                         @if (_activityOpen.Contains(id)) {
                                                             <div class="nwb-preview-body">
                                                                 @if (ActivityRows(id) is not { } rows) {
                                                                     <div class="nwb-empty">Loading...</div>
                                                                 } else if (rows.Count == 0) {
                                                                     <div class="nwb-empty">
                                                                         Nothing delivered or suppressed yet. The event this watches has not fired since
                                                                         the subscription was created.
                                                                     </div>
                                                                 } else {
                                                                     <div class="overflow-x-auto">
                                                                         <table class="data-table">
                                                                             <thead>
                                                                             <tr>
                                                                                 <th>When</th><th>Outcome</th><th>Event</th><th>Detail</th>
                                                                             </tr>
                                                                             </thead>
                                                                             <tbody>
                                                                             @foreach (var r in rows) {
                                                                                 <tr>
                                                                                     <td class="text-muted text-xs whitespace-nowrap">
                                                                                         @r.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                                                                     </td>
                                                                                     <td class="text-xs">@Outcome(r)</td>
                                                                                     <td class="text-xs">@r.Event</td>
                                                                                     <td class="text-muted text-xs">@Detail(kind, r)</td>
                                                                                 </tr>
                                                                             }
                                                                             </tbody>
                                                                         </table>
                                                                     </div>
                                                                 }
                                                             </div>
                                                         }
                                                     </div>;

    RenderFragment AdminDetail() => @<text>
                                         @if (AdminCurrent is { } row) {
                                             <div class="nwb-surface">
                                                 <div class="nwb-row">
                                                     <span class="nwb-k">Owner</span>
                                                     <span class="nwb-static">@row.OwnerUsername</span>
                                                 </div>
                                                 <div class="nwb-row">
                                                     <span class="nwb-k">Target</span>
                                                     <span class="nwb-static font-mono">@row.TargetMasked</span>
                                                 </div>
                                                 <div class="nwb-row">
                                                     <span class="nwb-cell">
                                                         <span class="nwb-k">Event</span>
                                                         <span class="nwb-static">@KindLabel(row.EventKind)</span>
                                                     </span>
                                                     <span class="nwb-cell">
                                                         <span class="nwb-k">Trigger</span>
                                                         <span class="nwb-static">@TriggerLabel(row.EventKind, row.Trigger)</span>
                                                     </span>
                                                 </div>
                                                 <div class="nwb-row">
                                                     <span class="nwb-cell">
                                                         <span class="nwb-k">Platforms</span>
                                                         <span class="nwb-static">@AdminList(row.Platforms)</span>
                                                     </span>
                                                     <span class="nwb-cell">
                                                         <span class="nwb-k">Filters</span>
                                                         <span class="nwb-static">@AdminList(row.Filters)</span>
                                                     </span>
                                                 </div>
                                                 <div class="nwb-row">
                                                     <span class="nwb-cell">
                                                         <span class="nwb-k">Created</span>
                                                         <span class="nwb-static">@AdminStamp(row.CreatedAt)</span>
                                                     </span>
                                                     <span class="nwb-cell">
                                                         <span class="nwb-k">Last delivery</span>
                                                         <span class="nwb-static">@AdminStamp(row.LastDeliveryAt)</span>
                                                     </span>
                                                 </div>
                                                 <div class="nwb-row">
                                                     <span class="nwb-cell">
                                                         <span class="nwb-k">Failures</span>
                                                         <span class="nwb-static">@row.FailCount</span>
                                                     </span>
                                                     <span class="nwb-cell">
                                                         <span class="nwb-k">State</span>
                                                         <span class="nwb-static">@(row.Active ? "active" : "paused")</span>
                                                     </span>
                                                 </div>
                                             </div>
                                             <div class="flex gap-1 items-center">
                                                 <button type="button" class="btn-mini" disabled="@_busy"
                                                         @onclick="@(() => AdminTest(row.Id))">
                                                     @(_confirmTest ? "Confirm, send test" : "Send test")
                                                 </button>
                                                 @if (row.Active) {
                                                     <button type="button" class="btn-mini" disabled="@_busy"
                                                             @onclick="@(() => AdminDeactivate(row.Id))">
                                                         Deactivate
                                                     </button>
                                                 }
                                                 <button type="button" class="btn-mini" disabled="@_busy"
                                                         @onclick="@(() => AdminDelete(row.Id))">
                                                     @(_confirmDelete ? "Confirm delete" : "Delete")
                                                 </button>
                                             </div>
                                             @Activity(row.Id, row.EventKind)
                                         } else {
                                             <div class="text-muted text-sm">Select a notification.</div>
                                         }
                                     </text>;

    static string Pretty(string json) {
        try {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException) {
            return json;
        }
    }

    public async Task Open(int? id = null) {
        _open = true;
        if (AdminScope) {
            if (id is not null) _adminSelectedId = id;
        } else if (id is not null) {
            State.Creating = false;
            State.SelectedId = id;
        }

        await LoadAll();
        await WriteHash(true);
        StateHasChanged();
    }

    async Task CloseAsync() {
        _open = false;
        _armed = false;
        _confirmDelete = false;
        _confirmTest = false;
        await WriteHash(true, true);
    }

    void Note(string text, bool ok) {
        Toasts.Push(ok ? StatusNoteKind.Ok : StatusNoteKind.Error, text);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || AdminScope) return;
        try {
            _nav = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/hashnav.js"));
            _selfRef = DotNetObjectReference.Create(this);
            _navHandle = await _nav.InvokeAsync<IJSObjectReference>("listen", _selfRef);
            _hashWired = true;
            var hash = await _nav.InvokeAsync<string>("read");
            await ApplyHash(hash);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "hash navigation could not be wired");
        }
    }

    [JSInvokable]
    public async Task OnHashChanged(string hash) {
        await ApplyHash(hash);
        StateHasChanged();
    }

    async Task ApplyHash(string hash) {
        if (!State.ApplyHash(hash)) {
            if (_open) {
                _open = false;
                StateHasChanged();
            }

            return;
        }

        _open = true;
        await LoadAll();
        StateHasChanged();
    }

    async Task WriteHash(bool push = false, bool clear = false) {
        if (!_hashWired || _nav is null) return;
        var hash = clear ? "" : State.Hash() ?? "";
        try {
            await _nav.InvokeVoidAsync(push ? "push" : "write", hash);
        }
        catch (JSDisconnectedException ex) {
            Logger.LogDebug(ex, "hash write skipped, the circuit is already gone");
        }
    }

    async Task LoadAll() {
        if (_kinds.Count == 0) await LoadKinds();
        if (AdminScope) {
            await LoadAdmin();
            return;
        }

        if (User.IsAuthenticated && _rows is null) await LoadRows();
        if (!State.Creating && Current is null && _rows is { Count: > 0 }) {
            State.Creating = true;
            State.SelectedId = null;
        }

        if (Current is { } row) Seed(row);
        await LoadPreview();
    }

    async Task LoadKinds() {
        _kinds = await Client().ListAsync<KindInfo>("/api/protos/feed/kinds", Logger);
        if (AdminScope) return;
        if (_kinds.Count > 0 && State.NewDraft.Filters.Count == 0) ApplyKindDefaults(State.NewDraft);
    }

    async Task LoadAdmin() {
        try {
            var res = await Client().GetAsync("/api/admin/feed/subscriptions");
            if (res.IsSuccessStatusCode) {
                _admin = await res.Content.ReadFromJsonAsync<AdminFeedListResponse>(SelfCallJson.Web) ?? EmptyAdmin;
            } else {
                Note($"Load failed ({(int)res.StatusCode}).", false);
                _admin ??= EmptyAdmin;
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "loading the admin notification list failed");
            Note("Load failed.", false);
            _admin ??= EmptyAdmin;
        }

        if (AdminCurrent is null) {
            _adminSelectedId = null;
            _confirmDelete = false;
            _confirmTest = false;
        }
    }

    async Task LoadRows() {
        _rows = await Client().ListAsync<NotificationRow>("/api/protos/feed/mine", Logger);
    }

    void Seed(NotificationRow row) {
        if (State.Edits.ContainsKey(row.Id)) return;
        var d = State.Draft(row.Id);
        d.EventKind = row.EventKind;
        d.Trigger = row.Trigger;
        d.Android = row.Platforms.Contains("android");
        d.Ios = row.Platforms.Contains("ios");
        d.Active = row.Active;
        d.MessageTemplate = row.MessageTemplate ?? "";
        d.Filters = [.. row.Filters];
    }

    async Task LoadPreview() {
        var seq = ++_previewSeq;
        var d = State.Active();
        _preview = null;
        List<PreviewRow> rows;
        try {
            var body = new {
                eventKind = d.EventKind, trigger = d.Trigger, platforms = PlatformsOf(d),
                filters = d.Filters.ToArray(),
                messageTemplate = string.IsNullOrWhiteSpace(d.MessageTemplate) ? null : d.MessageTemplate
            };
            var res = await Client().PostAsJsonAsync("/api/protos/feed/preview", body, SelfCallJson.Web);
            rows = res.IsSuccessStatusCode
                ? await res.Content.ReadFromJsonAsync<List<PreviewRow>>(SelfCallJson.Web) ?? []
                : [];
        }
        catch (Exception ex) {
            Logger.LogDebug(ex, "preview load failed");
            rows = [];
        }

        if (seq != _previewSeq) return;
        _preview = rows;
    }

    Task RefreshPreview() {
        _armed = false;
        return LoadPreview();
    }

    List<FeedActivityRow>? ActivityRows(int id) {
        return _activity.GetValueOrDefault(id);
    }

    void ResetActivity() {
        _activityOpen.Clear();
        _activity.Clear();
    }

    static string Outcome(FeedActivityRow r) => r.Status switch {
        "sent" => "delivered",
        "failed" => "webhook rejected",
        "blocked" => "suppressed by filter",
        _ => r.Status
    };

    string Detail(string? kind, FeedActivityRow r) {
        if (r.Reason is { Length: > 0 } reason) return FilterLabels(kind, reason);
        if (r.ResponseCode is { } code) return $"HTTP {code}";
        return r.Status == "failed" ? "no response from Discord" : "";
    }

    string FilterLabels(string? kind, string reason) {
        var opts = FiltersOf(kind);
        return string.Join(", ", reason
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(k => opts.FirstOrDefault(f => f.Key == k)?.Label ?? k));
    }

    async Task ToggleActivity(int id) {
        if (!_activityOpen.Add(id)) {
            _activityOpen.Remove(id);
            return;
        }

        await LoadActivity(id);
    }

    async Task LoadActivity(int id) {
        _activity.Remove(id);
        StateHasChanged();
        var url = AdminScope
            ? $"/api/protos/feed/admin/{id}/activity"
            : $"/api/protos/feed/{id}/activity";
        try {
            var res = await Client().GetAsync(url);
            _activity[id] = res.IsSuccessStatusCode
                ? await res.Content.ReadFromJsonAsync<List<FeedActivityRow>>(SelfCallJson.Web) ?? []
                : [];
            if (!res.IsSuccessStatusCode) Note($"Activity load failed ({(int)res.StatusCode}).", false);
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "loading activity for notification {NotificationId} failed", id);
            _activity[id] = [];
            Note("Activity load failed.", false);
        }
    }

    void OnRailFilter(string value) {
        State.RailFilter = value;
    }

    async Task OnTemplateChanged(NotificationDraft d, string value) {
        d.MessageTemplate = value;
        _debounce?.Cancel();
        _debounce?.Dispose();
        var cts = new CancellationTokenSource();
        _debounce = cts;
        StateHasChanged();
        try {
            await Task.Delay(PreviewDebounceMs, cts.Token);
        }
        catch (OperationCanceledException) {
            return;
        }

        if (cts.IsCancellationRequested) return;
        await LoadPreview();
        StateHasChanged();
    }

    async Task SelectNew() {
        State.Creating = true;
        State.SelectedId = null;
        _armed = false;
        ResetActivity();
        await LoadPreview();
        await WriteHash();
    }

    async Task Select(NotificationRow row) {
        State.Creating = false;
        State.SelectedId = row.Id;
        _armed = false;
        ResetActivity();
        State.Edits.Remove(row.Id);
        Seed(row);
        await LoadPreview();
        await WriteHash();
    }

    Task ToggleFilter(NotificationDraft d, string key, ChangeEventArgs e) {
        if (e.Value is true) {
            d.Filters.Add(key);
        } else {
            d.Filters.Remove(key);
        }

        return RefreshPreview();
    }

    void ApplyKindDefaults(NotificationDraft d) {
        d.Trigger = KindOf(d.EventKind)?.DefaultTrigger ?? "version_up";
        d.Filters = [.. FiltersOf(d.EventKind).Where(f => f.DefaultOn).Select(f => f.Key)];
    }

    Task OnKindChanged(NotificationDraft d) {
        ApplyKindDefaults(d);
        return RefreshPreview();
    }

    string[] PlatformsOf(NotificationDraft d) {
        var list = new List<string>();
        if (d.Android) list.Add("android");
        if (d.Ios) list.Add("ios");
        return list.ToArray();
    }

    async Task Create() {
        _busy = true;
        try {
            var d = State.NewDraft;
            var body = new {
                webhookUrl = d.Url, eventKind = d.EventKind, platforms = PlatformsOf(d),
                trigger = d.Trigger, label = (string?)null,
                filters = d.Filters.ToArray(),
                messageTemplate = string.IsNullOrWhiteSpace(d.MessageTemplate) ? null : d.MessageTemplate
            };
            var res = await Client().PostAsJsonAsync("/api/protos/feed", body, SelfCallJson.Web);
            if (res.IsSuccessStatusCode) {
                State.ResetNew();
                ApplyKindDefaults(State.NewDraft);
                await LoadRows();
                if (_rows is { Count: > 0 }) await Select(_rows[0]);
            } else {
                var err = await res.Content.ReadFromJsonAsync<FeedErrorBody>(SelfCallJson.Web);
                Note(err?.Error ?? $"Create failed ({(int)res.StatusCode}).", false);
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "creating the notification failed");
            Note("Create failed.", false);
        }

        _busy = false;
    }

    async Task Save(int id) {
        _busy = true;
        try {
            var d = State.Draft(id);
            var body = new {
                platforms = PlatformsOf(d), trigger = d.Trigger, active = d.Active,
                filters = d.Filters.ToArray(),
                messageTemplate = string.IsNullOrWhiteSpace(d.MessageTemplate) ? null : d.MessageTemplate
            };
            var res = await Client().PatchAsJsonAsync($"/api/protos/feed/{id}", body, SelfCallJson.Web);
            Note(res.IsSuccessStatusCode ? "Saved." : "Save failed.", res.IsSuccessStatusCode);
            if (res.IsSuccessStatusCode) await LoadRows();
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "saving notification {NotificationId} failed", id);
            Note("Save failed.", false);
        }

        _busy = false;
    }

    async Task SendTest(int id) {
        _busy = true;
        _armed = false;
        var sample = PreviewKey() ?? "";
        try {
            var res = await Client().PostAsync($"/api/protos/feed/{id}/test?sample={Uri.EscapeDataString(sample)}", null);
            Note(res.IsSuccessStatusCode ? "Sent to the webhook." : "The webhook rejected it.", res.IsSuccessStatusCode);
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "sending sample {SampleKey} failed", sample);
            Note("Send failed.", false);
        }

        _busy = false;
    }

    async Task DeleteRow(int id) {
        _busy = true;
        try {
            var res = await Client().DeleteAsync($"/api/protos/feed/{id}");
            if (res.IsSuccessStatusCode) {
                State.Edits.Remove(id);
                await LoadRows();
                await SelectNew();
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "deleting notification {NotificationId} failed", id);
        }

        _busy = false;
    }

    void OnAdminFilter(string value) {
        _adminFilter = value;
    }

    void AdminSelect(AdminFeedRow row) {
        _adminSelectedId = row.Id;
        _confirmDelete = false;
        _confirmTest = false;
        ResetActivity();
    }

    async Task AdminTest(int id) {
        if (!_confirmTest) {
            _confirmTest = true;
            _confirmDelete = false;
            return;
        }

        _confirmTest = false;
        _busy = true;
        try {
            var res = await Client().PostAsync($"/api/admin/feed/subscriptions/{id}/test", null);
            Note(res.IsSuccessStatusCode ? "Sent to the webhook." : "The webhook rejected it.", res.IsSuccessStatusCode);
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "admin test send for notification {NotificationId} failed", id);
            Note("Send failed.", false);
        }

        _busy = false;
    }

    async Task AdminDeactivate(int id) {
        _busy = true;
        _confirmDelete = false;
        _confirmTest = false;
        try {
            var res = await Client().PostAsync($"/api/admin/feed/subscriptions/{id}/deactivate", null);
            Note(res.IsSuccessStatusCode ? "Deactivated." : "Deactivate failed.", res.IsSuccessStatusCode);
            if (res.IsSuccessStatusCode) await LoadAdmin();
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "admin deactivate of notification {NotificationId} failed", id);
            Note("Deactivate failed.", false);
        }

        _busy = false;
    }

    async Task AdminDelete(int id) {
        if (!_confirmDelete) {
            _confirmDelete = true;
            _confirmTest = false;
            return;
        }

        _confirmDelete = false;
        _busy = true;
        try {
            var res = await Client().DeleteAsync($"/api/admin/feed/subscriptions/{id}");
            Note(res.IsSuccessStatusCode ? "Deleted." : "Delete failed.", res.IsSuccessStatusCode);
            if (res.IsSuccessStatusCode) {
                _adminSelectedId = null;
                ResetActivity();
                await LoadAdmin();
            }
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "admin delete of notification {NotificationId} failed", id);
            Note("Delete failed.", false);
        }

        _busy = false;
    }

    public async ValueTask DisposeAsync() {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = null;
        try {
            if (_navHandle is not null) {
                await _navHandle.InvokeVoidAsync("dispose");
                await _navHandle.DisposeAsync();
            }

            if (_nav is not null) await _nav.DisposeAsync();
        }
        catch (JSDisconnectedException) {
        }
        catch (ObjectDisposedException) {
        }

        _selfRef?.Dispose();
    }

}
