@using System.Globalization
@using EggIncognito.Models.Events
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Events

@if (Item.Event is { } e) {
    <div class="evcal-pop-lead">
        @if (EventPalette.IconUrl(e.Type, e.Ultra) is { } iconUrl) {
            <FallbackImg Class="evcal-pop-icon" Src="@iconUrl" Alt=""/>
        }
        <span class="evcal-pop-big">@EventMagnitude.Describe(e)</span>
        <span>@EggIcons.Pretty(e.Type)</span>
        @if (e.Ultra) {
            <span class="evcal-pop-ultra">ULTRA</span>
        }
    </div>
    <span class="evcal-pop-when">@Countdown</span>
    <span class="evcal-pop-line">@Absolute(Item.Start) to @Absolute(Item.End)</span>
} else if (Item.Prediction is { } p) {
    <div class="evcal-pop-lead">
        @if (EventPalette.IconUrl(p.Type, p.Ultra) is { } iconUrl) {
            <FallbackImg Class="evcal-pop-icon" Src="@iconUrl" Alt=""/>
        }
        <span class="evcal-pop-big">@Percent(p.Confidence)</span>
    </div>
    <span class="evcal-pop-when">@Absolute(p.PredictedStart) to @Absolute(p.PredictedEnd)</span>
    @if (p.Magnitudes.Count > 1) {
        <div class="evcal-pop-choices">
            @foreach (var odds in p.Magnitudes) {
                <span class="evcal-pop-choice" @key="odds.Multiplier">
                    <span>@EventMagnitude.Describe(odds.Multiplier)</span>
                    <span class="evcal-choice-pct" style="@PctStyle(odds.Probability)">@Percent(odds.Probability)</span>
                </span>
            }
        </div>
    }
    @if (Choices(p) is { Count: > 1 } popChoices) {
        <div class="evcal-pop-choices">
            @foreach (var candidate in popChoices) {
                <span class="evcal-pop-choice" @key="candidate.Type">
                    <span>@ChoiceLabel(candidate)</span>
                    <span class="evcal-choice-pct" style="@PctStyle(candidate.Probability)">@Percent(candidate.Probability)</span>
                </span>
            }
        </div>
    }
}

<span class="evcal-pop-hint">Click to pin</span>

@code {
    [Parameter]
    public EventCalendarItem Item { get; set; } = null!;

    [Parameter]
    public string Countdown { get; set; } = null!;

    [Parameter]
    public Func<double, string> Absolute { get; set; } = null!;

    static string Percent(double value) {
        return (value * 100).ToString("0", CultureInfo.InvariantCulture) + "%";
    }

    static IReadOnlyList<EventCandidate> Choices(EventPrediction? p) =>
        p is { Candidates.Count: > 1 }
            ? [.. p.Candidates.Where(c => !string.IsNullOrEmpty(c.Type)).OrderByDescending(c => c.Probability)]
            : [];

    static string ChoiceLabel(EventCandidate c) => WithMagnitude(EggIcons.Pretty(c.Type), c.Magnitudes);

    static string WithMagnitude(string label, IReadOnlyList<EventMagnitudeOdds> odds) =>
        odds.Count > 0 && EventMagnitude.Describe(odds[0].Multiplier) is { Length: > 0 } scalar ? $"{label} {scalar}" : label;

    static string PctStyle(double p) => FormattableString.Invariant($"--p:{Math.Clamp(p, 0, 1):0.###};");
}
