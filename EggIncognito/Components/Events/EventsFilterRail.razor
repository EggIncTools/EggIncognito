@using EggIncognito.Components.Calendar
@using EggIncognito.Services.Assets

<WorkbenchRail>
    <WorkbenchSection Label="Tier">
        <CalendarRailRow On="ShowStandard" OnClick="@(() => OnSetTier.InvokeAsync(false))">Standard</CalendarRailRow>
        <CalendarRailRow On="ShowUltra" Ultra="true" Style="@UltraRowStyle" OnClick="@(() => OnSetTier.InvokeAsync(true))">Ultra</CalendarRailRow>
    </WorkbenchSection>
    @foreach (var (group, index) in TypeGroups.Select((g, i) => (g, i))) {
        <WorkbenchSection @key="group.Key" Label="@group.Key" Tools="@(index == 0 ? BulkTools : null)">
            @foreach (var type in group) {
                <CalendarRailRow @key="type" On="TypeSelected(type)" DimWhenOff="true" Style="@TypeRowStyle(type)"
                                 IconUrl="@EventPalette.IconUrl(type)" OnClick="@(() => OnToggleType.InvokeAsync(type))">
                    <span>@EggIcons.Pretty(type)</span>
                </CalendarRailRow>
            }
        </WorkbenchSection>
    }
</WorkbenchRail>

@code {
    [Parameter]
    public bool ShowStandard { get; set; }

    [Parameter]
    public bool ShowUltra { get; set; }

    [Parameter]
    public IEnumerable<IGrouping<string, string>> TypeGroups { get; set; } = Enumerable.Empty<IGrouping<string, string>>();

    [Parameter]
    public Func<string, bool> TypeSelected { get; set; } = _ => false;

    [Parameter]
    public EventCallback<bool> OnSetTier { get; set; }

    [Parameter]
    public EventCallback<string> OnToggleType { get; set; }

    [Parameter]
    public EventCallback OnSelectAllTypes { get; set; }

    [Parameter]
    public EventCallback OnDeselectAllTypes { get; set; }

    RenderFragment BulkTools =>
        @<span class="evwb-bulk">
            <button type="button" class="evwb-bulk-btn" @onclick="@(() => OnSelectAllTypes.InvokeAsync())">All</button>
            <button type="button" class="evwb-bulk-btn" @onclick="@(() => OnDeselectAllTypes.InvokeAsync())">None</button>
        </span>;

    static string TypeRowStyle(string type) {
        return FormattableString.Invariant($"--evt-color:{EventPalette.ColorFor(type)};");
    }

    static string UltraRowStyle => FormattableString.Invariant(
        $"--evt-from:{EventPalette.CcGradientFrom};--evt-to:{EventPalette.CcGradientTo};");
}
