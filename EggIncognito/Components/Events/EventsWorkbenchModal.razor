@inherits SelfCallComponentBase
@using System.Globalization
@using System.Text.Json
@using EggIncognito.Components.Calendar
@using EggIncognito.Models.Calendar
@using EggIncognito.Models.Events
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Events
@inject EventsWorkbenchState State
@inject ILogger<EventsWorkbenchModal> Logger

<CalendarWorkbench TItem="EventCalendarItem" @ref="_cal" Title="Events" TitleId="eventsWorkbenchTitle" State="State"
                   Load="LoadRange" Items="Items" DetailTitle="PopTitle" Filtering="Filtering"
                   CardClass="evwb-card" AnchorStyle="AnchorStyle" OnWindowChanged="EnsurePredictions"
                   ShowPredictions="_showPredictions" OnTogglePredictions="TogglePredictions">
    <Rail>
        <EventsFilterRail ShowStandard="_showStandard" ShowUltra="_showUltra"
                          TypeGroups="TypeGroups" TypeSelected="TypeSelected" OnSetTier="SetTier" OnToggleType="ToggleType"
                          OnSelectAllTypes="SelectAllTypes" OnDeselectAllTypes="DeselectAllTypes"/>
    </Rail>
    <Bar>
        <EventsCalendarBar Bar="context" Css="@BarCss(context)" Style="@BarStyle(context)" OnSelect="@(() => _cal?.Select(context))"/>
    </Bar>
    <Detail>
        <EventsCalendarDetail Item="context" Countdown="@Countdown(context)" Absolute="Absolute"/>
    </Detail>
</CalendarWorkbench>

@code {
    const int FetchLimit = 1000;
    const double OverlapLookbackSeconds = 7 * 24 * 60 * 60;
    const double UncertainConfidence = 0.5;
    const int MinPredictionHorizonDays = 7;
    const int MaxPredictionHorizonDays = 90;

    readonly Dictionary<string, GameEventDto> _events = new(StringComparer.Ordinal);

    CalendarWorkbench<EventCalendarItem>? _cal;
    CalendarCoverage _covered;
    HashSet<string>? _typeFilter;
    bool _showStandard = true;
    bool _showUltra = true;
    bool _showPredictions = true;
    DateTimeOffset _horizonEnd;
    EventPredictionSet? _predictions;

    public Task Open() {
        _covered = default;
        _predictions = null;
        _horizonEnd = default;
        return _cal?.Open() ?? Task.CompletedTask;
    }

    bool Filtering => _typeFilter is not null || !_showStandard || !_showUltra;

    IEnumerable<string> TypesPresent =>
        _events.Values
            .Select(e => e.Type)
            .Concat(EventPalette.KnownTypes)
            .Where(t => !string.IsNullOrEmpty(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.Ordinal);

    IEnumerable<IGrouping<string, string>> TypeGroups =>
        TypesPresent
            .GroupBy(EventPalette.GroupOf, StringComparer.Ordinal)
            .OrderBy(g => Array.IndexOf(EventPalette.Groups, g.Key));

    bool Match(GameEventDto e) {
        if (e.Ultra ? !_showUltra : !_showStandard) return false;
        return _typeFilter is null || _typeFilter.Contains(e.Type);
    }

    bool GhostVisible(EventPrediction p) {
        if (p.Ultra ? !_showUltra : !_showStandard) return false;
        if (_typeFilter is null) return true;
        return p.Type is { Length: > 0 } known && _typeFilter.Contains(known);
    }

    bool TypeSelected(string type) {
        return _typeFilter is null || _typeFilter.Contains(type);
    }

    void ToggleType(string type) {
        var set = _typeFilter is null
            ? new HashSet<string>(TypesPresent, StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(_typeFilter, StringComparer.OrdinalIgnoreCase);
        if (TypeSelected(type)) set.Remove(type);
        else set.Add(type);
        _typeFilter = set;
        _cal?.ApplyFilters();
    }

    void SetTier(bool ultra) {
        if (ultra) _showUltra = !_showUltra;
        else _showStandard = !_showStandard;
        _cal?.ApplyFilters();
    }

    void SelectAllTypes() {
        _typeFilter = null;
        _cal?.ApplyFilters();
    }

    void DeselectAllTypes() {
        _typeFilter = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _cal?.ApplyFilters();
    }

    async Task TogglePredictions() {
        _showPredictions = !_showPredictions;
        if (_showPredictions && _cal is not null) await EnsurePredictions(_cal.VisibleStart, _cal.VisibleEnd);
        _cal?.ApplyFilters();
    }

    IReadOnlyList<EventCalendarItem> Items() {
        var items = new List<EventCalendarItem>(_events.Count);
        items.AddRange(_events.Values.Where(Match).Select(EventCalendarItem.Of));
        if (_showPredictions && _predictions?.Predictions is { } predictions) {
            items.AddRange(predictions.Where(GhostVisible).Select(EventCalendarItem.Of));
        }

        return items;
    }

    async Task<CalendarLoad> LoadRange(CalendarRange range) {
        if (_covered.Covers(range.Start, range.End)) return CalendarLoad.Ok;
        var url = FormattableString.Invariant(
            $"/api/v1/events?after={range.Start - OverlapLookbackSeconds:0}&before={range.End:0}&limit={FetchLimit}");
        try {
            var res = await Client().GetAsync(url);
            if ((int)res.StatusCode == 503) return CalendarLoad.Failed("Event history needs a database. This instance has none.");
            if (!res.IsSuccessStatusCode) return CalendarLoad.Failed("Events could not be loaded.");
            var body = await res.Content.ReadFromJsonAsync<GameEventListResponse>(JsonPresets.Web);
            if (body is null) return CalendarLoad.Failed("Events could not be loaded.");
            foreach (var e in body.Events) _events[EventCalendarItem.Of(e).Key] = e;
            if (body.Total <= body.Events.Count) {
                _covered = _covered.Extend(range.Start, range.End);
                return CalendarLoad.Ok;
            }

            return new CalendarLoad("Showing the newest 1000 events in this range.", false);
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the event calendar window could not be loaded");
            return CalendarLoad.Failed("Events could not be loaded.");
        }
    }

    async Task EnsurePredictions(DateTimeOffset visibleStart, DateTimeOffset visibleEnd) {
        if (!_showPredictions) return;
        if (visibleEnd <= DateTimeOffset.UtcNow) return;
        var reach = visibleEnd + (visibleEnd - visibleStart);
        var horizon = Math.Clamp((int)Math.Ceiling((reach - DateTimeOffset.UtcNow).TotalDays),
            MinPredictionHorizonDays, MaxPredictionHorizonDays);
        var horizonEnd = DateTimeOffset.UtcNow.AddDays(horizon);
        if (_predictions is not null && horizonEnd <= _horizonEnd) return;
        try {
            var res = await Client().GetAsync(FormattableString.Invariant($"/api/v1/events/predictions?horizon={horizon}"));
            if (!res.IsSuccessStatusCode) return;
            _predictions = await res.Content.ReadFromJsonAsync<EventPredictionSet>(JsonPresets.Web);
            _horizonEnd = horizonEnd;
        } catch (Exception ex) {
            Logger.LogDebug(ex, "event predictions could not be loaded");
        }
    }

    string BarCss(CalendarBar<EventCalendarItem> bar) {
        var css = CalendarWorkbench<EventCalendarItem>.BarCss(bar);
        if (bar.Item.Prediction is { } p) {
            css += " evcal-bar-ghost";
            if (p.Confidence < UncertainConfidence) css += " evcal-bar-uncertain";
        }

        return css;
    }

    string BarStyle(CalendarBar<EventCalendarItem> bar) {
        return (_cal?.BarStyle(bar) ?? "") + EventPalette.BarStyle(bar.Item.Type, bar.Item.Ultra);
    }

    static string AnchorStyle(EventCalendarItem item) {
        return EventPalette.BarStyle(item.Type, item.Ultra);
    }

    string Absolute(double unixSeconds) {
        return _cal?.Absolute(unixSeconds) ?? "";
    }

    static string Countdown(EventCalendarItem item) {
        return EventCountdown.Describe(item.Start, item.End, DateTimeOffset.UtcNow);
    }

    static string Label(EventCalendarItem item) {
        if (item.Prediction is { } p) {
            if (p.Type is not { Length: > 0 } type) return p.Ultra ? "Ultra event" : "Standard event";
            var pretty = WithMagnitude(EggIcons.Pretty(type), p.Magnitudes);
            return p.Kind is EventRuleKind.Pool or EventRuleKind.Ultra && p.Confidence < UncertainConfidence ? pretty + "?" : pretty;
        }

        if (item.Event is not { } e) return "";
        return string.IsNullOrWhiteSpace(e.Message) ? EggIcons.Pretty(e.Type) : e.Message;
    }

    static string PopTitle(EventCalendarItem item) {
        if (item.Prediction is { } p) {
            var type = p.Type is { Length: > 0 } t ? EggIcons.Pretty(t) : p.Ultra ? "Ultra event" : "Standard event";
            return type + " (predicted)";
        }

        return Label(item);
    }

    static string WithMagnitude(string label, IReadOnlyList<EventMagnitudeOdds> odds) =>
        odds.Count > 0 && EventMagnitude.Describe(odds[0].Multiplier) is { Length: > 0 } scalar ? $"{label} {scalar}" : label;
}
