@inherits SelfCallComponentBase
@using System.Globalization
@using System.Text.Json
@using EggIncognito.Components.Calendar
@using EggIncognito.Models.Calendar
@using EggIncognito.Models.Events
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Events
@inject ICurrentUser User
@inject EventsWorkbenchState State
@inject ILogger<EventsWorkbenchModal> Logger

<CalendarWorkbench TItem="EventCalendarItem" @ref="_cal" Title="Events" TitleId="eventsWorkbenchTitle" State="State"
                   Load="LoadRange" Items="Items" DetailTitle="PopTitle" Filtering="Filtering"
                   OnWindowChanged="OnWindowChanged">
    <Rail>
        <WorkbenchRail>
            <WorkbenchSection Label="Tier">
                <CalendarRailRow On="_showStandard" OnClick="@(() => SetTier(false))">Standard</CalendarRailRow>
                <CalendarRailRow On="_showUltra" Ultra="true" Style="@UltraRowStyle" OnClick="@(() => SetTier(true))">Ultra</CalendarRailRow>
            </WorkbenchSection>
            <WorkbenchSection Label="Types">
                <Tools>
                    <button type="button" class="btn-mini" @onclick="SelectAllTypes">Select all</button>
                    <button type="button" class="btn-mini" @onclick="DeselectAllTypes">Deselect all</button>
                </Tools>
                <ChildContent>
                    @foreach (var type in TypesPresent) {
                        <CalendarRailRow @key="type" On="TypeSelected(type)" DimWhenOff="true" Style="@TypeRowStyle(type)"
                                         IconUrl="@EventPalette.IconUrl(type)" OnClick="@(() => ToggleType(type))">
                            <span>@Pretty(type)</span>
                        </CalendarRailRow>
                    }
                </ChildContent>
            </WorkbenchSection>
            @if (_isAdmin) {
                <WorkbenchSection Label="Predictions">
                    <CalendarRailRow On="_showPredictions" OnClick="TogglePredictions">Show predictions</CalendarRailRow>
                </WorkbenchSection>
            }
        </WorkbenchRail>
    </Rail>
    <Bar>
        <button type="button" class="@BarCss(context)" style="@BarStyle(context)" @onclick="@(() => Select(context.Item))">
            @if (EventPalette.IconUrl(context.Item.Type, context.Item.Ultra) is { } iconUrl) {
                <img class="evcal-bar-icon" src="@iconUrl" alt="" loading="lazy" data-fallback/>
            }
            <span class="evcal-bar-label">@Label(context.Item)</span>
        </button>
    </Bar>
    <Detail>
        @if (context.Event is { } e) {
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Type</span>
                <span class="evcal-pop-v">@e.Type</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Multiplier</span>
                <span class="evcal-pop-v">@EventMagnitude.Describe(e)</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Ultra</span>
                <span class="evcal-pop-v">@(e.Ultra ? "yes" : "no")</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Timing</span>
                <span class="evcal-pop-v">@Countdown(context)</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Source</span>
                <span class="evcal-pop-v">@e.Source</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Start</span>
                <span class="evcal-pop-v">@Absolute(context.Start)</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">End</span>
                <span class="evcal-pop-v">@Absolute(context.End)</span>
            </div>
        } else if (context.Prediction is { } p) {
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Rule</span>
                <span class="evcal-pop-v">@KindLabel(p.Kind)</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Evidence</span>
                <span class="evcal-pop-v">@p.Evidence</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Confidence</span>
                <span class="evcal-pop-v">@Percent(p.Confidence)</span>
            </div>
            @foreach (var candidate in p.Candidates.Take(5)) {
                <div class="evcal-pop-row" @key="candidate.Type">
                    <span class="evcal-pop-k">Candidate</span>
                    <span class="evcal-pop-v">@Pretty(candidate.Type) @Percent(candidate.Probability)</span>
                </div>
            }

            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Last occurrence</span>
                <span class="evcal-pop-v">@Absolute(p.LastStart)</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Predicted start</span>
                <span class="evcal-pop-v">@Absolute(p.PredictedStart)</span>
            </div>
            <div class="evcal-pop-row">
                <span class="evcal-pop-k">Predicted end</span>
                <span class="evcal-pop-v">@Absolute(p.PredictedEnd)</span>
            </div>
        }
    </Detail>
</CalendarWorkbench>

@code {
    const int FetchLimit = 1000;
    const double OverlapLookbackSeconds = 7 * 24 * 60 * 60;
    const double UncertainConfidence = 0.5;
    const int MinPredictionHorizonDays = 7;
    const int MaxPredictionHorizonDays = 90;

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    readonly Dictionary<string, GameEventDto> _events = new(StringComparer.Ordinal);

    CalendarWorkbench<EventCalendarItem>? _cal;
    CalendarCoverage _covered;
    HashSet<string>? _typeFilter;
    bool _showStandard = true;
    bool _showUltra = true;
    bool _showPredictions = true;
    bool _isAdmin;
    DateTimeOffset _horizonEnd;
    EventPredictionSet? _predictions;

    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.Current.IsAtLeast(UserRole.Admin);
    }

    public Task Open() {
        _covered = default;
        _predictions = null;
        _horizonEnd = default;
        return _cal?.Open() ?? Task.CompletedTask;
    }

    bool Filtering => _typeFilter is not null || !_showStandard || !_showUltra;

    IEnumerable<string> TypesPresent =>
        _events.Values
            .Select(e => e.Type)
            .Where(t => !string.IsNullOrEmpty(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.Ordinal);

    bool Match(GameEventDto e) {
        if (e.Ultra ? !_showUltra : !_showStandard) return false;
        return _typeFilter is null || _typeFilter.Contains(e.Type);
    }

    bool GhostVisible(EventPrediction p) {
        if (p.Ultra ? !_showUltra : !_showStandard) return false;
        if (_typeFilter is null) return true;
        return p.Type is { Length: > 0 } known && _typeFilter.Contains(known);
    }

    bool TypeSelected(string type) {
        return _typeFilter is null || _typeFilter.Contains(type);
    }

    void ToggleType(string type) {
        var set = _typeFilter is null
            ? new HashSet<string>(TypesPresent, StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(_typeFilter, StringComparer.OrdinalIgnoreCase);
        if (TypeSelected(type)) set.Remove(type);
        else set.Add(type);
        _typeFilter = set;
        _cal?.ApplyFilters();
    }

    void SetTier(bool ultra) {
        if (ultra) _showUltra = !_showUltra;
        else _showStandard = !_showStandard;
        _cal?.ApplyFilters();
    }

    void SelectAllTypes() {
        _typeFilter = null;
        _cal?.ApplyFilters();
    }

    void DeselectAllTypes() {
        _typeFilter = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _cal?.ApplyFilters();
    }

    async Task TogglePredictions() {
        _showPredictions = !_showPredictions;
        if (_showPredictions && _cal is not null) await EnsurePredictions(_cal.VisibleStart, _cal.VisibleEnd);
        _cal?.ApplyFilters();
    }

    IReadOnlyList<EventCalendarItem> Items() {
        var items = new List<EventCalendarItem>(_events.Count);
        items.AddRange(_events.Values.Where(Match).Select(EventCalendarItem.Of));
        if (_isAdmin && _showPredictions && _predictions is { } set) {
            items.AddRange(set.Predictions.Where(GhostVisible).Select(EventCalendarItem.Of));
        }

        return items;
    }

    void Select(EventCalendarItem item) {
        _cal?.Select(item);
    }

    async Task<CalendarLoad> LoadRange(CalendarRange range) {
        if (_covered.Covers(range.Start, range.End)) return CalendarLoad.Ok;
        var url = FormattableString.Invariant(
            $"/api/v1/events?after={range.Start - OverlapLookbackSeconds:0}&before={range.End:0}&limit={FetchLimit}");
        try {
            var res = await Client().GetAsync(url);
            if ((int)res.StatusCode == 503) return CalendarLoad.Failed("Event history needs a database. This instance has none.");
            if (!res.IsSuccessStatusCode) return CalendarLoad.Failed("Events could not be loaded.");
            var body = await res.Content.ReadFromJsonAsync<GameEventListResponse>(JsonOpts);
            if (body is null) return CalendarLoad.Failed("Events could not be loaded.");
            foreach (var e in body.Events) _events[EventCalendarItem.Of(e).Key] = e;
            if (body.Total <= body.Events.Count) {
                _covered = _covered.Extend(range.Start, range.End);
                return CalendarLoad.Ok;
            }

            return new CalendarLoad("Showing the newest 1000 events in this range.", false);
        } catch (Exception ex) {
            Logger.LogWarning(ex, "the event calendar window could not be loaded");
            return CalendarLoad.Failed("Events could not be loaded.");
        }
    }

    Task OnWindowChanged(DateTimeOffset visibleStart, DateTimeOffset visibleEnd) {
        return EnsurePredictions(visibleStart, visibleEnd);
    }

    async Task EnsurePredictions(DateTimeOffset visibleStart, DateTimeOffset visibleEnd) {
        if (!_isAdmin || !_showPredictions) return;
        if (visibleEnd <= DateTimeOffset.UtcNow) return;
        var reach = visibleEnd + (visibleEnd - visibleStart);
        var horizon = Math.Clamp((int)Math.Ceiling((reach - DateTimeOffset.UtcNow).TotalDays),
            MinPredictionHorizonDays, MaxPredictionHorizonDays);
        var horizonEnd = DateTimeOffset.UtcNow.AddDays(horizon);
        if (_predictions is not null && horizonEnd <= _horizonEnd) return;
        try {
            var res = await Client().GetAsync(FormattableString.Invariant($"/api/v1/events/predictions?horizon={horizon}"));
            if (!res.IsSuccessStatusCode) return;
            _predictions = await res.Content.ReadFromJsonAsync<EventPredictionSet>(JsonOpts);
            _horizonEnd = horizonEnd;
        } catch (Exception ex) {
            Logger.LogDebug(ex, "event predictions could not be loaded");
        }
    }

    string BarCss(CalendarBar<EventCalendarItem> bar) {
        var css = CalendarWorkbench<EventCalendarItem>.BarCss(bar);
        if (bar.Item.Prediction is { } p) {
            css += " evcal-bar-ghost";
            if (p.Confidence < UncertainConfidence) css += " evcal-bar-uncertain";
        }

        return css;
    }

    string BarStyle(CalendarBar<EventCalendarItem> bar) {
        return (_cal?.BarStyle(bar) ?? "") + EventPalette.BarStyle(bar.Item.Type, bar.Item.Ultra);
    }

    string Absolute(double unixSeconds) {
        return _cal?.Absolute(unixSeconds) ?? "";
    }

    static string TypeRowStyle(string type) {
        return FormattableString.Invariant($"--evt-color:{EventPalette.ColorFor(type)};");
    }

    static string UltraRowStyle => FormattableString.Invariant(
        $"--evt-from:{EventPalette.CcGradientFrom};--evt-to:{EventPalette.CcGradientTo};");

    static string Countdown(EventCalendarItem item) {
        return EventCountdown.Describe(item.Start, item.End, DateTimeOffset.UtcNow);
    }

    static string Label(EventCalendarItem item) {
        if (item.Prediction is { } p) {
            if (p.Type is not { Length: > 0 } type) return p.Ultra ? "Ultra event" : "Standard event";
            var pretty = Pretty(type);
            return p.Kind is EventRuleKind.Pool or EventRuleKind.Ultra && p.Confidence < UncertainConfidence ? pretty + "?" : pretty;
        }

        if (item.Event is not { } e) return "";
        return string.IsNullOrWhiteSpace(e.Message) ? Pretty(e.Type) : e.Message;
    }

    static string PopTitle(EventCalendarItem item) {
        if (item.Prediction is { } p) {
            var type = p.Type is { Length: > 0 } t ? Pretty(t) : p.Ultra ? "Ultra event" : "Standard event";
            return type + " Predicted";
        }

        return Label(item);
    }

    static string KindLabel(EventRuleKind kind) {
        return kind switch {
            EventRuleKind.WeekdayLane => "Weekday lane",
            EventRuleKind.Alternating => "Alternating lane",
            EventRuleKind.Periodic => "Periodic lane",
            EventRuleKind.Pool => "Weekday pool",
            _ => "Ultra cadence"
        };
    }

    static string Percent(double value) {
        return (value * 100).ToString("0", CultureInfo.InvariantCulture) + "%";
    }

    static string Pretty(string raw) {
        var words = raw.Replace('-', ' ').Replace('_', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..].ToLowerInvariant()));
    }

}
