    async Task RecordGif() {
        if (_recorder is null || _recording) return;
        _selfRef ??= DotNetObjectReference.Create(this);
        _recording = true;
        _recordStage = "capturing";
        _recordFraction = 0;
        StateHasChanged();
        try {
            var opts = new { fps = _gifFps, maxWidth = _gifMaxWidth, fallbackColor = "#1a1a1f" };
            await _recorder.InvokeVoidAsync("record", _selfRef, opts);
            Status("GIF downloaded.");
        }
        catch (Exception ex) {
            Fail($"record failed: {ex.Message}");
        }
        finally {
            _recording = false;
            _recordStage = "";
            StateHasChanged();
        }
    }

