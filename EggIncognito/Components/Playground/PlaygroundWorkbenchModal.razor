    IEnumerable<PresetRow> FilteredPresets() {
        var rows = string.IsNullOrWhiteSpace(_presetSearch)
            ? _presets
            : _presets.Where(p => ((p.Name ?? p.Id) ?? "").Contains(_presetSearch, StringComparison.OrdinalIgnoreCase));
        return rows.Take(60);
    }

    async Task LoadPreset(string id) {
        _presetId = id;
        await ApplyLayout(true);
    }

    async Task ApplyLayout(bool fromPreset) {
        if (_mod is null) return;
        _applyCts?.Cancel();
        var cts = new CancellationTokenSource();
        _applyCts = cts;
        var ct = cts.Token;

        _busy = true;
        Status("Building farm");
        try {
            var body = new StringContent(RequestNode(fromPreset).ToJsonString(), Encoding.UTF8, "application/json");
            var res = await Client().PostAsync("/api/farm/layout", body, ct);
            if (!res.IsSuccessStatusCode) {
                await LayoutGone($"layout failed: HTTP {(int)res.StatusCode}");
                return;
            }

            var layout = await res.Content.ReadFromJsonAsync<LayoutResult>(ct);
            if (layout is null || !layout.Ok) {
                await LayoutGone(layout?.Diagnostics ?? "the layout API returned no data");
                return;
            }

            if (ct.IsCancellationRequested) return;

            _layoutFailed = false;
            _diagnostics = layout.Diagnostics;
            _placements = layout.Placements ?? [];
            _unresolved = layout.Unresolved ?? [];
            _extents = layout.Extents;
            _binaryVersion = layout.BinaryVersion;
            RebuildSlots();
            if (fromPreset) HydrateFromLayout(layout);

            if (_mod is null) return;
            await _mod.InvokeVoidAsync("setLighting", ct, LightingPayload());
            var farm = await _mod.InvokeAsync<SetFarmResult?>("setFarm", ct, new object[] { _placements });
            _skipped = farm?.Skipped ?? [];
            if (layout.Motion is { } motion) await _mod.InvokeVoidAsync("setMotion", ct, motion);
            await _mod.InvokeVoidAsync("setPlaying", ct, _playing);
            await RefreshAnimatedFlag();
            Status($"Placed {farm?.Loaded ?? 0} of {_placements.Length} slots.");
        }
        catch (OperationCanceledException ex) {
            Logger.LogDebug(ex, "farm layout build was superseded by a newer request");
        }
        catch (Exception ex) {
            await LayoutGone(ex.Message);
        }
        finally {
            _busy = false;
            Autosave();
            StateHasChanged();
        }
    }

    async Task LayoutGone(string diagnostics) {
        _layoutFailed = true;
        _diagnostics = diagnostics;
        _placements = [];
        _slots = [];
        _unresolved = [];
        _skipped = [];
        _extents = null;
        Fail(diagnostics);
        if (_mod is null) return;
        try {
            await _mod.InvokeVoidAsync("clearFarm");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "could not clear the farm scene");
        }
    }

    JsonObject RequestNode(bool fromPreset) {
        var node = new JsonObject {
            ["platform"] = MeshPlatform,
            ["chickenCount"] = _chickenCount
        };
        if (fromPreset && !string.IsNullOrEmpty(_presetId)) {
            node["showcaseId"] = _presetId;
            return node;
        }

        node["farmConfig"] = JsonNode.Parse(ConfigJson());
        node["state"] = StateNode();
        return node;
    }

    JsonObject StateNode() {
        var habs = new JsonArray();
        for (var i = 0; i < FarmState.HabSlots; i++) habs.Add(HabTier(i));
        return new JsonObject {
            ["habs"] = habs,
            ["silosOwned"] = _state.SilosOwned,
            ["siloAssetType"] = _state.SiloAssetType,
            ["eggType"] = _state.EggType,
            ["labTier"] = _state.LabTier,
            ["depotTier"] = _state.DepotTier,
            ["hoaTier"] = _state.HoaTier,
            ["missionControlLevel"] = _state.MissionControlLevel,
            ["fuelTankTier"] = _state.FuelTankTier,
            ["hyperloopStation"] = _state.HyperloopStation,
            ["hyperloopUnderConstruction"] = _state.HyperloopUnderConstruction,
            ["artifactsEnabled"] = _state.ArtifactsEnabled,
            ["homeFarm"] = _state.HomeFarm,
            ["fuelTankUnlocked"] = _state.FuelTankUnlocked,
            ["hasUnreadMail"] = _state.HasUnreadMail
        };
    }

    string ConfigJson() {
        return JsonFormatter.Default.Format(BuildConfig());
    }

    ShellDB.Types.FarmConfiguration BuildConfig() {
        var cfg = new ShellDB.Types.FarmConfiguration();
        foreach (var pair in _shells.OrderBy(k => k.Key, StringComparer.Ordinal)) {
            if (string.IsNullOrEmpty(pair.Value)) continue;
            if (!SplitSlot(pair.Key, out var type, out var index)) continue;
            cfg.ShellConfigs.Add(new ShellDB.Types.ShellConfiguration {
                AssetType = type, Index = (uint)index, ShellIdentifier = pair.Value
            });
        }

        foreach (var element in ElementNames()) {
            var set = _setByElement.GetValueOrDefault(element);
            if (string.IsNullOrEmpty(set) && string.IsNullOrEmpty(_decoratorId)) continue;
            if (!Enum.TryParse<ShellDB.Types.FarmElement>(element, out var parsed)) continue;
            var entry = new ShellDB.Types.ShellSetConfiguration { Element = parsed, Index = 0 };
            if (!string.IsNullOrEmpty(set)) entry.ShellSetIdentifier = set;
            if (!string.IsNullOrEmpty(_decoratorId)) entry.DecoratorIdentifier = _decoratorId;
            cfg.ShellSetConfigs.Add(entry);
        }

        if (!string.IsNullOrEmpty(_chickenId)) {
            var chicken = new ShellDB.Types.ChickenConfig { ChickenIdentifier = _chickenId };
            if (!string.IsNullOrEmpty(_hatId)) chicken.HatIdentifier = _hatId;
            cfg.ChickenConfigs.Add(chicken);
        }

        cfg.LightingConfigEnabled = _lighting.Enabled;
        cfg.LightingConfig = new ShellDB.Types.LightingConfig {
            LightDir = new Vector3 { X = _lighting.DirX, Y = _lighting.DirY, Z = _lighting.DirZ },
            LightDirectColor = ColorVec(_lighting.DirectColor),
            LightDirectIntensity = _lighting.DirectIntensity,
            LightAmbientColor = ColorVec(_lighting.AmbientColor),
            LightAmbientIntensity = _lighting.AmbientIntensity,
            FogColor = ColorVec(_lighting.FogColor),
            FogNear = _lighting.FogNear,
            FogFar = _lighting.FogFar,
            FogDensity = _lighting.FogDensity
        };
        return cfg;
    }

    void HydrateFromConfig(ShellDB.Types.FarmConfiguration cfg) {
        _shells.Clear();
        foreach (var c in cfg.ShellConfigs) {
            if (string.IsNullOrEmpty(c.ShellIdentifier)) continue;
            _shells[$"{c.AssetType}:{c.Index}"] = c.ShellIdentifier;
        }

        _setByElement.Clear();
        _decoratorId = null;
        foreach (var s in cfg.ShellSetConfigs) {
            if (!string.IsNullOrEmpty(s.ShellSetIdentifier)) _setByElement[s.Element.ToString()] = s.ShellSetIdentifier;
            if (!string.IsNullOrEmpty(s.DecoratorIdentifier)) _decoratorId = s.DecoratorIdentifier;
        }

        var chicken = cfg.ChickenConfigs.FirstOrDefault();
        _chickenId = chicken is null || string.IsNullOrEmpty(chicken.ChickenIdentifier) ? null : chicken.ChickenIdentifier;
        _hatId = chicken is null || string.IsNullOrEmpty(chicken.HatIdentifier) ? null : chicken.HatIdentifier;
        _lighting.Enabled = cfg.LightingConfigEnabled;
        if (cfg.LightingConfig is { } light) {
            if (light.LightDir is { } dir) {
                _lighting.DirX = dir.X;
                _lighting.DirY = dir.Y;
                _lighting.DirZ = dir.Z;
            }

            if (light.LightDirectColor is { } dc) _lighting.DirectColor = Hex(dc.X, dc.Y, dc.Z);
            if (light.LightAmbientColor is { } ac) _lighting.AmbientColor = Hex(ac.X, ac.Y, ac.Z);
            if (light.FogColor is { } fc) _lighting.FogColor = Hex(fc.X, fc.Y, fc.Z);
            _lighting.DirectIntensity = light.LightDirectIntensity;
            _lighting.AmbientIntensity = light.LightAmbientIntensity;
            _lighting.FogNear = light.FogNear;
            _lighting.FogFar = light.FogFar;
            _lighting.FogDensity = light.FogDensity;
        }
    }

    void HydrateFromLayout(LayoutResult layout) {
        if (layout.State is { } s) {
            for (var i = 0; i < FarmState.HabSlots; i++)
                _state.Habs[i] = s.Habs is { Length: > 0 } && i < s.Habs.Length ? s.Habs[i] : FarmState.EmptyHabTier;
            _state.SilosOwned = s.SilosOwned;
            if (!string.IsNullOrEmpty(s.SiloAssetType)) _state.SiloAssetType = s.SiloAssetType;
            if (!string.IsNullOrEmpty(s.EggType)) _state.EggType = s.EggType;
            _state.LabTier = s.LabTier;
            _state.DepotTier = s.DepotTier;
            _state.HoaTier = s.HoaTier;
            _state.MissionControlLevel = s.MissionControlLevel;
            _state.FuelTankTier = s.FuelTankTier;
            _state.HyperloopStation = s.HyperloopStation;
            _state.ArtifactsEnabled = s.ArtifactsEnabled;
            _state.HomeFarm = s.HomeFarm;
            _state.FuelTankUnlocked = s.FuelTankUnlocked;
            _state.HasUnreadMail = s.HasUnreadMail;
        }

        _shells.Clear();
        _setByElement.Clear();
        foreach (var p in _placements) {
            if (p.AssetType is null || string.IsNullOrEmpty(p.ShellIdentifier)) continue;
            _shells[$"{p.AssetType}:{p.Index}"] = p.ShellIdentifier;
        }

        if (layout.Lighting is { } lighting) {
            _lighting.Enabled = lighting.Enabled;
            if (lighting.LightDir is { } dir) {
                _lighting.DirX = dir.X;
                _lighting.DirY = dir.Y;
                _lighting.DirZ = dir.Z;
            }

            if (lighting.LightDirectColor is { } dc) _lighting.DirectColor = Hex(dc.X, dc.Y, dc.Z);
            if (lighting.LightAmbientColor is { } ac) _lighting.AmbientColor = Hex(ac.X, ac.Y, ac.Z);
            if (lighting.FogColor is { } fc) _lighting.FogColor = Hex(fc.X, fc.Y, fc.Z);
            _lighting.DirectIntensity = lighting.LightDirectIntensity;
            _lighting.AmbientIntensity = lighting.LightAmbientIntensity;
            _lighting.FogNear = lighting.FogNear;
            _lighting.FogFar = lighting.FogFar;
            _lighting.FogDensity = lighting.FogDensity;
        }
    }

    void RebuildSlots() {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        var slots = new List<SlotRef>();
        foreach (var p in _placements) {
            if (p.AssetType is null || p.Element is null) continue;
            var slot = new SlotRef(p.Element, p.AssetType, p.Index);
            if (seen.Add(SlotKey(slot))) slots.Add(slot);
        }

        _slots = slots;
    }

    IEnumerable<string> ElementNames() {
        var fromSlots = _slots.Select(s => s.Element).Distinct(StringComparer.Ordinal).ToList();
        return fromSlots.Count > 0 ? fromSlots : _setByElement.Keys;
    }

    IEnumerable<string> ElementsWithSets() {
        return ElementNames().Where(e => SetIdsForElement(e).Any());
    }

    IEnumerable<SlotRef> SlotsOf(string element) {
        return _slots.Where(s => string.Equals(s.Element, element, StringComparison.Ordinal));
    }

    static string SlotKey(SlotRef slot) {
        return $"{slot.AssetType}:{slot.Index}";
    }

    string ShellOf(SlotRef slot) {
        return _shells.GetValueOrDefault(SlotKey(slot)) ?? "";
    }

    IReadOnlyList<CatalogShell> ShellsFor(string assetType) {
        foreach (var element in _catalogElements) {
            foreach (var type in element.AssetTypes ?? []) {
                if (string.Equals(type.AssetType, assetType, StringComparison.Ordinal)) return type.Shells ?? [];
            }
        }

        return [];
    }

    IEnumerable<string> SetIdsForElement(string element) {
        return SlotsOf(element)
            .SelectMany(s => ShellsFor(s.AssetType))
            .Select(s => s.SetIdentifier)
            .Where(id => !string.IsNullOrEmpty(id))
            .Select(id => id!)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(id => id, StringComparer.Ordinal);
    }

    IReadOnlyList<CatalogAssetType> AssetTypesOf(string element) {
        foreach (var e in _catalogElements) {
            if (string.Equals(e.Element, element, StringComparison.Ordinal)) return e.AssetTypes ?? [];
        }

        return [];
    }

    IReadOnlyList<TierOption> TierOptions(string element, int fallbackCount) {
        var types = AssetTypesOf(element);
        if (types.Count == 0) {
            var generated = new List<TierOption>();
            for (var i = 0; i < fallbackCount; i++) generated.Add(new TierOption(i, $"tier {i}"));
            return generated;
        }

        var options = new List<TierOption>();
        for (var i = 0; i < types.Count; i++) options.Add(new TierOption(i, types[i].AssetType));
        return options;
    }

    IReadOnlyList<string> EggOptions() {
        const string prefix = "Hatchery";
        var types = AssetTypesOf("Hatchery");
        var subPieces = types.SelectMany(t => t.SubPieces ?? []).ToHashSet(StringComparer.Ordinal);
        var options = new List<string>();
        foreach (var type in types) {
            if (subPieces.Contains(type.AssetType)) continue;
            if (!type.AssetType.StartsWith(prefix, StringComparison.Ordinal)) continue;
            var egg = type.AssetType[prefix.Length..];
            if (egg.Length == 0 || string.Equals(egg, "Custom", StringComparison.Ordinal)) continue;
            options.Add(egg);
        }

        if (options.Count == 0) options.Add("Edible");
        return options;
    }

    static IReadOnlyList<string> CameraElements() {
        var names = new List<string>();
        foreach (var e in Enum.GetValues<ShellDB.Types.FarmElement>()) {
            if (e is ShellDB.Types.FarmElement.Unknown or ShellDB.Types.FarmElement.Chicken or ShellDB.Types.FarmElement.Hat) continue;
            names.Add(e.ToString());
        }

        return names;
    }

    int HabTier(int slot) {
        return slot >= 0 && slot < _state.Habs.Length ? _state.Habs[slot] : FarmState.EmptyHabTier;
    }

    static int[] NormalizeHabs(int[]? source) {
        var habs = new int[FarmState.HabSlots];
        for (var i = 0; i < habs.Length; i++)
            habs[i] = source is not null && i < source.Length ? source[i] : FarmState.EmptyHabTier;
        return habs;
    }

    void SetHab(int slot, ChangeEventArgs e) {
        if (slot >= 0 && slot < _state.Habs.Length && int.TryParse(e.Value?.ToString(), out var tier))
            _state.Habs[slot] = tier;
        QueueApply();
    }

    void SetShell(string slotKey, ChangeEventArgs e) {
        var value = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(value)) _shells.Remove(slotKey);
        else _shells[slotKey] = value;
        QueueApply();
    }

    void SetElementSet(string element, ChangeEventArgs e) {
        var value = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(value)) {
            _setByElement.Remove(element);
            foreach (var slot in SlotsOf(element)) _shells.Remove(SlotKey(slot));
        } else {
            _setByElement[element] = value;
            foreach (var slot in SlotsOf(element)) {
                var match = ShellsFor(slot.AssetType)
                    .FirstOrDefault(s => string.Equals(s.SetIdentifier, value, StringComparison.Ordinal));
                if (match is not null) _shells[SlotKey(slot)] = match.Identifier;
            }
        }

        QueueApply();
    }

    void SetDecorator(ChangeEventArgs e) {
        var value = e.Value?.ToString() ?? "";
        _decoratorId = string.IsNullOrEmpty(value) ? null : value;
        var deco = _decorators.FirstOrDefault(d => string.Equals(d.Identifier, _decoratorId, StringComparison.Ordinal));
        var members = deco?.Members;
        if (members is not null) {
            foreach (var member in members) {
                foreach (var slot in _slots) {
                    if (string.Equals(slot.AssetType, member.AssetType, StringComparison.OrdinalIgnoreCase))
                        _shells[SlotKey(slot)] = member.Identifier;
                }
            }
        }

        QueueApply();
    }

    void SetChicken(ChangeEventArgs e) {
        var value = e.Value?.ToString() ?? "";
        _chickenId = string.IsNullOrEmpty(value) ? null : value;
        QueueApply();
    }

    void SetHat(ChangeEventArgs e) {
        var value = e.Value?.ToString() ?? "";
        _hatId = string.IsNullOrEmpty(value) ? null : value;
        QueueApply();
    }

    void QueueApply() {
        _dirty = true;
        _applyCts?.Cancel();
        var cts = new CancellationTokenSource();
        _applyCts = cts;
        _ = Task.Delay(400, cts.Token).ContinueWith(async t => {
            if (t.IsCanceled) return;
            await InvokeAsync(() => ApplyLayout(false));
        }, TaskScheduler.Default);
    }

    async Task MenuRebuild() {
        CloseMenus();
        await ApplyLayout(false);
    }

    object LightingPayload() {
        return new {
            lightDir = new[] { _lighting.DirX, _lighting.DirY, _lighting.DirZ },
            lightDirectColor = Rgb(_lighting.DirectColor),
            lightDirectIntensity = _lighting.DirectIntensity,
            lightAmbientColor = Rgb(_lighting.AmbientColor),
            lightAmbientIntensity = _lighting.AmbientIntensity,
            fogColor = Rgb(_lighting.FogColor),
            fogNear = _lighting.FogNear,
            fogFar = _lighting.FogFar,
            fogDensity = _lighting.FogDensity
        };
    }

    async Task PushLighting() {
        if (_mod is not null) await _mod.InvokeVoidAsync("setLighting", LightingPayload());
        Autosave();
    }

    async Task ApplyBackground() {
        if (_mod is not null) await _mod.InvokeVoidAsync("setBackground", _bgTransparent ? null : _bgColor);
        Autosave();
    }

    async Task FocusPlacement(string key) {
        if (_mod is not null) await _mod.InvokeVoidAsync("focusOn", key);
    }

    async Task ApplyCamera() {
        if (_mod is null) return;
        try {
            var shot = await Client().GetFromJsonAsync<CameraResult>(
                $"/api/farm/camera?element={Uri.EscapeDataString(_cameraElement)}&index={_cameraIndex}");
            if (shot is null || !shot.Ok) {
                Fail(shot?.Diagnostics ?? "camera lookup failed");
                return;
            }

            _cameraLocator = shot.Locator;
            float[] focus = shot.Focus is { } f ? [f.X, f.Y, f.Z] : [0f, 0f, 0f];
            if (_mod is not null) await _mod.InvokeVoidAsync("setCamera", focus, shot.Distance, shot.Height);
        }
        catch (Exception ex) {
            Fail(ex.Message);
        }
    }

