    IEnumerable<KeyValuePair<string, int>> OriginCounts() {
        return _placements
            .GroupBy(p => p.Provenance?.Origin ?? "unknown", StringComparer.Ordinal)
            .OrderBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()));
    }

    static string OriginChipClass(string? origin) {
        return origin switch {
            nameof(PlacementOrigin.Binary) => "text-ok",
            nameof(PlacementOrigin.Authored) => "text-err",
            _ => "text-muted"
        };
    }

    static bool SplitSlot(string key, out ShellSpec.Types.AssetType type, out int index) {
        type = ShellSpec.Types.AssetType.Unknown;
        index = 0;
        var cut = key.LastIndexOf(':');
        return cut > 0
               && Enum.TryParse(key[..cut], out type)
               && int.TryParse(key[(cut + 1)..], NumberStyles.Integer, CultureInfo.InvariantCulture, out index);
    }

    static Vector4 ColorVec(string hex) {
        var rgb = Rgb(hex);
        return new Vector4 { X = rgb[0], Y = rgb[1], Z = rgb[2], W = 1f };
    }

    static float[] Rgb(string? hex) {
        if (hex is { Length: 7 } && hex[0] == '#'
                                 && int.TryParse(hex[1..], NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var v)) {
            return [((v >> 16) & 0xFF) / 255f, ((v >> 8) & 0xFF) / 255f, (v & 0xFF) / 255f];
        }

        return [1f, 1f, 1f];
    }

    static string Hex(float r, float g, float b) {
        return $"#{Chan(r):x2}{Chan(g):x2}{Chan(b):x2}";
    }

    static int Chan(float v) {
        return Math.Clamp((int)MathF.Round(v * 255f), 0, 255);
    }

