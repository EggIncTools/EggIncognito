    protected override void OnInitialized() {
        base.OnInitialized();
        _isAdmin = User.IsAtLeast(UserRole.Admin);
    }

    public Task Open() {
        if (!_isAdmin || _open) return Task.CompletedTask;
        _open = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    async Task CloseModal() {
        if (!_open) return;
        _open = false;
        CloseMenus();
        _namePromptOpen = false;
        _gifOpen = false;
        await TeardownAsync();
        StateHasChanged();
    }

    async Task TeardownAsync() {
        _applyCts?.Cancel();
        _autosaveCts?.Cancel();
        await _gifDragHandle.DisposeModuleQuietAsync("dispose", Logger);
        await _mod.DisposeModuleQuietAsync("dispose", Logger);
        await _autosave.DisposeModuleQuietAsync(logger: Logger);
        await _recorder.DisposeModuleQuietAsync(logger: Logger);
        await _popoverDragMod.DisposeModuleQuietAsync(logger: Logger);
        _gifDragHandle = null;
        _mod = null;
        _autosave = null;
        _recorder = null;
        _popoverDragMod = null;
        _selfRef?.Dispose();
        _selfRef = null;
        _initialized = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!_open || !_isAdmin) return;
        if (!_initialized) {
            _initialized = true;
            await InitializeAsync();
            return;
        }

        if (_gifOpen && _gifDragHandle is null && _popoverDragMod is not null) {
            try {
                _gifDragHandle = await _popoverDragMod.InvokeAsync<IJSObjectReference>("makeDraggable", _gifPopoverRef, _gifPopoverHeadRef);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
                Logger.LogDebug(ex, "GIF popover drag handle could not be created");
            }
        } else if (!_gifOpen && _gifDragHandle is not null) {
            await _gifDragHandle.DisposeModuleQuietAsync("dispose", Logger);
            _gifDragHandle = null;
        }
    }

    async Task InitializeAsync() {
        try {
            _mod = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/playground.js"));
            var ready = await _mod.InvokeAsync<bool>("init", _canvas);
            if (!ready) {
                FatalError("WebGL is unavailable in this browser, so the farm cannot be drawn.");
                return;
            }

            await _mod.InvokeVoidAsync("setPlaying", true);
            await ApplyBackground();
            await _mod.InvokeVoidAsync("setLighting", LightingPayload());

            _autosave = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/playgroundAutosave.js"));
            _recorder = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/playgroundRecorder.js"));
            _popoverDragMod = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/popoverDrag.js"));

            await LoadCatalog();
            await LoadShowcase();
            await LoadShellObjects();
            await LoadDecorators();
            await RefreshDesigns();
            try {
                _appVersion = (await Client().GetFromJsonAsync<AppVersionDto>("/api/app/version"))?.Version ?? "";
            }
            catch {
                _appVersion = "";
            }

            if (!await TryRestoreAutosave()) await ApplyLayout(false);
        }
        catch (Exception ex) {
            FatalError($"3D init failed: {ex.Message}");
        }
    }

    async Task LoadCatalog() {
        try {
            var res = await Client().GetFromJsonAsync<CatalogResult>($"/api/farm/catalog?platform={MeshPlatform}");
            _catalogElements = res?.Elements?.ToList() ?? [];
            if (res is { Ok: false }) Fail(res.Diagnostics ?? "no asset catalog stored");
        }
        catch {
            _catalogElements = [];
        }
    }

    async Task LoadShowcase() {
        try {
