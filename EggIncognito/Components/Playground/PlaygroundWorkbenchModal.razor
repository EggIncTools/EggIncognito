    FarmDesignPayload BuildPayload() {
        return new FarmDesignPayload {
            Platform = MeshPlatform,
            State = _state,
            ChickenCount = _chickenCount,
            ShowcaseId = _presetId,
            Background = _bgColor,
            BackgroundTransparent = _bgTransparent,
            FarmConfig = JsonNode.Parse(ConfigJson())
        };
    }

    async Task RestoreFromPayload(FarmDesignPayload payload) {
        _suppressAutosave = true;
        try {
            _state = payload.State ?? new FarmStateModel();
            _state.Habs = NormalizeHabs(_state.Habs);
            if (string.IsNullOrEmpty(_state.SiloAssetType)) _state.SiloAssetType = "Silo0Small";
            if (string.IsNullOrEmpty(_state.EggType)) _state.EggType = "Edible";
            _chickenCount = payload.ChickenCount;
            _presetId = payload.ShowcaseId;
            if (!string.IsNullOrEmpty(payload.Background)) _bgColor = payload.Background;
            _bgTransparent = payload.BackgroundTransparent;

            if (payload.FarmConfig is { } config) {
                try {
                    HydrateFromConfig(ShellDB.Types.FarmConfiguration.Parser.ParseJson(config.ToJsonString()));
                }
                catch (InvalidProtocolBufferException) {
                    Fail("saved farm configuration is not a valid ShellDB.FarmConfiguration");
                }
            }

            await ApplyBackground();
        }
        finally {
            _suppressAutosave = false;
        }

        await ApplyLayout(false);
    }

    async Task SaveDesign() {
        var name = string.IsNullOrEmpty(_currentDesign) ? _designName.Trim() : _currentDesign;
        if (string.IsNullOrWhiteSpace(name)) return;
        var json = JsonSerializer.Serialize(BuildPayload());
        var res = await Client().PutAsJsonAsync($"/api/env/designs/{Uri.EscapeDataString(name)}",
            new { payload = json, note = string.IsNullOrWhiteSpace(_versionNote) ? null : _versionNote.Trim() });
        if (!res.IsSuccessStatusCode) {
            Fail($"save failed: HTTP {(int)res.StatusCode}");
            return;
        }

        var body = await res.Content.ReadFromJsonAsync<SaveResult>();
        _currentDesign = name;
        _currentVersion = body?.Version ?? _currentVersion + 1;
        _designName = "";
        _versionNote = "";
        _dirty = false;
        Status($"Saved \"{name}\" v{_currentVersion}.");
        await RefreshDesigns();
        await LoadVersions();
        if (_autosave is not null) {
            try {
                await _autosave.InvokeVoidAsync("clear");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
                Logger.LogDebug(ex, "could not clear the farm autosave after save");
            }
        }
    }

    async Task LoadDesign(string name) {
        Status("Loading design");
        try {
            var json = await Client().GetStringAsync($"/api/env/designs/{Uri.EscapeDataString(name)}");
            var payload = JsonSerializer.Deserialize<FarmDesignPayload>(json);
            if (payload is null) {
                Fail("design is corrupt");
                return;
            }

            await RestoreFromPayload(payload);
            _currentDesign = name;
            _dirty = false;
            await LoadVersions();
            _currentVersion = _versions.Count > 0 ? _versions[0].VersionNo : 0;
            Status($"Loaded \"{name}\" v{_currentVersion}.");
        }
        catch (Exception ex) {
            Fail(ex.Message);
        }
    }

    async Task NewDesign() {
        _shells.Clear();
        _setByElement.Clear();
        _state = new FarmStateModel();
        _lighting = new LightingModel();
        _decoratorId = null;
        _chickenId = null;
        _hatId = null;
        _presetId = null;
        _chickenCount = 0;
        _currentDesign = "";
        _currentVersion = 0;
        _versions = [];
        _designName = "";
        _versionNote = "";
        _dirty = false;
        Status("New design.");
        await ApplyLayout(false);
    }

    async Task LoadVersions() {
        if (string.IsNullOrEmpty(_currentDesign)) {
            _versions = [];
            return;
        }

        try {
            var res = await Client().GetFromJsonAsync<DesignVersionsResult>(
                $"/api/env/designs/{Uri.EscapeDataString(_currentDesign)}/versions");
            _versions = res?.Versions?.ToList() ?? [];
        }
        catch {
            _versions = [];
        }
    }

    async Task RollbackTo(int versionNo) {
        if (string.IsNullOrEmpty(_currentDesign)) return;
        try {
            var res = await Client().PostAsJsonAsync(
                $"/api/env/designs/{Uri.EscapeDataString(_currentDesign)}/rollback", new { versionNo });
            if (!res.IsSuccessStatusCode) {
                Fail($"rollback failed: HTTP {(int)res.StatusCode}");
                return;
            }

            var body = await res.Content.ReadFromJsonAsync<RollbackResult>();
            var json = await Client().GetStringAsync($"/api/env/designs/{Uri.EscapeDataString(_currentDesign)}");
            var payload = JsonSerializer.Deserialize<FarmDesignPayload>(json);
            if (payload is not null) await RestoreFromPayload(payload);
            _currentVersion = body?.NewVersion ?? _currentVersion;
            _dirty = false;
            await LoadVersions();
            Status($"Rolled back to v{versionNo} (now v{_currentVersion}).");
        }
        catch (Exception ex) {
            Fail(ex.Message);
        }
    }

    async Task DeleteDesign() {
        if (string.IsNullOrEmpty(_currentDesign)) return;
        var res = await Client().DeleteAsync($"/api/env/designs/{Uri.EscapeDataString(_currentDesign)}");
        if (res.IsSuccessStatusCode) {
            await NewDesign();
            await RefreshDesigns();
        } else {
            Fail($"delete failed: HTTP {(int)res.StatusCode}");
        }
    }

    async Task RefreshDesigns() {
        try {
            var res = await Client().GetFromJsonAsync<DesignListResult>("/api/env/designs");
            _savedDesigns = res?.Designs?.Select(d => d.Name).ToList() ?? [];
        }
        catch {
            _savedDesigns = [];
        }
    }

    async Task<bool> TryRestoreAutosave() {
        if (_autosave is null || _mod is null) return false;
        AutosaveRecord? rec;
        try {
            rec = await _autosave.InvokeAsync<AutosaveRecord?>("load");
        }
        catch {
            rec = null;
        }

        if (rec is null || string.IsNullOrEmpty(rec.Json)) return false;
        if (!AutosaveRecency.IsFresh(rec.SavedAt, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds())) {
            await _autosave.InvokeVoidAsync("clear");
            return false;
        }

        var restored = false;
        try {
            var payload = JsonSerializer.Deserialize<FarmDesignPayload>(rec.Json);
            if (payload is not null) {
                await RestoreFromPayload(payload);
                restored = true;
                Status("Restored your unsaved farm.");
            }
        }
        catch (JsonException ex) {
            Logger.LogWarning(ex, "the autosaved farm design could not be parsed and was discarded");
        }
        finally {
            if (_autosave is not null) await _autosave.InvokeVoidAsync("clear");
        }

        return restored;
    }

    void Autosave() {
        _dirty = true;
        if (_suppressAutosave) return;
        _autosaveCts?.Cancel();
        var cts = new CancellationTokenSource();
        _autosaveCts = cts;
        var json = JsonSerializer.Serialize(BuildPayload());
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _ = Task.Delay(750, cts.Token).ContinueWith(async t => {
            if (t.IsCanceled || _autosave is null) return;
            try {
                await _autosave.InvokeVoidAsync("save", json, _appVersion, now);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
                Logger.LogDebug(ex, "farm autosave could not be written");
            }
        }, TaskScheduler.Default);
    }

