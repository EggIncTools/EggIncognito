@page "/"
@page "/protos"
@page "/protos/{*Path}"
@page "/data"
@page "/periodicals"
@page "/capture"
@page "/capture/device/{DeviceId}"
@rendermode @(RenderModes.InteractiveServer)
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<Protos> Logger
@inject ProtoWorkbenchState State
@inject NavigationManager Nav
@inject ToastService Toasts
@inject AdminNotifier Notifier
@inject IServiceProvider Services
@using System.Text.Json
@using EggIncognito.Components.Api
@using EggIncognito.Components.Contracts
@using EggIncognito.Components.Events
@using EggIncognito.Components.Protos
@using EggIncognito.Core.Services.ProtoExtract
@using EggIncognito.Services.Protos
@using EggIncognito.Services.Events
@implements IAsyncDisposable

<PageTitle>EggIncognito</PageTitle>

<main class="page page-wide pt-6 pb-8">
    <h1 class="sr-only">EggIncognito</h1>

    <div class="pd-grid">
        <div class="pd-mod pd-identity">
            <IdentityPanel OnOpenSupport="OpenSupport" OnOpenTerms="OpenTerms" OnOpenPrivacy="OpenPrivacy"
                           OnOpenAdmin="OpenAdmin"/>
        </div>
        <div class="pd-mod pd-main pd-stack">
            <section class="reg-wrap">
                <div class="reg-toolbar">
                    <BrandPanel Rows="_rows" OnOpenVersion="OpenVersion"/>
                    <div class="reg-toolbar-controls">
                        <Tooltip Class="tt-ctl">
                            <ChildContent>
                                <label id="protoPageDrop" class="reg-drop" for="wbFile">
                                    <Icon Name="upload" Class="icon-sm"/>
                                    <span>Drop a build</span>
                                </label>
                            </ChildContent>
                            <Tip>
                                <span class="tt-title">Drop a build</span>
                                <span class="tt-line">Drag an APK, APKM, XAPK or IPA onto this, or click to pick one. The proto inside is extracted and submitted to the registry.</span>
                            </Tip>
                        </Tooltip>
                        <Tooltip Class="tt-ctl">
                            <ChildContent>
                                <button type="button" class="reg-intake"
                                        aria-label="Open the proto workbench" @onclick="@(() => _workbench?.Open())">
                                    <Icon Name="chevron-right" Class="icon-sm"/>
                                </button>
                            </ChildContent>
                            <Tip>
                                <span class="tt-title">Proto workbench</span>
                                <span class="tt-line">Browse every registered version, diff two protos side by side and inspect their messages.</span>
                            </Tip>
                        </Tooltip>
                        @if (_isContributor || _isAdmin) {
                            <Tooltip Class="tt-ctl">
                                <ChildContent>
                                    <button type="button" class="reg-intake" aria-label="Review staged submissions in the proto workbench"
                                            @onclick="OpenReview">
                                        <Icon Name="clipboard" Class="icon-sm"/>
                                    </button>
                                </ChildContent>
                                <Tip>
                                    <span class="tt-title">Review submissions</span>
                                    <span class="tt-line">Builds dropped by other people wait here. Accept them into the registry or reject them.</span>
                                </Tip>
                            </Tooltip>
                        }
                        @if (_isAdmin) {
                            <Tooltip Class="tt-ctl">
                                <ChildContent>
                                    <button type="button" class="reg-add-toggle" aria-label="Add a version in the proto workbench"
                                            @onclick="OpenAddVersion">
                                        +
                                    </button>
                                </ChildContent>
                                <Tip>
                                    <span class="tt-title">Add a version</span>
                                    <span class="tt-line">Register a version by hand, for builds that cannot be dropped as a file.</span>
                                </Tip>
                            </Tooltip>
                        }
                    </div>
                </div>
                @if (_loading && _rows.Count == 0) {
                    <div class="backfill-empty">Loading...</div>
                } else if (_rows.Count == 0) {
                    <div class="reg-empty">
                        <div>No proto versions yet.</div>
                        <div class="reg-empty-hint">Drop a build on the toolbar, or open the proto workbench, to add one.</div>
                    </div>
                } else {
                    var bands = SortedBands;
                    _laneLayout = ShaLanes.Build(
                        bands.Select(b => b.Key).ToList(),
                        bands.Select(b => b.Primary.Key()).ToList(),
                        AllReleases.Select(r => r.Primary.Key()).ToList());
                    var laneRows = _laneLayout.Rows;
                    <div class="reg-scroll">
                        <table class="data-table reg-table" style="--reg-gutter: @Gutter(ShaLanes.LaneCount(_laneLayout))">
                            <thead>
                            <tr>
                                <th class="reg-th-sort reg-c-app" @onclick="@(() => Sort("appVersion"))">
                                    <span>App version</span>@Caret("appVersion")
                                </th>
                                <th class="reg-th-sort reg-c-build" @onclick="@(() => Sort("build"))">
                                    <span>Build</span>@Caret("build")
                                </th>
                                <th class="reg-th-sort reg-c-client" @onclick="@(() => Sort("client"))">
                                    <span>Client</span>@Caret("client")
                                </th>
                                <th class="reg-th-sort reg-c-sha" @onclick="@(() => Sort("sha"))">
                                    <span>Proto SHA</span>@Caret("sha")
                                </th>
                            </tr>
                            </thead>
                            @foreach (var band in bands) {
                                var lane = laneRows.GetValueOrDefault(band.Key);
                                var span = band.Releases.Count;
                                <tbody class="reg-band">
                                @for (var i = 0; i < span; i++) {
                                    var rel = band.Releases[i];
                                    var primary = rel.Primary;
                                    <tr class="reg-row" @onclick="@(() => OpenVersion(primary))">
                                        <td class="reg-version reg-c-app" data-label="App version">@primary.AppVersion</td>
                                        <td class="reg-c-build" data-label="Build">
                                            <span class="reg-builds">
                                                @foreach (var m in rel.Members) {
                                                    <a class="reg-build-link" href="@VersionHref(m)" @onclick:stopPropagation="true"
                                                       @onclick:preventDefault="true" @onclick="@(() => OpenVersion(m))">
                                                        <PlatformIcon Platform="@m.Platform"/>
                                                        @if (m.BuildFlag is { } memberFlag) {
                                                            <Tooltip>
                                                                <ChildContent>
                                                                    <span class="reg-num reg-num-bad">@m.Build</span>
                                                                </ChildContent>
                                                                <Tip>
                                                                    <span class="tt-line tt-bad">@FlagLabel(memberFlag)</span>
                                                                </Tip>
                                                            </Tooltip>
                                                        } else {
                                                            <span class="reg-num">@m.Build</span>
                                                        }
                                                    </a>
                                                }
                                            </span>
                                        </td>
                                        @if (i == 0) {
                                            <td class="reg-num reg-c-client" data-label="Client" rowspan="@span">@ClientText(band.Primary)</td>
                                            <td class="reg-c-sha reg-sha-cell" data-label="Proto SHA" rowspan="@span">
                                                @if (lane is not null) {
                                                    foreach (var seg in lane.Segments) {
                                                        <span class="@LaneSpanClass(seg)" style="--lane: @seg.Lane"
                                                              role="button" aria-label="Open proto group"
                                                              @onclick:stopPropagation="true" @onclick="@(() => OpenGroup(seg.GroupId))"
                                                              @onmouseenter="@(() => SetHotGroup(seg.GroupId))"
                                                              @onmouseleave="@(() => SetHotGroup(null))">
                                                        </span>
                                                    }
                                                }
                                                <span class="inline-flex items-center gap-1"
                                                      @onmouseenter="@(() => SetHotGroup(lane?.GroupId))"
                                                      @onmouseleave="@(() => SetHotGroup(null))">
                                                    <span class="@ShaChipClass(lane)">@Short(band.Primary.ProtoSha)</span>
                                                    @if (band.Primary.SortOrder is { } so && so != 0) {
                                                        <span class="text-muted text-xs">@OrderLabel(so)</span>
                                                    }
                                                </span>
                                            </td>
                                        }
                                    </tr>
                                }
                                </tbody>
                            }
                        </table>
                    </div>
                }
            </section>
        </div>
        <div class="pd-mod pd-side">
            <PeriodicalsPanel OnManageDevices="OpenDeviceWorkbench" OnOpenNotifications="OpenNotifications"
                              OnOpenApiWorkbench="OpenApiWorkbench" OnOpenCapture="OpenCaptureWorkbench"
                              OnOpenEvents="OpenEvents" OnOpenContracts="OpenContracts" OnOpenSupport="OpenSupport"/>
        </div>
    </div>
</main>

<NotificationsWorkbenchModal @ref="_notificationsModal"/>
<ProtoWorkbenchModal @ref="_workbench" OnChanged="OnMutated" OnRefChanged="OnWorkbenchRef" OnClosed="OnWorkbenchClosed"/>
<DeviceWorkbenchModal @ref="_deviceWorkbench" OnChanged="OnMutated"/>
<ApiWorkbenchModal @ref="_apiWorkbench"/>
<EventsWorkbenchModal @ref="_eventsModal"/>
<ContractsWorkbenchModal @ref="_contractsModal"/>
<AdminWorkbenchModal @ref="_adminWorkbench"/>
<SupportModal @ref="_supportModal"/>
<TermsModal @ref="_termsModal"/>
<PrivacyModal @ref="_privacyModal"/>

@code {
    ProtoWorkbenchModal? _workbench;
    DeviceWorkbenchModal? _deviceWorkbench;
    ApiWorkbenchModal? _apiWorkbench;
    AdminWorkbenchModal? _adminWorkbench;
    EventsWorkbenchModal? _eventsModal;
    ContractsWorkbenchModal? _contractsModal;
    SupportModal? _supportModal;
    TermsModal? _termsModal;
    PrivacyModal? _privacyModal;

    void OpenSupport() {
        _supportModal?.Open();
    }

    void OpenAdmin() {
        _adminWorkbench?.Open();
    }

    void OpenTerms() {
        _termsModal?.Open();
    }

    void OpenPrivacy() {
        _privacyModal?.Open();
    }

    Task OpenDeviceWorkbench(string? deviceId) {
        return _deviceWorkbench?.Open(deviceId) ?? Task.CompletedTask;
    }

    Task OpenApiWorkbench() {
        return _apiWorkbench?.Open() ?? Task.CompletedTask;
    }

    Task OpenCaptureWorkbench() {
        return _apiWorkbench?.OpenCapture() ?? Task.CompletedTask;
    }

    Task OpenEvents() {
        return _eventsModal?.Open() ?? Task.CompletedTask;
    }

    Task OpenContracts() {
        return _contractsModal?.Open() ?? Task.CompletedTask;
    }

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    List<ProtoRegistryRow> _rows = [];

    bool _loading = true;
    bool _isAdmin;
    bool _isContributor;

    string _sortCol = "appVersion";
    bool _sortDesc = true;

    NotificationsWorkbenchModal? _notificationsModal;

    Task OpenNotifications() {
        return _notificationsModal?.Open() ?? Task.CompletedTask;
    }

    [SupplyParameterFromQuery(Name = "login_error")]
    public int LoginError { get; set; }

    [Parameter] public string? Path { get; set; }

    [Parameter] public string? DeviceId { get; set; }

    JsRouteSync? _routeSync;

    static string VersionHref(ProtoRegistryRow r) {
        return $"/protos/{r.Platform}/{Uri.EscapeDataString(r.Build)}";
    }

    Task OpenVersion(ProtoRegistryRow r) {
        var value = new ProtoRef(ProtoRefSource.Registry, r.Platform, r.Build, null);
        _workbench?.OpenAt(value, null, null);
        _routeSync?.Push($"/protos/{r.Platform}/{Uri.EscapeDataString(r.Build)}");
        return Task.CompletedTask;
    }

    Task OnWorkbenchRef(WorkbenchRef value) {
        _routeSync?.Replace(value.A is null ? "/protos" : "/protos/" + ProtoRefParser.Format(value));
        return Task.CompletedTask;
    }

    bool _closingFromRoute;

    Task OnWorkbenchClosed() {
        if (_closingFromRoute) return Task.CompletedTask;
        _routeSync?.Push("/protos");
        return Task.CompletedTask;
    }

    void ApplyRef(WorkbenchRef value) {
        if (value.A is null) {
            _closingFromRoute = true;
            try {
                _workbench?.Close();
            } finally {
                _closingFromRoute = false;
            }

            return;
        }

        _workbench?.OpenAt(value.A, value.B, value.Mode);
    }

    void ApplyPath() {
        var segments = _routeSync!.Segments;
        var tail = segments.Count > 0 && segments[0] == "protos" ? string.Join("/", segments.Skip(1)) : "";

        if (tail.Length == 0) {
            ApplyRef(new WorkbenchRef(null, null, null));
            return;
        }

        var parts = tail.Split('/');
        if (parts.Length >= 2 && parts[1].Length > 0
                              && ProtoRefParser.Known.Any(p => p.Equals(parts[0], StringComparison.OrdinalIgnoreCase))) {
            var build = Uri.UnescapeDataString(parts[1]);
            _workbench?.OpenAt(new ProtoRef(ProtoRefSource.Registry, parts[0], build, null), null, null);
            return;
        }

        if (parts.Length == 1) {
            var seg = parts[0];
            var isRouteAction = seg.Equals("terms", StringComparison.OrdinalIgnoreCase)
                                || seg.Equals("privacy", StringComparison.OrdinalIgnoreCase)
                                || seg.Equals("support", StringComparison.OrdinalIgnoreCase)
                                || seg.Equals("add", StringComparison.OrdinalIgnoreCase)
                                || seg.Equals("review", StringComparison.OrdinalIgnoreCase);
            if (isRouteAction) {
                _closingFromRoute = true;
                try {
                    _workbench?.Close();
                } finally {
                    _closingFromRoute = false;
                }

                if (seg.Equals("terms", StringComparison.OrdinalIgnoreCase)) OpenTerms();
                else if (seg.Equals("privacy", StringComparison.OrdinalIgnoreCase)) OpenPrivacy();
                else if (seg.Equals("support", StringComparison.OrdinalIgnoreCase)) OpenSupport();
                else if (seg.Equals("review", StringComparison.OrdinalIgnoreCase)) _workbench?.OpenReview();
                else _workbench?.OpenAdd();
                return;
            }
        }

        ApplyRef(ProtoRefParser.Parse(tail));
    }

    static int ByVersion(ProtoRegistryRow a, ProtoRegistryRow b) {
        return ProtoVersionOrdering.Compare(b.Key(), a.Key());
    }

    Comparison<ProtoRegistryRow> RowComparison {
        get {
            Comparison<ProtoRegistryRow> primary = _sortCol switch {
                "platform" => (a, b) => string.Compare(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase),
                "appVersion" => (a, b) => ByVersion(a, b),
                "build" => (a, b) => {
                    var p = string.Compare(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase);
                    return p != 0 ? p : CompareBuild(a.Build, b.Build);
                },
                "client" => (a, b) => CompareNumeric(a.ClientVersion, b.ClientVersion),
                "sha" => (a, b) => string.Compare(a.ProtoSha, b.ProtoSha, StringComparison.OrdinalIgnoreCase),
                _ => ByVersion
            };
            return (a, b) => {
                var v = primary(a, b);
                return v != 0 ? v : ByVersion(a, b);
            };
        }
    }

    static List<Models.Registry.Release> ReleasesOf(IEnumerable<ProtoRegistryRow> rows) {
        var byKey = new Dictionary<long, List<ProtoRegistryRow>>();
        foreach (var r in rows) {
            var key = ReleaseKey(r);
            if (!byKey.TryGetValue(key, out var list)) {
                list = [];
                byKey[key] = list;
            }

            list.Add(r);
        }

        return byKey
            .Select(kv => new Models.Registry.Release(kv.Key, kv.Value.OrderBy(m => m.Platform, StringComparer.OrdinalIgnoreCase)
                .ThenByDescending(m => m.Build, BuildComparer).ToList()))
            .ToList();
    }

    List<Models.Registry.Release> AllReleases => ReleasesOf(_rows);

    List<Models.Registry.Release> SortedReleases {
        get {
            var releases = ReleasesOf(_rows);
            var cmp = RowComparison;
            releases.Sort((x, y) => cmp(x.Primary, y.Primary));
            if (_sortDesc) releases.Reverse();
            return releases;
        }
    }

    List<Models.Registry.ReleaseBand> SortedBands => Models.Registry.ReleaseBand.Of(SortedReleases);

    void Sort(string col) {
        if (_sortCol == col) _sortDesc = !_sortDesc;
        else {
            _sortCol = col;
            _sortDesc = false;
        }
    }

    static string FlagLabel(string flag) {
        return flag == "android_build_on_ios" ? "Android build number on an iOS version" : flag.Replace('_', ' ');
    }

    ShaLaneLayout _laneLayout = new(new Dictionary<long, ShaLaneRow>(), new Dictionary<int, string>());
    string? _hotSha;

    static string Gutter(int lanes) {
        return FormattableString.Invariant($"{lanes * 0.75:0.###}rem");
    }

    static string LaneClass(ShaLaneMark mark) {
        return mark switch {
            ShaLaneMark.Start => "reg-lane reg-lane-start",
            ShaLaneMark.Node => "reg-lane reg-lane-node",
            ShaLaneMark.End => "reg-lane reg-lane-end",
            _ => "reg-lane reg-lane-pass"
        };
    }

    string LaneSpanClass(ShaLaneSegment seg) {
        var css = $"{LaneClass(seg.Mark)} reg-lane-c{seg.Lane % 4}";
        return IsHotGroup(seg.GroupId) ? $"{css} reg-lane-hot" : css;
    }

    string ShaChipClass(ShaLaneRow? lane) {
        const string css = "code-chip reg-sha";
        return lane?.GroupId is { } groupId && IsHotGroup(groupId) ? $"{css} reg-sha-hot" : css;
    }

    bool IsHotGroup(int groupId) {
        return _hotSha is { Length: > 0 } hot
               && _laneLayout.GroupShas.TryGetValue(groupId, out var sha)
               && string.Equals(sha, hot, StringComparison.OrdinalIgnoreCase);
    }

    void SetHotGroup(int? groupId) {
        _hotSha = groupId is { } gid && _laneLayout.GroupShas.TryGetValue(gid, out var sha) ? sha : null;
    }

    void OpenGroup(int groupId) {
        if (!_laneLayout.GroupShas.TryGetValue(groupId, out var sha)) return;
        _workbench?.OpenGroup(sha);
    }

    static string ClientText(ProtoRegistryRow r) {
        return r.ClientVersion ?? "";
    }

    MarkupString Caret(string col) {
        return new MarkupString(_sortCol == col ? _sortDesc ? " ▾" : " ▴" : "");
    }

    static readonly IComparer<string> BuildComparer = Comparer<string>.Create((a, b) => CompareBuild(a, b));

    static int CompareBuild(string? a, string? b) {
        var an = long.TryParse(a, out var al);
        var bn = long.TryParse(b, out var bl);
        if (an && bn) return al.CompareTo(bl);
        return an != bn ? an.CompareTo(bn) : CompareSemver(a, b);
    }

    static int CompareNumeric(string? a, string? b) {
        var ax = long.TryParse(a, out var al);
        var bx = long.TryParse(b, out var bl);
        if (ax && bx) return al.CompareTo(bl);
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    static int CompareSemver(string? a, string? b) {
        var ap = (a ?? "").Split('.');
        var bp = (b ?? "").Split('.');
        var n = Math.Max(ap.Length, bp.Length);
        for (var i = 0; i < n; i++) {
            var av = i < ap.Length && long.TryParse(ap[i], out var x) ? x : 0;
            var bv = i < bp.Length && long.TryParse(bp[i], out var y) ? y : 0;
            if (av != bv) return av.CompareTo(bv);
        }

        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized() {
        base.OnInitialized();

        _isAdmin = User.IsAtLeast(UserRole.Admin);
        _isContributor = User.IsAtLeast(UserRole.Contributor);
        if (LoginError == 1) Toasts.Push(StatusNoteKind.Error, "Login failed. Try again.");
    }

    protected override async Task OnInitializedAsync() {
        if (ViewerClock.Of(Services) is { } clock) {
            await clock.EnsureAsync(Services, User, CancellationToken.None);
            clock.Changed += OnZoneChanged;
        }

        await Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        if (ViewerClock.Of(Services) is { } clock) await clock.SyncAsync();
        _topics ??= Notifier.Subscribe(OnTopic);
        await Vis.ListenAsync(OnVisibleAsync);
        try {
            _protoDrop ??= await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/protoStrip.js"));
            await _protoDrop.InvokeAsync<bool>("wireDrop", "protoPageDrop", "wbFile");
        } catch (JSDisconnectedException ex) {
            Logger.LogDebug(ex, "proto drop zone not wired, the circuit is already gone");
        }

        _routeSync = new JsRouteSync(JS, Env, Nav, "/protos", Logger);
        _routeSync.Changed += () => InvokeAsync(() => {
            ApplyPath();
            StateHasChanged();
        });
        await _routeSync.StartAsync();
        ApplyPath();
        await ApplyRouteAsync();
        await ApplyFragmentAsync();
    }

    Task ApplyRouteAsync() {
        if (_deviceWorkbench is not { } devices) return Task.CompletedTask;
        var route = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');
        return route.StartsWith("capture", StringComparison.OrdinalIgnoreCase)
            ? devices.OpenCapture(DeviceId)
            : Task.CompletedTask;
    }

    Task ApplyFragmentAsync() {
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        if (fragment.Length == 0) return Task.CompletedTask;
        if (string.Equals(fragment, "console", StringComparison.OrdinalIgnoreCase))
            return _deviceWorkbench?.OpenScreen() ?? Task.CompletedTask;
        if (string.Equals(fragment, "devices", StringComparison.OrdinalIgnoreCase))
            return _deviceWorkbench?.Open() ?? Task.CompletedTask;
        if (fragment.StartsWith("capture/", StringComparison.OrdinalIgnoreCase))
            return _deviceWorkbench?.OpenCapture(fragment["capture/".Length..]) ?? Task.CompletedTask;

        if (_adminWorkbench is not { } admin) return Task.CompletedTask;
        if (string.Equals(fragment, "admin", StringComparison.OrdinalIgnoreCase)) admin.Open();
        else if (string.Equals(fragment, "playground", StringComparison.OrdinalIgnoreCase)) admin.OpenPlaygroundPane();
        return Task.CompletedTask;
    }

    PageVisibility? _vis;
    IJSObjectReference? _protoDrop;
    IDisposable? _topics;
    bool _disposed;
    bool _missed;
    bool _refreshing;

    PageVisibility Vis => _vis ??= new PageVisibility(JS, Env);

    void OnTopic(string topic) {
        if (_disposed) return;
        if (topic != AdminTopics.ProtoRegistry && topic != AdminTopics.Staged) return;
        _ = InvokeAsync(RefreshAll);
    }

    async Task OnVisibleAsync(bool visible) {
        if (_disposed || !visible || !_missed) return;
        _missed = false;
        await InvokeAsync(RefreshAll);
    }

    async Task RefreshAll() {
        if (_disposed || _loading || _busyMutating || _refreshing) return;
        _refreshing = true;
        try {
            if (!await Vis.IsVisibleAsync()) {
                _missed = true;
                return;
            }

            await Load(true);
            if (_workbench is { } workbench) await workbench.RefreshReview();
            StateHasChanged();
        } finally {
            _refreshing = false;
        }
    }

    bool _busyMutating;

    async Task Load(bool background = false) {
        if (!background) _loading = true;
        try {
            _rows = await Client().GetFromJsonAsync<List<ProtoRegistryRow>>("/api/protos/versions", JsonOpts) ?? [];
            State.Registry = _rows;
            State.RegistryLoadedAt = DateTime.UtcNow;
        } catch (Exception ex) {
            if (ex is not OperationCanceledException) Logger.LogWarning(ex, "proto registry load failed");
            if (!background) _rows = [];
        }

        if (!background) _loading = false;
    }

    Task OpenAddVersion() {
        _workbench?.OpenAdd();
        _routeSync?.Push("/protos/add");
        return Task.CompletedTask;
    }

    Task OpenReview() {
        _workbench?.OpenReview();
        _routeSync?.Push("/protos/review");
        return Task.CompletedTask;
    }

    async Task OnMutated() {
        _busyMutating = true;
        try {
            await Load();
        } finally {
            _busyMutating = false;
        }
    }

    static string OrderLabel(int order) {
        return order > 0 ? $"+{order}" : $"{order}";
    }

    static string Short(string? sha) {
        return string.IsNullOrEmpty(sha) ? "" : sha.Length <= 6 ? sha : sha[..6];
    }

    void OnZoneChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync() {
        if (ViewerClock.Of(Services) is { } clock) clock.Changed -= OnZoneChanged;
        _disposed = true;
        _topics?.Dispose();
        _topics = null;
        if (_vis is not null) await _vis.DisposeAsync();
        await _protoDrop.DisposeModuleAsync(logger: Logger);
        if (_routeSync is not null) await _routeSync.DisposeAsync();
    }

    static long ReleaseKey(ProtoRegistryRow r) {
        return r.CanonicalId ?? r.Id;
    }

}
