@page "/inspector"
@rendermode @(RenderModes.InteractiveServer)
@inject NavigationManager Nav

@code {

    protected override void OnAfterRender(bool firstRender) {
        if (!firstRender) return;
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        var target = fragment.Length > 0 && !fragment.StartsWith("api", StringComparison.Ordinal)
            ? $"/#api/{fragment}"
            : fragment.Length > 0
                ? $"/#{fragment}"
                : "/#api";
        Nav.NavigateTo(target, replace: true);
    }

}
