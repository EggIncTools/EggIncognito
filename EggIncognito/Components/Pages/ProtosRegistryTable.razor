@using EggIncognito.Core.Services.ProtoExtract
@using EggIncognito.Services.Protos

@{
    var bands = SortedBandsOf(Rows);
    var layout = ShaLanes.Build(
        bands.Select(b => b.Key).ToList(),
        bands.Select(b => b.Primary.Key()).ToList(),
        ReleasesOf(Rows).Select(r => r.Primary.Key()).ToList());
    var laneRows = layout.Rows;
}
<div class="reg-scroll">
    <table class="data-table reg-table" style="--reg-gutter: @Gutter(ShaLanes.LaneCount(layout))">
        <thead>
        <tr>
            <th class="reg-th-sort reg-c-app" @onclick="@(() => Sort("appVersion"))">
                <span>App</span>@Caret("appVersion")
            </th>
            <th class="reg-th-sort reg-c-build" @onclick="@(() => Sort("build"))">
                <span>Build</span>@Caret("build")
            </th>
            <th class="reg-th-sort reg-c-client" @onclick="@(() => Sort("client"))">
                <span>Client</span>@Caret("client")
            </th>
            <th class="reg-th-sort reg-c-sha" @onclick="@(() => Sort("sha"))">
                <span>SHA</span>@Caret("sha")
            </th>
        </tr>
        </thead>
        @foreach (var band in bands) {
            var lane = laneRows.GetValueOrDefault(band.Key);
            var span = band.Releases.Count;
            <tbody class="reg-band">
            @for (var i = 0; i < span; i++) {
                var rel = band.Releases[i];
                var primary = rel.Primary;
                <tr class="reg-row" @onclick="@(() => OnOpenVersion.InvokeAsync(primary))">
                    <td class="reg-version reg-c-app" data-label="App version">@primary.AppVersion</td>
                    <td class="reg-c-build" data-label="Build">
                        <span class="reg-builds">
                            @foreach (var m in rel.Members) {
                                <button type="button" class="reg-build-link" @onclick:stopPropagation="true"
                                        @onclick="@(() => OnOpenVersion.InvokeAsync(m))">
                                    @if (PlatformIcons) {
                                        <PlatformIcon Platform="@m.Platform"/>
                                    }
                                    @if (m.BuildFlag is { } memberFlag) {
                                        <Tooltip Text="@FlagLabel(memberFlag)" Error="true">
                                            <span class="reg-num reg-num-bad">@m.Build</span>
                                        </Tooltip>
                                    } else {
                                        <span class="reg-num">@m.Build</span>
                                    }
                                </button>
                            }
                        </span>
                    </td>
                    @if (i == 0) {
                        <td class="reg-num reg-c-client" data-label="Client" rowspan="@span">@ClientText(band.Primary)</td>
                        <td class="reg-c-sha reg-sha-cell" data-label="Proto SHA" rowspan="@span">
                            @if (lane is not null) {
                                foreach (var seg in lane.Segments) {
                                    <span class="@LaneSpanClass(layout, seg)" style="--lane: @seg.Lane"
                                          role="button" aria-label="Open proto group"
                                          @onclick:stopPropagation="true" @onclick="@(() => OpenGroupAsync(layout, seg.GroupId))"
                                          @onmouseenter="@(() => SetHotGroup(layout, seg.GroupId))"
                                          @onmouseleave="@(() => SetHotGroup(layout, null))">
                                    </span>
                                }
                            }
                            <span class="reg-sha-group"
                                  @onmouseenter="@(() => SetHotGroup(layout, lane?.GroupId))"
                                  @onmouseleave="@(() => SetHotGroup(layout, null))">
                                <span class="@ShaChipClass(layout, lane)">@Short(band.Primary.ProtoSha)</span>
                                @if (band.Primary.SortOrder is { } so && so != 0) {
                                    <span class="reg-order">@OrderLabel(so)</span>
                                }
                            </span>
                        </td>
                    }
                </tr>
            }
            </tbody>
        }
    </table>
</div>

@code {
    [Parameter] public List<ProtoRegistryRow> Rows { get; set; } = [];

    [Parameter] public bool PlatformIcons { get; set; } = true;

    [Parameter] public EventCallback<ProtoRegistryRow> OnOpenVersion { get; set; }

    [Parameter] public EventCallback<string> OnOpenGroup { get; set; }

    string _sortCol = "appVersion";
    bool _sortDesc = true;

    string? _hotSha;

    void Sort(string col) {
        if (_sortCol == col) _sortDesc = !_sortDesc;
        else {
            _sortCol = col;
            _sortDesc = false;
        }
    }

    static int ByVersion(ProtoRegistryRow a, ProtoRegistryRow b) {
        return ProtoVersionOrdering.Compare(b.Key(), a.Key());
    }

    Comparison<ProtoRegistryRow> RowComparison {
        get {
            Comparison<ProtoRegistryRow> primary = _sortCol switch {
                "platform" => (a, b) => string.Compare(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase),
                "appVersion" => (a, b) => ByVersion(a, b),
                "build" => (a, b) => {
                    var p = string.Compare(a.Platform, b.Platform, StringComparison.OrdinalIgnoreCase);
                    return p != 0 ? p : EggIncognito.Core.Services.Devices.VersionCompare.Build(a.Build, b.Build);
                },
                "client" => (a, b) => CompareNumeric(a.ClientVersion, b.ClientVersion),
                "sha" => (a, b) => string.Compare(a.ProtoSha, b.ProtoSha, StringComparison.OrdinalIgnoreCase),
                _ => ByVersion
            };
            return (a, b) => {
                var v = primary(a, b);
                return v != 0 ? v : ByVersion(a, b);
            };
        }
    }

    static List<Models.Registry.Release> ReleasesOf(IEnumerable<ProtoRegistryRow> rows) {
        var byKey = new Dictionary<long, List<ProtoRegistryRow>>();
        foreach (var r in rows) {
            var key = ReleaseKey(r);
            if (!byKey.TryGetValue(key, out var list)) {
                list = [];
                byKey[key] = list;
            }

            list.Add(r);
        }

        return byKey
            .Select(kv => new Models.Registry.Release(kv.Key, kv.Value.OrderBy(m => m.Platform, StringComparer.OrdinalIgnoreCase)
                .ThenByDescending(m => m.Build, EggIncognito.Core.Services.Devices.VersionCompare.BuildComparer).ToList()))
            .ToList();
    }

    List<Models.Registry.ReleaseBand> SortedBandsOf(IEnumerable<ProtoRegistryRow> source) {
        var releases = ReleasesOf(source);
        var cmp = RowComparison;
        releases.Sort((x, y) => cmp(x.Primary, y.Primary));
        if (_sortDesc) releases.Reverse();
        return Models.Registry.ReleaseBand.Of(releases);
    }

    static long ReleaseKey(ProtoRegistryRow r) {
        return r.CanonicalId ?? r.Id;
    }

    static string FlagLabel(string flag) {
        return flag == "android_build_on_ios" ? "Android build number on an iOS version" : flag.Replace('_', ' ');
    }

    static string Gutter(int lanes) {
        return FormattableString.Invariant($"{lanes * 0.75 + 0.375:0.###}rem");
    }

    static string LaneClass(ShaLaneMark mark) {
        return mark switch {
            ShaLaneMark.Start => "reg-lane reg-lane-start",
            ShaLaneMark.Node => "reg-lane reg-lane-node",
            ShaLaneMark.End => "reg-lane reg-lane-end",
            _ => "reg-lane reg-lane-pass"
        };
    }

    string LaneSpanClass(ShaLaneLayout layout, ShaLaneSegment seg) {
        var css = $"{LaneClass(seg.Mark)} reg-lane-c{seg.Lane % 4}";
        return IsHotGroup(layout, seg.GroupId) ? $"{css} reg-lane-hot" : css;
    }

    string ShaChipClass(ShaLaneLayout layout, ShaLaneRow? lane) {
        const string css = "code-chip reg-sha";
        return lane?.GroupId is { } groupId && IsHotGroup(layout, groupId) ? $"{css} reg-sha-hot" : css;
    }

    bool IsHotGroup(ShaLaneLayout layout, int groupId) {
        return _hotSha is { Length: > 0 } hot
               && layout.GroupShas.TryGetValue(groupId, out var sha)
               && string.Equals(sha, hot, StringComparison.OrdinalIgnoreCase);
    }

    void SetHotGroup(ShaLaneLayout layout, int? groupId) {
        _hotSha = groupId is { } gid && layout.GroupShas.TryGetValue(gid, out var sha) ? sha : null;
    }

    Task OpenGroupAsync(ShaLaneLayout layout, int groupId) {
        return !layout.GroupShas.TryGetValue(groupId, out var sha) ? Task.CompletedTask : OnOpenGroup.InvokeAsync(sha);
    }

    static string ClientText(ProtoRegistryRow r) {
        return r.ClientVersion ?? "";
    }

    MarkupString Caret(string col) {
        return new MarkupString(_sortCol == col ? _sortDesc ? " ▾" : " ▴" : "");
    }

    static int CompareNumeric(string? a, string? b) {
        var ax = long.TryParse(a, out var al);
        var bx = long.TryParse(b, out var bl);
        if (ax && bx) return al.CompareTo(bl);
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    static int CompareSemver(string? a, string? b) {
        var ap = (a ?? "").Split('.');
        var bp = (b ?? "").Split('.');
        var n = Math.Max(ap.Length, bp.Length);
        for (var i = 0; i < n; i++) {
            var av = i < ap.Length && long.TryParse(ap[i], out var x) ? x : 0;
            var bv = i < bp.Length && long.TryParse(bp[i], out var y) ? y : 0;
            if (av != bv) return av.CompareTo(bv);
        }

        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    static string OrderLabel(int order) {
        return order > 0 ? $"+{order}" : $"{order}";
    }

    static string Short(string? sha) {
        return EggIncognito.Core.Hashes.Short(sha, 6);
    }
}
