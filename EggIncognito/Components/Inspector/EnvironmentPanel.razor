@using EggIncognito.Services.Api
<div class="env-box">
    <div class="env-head">
        <button type="button" class="env-title" @onclick="Toggle">
            <Caret Open="State.EnvOpen"/>BasicRequestInfo Setup
        </button>
        @if (!State.EnvOpen) {
            <span class="env-state @(State.EnvValidated ? "ok" : "")">
                @(State.EnvValidated ? "validated" : "not validated")
            </span>
        }
    </div>
    @if (State.EnvOpen) {
        <div class="env-rowgroup">
            <EnvField Row="@Find("eiUserId")" WidthClass="env-w-eid" OnChanged="OnChanged"/>
            <EnvField Row="@Find("debug")" WidthClass="env-w-bool" OnChanged="OnChanged"/>
        </div>
        <div class="env-rowgroup">
            <EnvField Row="@Find("clientVersion")" WidthClass="env-w-tiny" OnChanged="OnChanged"/>
            <EnvField Row="@Find("version")" WidthClass="env-w-sm" OnChanged="OnChanged"/>
            <EnvField Row="@Find("build")" WidthClass="env-w-sm" OnChanged="OnChanged"/>
        </div>
        <div class="env-rowgroup">
            <EnvField Row="@Find("platform")" WidthClass="env-w-sm" OnChanged="OnChanged"/>
            <EnvField Row="@Find("country")" WidthClass="env-w-code" OnChanged="OnChanged"/>
            <EnvField Row="@Find("language")" WidthClass="env-w-code" OnChanged="OnChanged"/>
        </div>
        @if (!string.IsNullOrEmpty(State.EnvError)) {
            <div class="env-error">@State.EnvError</div>
        }

        <div class="env-foot">
            @if (!State.EnvValidated && State.EnvError is not null) {
                <button type="button" class="btn-mini" @onclick="OnForceSave">
                    Save anyway
                </button>
            }
            <button type="button" class="btn-secondary env-validate" disabled="@State.EnvValidating"
                    @onclick="OnValidate">
                @(State.EnvValidating ? "Validating..." : "Validate")
            </button>
        </div>
    }
</div>

@code {
    [Inject] public ApiWorkbenchState State { get; set; } = default!;

    [Parameter] public IReadOnlyList<EnvRow> Rows { get; set; } = [];
    [Parameter] public EventCallback<EnvRow> OnChanged { get; set; }
    [Parameter] public EventCallback OnValidate { get; set; }
    [Parameter] public EventCallback OnForceSave { get; set; }

    void Toggle() {
        State.EnvOpen = !State.EnvOpen;
    }

    EnvRow? Find(string key) {
        foreach (var r in Rows) {
            if (r.Key == key) return r;
        }

        return null;
    }

}
