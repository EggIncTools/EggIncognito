@using EggIncognito.Models.Inspector
@using EggIncognito.Services.Api
@using EggIncognito.Services.Inspector
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IRouteCatalog Catalog
@inject IProtoReflection Reflection

<div class="awb-tools">
    <a class="btn-mini" href="/api/tools/postman-collection" download>
        <Icon Name="download" Class="icon-sm"/> Postman
    </a>
    <button type="button" class="btn-mini @(State.HasSalt ? "awb-tool-ok" : "text-muted")" @onclick="OnOpenSalt">
        <Icon Name="@(State.HasSalt ? "check" : "key")" Class="icon-sm"/> Salt
    </button>
</div>

@if (!string.IsNullOrEmpty(State.Notice)) {
    <StatusNote Severity="StatusNoteKind.Error">@State.Notice</StatusNote>
}

<div class="wb-rail-slot awb-rail-list">
    <WorkbenchSection Label="@EndpointsLabel" Scroll="true">
        @if (ShowRouteCatalog) {
            <WorkbenchEntry Selected="RouteCatalogSelected" OnClick="@(_ => OnOpenRouteCatalog.InvokeAsync())">
                <Lead>
                    <span class="wb-lead">
                        <Icon Name="map-pin" Class="icon-sm"/>
                    </span>
                </Lead>
                <Name>Route catalog</Name>
                <MetaLine>
                    @if (RouteSummary is { } summary) {
                        <span class="meta-dots">
                            <span>@summary.Routes routes</span>
                            @if (summary.Edited > 0) {
                                <span>@summary.Edited edited</span>
                            }
                            @if (summary.Drift > 0) {
                                <span>@summary.Drift drift</span>
                            }
                        </span>
                    }
                </MetaLine>
            </WorkbenchEntry>
        }
        <div class="insp-list">
            <Virtualize Items="EndpointRows()" Context="row" ItemSize="24" OverscanCount="12">
                @if (row.Route is null) {
                    <div class="ep-ns" @onclick="@(() => ToggleGroup(row.Ns))">
                        <span class="ep-caret @(_collapsed.Contains(row.Ns) ? "" : "ep-caret-open")"></span>@(row.Ns)/
                    </div>
                } else {
                    <div class="ep @(State.Selected?.Path == row.Route.Path ? "active" : "")"
                         @onclick="@(() => OnSelectEndpoint.InvokeAsync(row.Route))">
                        <span class="ep-name">@row.Label</span>
                        @if (row.Route.RequestWrapped || row.Route.ResponseWrapped) {
                            <span class="ep-signed">
                                <Icon Name="lock" Class="icon-sm"/>
                            </span>
                        }
                    </div>
                }
            </Virtualize>
        </div>
    </WorkbenchSection>
</div>

<div class="wb-rail-slot awb-rail-hist @(State.HistoryOpen ? "awb-rail-hist-open" : "")">
    <div class="insp-disc awb-hist @(State.HistoryOpen ? "" : "collapsed")">
        <div class="insp-disc-head">
            <button type="button" class="insp-disc-toggle" @onclick="ToggleHistory">
                <span class="ep-caret @(State.HistoryOpen ? "ep-caret-open" : "")"></span>@HistoryLabel
            </button>
            @if (State.HistoryOpen && State.History.Count > 0) {
                <button type="button" class="btn-mini btn-danger" @onclick="OnClearHistory">
                    <Icon Name="trash-2" Class="icon-sm"/> Clear
                </button>
            }
        </div>
        <div class="insp-disc-body awb-hist-body">
            <HistoryPanel History="State.History" OnRestoreHistory="OnRestoreHistory" OnDeleteHistory="OnDeleteHistory"/>
        </div>
    </div>
</div>

@code {
    [Inject] public ApiWorkbenchState State { get; set; } = default!;

    [Parameter] public string Filter { get; set; } = "";
    [Parameter] public EventCallback<RouteInfo> OnSelectEndpoint { get; set; }
    [Parameter] public EventCallback OnOpenSalt { get; set; }
    [Parameter] public bool ShowRouteCatalog { get; set; }
    [Parameter] public bool RouteCatalogSelected { get; set; }
    [Parameter] public EventCallback OnOpenRouteCatalog { get; set; }
    [Parameter] public RouteCatalogSummary? RouteSummary { get; set; }
    [Parameter] public EventCallback<InspectorHistoryEntry> OnRestoreHistory { get; set; }
    [Parameter] public EventCallback<string> OnDeleteHistory { get; set; }
    [Parameter] public EventCallback OnClearHistory { get; set; }

    readonly HashSet<string> _collapsed = [];

    List<RouteInfo>? _routes;
    List<RailRow>? _rows;
    string? _rowsKey;

    string EndpointsLabel => $"Endpoints ({Routes().Count})";

    string HistoryLabel => $"History ({State.History.Count})";

    List<RouteInfo> Routes() {
        return _routes ??= [.. Catalog.All()];
    }

    void ToggleHistory() {
        State.HistoryOpen = !State.HistoryOpen;
    }

    void ToggleGroup(string ns) {
        if (!_collapsed.Remove(ns)) _collapsed.Add(ns);
        _rowsKey = null;
    }

    List<RailRow> EndpointRows() {
        var key = Filter.Trim();
        if (_rowsKey == key && _rows is not null) return _rows;
        _rowsKey = key;
        _rows = BuildEndpointRows(key);
        return _rows;
    }

    List<RailRow> BuildEndpointRows(string needle) {
        var routes = Routes();
        var source = needle.Length == 0
            ? routes
            : [.. routes.Where(e => e.Path.Contains(needle, StringComparison.OrdinalIgnoreCase))];

        var rows = new List<RailRow>();
        foreach (var group in RouteNamespaces.Group(source, e => e.Path)) {
            rows.Add(new RailRow(group.Key, null, ""));
            if (_collapsed.Contains(group.Key)) continue;
            foreach (var e in group) rows.Add(new RailRow(group.Key, e, RouteNamespaces.LocalPath(e.Path)));
        }

        return rows;
    }

}
