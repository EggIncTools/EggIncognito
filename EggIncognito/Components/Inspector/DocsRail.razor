@using EggIncognito.Models.Inspector
@using EggIncognito.Services.Api
@using EggIncognito.Services.Inspector
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IDocRegistry Registry
@inject IRouteCatalog Catalog
@inject ApiWorkbenchState State

@{ EnsureRows(); }
<div class="wb-rail-slot awb-rail-list docs-rail-half">
    <WorkbenchSection Label="@($"Messages ({_messageCount})")" Scroll="true">
        @if (_messageRows is { Count: 0 }) {
            <div class="docs-rail-empty">No message matches the filter.</div>
        } else {
            <div class="insp-list">
                <Virtualize Items="_messageRows" Context="row" ItemSize="24" OverscanCount="12">
                    <div class="ep @(row.Depth > 0 ? "ep-nested" : "") @(IsActive(row.Leaf) ? "active" : "")"
                         style="@DepthStyle(row.Depth)" @onclick="@(() => Select(row.Leaf))">
                        @if (row.HasChildren) {
                            <span class="ep-caret @(row.Expanded ? "ep-caret-open" : "")"
                                  @onclick="@(() => ToggleMessage(row.Key))" @onclick:stopPropagation="true">
                            </span>
                        }
                        <span class="ep-name">@row.Label</span>
                    </div>
                </Virtualize>
            </div>
        }
    </WorkbenchSection>
</div>

<div class="wb-rail-slot awb-rail-list docs-rail-half">
    <WorkbenchSection Label="@($"Endpoints ({_endpointCount})")" Scroll="true">
        @if (_endpointRows is { Count: 0 }) {
            <div class="docs-rail-empty">No endpoint matches the filter.</div>
        } else {
            <div class="insp-list">
                <Virtualize Items="_endpointRows" Context="row" ItemSize="24" OverscanCount="12">
                    @if (row.Leaf is null) {
                        <div class="ep-ns" @onclick="@(() => ToggleEndpoints(row.Key))">
                            <span class="ep-caret @(row.Expanded ? "ep-caret-open" : "")"></span>@row.Label
                        </div>
                    } else {
                        <div class="ep @(IsActive(row.Leaf) ? "active" : "")" @onclick="@(() => Select(row.Leaf))">
                            <span class="ep-name">@row.Label</span>
                            @if (row.Locked) {
                                <span class="ep-signed">
                                    <Icon Name="lock" Class="icon-sm"/>
                                </span>
                            }
                        </div>
                    }
                </Virtualize>
            </div>
        }
    </WorkbenchSection>
</div>

@code {
    const string MessagesRoot = "messages";
    const string EndpointsRoot = "endpoints";

    [Parameter] public string? Filter { get; set; }
    [Parameter] public EventCallback<DocSubjectRef> OnSelectSubject { get; set; }

    readonly RailExpansion _messages = new();
    readonly RailExpansion _endpoints = new();

    List<DocRailRow> _messageRows = [];
    List<DocRailRow> _endpointRows = [];
    int _messageCount;
    int _endpointCount;
    string? _rowsKey;
    int _version;
    Dictionary<string, RouteInfo>? _routes;

    void EnsureRows() {
        var needle = (Filter ?? "").Trim();
        var selected = State.Kind == ApiSelectionKind.Docs ? State.Docs : null;
        var followedMessages = _messages.Follow(SelectionKey(selected, DocSubjectKind.Message), MessageAncestors(selected));
        var followedEndpoints = _endpoints.Follow(SelectionKey(selected, DocSubjectKind.Endpoint), EndpointAncestors(selected));
        var key = $"{needle}\n{_version}";
        if (!followedMessages && !followedEndpoints && key == _rowsKey) return;
        _rowsKey = key;
        _messageRows = BuildMessages(needle);
        _endpointRows = BuildEndpoints(needle);
    }

    void ToggleMessage(string key) {
        _messages.Toggle(key);
        _version++;
    }

    void ToggleEndpoints(string key) {
        _endpoints.Toggle(key);
        _version++;
    }

    Task Select(DocSubject? leaf) {
        return leaf is null ? Task.CompletedTask : OnSelectSubject.InvokeAsync(RefFor(leaf));
    }

    static DocSubjectRef RefFor(DocSubject leaf) {
        return new DocSubjectRef(DocSubjectKinds.Parse(leaf.Kind), leaf.Key);
    }

    bool IsActive(DocSubject? leaf) {
        return leaf is not null && State.Kind == ApiSelectionKind.Docs && State.Docs == RefFor(leaf);
    }

    static string? SelectionKey(DocSubjectRef? selected, DocSubjectKind kind) {
        return selected is not null && selected.Kind == kind ? selected.Key : null;
    }

    static IEnumerable<string> MessageAncestors(DocSubjectRef? selected) {
        if (selected is not { Kind: DocSubjectKind.Message }) yield break;
        for (var i = selected.Key.IndexOf('.'); i > 0; i = selected.Key.IndexOf('.', i + 1)) yield return selected.Key[..i];
    }

    static IEnumerable<string> EndpointAncestors(DocSubjectRef? selected) {
        return selected is { Kind: DocSubjectKind.Endpoint } ? [RouteNamespaces.Of(selected.Key)] : [];
    }

    static string? DepthStyle(int depth) {
        return depth > 0 ? $"--ep-depth: {depth}" : null;
    }

    IReadOnlyList<DocSubject> RootChildren(string key) {
        return Registry.Roots().FirstOrDefault(r => r.Key == key)?.Children ?? [];
    }

    List<DocRailRow> BuildMessages(string needle) {
        var children = RootChildren(MessagesRoot);
        var visible = needle.Length == 0 ? null : Visible(children, needle);
        var included = new List<DocSubject>();
        var present = new HashSet<string>(StringComparer.Ordinal);
        foreach (var c in children) {
            if (visible is not null && !visible.Contains(c.Key)) continue;
            included.Add(c);
            present.Add(c.Key);
        }

        _messageCount = included.Count;
        var byParent = new Dictionary<string, List<DocSubject>>(StringComparer.Ordinal);
        var top = new List<DocSubject>();
        foreach (var c in included) {
            if (c.Parent is null || !present.Contains(c.Parent)) {
                top.Add(c);
                continue;
            }

            if (!byParent.TryGetValue(c.Parent, out var kids)) {
                kids = [];
                byParent[c.Parent] = kids;
            }

            kids.Add(c);
        }

        var rows = new List<DocRailRow>();
        Walk(rows, top, byParent, visible is not null);
        return rows;
    }

    void Walk(List<DocRailRow> rows, List<DocSubject> nodes, Dictionary<string, List<DocSubject>> byParent, bool filtering) {
        foreach (var n in nodes) {
            var kids = byParent.GetValueOrDefault(n.Key);
            var has = kids is { Count: > 0 };
            var open = has && (filtering || _messages.IsOpen(n.Key));
            rows.Add(new DocRailRow(n.Key, n, ShortName(n.Key), Depth(n.Key), has, open, false));
            if (open && kids is not null) Walk(rows, kids, byParent, filtering);
        }
    }

    List<DocRailRow> BuildEndpoints(string needle) {
        var endpoints = RootChildren(EndpointsRoot);
        var source = needle.Length == 0 ? endpoints : [.. endpoints.Where(e => Matches(e.Key, needle))];
        _endpointCount = source.Count;
        var rows = new List<DocRailRow>();
        foreach (var group in RouteNamespaces.Group(source, e => e.Key)) {
            var open = needle.Length > 0 || _endpoints.IsOpen(group.Key);
            rows.Add(new DocRailRow(group.Key, null, group.Key + "/", 0, true, open, false));
            if (!open) continue;
            foreach (var e in group) {
                rows.Add(new DocRailRow(e.Key, e, RouteNamespaces.LocalPath(e.Key), 0, false, false, Locked(e.Key)));
            }
        }

        return rows;
    }

    bool Locked(string path) {
        if (_routes is null) {
            _routes = [with(StringComparer.Ordinal)];
            foreach (var r in Catalog.All()) _routes[r.Path] = r;
        }

        return _routes.GetValueOrDefault(path) is { } route && (route.RequestWrapped || route.ResponseWrapped);
    }

    static int Depth(string key) {
        return key.Count(c => c == '.');
    }

    static string ShortName(string key) {
        var i = key.LastIndexOf('.');
        return i < 0 ? key : key[(i + 1)..];
    }

    static HashSet<string> Visible(IReadOnlyList<DocSubject> children, string needle) {
        var byKey = new Dictionary<string, DocSubject>(StringComparer.Ordinal);
        foreach (var c in children) byKey[c.Key] = c;

        var set = new HashSet<string>(StringComparer.Ordinal);
        foreach (var c in children) {
            if (!Matches(c.Title, needle) && !Matches(c.Key, needle)) continue;
            set.Add(c.Key);
            var parent = c.Parent;
            while (parent is not null && set.Add(parent)) parent = byKey.GetValueOrDefault(parent)?.Parent;
        }

        return set;
    }

    static bool Matches(string text, string needle) {
        return text.Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

}
