@inject ILogger<LiveConsentDialog> Logger

@if (Open) {
    <ModalShell Title="Live API mode" TitleId="liveConsentTitle" Width="ModalWidth.Small" OnClose="OnClose">
        <div class="modal-body">
            <p class="text-muted text-sm mt-0">
                This sends real requests to the Egg, Inc. API (auxbrain.com) using the values you provide.
                You are solely responsible for how you use it. The developers of EggIncognito accept no
                responsibility for any misuse or for any consequences of that use.
            </p>
            <div class="insp-dialog-foot">
                <button type="button" class="btn-secondary" @ref="_cancelRef" @onclick="OnClose">Cancel</button>
                <button type="button" class="btn-primary" @onclick="OnAccept">I understand, enable Live API</button>
            </div>
        </div>
    </ModalShell>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnAccept { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    ElementReference _cancelRef;
    bool _wasOpen;
    bool _focus;

    protected override void OnParametersSet() {
        if (Open && !_wasOpen) _focus = true;
        _wasOpen = Open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!_focus) return;
        _focus = false;
        try {
            await _cancelRef.FocusAsync();
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "could not focus the consent dialog cancel button");
        }
    }

}
