@using System.Globalization
@using System.Text.Json
@using EggIncognito.Models.Inspector
<div class="forensics">
    <div class="forensics-input">
        <textarea class="raw-json forensics-paste" spellcheck="false" placeholder="Paste base64 to diagnose..."
                  @attributes="InputAttrs.NoAutofill"
                  @bind="_manualB64" @bind:event="oninput"></textarea>
        <button class="btn-primary" disabled="@(string.IsNullOrWhiteSpace(_manualB64))" @onclick="RunManual">Diagnose</button>
    </div>

    @if (Result is null) {
        <div class="muted">No diagnosis yet. A failed decode auto-populates here, or paste bytes above.</div>
    } else if (Result.Error is not null) {
        <div class="error-box">@Result.Error</div>
    } else {
        <div class="resp-status @(Result.Ok ? "ok" : "bad")">@(Result.Ok ? "structurally valid" : "corruption found")</div>

        @if (Result.FirstError is not null) {
            <div class="section-head">
                <h3>First break</h3>
            </div>
            <div class="forensics-break">
                <div>byte <strong>@Result.FirstError.Offset</strong> of @Result.TotalLen: @Result.FirstError.Message</div>
                <div class="muted">path @Result.FirstError.Path@(Result.FirstError.ResolvedPath is null ? "" : $" ({Result.FirstError.ResolvedPath})")</div>
            </div>
            @if (Result.HexAround is not null) {
                <div class="bytes-label">hex (error byte marked)</div>
                <div class="bytes">@HexMarked(Result.HexAround)</div>
            }
        }

        @if (Result.Salvaged is { Count: > 0 }) {
            <div class="section-head">
                <h3>Salvaged strings</h3>
            </div>
            <div class="forensics-salvage">
                @foreach (var s in Result.Salvaged) {
                    <div>
                        <span class="muted">@s.Offset:</span> @s.Text
                    </div>
                }
            </div>
        }

        @if (Result.Recovered?.Fields is { Count: > 0 }) {
            <div class="section-head">
                <h3>Recovered fields (past the break)</h3>
            </div>
            <div class="forensics-recovered">
                @foreach (var f in Result.Recovered.Fields) {
                    <div class="forensics-rfield @(f.Bad ? "bad" : "")">
                        <span class="muted">@(f.ResolvedName ?? $"#{f.Field}")</span>
                        <span class="forensics-wire">@f.Wire</span>
                        <span>@f.Value</span>
                    </div>
                }
            </div>
        }

        <div class="section-head">
            <h3>Field tree (@Result.NodesWalked nodes)</h3>
        </div>
        <div class="forensics-tree">
            @if (Result.Tree is not null) {
                @foreach (var n in Result.Tree) {
                    @TreeNode(n, 0)
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public DiagnoseDto? Result { get; set; }
    [Parameter] public string? RootType { get; set; }
    [Parameter] public Func<HttpClient> ClientFactory { get; set; } = default!;

    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    string _manualB64 = "";

    async Task RunManual() {
        try {
            var res = await ClientFactory().PostAsJsonAsync("/api/tools/diagnose",
                new { Base64 = _manualB64, RootType }, JsonOpts);
            Result = await res.Content.ReadFromJsonAsync<DiagnoseDto>(JsonOpts);
        }
        catch (Exception ex) {
            Result = new DiagnoseDto(false, 0, 0, null, null, null, null, null, ex.Message);
        }
    }

    static string DepthStyle(int depth) {
        return "--forensics-depth: " + (depth * 0.875).ToString("0.###", CultureInfo.InvariantCulture) + "rem";
    }

    RenderFragment HexMarked(HexWindowDto w) => builder => {
        var seq = 0;
        for (var i = 0; i < w.Hex.Length; i += 2) {
            var byteIdx = i / 2;
            var pair = w.Hex.Substring(i, Math.Min(2, w.Hex.Length - i));
            if (byteIdx == w.ErrorIndexInWindow) {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "hex-error");
                builder.AddContent(seq++, pair);
                builder.CloseElement();
            } else builder.AddContent(seq++, pair);

            builder.AddContent(seq++, " ");
        }
    };

    RenderFragment TreeNode(WireNodeDto n, int depth) => @<div class="forensics-node @(n.SchemaMismatch ? "mismatch" : "")"
                                                               style="@DepthStyle(depth)">
                                                             <span class="muted">@n.Path</span>
                                                             @if (n.ResolvedName is not null) {
                                                                 <span class="forensics-name">@n.ResolvedName</span>
                                                             }
                                                             <span class="forensics-wire">@n.Wire</span>
                                                             <span class="muted">@@@n.Offset@(n.Len is null ? "" : $", len {n.Len}")</span>
                                                             @if (n.Children is { Count: > 0 }) {
                                                                 @foreach (var c in n.Children) {
                                                                     @TreeNode(c, depth + 1)
                                                                 }
                                                             }
                                                         </div>;

}
