@using EggIncognito.Components.Capture
@using EggIncognito.Models.Inspector
@if (Response is null) {
    <div class="muted">No response yet.</div>
} else if (Response.Error is not null && (Response.Stages is null || Response.Stages.Count == 0)
                                      && Response.Status is null) {
    <div class="error-box">@Response.Error</div>
    @if (!string.IsNullOrEmpty(Response.Resolution)) {
        <div class="error-fix">
            <span class="fix-label">Possible fix:</span> @Response.Resolution
        </div>
    }
} else {
    var ok = Response.Status is >= 200 and < 300;
    <div class="resp-status @(ok ? "ok" : "bad")">HTTP @(Response.Status?.ToString() ?? "?")</div>

    @if (Response.Stages is { Count: > 0 }) {
        <Pipeline Stages="Response.Stages"/>
    }

    @if (Response.Error is not null) {
        <div class="error-box">@Response.Error</div>
        @if (!string.IsNullOrEmpty(Response.Resolution)) {
            <div class="error-fix">
                <span class="fix-label">Possible fix:</span> @Response.Resolution
            </div>
        }
    }

    @if (Response.WrappedMismatch) {
        <div class="error-fix">
            <span class="fix-label">Route mismatch:</span>
            This route declares responseWrapped: false, but the response is AuthenticatedMessage-wrapped.
            @if (IsAdmin) {
                <button type="button" class="btn-mini" disabled="@FixBusy" @onclick="@(() => OnFixWrapped.InvokeAsync())">
                    @(FixBusy ? "Setting..." : "Set responseWrapped: true")
                </button>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Response.Json) || !string.IsNullOrEmpty(Response.RawBase64)) {
        <CodeFormats Key="Response" Label="Response" Json="@Response.Json" RawBase64="@Response.RawBase64"
                     View="_view" Choice="_formatChoice" EmptyNote="(no decoded response body)"/>
    }
}

@code {
    [Parameter] public SendResponse? Response { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public bool FixBusy { get; set; }
    [Parameter] public EventCallback OnFixWrapped { get; set; }

    readonly CaptureViewState _view = new();
    readonly Dictionary<string, string> _formatChoice = new();
}
