@using EggIncognito.Models.Inspector
@if (Build is not null) {
    <Disclosure Open="_sentOpen" OpenChanged="@(_ => ToggleSent())" Label="Sent">
        <Pipeline Stages="Build"/>
    </Disclosure>
}

@if (Response is not null) {
    <Disclosure Open="_receivedOpen" OpenChanged="@(o => _receivedOpen = o)" Label="Received">
        <Tools>
            @if (CanSaveDb && Response.Json is not null) {
                <button type="button" class="btn-mini" @onclick="OnSaveToDb">
                    <Icon Name="database" Class="icon-sm"/> Save to DB
                </button>
            }
        </Tools>
        <ChildContent>
            <ResponsePanel Response="Response" IsAdmin="IsAdmin" FixBusy="FixBusy" OnFixWrapped="OnFixWrapped"/>
        </ChildContent>
    </Disclosure>
}

@if (Diagnosis is not null) {
    <Disclosure Open="_diagOpen" OpenChanged="@(o => _diagOpen = o)" Label="Diagnosis">
        <Forensics Result="Diagnosis" RootType="@RootType" ClientFactory="ClientFactory"/>
    </Disclosure>
}

@code {
    [Parameter] public List<TransportStage>? Build { get; set; }
    [Parameter] public SendResponse? Response { get; set; }
    [Parameter] public DiagnoseDto? Diagnosis { get; set; }
    [Parameter] public string? RootType { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public bool FixBusy { get; set; }
    [Parameter] public EventCallback OnFixWrapped { get; set; }
    [Parameter] public Func<HttpClient> ClientFactory { get; set; } = default!;
    [Parameter] public bool CanSaveDb { get; set; }
    [Parameter] public EventCallback OnSaveToDb { get; set; }

    bool _sentOpen = true;
    bool _receivedOpen = true;
    bool _diagOpen;
    bool _sentTouched;

    object? _lastBuild;
    object? _lastResponse;
    object? _lastDiagnosis;

    protected override void OnParametersSet() {
        if (!ReferenceEquals(_lastBuild, Build)) {
            _lastBuild = Build;
            _sentTouched = false;
            _sentOpen = true;
        }

        if (!ReferenceEquals(_lastResponse, Response)) {
            _lastResponse = Response;
            if (Response is not null && !_sentTouched) _sentOpen = false;
        }

        if (!ReferenceEquals(_lastDiagnosis, Diagnosis)) {
            _lastDiagnosis = Diagnosis;
            if (Diagnosis is not null) _diagOpen = true;
        }
    }

    void ToggleSent() {
        _sentOpen = !_sentOpen;
        _sentTouched = true;
    }

}
