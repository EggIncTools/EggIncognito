@if (Show) {
    <div class="path-param-row">
        <label>
            URL path parameter (e.g. EID)
            <button type="button" class="forget-eids" @onclick="OnForget">forget</button>
        </label>
        <input list="recentEids" placeholder="EI1234567890123456" @attributes="InputAttrs.NoAutofill"
               @bind:get="Value" @bind:set="v => ValueChanged.InvokeAsync(v)" @bind:event="oninput"/>
    </div>
}
<datalist id="recentEids">
    @foreach (var eid in RecentEids) {
        <option value="@eid"/>
    }
</datalist>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<string> RecentEids { get; set; } = [];
    [Parameter] public EventCallback OnForget { get; set; }
}
