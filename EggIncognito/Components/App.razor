@using EggIncognito.Services.Theme
@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment HostEnvironment
@inject ThemeResolver Themes
<!DOCTYPE html>
<html lang="en" data-eggidentity-theme="@(_theme is null ? null : "u")">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <title>@_meta.Title</title>
    <link rel="icon" type="image/png" href="/brand/icon-trimmed.png"/>

    <meta name="description" content="@_meta.Description"/>
    <meta name="theme-color" content="@(_subProd ? "#469a5e" : "#ef7559")"/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="EggIncognito"/>
    <meta property="og:title" content="@_meta.Title"/>
    <meta property="og:description" content="@_meta.Description"/>
    <meta property="og:url" content="@_canonicalUrl"/>
    <meta property="og:image" content="https://eggincognito.egginc.tools/brand/logo.png"/>
    <meta property="og:image:alt" content="EggIncognito"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="@_meta.Title"/>
    <meta name="twitter:description" content="@_meta.Description"/>
    <meta name="twitter:image" content="https://eggincognito.egginc.tools/brand/logo.png"/>

    <link rel="stylesheet" href="@($"/nav.css?v={_assetVersion}")"/>
    <link rel="stylesheet" href="@($"/styles.css?v={_assetVersion}")"/>
    <link rel="stylesheet" href="@($"/EggIncognito.styles.css?v={_assetVersion}")"/>
    @if (_subProd) {
        <link rel="stylesheet" href="@($"/subprod.css?v={_assetVersion}")"/>
    }
    @if (_theme is { HueRotation: true }) {
        @_huePropertyBlock
    }
    @if (_theme is not null) {
        <style id="egi-theme" nonce="@_nonce">@((MarkupString)_theme.Css)</style>
    }
    <script src="@($"/interop/themeBoot.js?v={_assetVersion}")" data-lock-accent="@(_subProd ? "1" : null)"></script>
    <HeadOutlet/>
</head>
<body class="m-0 bg-bg text-fg font-sans">
<Routes/>

<dialog id="components-reconnect-modal">
    <div class="reconnect-card">
        <div class="components-rejoining-animation reconnect-spinner" aria-hidden="true"></div>
        <p class="reconnect-msg reconnect-first">Lost the connection to the server. Trying to get you back...</p>
        <p class="reconnect-msg reconnect-repeated">
            Still trying to reconnect. Next attempt in
            <span id="components-seconds-to-next-attempt"></span>s...
        </p>
        <p class="reconnect-msg reconnect-failed">Could not reconnect. Check your network, then try again.</p>
        <p class="reconnect-msg reconnect-pause">Connection paused. Picking it back up...</p>
        <p class="reconnect-msg reconnect-resume-failed">This session has expired. Reload to pick up where you left off.</p>
        <div class="reconnect-actions">
            <button type="button" id="components-reconnect-button" class="btn-primary">Try again</button>
            <button type="button" id="components-resume-button" class="btn-primary">Reload</button>
        </div>
    </div>
</dialog>

<script src="_framework/blazor.web.js"></script>
<script src="_content/EggIdentity.UI/outsideClick.js"></script>
<script src="_content/EggIdentity.UI/scrollLock.js"></script>
<script src="_content/EggIdentity.UI/comboBoxPicker.js"></script>
<script src="_content/EggIdentity.UI/calendarScroll.js"></script>
<script src="_content/EggIdentity.Consent/consent.js"></script>
<script src="_content/EggIdentity.Visits/visits.js"></script>
<script src="@($"/interop/reconnectWatcher.js?v={_assetVersion}")"></script>
<script src="@($"/interop/tooltip.js?v={_assetVersion}")"></script>
</body>
</html>

@code {

    static readonly string _assetVersion =
        BuildInfo.FromAssembly("https://github.com/EggIncTools/EggIncognito").ShortSha;

    PageMeta.Meta _meta;
    string _canonicalUrl = "https://eggincognito.egginc.tools/";
    bool _subProd;
    ResolvedTheme? _theme;
    string? _nonce;
    MarkupString _huePropertyBlock;

    protected override async Task OnInitializedAsync() {
        _subProd = string.Equals(HostEnvironment.EnvironmentName, "Staging", StringComparison.OrdinalIgnoreCase);
        var ctx = HttpContextAccessor.HttpContext;
        var req = ctx?.Request;
        var path = req?.Path.Value;
        _meta = PageMeta.For(path);
        if (req is not null)
            _canonicalUrl = $"https://eggincognito.egginc.tools{(string.IsNullOrEmpty(path) ? "/" : path)}";
        _nonce = ctx?.Items["egi.csp.nonce"] as string;
        _theme = await Themes.ResolveAsync(ctx?.RequestAborted ?? CancellationToken.None);
        if (_theme is { HueRotation: true }) {
            var nonceAttr = _nonce is null ? "" : $" nonce=\"{_nonce}\"";
            _huePropertyBlock = new MarkupString(
                $"<style{nonceAttr}>@property --egi-hue-shift {{ syntax: \"<angle>\"; inherits: true; initial-value: 0deg; }}</style>");
        }
    }

}
