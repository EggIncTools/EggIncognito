@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<ModalShell> Logger
<div class="modal-backdrop" @onclick="BackdropClick">
    <div class="@CardCss" role="dialog" aria-modal="true" aria-labelledby="@TitleId" tabindex="-1"
         @ref="_card" @onkeydown="OnKeyDown" @onclick:stopPropagation="true">
        <div class="modal-head">
            <h3 class="modal-title" id="@TitleId">@Title</h3>
            @if (HeadTools is not null) {
                @HeadTools
            }
            @if (!HideClose) {
                <button type="button" class="reg-edit-btn" aria-label="Close" @onclick="Close">
                    <Icon Name="x"/>
                </button>
            }
        </div>
        @ChildContent
    </div>
</div>

@code {

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? TitleId { get; set; }
    [Parameter] public string? CardClass { get; set; }
    [Parameter] public ModalWidth Width { get; set; } = ModalWidth.Regular;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool HideClose { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? HeadTools { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    ElementReference _card;
    IJSObjectReference? _scrollLock;

    string CardCss {
        get {
            var css = "modal-card" + Width switch {
                ModalWidth.Small => " modal-card-sm",
                ModalWidth.Large => " modal-card-lg",
                _ => ""
            };
            return string.IsNullOrEmpty(CardClass) ? css : $"{css} {CardClass}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        await _card.FocusAsync();
        try {
            _scrollLock = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/scrollLock.js"));
            await _scrollLock.InvokeVoidAsync("lock");
        } catch (Exception ex) {
            Logger.LogDebug(ex, "modal scroll lock unavailable");
        }
    }

    public ValueTask DisposeAsync() {
        return _scrollLock.DisposeModuleQuietAsync("unlock", Logger);
    }

    Task BackdropClick() {
        return CloseOnBackdrop ? Close() : Task.CompletedTask;
    }

    Task Close() {
        return OnClose.InvokeAsync();
    }

    Task OnKeyDown(KeyboardEventArgs e) {
        return CloseOnEscape && e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
    }

}
