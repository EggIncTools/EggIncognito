@using System.Globalization
@using EggIdentity.AdminUi
@using EggIdentity.Client
@using EggIncognito.Components.Theme
@using Microsoft.AspNetCore.WebUtilities
@rendermode @(RenderModes.InteractiveServer)
@inject AuthState Auth
@inject ICurrentUser User
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject IServiceProvider Services
@inject ToastService Toasts

<button type="button" class="auth-name" @onclick="Open">
    @if (!string.IsNullOrEmpty(User.AvatarUrl)) {
        <img class="auth-avatar" src="@User.AvatarUrl" alt=""/>
    }
    @User.Username
</button>

@if (_open) {
    <ModalShell Title="Account" TitleId="accountModalTitle" CardClass="account-modal" CloseOnEscape="true" OnClose="Close">
        <div class="modal-body">
            @if (Auth.WidgetEnabled && !string.IsNullOrEmpty(_sessionToken)) {
                <ProfilePanel SessionToken="@_sessionToken" ReturnUrl="@_returnUrl">
                    <AvatarTemplate Context="ctx">
                        <div class="flex items-center gap-4 mb-4">
                            @if (!string.IsNullOrEmpty(ctx.AvatarUrl)) {
                                <img class="w-16 h-16 rounded-full bg-panel2 object-cover shrink-0" src="@LinkHref(ctx.AvatarUrl!)" alt="Profile picture"/>
                            } else {
                                <div class="w-16 h-16 rounded-full bg-panel2 shrink-0"></div>
                            }
                            <div class="flex flex-col gap-1.5 min-w-0">
                                <label class="btn-mini w-fit cursor-pointer">
                                    <Icon Name="upload" Class="icon-sm"/> Upload picture
                                    <InputFile class="hidden" OnChange="@ctx.OnFileSelected" accept="image/png,image/jpeg,image/webp"/>
                                </label>
                                <span class="text-muted text-xs">PNG, JPEG, or WebP, up to 2 MB.</span>
                                @if (ctx.Error is not null) {
                                    <span class="text-err text-xs">@ctx.Error</span>
                                }
                            </div>
                        </div>
                    </AvatarTemplate>
                    <ProvidersTemplate Context="ctx">
                        <hr class="my-3 border-0 border-t border-border"/>
                        @if (ctx.Banner is not null) {
                            <div class="text-muted text-sm mb-2">@ctx.Banner</div>
                        }
                        <table class="w-full border-collapse text-sm">
                            <tbody>
                            @foreach (var item in ctx.Items) {
                                <tr>
                                    <td class="py-2 pr-2 border-b border-border align-middle w-32">
                                        <span class="flex items-center gap-2 font-medium">
                                            <img class="acct-prov-icon" src="@LinkHref(_identity!.IconUrl(item.Provider))" alt="" loading="lazy"/>
                                            @Cap(item.Provider)
                                        </span>
                                    </td>
                                    <td class="py-2 px-2 border-b border-border align-middle min-w-0">
                                        @if (item.Identity is { } id) {
                                            <span class="flex items-center gap-2 min-w-0">
                                                @if (!string.IsNullOrEmpty(id.Avatar)) {
                                                    <button type="button" class="acct-chip" aria-label="Use this picture" @onclick="item.OnSelectAvatar">
                                                        <img src="@LinkHref(id.Avatar!)" alt=""/>
                                                    </button>
                                                }
                                                <span class="truncate">@(id.Username ?? id.Subject)</span>
                                                <span class="text-xs text-muted shrink-0">@id.LinkedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                                            </span>
                                        } else {
                                            <span class="text-xs text-muted">Not linked</span>
                                        }
                                    </td>
                                    <td class="py-2 pl-2 border-b border-border align-middle whitespace-nowrap text-right">
                                        @if (!item.Linked) {
                                            <a class="btn-mini" href="@LinkHref(item.LinkUrl)">Link</a>
                                        } else {
                                            @if (item.CanUnlink) {
                                                <button type="button" class="btn-mini btn-danger" @onclick="item.OnUnlink">Unlink</button>
                                            } else {
                                                <button type="button" class="btn-mini" disabled>Linked</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </ProvidersTemplate>
                </ProfilePanel>
            } else if (Auth.LocalIdentityActive) {
                <p class="text-muted m-0">Local identity session; linked logins and avatars are not available.</p>
            } else {
                <p class="text-muted m-0">Log in to manage your linked logins and avatar.</p>
            }
            @if (User.IsAuthenticated && !string.IsNullOrEmpty(_sessionToken)) {
                <ProfilePreferences SessionToken="@_sessionToken" OnChanged="OnProfileChanged"/>
            }
            <ThemePicker/>
        </div>
    </ModalShell>
}

@code {
    [Parameter] public EventCallback OnProfileChanged { get; set; }

    string _sessionToken = "";
    string _returnUrl = "";
    bool _open;
    bool _stripQuery;
    IdentityApiClient? _identity;

    protected override async Task OnInitializedAsync() {
        _identity = Services.GetService(typeof(IdentityApiClient)) as IdentityApiClient;
        _sessionToken = HttpContextAccessor.HttpContext?.Request.Cookies[Auth.SessionCookieName] ?? "";
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _returnUrl = uri.GetLeftPart(UriPartial.Path);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.ContainsKey("linked")) {
            Toasts.Push(StatusNoteKind.Ok, "Login linked.");
        } else if (query.ContainsKey("linkConflict")) {
            Toasts.Push(StatusNoteKind.Error, "That login already belongs to a different account, so it was not linked. Account merges go through an admin.");
        } else if (query.ContainsKey("linkError")) {
            Toasts.Push(StatusNoteKind.Error, "Linking failed. Try again.");
        } else {
            return;
        }

        _open = true;
        _stripQuery = true;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender && _stripQuery) {
            _stripQuery = false;
            Nav.NavigateTo(_returnUrl, replace: true);
        }
    }

    void Open() {
        _open = true;
    }

    void Close() {
        _open = false;
    }

    static string Cap(string s) {
        return string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];
    }

    string LinkHref(string url) {
        return url.StartsWith("http", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(Auth.IdentityHostUrl)
            ? url
            : $"{Auth.IdentityHostUrl!.TrimEnd('/')}/{url.TrimStart('/')}";
    }

}
