@using System.Globalization
@using EggIdentity.AdminUi
@using EggIdentity.Client
@using EggIncognito.Components.Theme
@using EggIncognito.Services.Assets
@using EggIncognito.Services.Events
@using Microsoft.AspNetCore.WebUtilities
@rendermode @(RenderModes.InteractiveServer)
@inject AuthState Auth
@inject ICurrentUser User
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject IServiceProvider Services
@inject ToastService Toasts
@inject EggIdentity.UI.Suite.SuiteContext Suite
@inject ILogger<AccountModal> Logger

@if (ShowTrigger) {
    <Tooltip Text="Account settings">
        <button type="button" class="auth-gear" aria-label="Account settings" @onclick="Show">
            <Icon Name="settings" Class="icon-sm"/>
        </button>
    </Tooltip>
}

@if (_open) {
    <ModalShell Title="Account" TitleId="accountModalTitle" CardClass="account-modal" CloseOnEscape="true" OnClose="Close">
        <div class="modal-body">
            @if (Auth.WidgetEnabled && !string.IsNullOrEmpty(_sessionToken)) {
                <ProfilePanel SessionToken="@_sessionToken" ReturnUrl="@_returnUrl">
                    <AvatarTemplate Context="ctx">
                        <div class="acct-avatar-row">
                            @if (!string.IsNullOrEmpty(ctx.AvatarUrl)) {
                                <img class="acct-avatar" src="@LinkHref(ctx.AvatarUrl!)" alt="Profile picture"/>
                            } else {
                                <div class="acct-avatar"></div>
                            }
                            <div class="acct-avatar-tools">
                                <label class="btn-mini acct-upload">
                                    <Icon Name="upload" Class="icon-sm"/> Upload picture
                                    <InputFile OnChange="@ctx.OnFileSelected" accept="image/png,image/jpeg,image/webp"/>
                                </label>
                                <span class="acct-hint">PNG, JPEG, or WebP, up to 2 MB.</span>
                                @if (ctx.Error is not null) {
                                    <span class="acct-err">@ctx.Error</span>
                                }
                            </div>
                        </div>
                    </AvatarTemplate>
                    <ProvidersTemplate Context="ctx">
                        <hr class="acct-rule"/>
                        @if (ctx.Banner is not null) {
                            <div class="acct-banner">@ctx.Banner</div>
                        }
                        <table class="acct-table">
                            <tbody>
                            @foreach (var item in ctx.Items) {
                                <tr>
                                    <td>
                                        <span class="acct-prov">
                                            <img class="acct-prov-icon" src="@LinkHref(_identity!.IconUrl(item.Provider))" alt="" loading="lazy"/>
                                            @EggIcons.Pretty(item.Provider)
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Identity is { } id) {
                                            <span class="acct-id">
                                                @if (!string.IsNullOrEmpty(id.Avatar)) {
                                                    <button type="button" class="acct-chip" aria-label="Use this picture" @onclick="item.OnSelectAvatar">
                                                        <img src="@LinkHref(id.Avatar!)" alt=""/>
                                                    </button>
                                                }
                                                <span class="acct-id-name">@(id.Username ?? id.Subject)</span>
                                                <span class="acct-id-date">@ViewerClock.At(Services, id.LinkedAt).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                                            </span>
                                        } else {
                                            <span class="acct-hint">Not linked</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!item.Linked) {
                                            <a class="btn-mini" href="@LinkHref(item.LinkUrl)">Link</a>
                                        } else {
                                            @if (item.CanUnlink) {
                                                <button type="button" class="btn-mini btn-danger" @onclick="item.OnUnlink">Unlink</button>
                                            } else {
                                                <button type="button" class="btn-mini" disabled>Linked</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <div class="acct-actions">
                            <button type="button" class="btn-mini" disabled="@_syncing" @onclick="SyncIdentities">
                                <Icon Name="refresh-cw" Class="icon-sm"/> @(_syncing ? "Syncing..." : "Sync from providers")
                            </button>
                        </div>
                    </ProvidersTemplate>
                </ProfilePanel>
            } else if (Auth.LocalIdentityActive) {
                <p class="acct-note">Local identity session; linked logins and avatars are not available.</p>
            } else {
                <p class="acct-note">Log in to manage your linked logins and avatar.</p>
            }
            @if (User.Current.IsAuthenticated && !string.IsNullOrEmpty(_sessionToken)) {
                <ProfilePreferences SessionToken="@_sessionToken" OnChanged="OnProfileChanged"/>
            }
            <AccountEidEditor/>
            <ThemePicker/>
        </div>
    </ModalShell>
}

@code {
    [Parameter] public EventCallback OnProfileChanged { get; set; }

    [Parameter] public bool ShowTrigger { get; set; } = true;

    string _sessionToken = "";
    bool _syncing;
    string _returnUrl = "";
    bool _open;
    bool _stripQuery;
    IdentityApiClient? _identity;

    protected override async Task OnInitializedAsync() {
        _identity = Services.GetService(typeof(IdentityApiClient)) as IdentityApiClient;
        _sessionToken = HttpContextAccessor.HttpContext?.Request.Cookies[Auth.SessionCookieName] ?? "";
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _returnUrl = uri.GetLeftPart(UriPartial.Path);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.ContainsKey("linked")) {
            Toasts.Push(StatusNoteKind.Ok, "Login linked.");
        } else if (query.ContainsKey("linkConflict")) {
            Toasts.Push(StatusNoteKind.Error, "That login already belongs to a different account, so it was not linked. Account merges go through an admin.");
        } else if (query.ContainsKey("linkError")) {
            Toasts.Push(StatusNoteKind.Error, "Linking failed. Try again.");
        } else {
            return;
        }

        _open = true;
        _stripQuery = true;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender && _stripQuery) {
            _stripQuery = false;
            Nav.NavigateTo(_returnUrl, replace: true);
        }
    }

    Task Show() {
        _open = true;
        return Suite.LoadAsync();
    }

    public Task Open() {
        var load = Show();
        StateHasChanged();
        return load;
    }

    async Task SyncIdentities() {
        _syncing = true;
        try {
            await Suite.SyncIdentitiesAsync();
            Toasts.Push(StatusNoteKind.Ok, "Linked logins synced from their providers.");
        } catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) {
            Logger.LogDebug(ex, "linked identities could not be synced");
            Toasts.Push(StatusNoteKind.Error, "Sync failed. Try again.");
        } finally {
            _syncing = false;
        }
    }

    void Close() {
        _open = false;
    }

    string LinkHref(string url) {
        return !url.StartsWith('/') || string.IsNullOrEmpty(Auth.IdentityHostUrl)
            ? url
            : $"{Auth.IdentityHostUrl!.TrimEnd('/')}{url}";
    }

}
