@using System.Net
@using System.Text.Json
@using EggIncognito.Models.Admin
@using EggIncognito.Models.ApiKeys
@inherits SelfCallComponentBase
@inject ToastService Toasts
@inject ILogger<ApiKeysPanel> Logger

<div class="flex flex-col gap-4">
    <div class="apidoc">
        <div class="apidoc-body">
            <p class="m-0">Authenticate with the <span class="code-chip">X-Api-Key</span> header.</p>
            <pre class="apidoc-example">curl -H "X-Api-Key: &lt;your-key&gt;" @($"{_origin}/api/v1/data")</pre>
        </div>
    </div>
    @if (_noDb) {
        <p class="text-muted text-sm m-0">API keys need a database and are not available on this instance.</p>
    } else {
        @if (_minted is not null) {
            <div>
                <p class="text-sm mt-0 mb-1 font-semibold">Copy it now - it will not be shown again.</p>
                <pre class="result-pre">@_minted.Key</pre>
                <div class="flex items-center gap-3 mt-2">
                    <CopyButton Text="@_minted.Key" ButtonClass="btn-primary" ShowIcon="false" Label="Copy key" ResetDelayMs="0" OnCopied="@(() => _copied = true)"/>
                    <button type="button" class="btn-mini" @onclick="Dismiss">Done</button>
                    @if (_copied) {
                        <span class="text-green-400 text-sm">Copied.</span>
                    }
                </div>
            </div>
        } else {
            <div>
                @if (_keys is not null) {
                    <p class="text-muted text-xs mt-0 mb-2">@(_cap is { } c ? $"{ActiveCount}/{c} keys used" : "No key limit for your account.")</p>
                }
                <div class="flex items-end gap-3">
                    <label class="sub-field w-full max-w-xs">
                        <span class="sub-field-label">Name</span>
                        <input class="field-input w-full" placeholder="my integration" disabled="@AtCap" @bind="_name" @bind:event="oninput"/>
                    </label>
                    <button type="button" class="btn-primary shrink-0" disabled="@(_busy || AtCap || string.IsNullOrWhiteSpace(_name))" @onclick="Create">
                        @(_busy ? "Creating..." : "Create key")
                    </button>
                </div>
                @if (AtCap) {
                    <p class="text-muted text-sm mt-2 mb-0">Key limit reached - revoke a key to mint a new one.</p>
                }
            </div>
        }

        @if (_keys is null) {
            <p class="text-muted text-sm m-0">Loading...</p>
        } else if (_keys.Count == 0) {
            <div class="reg-empty">
                <div>No API keys yet.</div>
                <div class="reg-empty-hint">Create one above to use the data API.</div>
            </div>
        } else {
            <ApiKeysTable Rows="@TableRows" ShowOwner="false" Busy="_busyRow" OnRevoke="Revoke"/>
        }
    }
</div>

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    string _origin = "https://eggincognito.egginc.tools";

    bool _noDb;
    List<ApiKeysPanelRow>? _keys;
    int? _cap;
    string _name = "";
    bool _busy;
    private bool _busyRow { get; set; }

    Minted? _minted;
    bool _copied;

    int ActiveCount => _keys?.Count(k => !k.Revoked) ?? 0;

    bool AtCap => _cap is { } c && ActiveCount >= c;

    List<ApiKeyRow> TableRows => (_keys ?? []).Select(k => new ApiKeyRow(k.Id, null, k.Name, k.Prefix, k.LastUsedAt, k.RequestCount, k.Revoked)).ToList();

    protected override async Task OnInitializedAsync() {
        if (!string.IsNullOrEmpty(SelfBaseAddress)) _origin = SelfBaseAddress;
        await LoadKeys();
    }

    async Task LoadKeys() {
        try {
            var res = await Client().GetAsync("/api/v1/keys");
            if (res.StatusCode == HttpStatusCode.ServiceUnavailable) {
                _noDb = true;
                return;
            }

            if (res.IsSuccessStatusCode) {
                var body = await res.Content.ReadFromJsonAsync<KeysResponse>(JsonOpts);
                _keys = body?.Keys ?? [];
                _cap = body?.Cap;
            } else {
                _keys ??= [];
            }
        }
        catch {
            _keys ??= [];
        }
    }

    async Task Create() {
        _busy = true;
        _copied = false;
        try {
            var res = await Client().PostAsJsonAsync("/api/v1/keys", new { name = _name }, JsonOpts);
            if (res.IsSuccessStatusCode) {
                _minted = await res.Content.ReadFromJsonAsync<Minted>(JsonOpts);
                _name = "";
                await LoadKeys();
            } else if (res.StatusCode == HttpStatusCode.ServiceUnavailable) {
                _noDb = true;
            } else if (res.StatusCode == HttpStatusCode.Conflict) {
                string? msg = null;
                try {
                    msg = (await res.Content.ReadFromJsonAsync<ApiKeyErrorBody>(JsonOpts))?.Error;
                }
                catch (Exception ex) {
                    Logger.LogDebug(ex, "key conflict body unreadable");
                }

                Toasts.Push(StatusNoteKind.Error, string.IsNullOrWhiteSpace(msg) ? "Key limit reached." : msg);
            } else {
                Toasts.Push(StatusNoteKind.Error, $"Create failed ({(int)res.StatusCode}).");
            }
        }
        catch (Exception ex) {
            Toasts.Push(StatusNoteKind.Error, $"Create failed: {ex.Message}");
        }

        _busy = false;
    }

    async Task Revoke(long id) {
        _busyRow = true;
        try {
            var res = await Client().DeleteAsync($"/api/v1/keys/{id}");
            if (res.IsSuccessStatusCode) await LoadKeys();
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "revoking API key {KeyId} failed", id);
        }

        _busyRow = false;
    }

    void Dismiss() {
        _minted = null;
        _copied = false;
    }

}
