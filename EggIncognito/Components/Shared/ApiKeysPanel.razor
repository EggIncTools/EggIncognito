@using System.Net
@using System.Text.Json
@using EggIncognito.Models.Admin
@using EggIncognito.Models.ApiKeys
@inherits SelfCallComponentBase
@inject ToastService Toasts
@inject ILogger<ApiKeysPanel> Logger

<div class="akp">
    <div class="akp-doc">
        <p>Authenticate with the <span class="code-chip">X-Api-Key</span> header.</p>
        <pre class="akp-example">curl -H "X-Api-Key: &lt;your-key&gt;" @($"{_origin}/api/v1/data")</pre>
    </div>
    @if (_noDb) {
        <Note>API keys need a database and are not available on this instance.</Note>
    } else {
        @if (_minted is not null) {
            <div>
                <p class="akp-minted-note">Copy it now - it will not be shown again.</p>
                <pre class="result-pre">@_minted.Key</pre>
                <div class="akp-minted-actions">
                    <CopyButton Text="@_minted.Key" Class="btn-primary" ShowIcon="false" Label="Copy key" OnCopied="@(() => _copied = true)">Copy key</CopyButton>
                    <button type="button" class="btn-mini" @onclick="Dismiss">Done</button>
                    @if (_copied) {
                        <span class="akp-copied">Copied.</span>
                    }
                </div>
            </div>
        } else {
            <div>
                @if (_keys is not null) {
                    <p class="akp-cap">@(_cap is { } c ? $"{ActiveCount}/{c} keys used" : "No key limit for your account.")</p>
                }
                <div class="akp-create">
                    <FieldLabel Label="Name" Class="akp-name">
                        <input class="field-input" placeholder="my integration" disabled="@AtCap" @bind="_name" @bind:event="oninput"/>
                    </FieldLabel>
                    <button type="button" class="btn-primary" disabled="@(_busy || AtCap || string.IsNullOrWhiteSpace(_name))" @onclick="Create">
                        @(_busy ? "Creating..." : "Create key")
                    </button>
                </div>
                @if (AtCap) {
                    <Note Gap="true">Key limit reached - revoke a key to mint a new one.</Note>
                }
            </div>
        }

        @if (_keys is null) {
            <Note>Loading...</Note>
        } else if (_keys.Count == 0) {
            <EmptyState Tall="true" Title="No API keys yet." Hint="Create one above to use the data API."/>
        } else {
            <ApiKeysTable Rows="@TableRows" ShowOwner="false" Busy="_busyRow" OnRevoke="Revoke"/>
        }
    }
</div>

@code {
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    string _origin = "https://eggincognito.egginc.tools";

    bool _noDb;
    List<ApiKeysPanelRow>? _keys;
    int? _cap;
    string _name = "";
    bool _busy;
    private bool _busyRow { get; set; }

    Minted? _minted;
    bool _copied;

    int ActiveCount => _keys?.Count(k => !k.Revoked) ?? 0;

    bool AtCap => _cap is { } c && ActiveCount >= c;

    List<ApiKeyRow> TableRows => (_keys ?? []).Select(k => new ApiKeyRow(k.Id, null, k.Name, k.Prefix, k.LastUsedAt, k.RequestCount, k.Revoked)).ToList();

    protected override async Task OnInitializedAsync() {
        if (!string.IsNullOrEmpty(SelfBaseAddress)) _origin = SelfBaseAddress;
        await LoadKeys();
    }

    async Task LoadKeys() {
        try {
            var res = await Client().GetAsync("/api/v1/keys");
            if (res.StatusCode == HttpStatusCode.ServiceUnavailable) {
                _noDb = true;
                return;
            }

            if (res.IsSuccessStatusCode) {
                var body = await res.Content.ReadFromJsonAsync<KeysResponse>(JsonOpts);
                _keys = body?.Keys ?? [];
                _cap = body?.Cap;
            } else {
                _keys ??= [];
            }
        } catch {
            _keys ??= [];
        }
    }

    async Task Create() {
        _busy = true;
        _copied = false;
        try {
            var res = await Client().PostAsJsonAsync("/api/v1/keys", new { name = _name }, JsonOpts);
            if (res.IsSuccessStatusCode) {
                _minted = await res.Content.ReadFromJsonAsync<Minted>(JsonOpts);
                _name = "";
                await LoadKeys();
            } else if (res.StatusCode == HttpStatusCode.ServiceUnavailable) {
                _noDb = true;
            } else if (res.StatusCode == HttpStatusCode.Conflict) {
                string? msg = null;
                try {
                    msg = (await res.Content.ReadFromJsonAsync<ApiKeyErrorBody>(JsonOpts))?.Error;
                } catch (Exception ex) {
                    Logger.LogDebug(ex, "key conflict body unreadable");
                }

                Toasts.Push(StatusNoteKind.Error, string.IsNullOrWhiteSpace(msg) ? "Key limit reached." : msg);
            } else {
                Toasts.Push(StatusNoteKind.Error, $"Create failed ({(int)res.StatusCode}).");
            }
        } catch (Exception ex) {
            Toasts.Push(StatusNoteKind.Error, $"Create failed: {ex.Message}");
        }

        _busy = false;
    }

    async Task Revoke(long id) {
        _busyRow = true;
        try {
            var res = await Client().DeleteAsync($"/api/v1/keys/{id}");
            if (res.IsSuccessStatusCode) await LoadKeys();
        } catch (Exception ex) {
            Logger.LogWarning(ex, "revoking API key {KeyId} failed", id);
        }

        _busyRow = false;
    }

    void Dismiss() {
        _minted = null;
        _copied = false;
    }

}
