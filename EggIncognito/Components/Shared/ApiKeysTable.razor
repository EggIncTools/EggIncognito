@using EggIncognito.Models.Admin
@using EggIncognito.Services.Events
@inject IServiceProvider Services
<TableScroll>
    <table class="data-table akt">
        <thead>
        <tr>
            @if (ShowOwner) {
                <th>Owner</th>
                <th>Name</th>
                <th>Prefix</th>
            } else {
                <th>Prefix</th>
                <th>Name</th>
            }
            <th>Last used</th><th>Requests</th><th>Status</th><th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var k in Rows) {
            <tr class="@(!ShowOwner && k.Revoked ? "akt-revoked" : null)">
                @if (ShowOwner) {
                    <td class="mono">@k.OwnerUserId</td>
                    <td class="akt-name">@k.Name</td>
                    <td class="mono">@k.Prefix</td>
                } else {
                    <td class="mono">@($"{k.Prefix}…")</td>
                    <td class="akt-name">@k.Name</td>
                }
                <td class="muted">@(k.LastUsedAt is { } used ? ViewerClock.At(Services, used).ToString("yyyy-MM-dd HH:mm:ss") : "never")</td>
                <td class="mono">@k.RequestCount</td>
                <td>
                    <span class="@(k.Revoked ? "muted" : "text-ok")">@(k.Revoked ? "revoked" : "active")</span>
                </td>
                <td class="tools">
                    @if (OnDelete.HasDelegate) {
                        @if (!k.Revoked) {
                            <button type="button" class="btn-mini" disabled="@Busy" @onclick="() => OnRevoke.InvokeAsync(k.Id)">Revoke</button>
                        }
                        <button type="button" class="btn-mini btn-danger" disabled="@Busy" @onclick="() => OnDelete.InvokeAsync(k.Id)">Delete</button>
                    } else {
                        @if (!k.Revoked) {
                            <button type="button" class="btn-mini btn-danger" disabled="@Busy" @onclick="() => OnRevoke.InvokeAsync(k.Id)">Revoke</button>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</TableScroll>

@code {
    [Parameter] [EditorRequired] public List<ApiKeyRow> Rows { get; set; } = [];
    [Parameter] public bool ShowOwner { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] [EditorRequired] public EventCallback<long> OnRevoke { get; set; }
    [Parameter] public EventCallback<long> OnDelete { get; set; }
}
