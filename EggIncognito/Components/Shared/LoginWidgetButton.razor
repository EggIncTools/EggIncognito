@rendermode @(RenderModes.InteractiveServer)
@inject AuthState Auth
@inject NavigationManager Nav
@inject IdentityApiClient Identity
@using EggIdentity.Client

@if (!Auth.WidgetEnabled) {
    <span class="@CssClass auth-unavailable">Login unavailable (identity service not configured)</span>
} else {
    <div class="auth-source-anchor">
        <button type="button" class="@CssClass" @onclick="Toggle" disabled="@_loading">
            @(_loading ? "Loading..." : Label)
        </button>
        @if (_sources is not null || _error is not null) {
            <span class="popover-backdrop" @onmousedown="Close"></span>
        }
        @if (_sources is not null) {
            <div class="@MenuCss">
                @foreach (var s in _sources) {
                    <a class="auth-source-btn" href="@Abs(s.Url)">
                        @if (!string.IsNullOrEmpty(s.IconUrl)) {
                            <img class="auth-source-logo" src="@Abs(s.IconUrl)" alt="" width="16" height="16"/>
                        }
                        <span>@s.Name</span>
                    </a>
                }
            </div>
        } else if (_error is not null) {
            <div class="@MenuCss">
                <p class="auth-source-error">@_error</p>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string CssClass { get; set; } = "btn-primary";
    [Parameter] public string Label { get; set; } = "Log in";
    [Parameter] public LoginMenuPlacement Placement { get; set; } = LoginMenuPlacement.BottomRight;

    private IReadOnlyList<LoginSourceResponse>? _sources;
    private bool _loading;
    private string? _error;

    private string Abs(string url) {
        return !url.StartsWith('/') || string.IsNullOrEmpty(Auth.IdentityHostUrl)
            ? url
            : $"{Auth.IdentityHostUrl!.TrimEnd('/')}{url}";
    }

    private string MenuCss => $"auth-source-menu auth-place-{Placement.ToString().ToLowerInvariant()}";

    private void Close() {
        _sources = null;
        _error = null;
    }

    private async Task Toggle() {
        if (_sources is not null || _error is not null) {
            Close();
            return;
        }

        _loading = true;
        try {
            var resp = await Identity.GetLoginSourcesAsync(Nav.Uri, CancellationToken.None);
            if (resp.Sources.Count == 0)
                _error = "No login providers configured.";
            else
                _sources = resp.Sources;
        } catch (Exception) {
            _error = "Login temporarily unavailable.";
        } finally {
            _loading = false;
        }
    }

}
