@* Contributor edit surface for a subject's Markdown doc: a source textarea, a live preview, and a
   formatting toolbar. Saves through POST /api/docs/doc and uploads images through POST /api/docs/image.
   Blazor cannot read a textarea's selection without JS interop, so toolbar buttons append their markdown
   token to the value instead of wrapping the selection. *@
@using System.Net.Http.Headers
@using System.Text.Json
@inherits SelfCallComponentBase
@inject ICurrentUser User
@inject ToastService Toasts

@if (_canEdit) {
    <div class="md-editor">
        <div class="md-toolbar">
            @foreach (var b in Buttons) {
                <button type="button" class="md-tb-btn" aria-label="@b.Title" @onclick="() => Insert(b.Token)">@b.Label</button>
            }
            <label class="md-tb-btn">
                upload
                <InputFile accept="image/png,image/jpeg,image/gif,image/webp" hidden="hidden" OnChange="OnImagePicked"/>
            </label>
            <span class="md-editor-spacer"></span>
            @if (OnCancel.HasDelegate) {
                <button type="button" class="btn-mini" disabled="@_busy" @onclick="Cancel">Cancel</button>
            }
            <button type="button" class="btn-primary" disabled="@_busy" @onclick="Save">Save</button>
        </div>
        <textarea class="md-source" spellcheck="false" value="@_value" @oninput="OnInput"></textarea>
        <div class="md-preview-wrap">
            <div class="md-preview-label">Preview</div>
            <Markdown Body="@_value" CssClass="md-preview"/>
        </div>
    </div>
}

@code {
    [Parameter] public string Kind { get; set; } = "";
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public string? Initial { get; set; }
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    const long MaxImageBytes = 5 * 1024 * 1024;
    static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    static readonly (string Label, string Title, string Token)[] Buttons = [
        ("B", "Bold", "**bold**"),
        ("I", "Italic", "*italic*"),
        ("</>", "Code", "`code`"),
        ("H", "Heading", "\n## "),
        ("-", "List item", "\n- "),
        (">", "Callout / gotcha", "\n> "),
        ("link", "Link", "[text](https://)"),
        ("img url", "Image by URL", "![alt](https://)")
    ];

    bool _canEdit;
    bool _busy;
    string _value = "";
    string? _seeded;
    bool _dirty;

    protected override void OnInitialized() {
        base.OnInitialized();
        _canEdit = User.IsAtLeast(UserRole.Contributor);
    }

    protected override void OnParametersSet() {
        if (!_dirty && Initial != _seeded) {
            _value = Initial ?? "";
            _seeded = Initial;
        }
    }

    void OnInput(ChangeEventArgs e) {
        _value = e.Value?.ToString() ?? "";
        _dirty = true;
    }

    void Insert(string token) {
        _value += token;
        _dirty = true;
    }

    void SetStatus(string message, StatusNoteKind kind) {
        Toasts.Push(kind, message);
    }

    Task Cancel() {
        _value = Initial ?? "";
        _dirty = false;
        return OnCancel.InvokeAsync();
    }

    async Task Save() {
        _busy = true;
        try {
            var res = await Client().PostAsJsonAsync("/api/docs/doc",
                new { subjectKind = Kind, subjectKey = Key, bodyMd = _value }, JsonOpts);
            if (res.IsSuccessStatusCode) {
                SetStatus(string.IsNullOrWhiteSpace(_value) ? "Cleared." : "Saved.", StatusNoteKind.Ok);
                if (OnSaved.HasDelegate) await OnSaved.InvokeAsync(_value);
            } else {
                SetStatus((int)res.StatusCode == 403 ? "Not authorized."
                    : (int)res.StatusCode == 503 ? "No database configured."
                    : $"HTTP {(int)res.StatusCode}", StatusNoteKind.Error);
            }
        }
        catch (Exception ex) {
            SetStatus($"Save failed: {ex.Message}", StatusNoteKind.Error);
        }
        finally {
            _busy = false;
        }
    }

    async Task OnImagePicked(InputFileChangeEventArgs e) {
        if (e.FileCount == 0) return;
        var file = e.File;
        _dirty = true;
        _busy = true;
        SetStatus($"Uploading {file.Name}...", StatusNoteKind.Busy);
        try {
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(MaxImageBytes);
            var part = new StreamContent(stream);
            if (!string.IsNullOrEmpty(file.ContentType))
                part.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(part, "file", file.Name);
            var res = await Client().PostAsync("/api/docs/image", content);
            if (res.IsSuccessStatusCode) {
                var data = await res.Content.ReadFromJsonAsync<Models.Docs.ImageResult>(JsonOpts);
                _value += $"\n![{file.Name}]({data?.Url})\n";
                SetStatus("Image inserted.", StatusNoteKind.Ok);
            } else {
                var msg = (int)res.StatusCode == 403 ? "not authorized"
                    : (int)res.StatusCode == 503 ? "no database" : $"HTTP {(int)res.StatusCode}";
                _value += $"\n*(image upload failed: {msg})*\n";
                SetStatus($"Upload failed: {msg}", StatusNoteKind.Error);
            }
        }
        catch (Exception ex) {
            _value += $"\n*(image upload failed: {ex.Message})*\n";
            SetStatus($"Upload failed: {ex.Message}", StatusNoteKind.Error);
        }
        finally {
            _busy = false;
        }
    }

}
