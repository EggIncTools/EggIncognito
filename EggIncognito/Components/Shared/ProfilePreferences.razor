@using EggIdentity.Client
@inject IServiceProvider Services
@inject ToastService Toasts

<div class="prof-prefs">
    <div class="sub-section-head">Preferences</div>
    @if (_identity is null) {
        <p class="text-muted text-xs m-0">Preferences need the identity service.</p>
    } else {
        <div class="prof-prefs-grid">
            <label class="theme-field">
                <span>Time zone</span>
                <TimeZonePicker Value="@_timezone" ValueChanged="OnTimezone"/>
            </label>
            <label class="theme-field">
                <span>Language</span>
                <LanguagePicker Value="@_language" ValueChanged="OnLanguage"/>
            </label>
        </div>
        <p class="text-muted text-xs m-0">
            Shared with every app that signs you in through EggIdentity.
            Will also take effect in other EggIdentity apps (e.g.,
            <a href="@EggLedgerUrl" target="_blank" rel="noopener noreferrer">EggLedger</a>).
        </p>
        <div class="theme-picker-actions">
            <button type="button" class="btn-mini" disabled="@(_busy || !Dirty)" @onclick="Save">
                @(_busy ? "Saving..." : "Save preferences")
            </button>
        </div>
    }
</div>

@code {
    const string EggLedgerUrl = "https://eggledger.egginc.tools";

    [Parameter] [EditorRequired] public string SessionToken { get; set; } = "";

    [Parameter] public EventCallback OnChanged { get; set; }

    IdentityApiClient? _identity;
    string _timezone = "";
    string _language = "";
    string _savedTimezone = "";
    string _savedLanguage = "";
    bool _busy;

    bool Dirty => _timezone != _savedTimezone || _language != _savedLanguage;

    protected override async Task OnInitializedAsync() {
        _identity = Services.GetService(typeof(IdentityApiClient)) as IdentityApiClient;
        if (_identity is null || SessionToken.Length == 0) return;
        try {
            var profile = await _identity.GetProfileAsync(SessionToken, CancellationToken.None);
            _savedTimezone = _timezone = profile?.Timezone ?? "";
            _savedLanguage = _language = profile?.Language ?? "";
        } catch (HttpRequestException) {
            SetMessage("Could not read your preferences.", StatusNoteKind.Error);
        }
    }

    void OnTimezone(string? value) {
        _timezone = value ?? "";
    }

    void OnLanguage(string? value) {
        _language = value ?? "";
    }

    async Task Save() {
        if (_identity is null) return;
        _busy = true;
        bool ok;
        try {
            ok = await _identity.SetPreferencesAsync(SessionToken, _timezone, _language, null, CancellationToken.None);
        } catch (HttpRequestException) {
            ok = false;
        }

        _busy = false;
        if (!ok) {
            SetMessage("Could not save your preferences.", StatusNoteKind.Error);
            return;
        }

        _savedTimezone = _timezone;
        _savedLanguage = _language;
        SetMessage("Preferences saved.", StatusNoteKind.Ok);
        await OnChanged.InvokeAsync();
    }

    void SetMessage(string message, StatusNoteKind kind) {
        Toasts.Push(kind, message);
    }

}
