@using EggIncognito.Core.Services.Devices
@inject IEnumerable<IDevicePanel> Panels

@if (Panels.FirstOrDefault(p => p.Shelf == DevicePanelShelves.Replace(Id)) is { } panel) {
    <DynamicComponent Type="panel.ComponentType" Parameters="Parameters"/>
} else {
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public Dictionary<string, object?>? Parameters { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
