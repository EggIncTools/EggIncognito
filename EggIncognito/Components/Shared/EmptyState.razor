<div class="empty-state @(Fill ? "empty-fill" : "") @(Tall ? "empty-tall" : "") @Class">
    @if (Icon is { Length: > 0 }) {
        <Icon Name="@Icon" Class="empty-icon"/>
    }
    @ChildContent
    @if (Hint is not null) {
        <div class="empty-hint">@Hint</div>
    }
</div>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Fill { get; set; }
    [Parameter] public bool Tall { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Hint { get; set; }
}
