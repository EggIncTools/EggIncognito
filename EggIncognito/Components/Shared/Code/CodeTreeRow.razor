@using EggIncognito.Components.Capture
@using EggIncognito.Core.Services.Syntax
@if (FlattenRoot) {
    <div class="jtree-flat">
        @ChildRows()
    </div>
} else if (!Hidden) {
    <div class="jtree-node @(IsRoot ? "jtree-root" : "") @(Node.Expanded ? "jtree-expanded" : "") @(Node.Dim ? "jtree-dim" : "") @(Node.SelfMatch ? "jtree-match" : "")">
        <div class="jtree-row" @onclick="ToggleRow">
            <span class="jtree-caret @(Node.IsContainer ? "caret" : "jtree-caret-leaf") @(Node.IsContainer && Node.Expanded ? "open" : "")"></span>
            @if (Node.KeyText is not null) {
                <span class="jtree-key">
                    <SpanText Text="@Node.KeyText" Spans="@Marks(Node.KeyText)"/>
                </span>
                <span class="jtree-colon">: </span>
            }
            @if (Node.IsContainer) {
                <span class="jtree-summary">@SummaryText</span>
            } else {
                @LeafSpan()
            }
        </div>
        @if (Node.IsContainer && Node.Expanded) {
            <div class="jtree-children">
                @ChildRows()
            </div>
        }
    </div>
}

@code {
    [Parameter] public CodeTreeNode Node { get; set; } = default!;
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public bool IsRoot { get; set; }
    [Parameter] public CodeRevealState? Reveal { get; set; }

    const int RowPage = 200;

    bool _clampOpen;
    string[] _needle = [];
    CodeRevealState? _ownReveal;
    int _shown = RowPage;

    CodeRevealState RevealState => Reveal ?? (_ownReveal ??= new CodeRevealState());

    bool Hidden => Search.Length > 0 && Node.Dim;

    string SummaryText => Search.Length > 0
        ? $"{Node.Summary}, {Node.Children.Count(c => !c.Dim)} matching"
        : Node.Summary;

    RenderFragment ChildRows() => builder => {
        IReadOnlyList<CodeTreeNode> visible = Search.Length > 0 ? [.. Node.Children.Where(c => !c.Dim)] : Node.Children;
        var count = Math.Min(_shown, visible.Count);
        for (var i = 0; i < count; i++) {
            builder.OpenComponent<CodeTreeRow>(0);
            builder.SetKey(visible[i]);
            builder.AddComponentParameter(1, nameof(Node), visible[i]);
            builder.AddComponentParameter(2, nameof(View), View);
            builder.AddComponentParameter(3, nameof(Search), Search);
            builder.AddComponentParameter(4, nameof(Reveal), Reveal);
            builder.CloseComponent();
        }

        if (visible.Count <= count) return;
        builder.OpenElement(5, "button");
        builder.AddAttribute(6, "type", "button");
        builder.AddAttribute(7, "class", "btn-mini jtree-more");
        builder.AddAttribute(8, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => _shown += RowPage));
        builder.AddContent(9, $"Show {Math.Min(RowPage, visible.Count - count)} more of {visible.Count - count}");
        builder.CloseElement();
    };

    void ToggleRow() {
        if (Node.IsContainer) Node.Expanded = !Node.Expanded;
    }

    bool FlattenRoot => IsRoot && Node.IsContainer && Node.DescendantCount <= CodeTreeNode.SmallChildLimit;

    bool IsEmptyLeaf => Node.Kind == "string" && Node.LeafText == "\"\"";

    bool IsSensitive => View.IsSensitiveKey(Node.KeyName) && !IsEmptyLeaf;

    string RevealKey => Node.KeyName + ":" + Node.LeafText;

    string LeafDisplay() {
        var full = Node.LeafText;
        var searching = Search.Length > 0;
        if (Node.Kind == "string" && full.Length > CodeTreeNode.ValueClamp + 2 && !_clampOpen && !searching) {
            var inner = full.Substring(1, Math.Min(CodeTreeNode.ValueClamp, full.Length - 2));
            return "\"" + inner + "...\"";
        }

        return full;
    }

    bool IsClamped =>
        Node.Kind == "string" && Node.LeafText.Length > CodeTreeNode.ValueClamp + 2;

    IReadOnlyList<Span> Marks(string? text) {
        if (Search.Length == 0 || string.IsNullOrEmpty(text)) return TextSpans.Empty;
        return TextSpans.Find(text, _needle, TokenClasses.Mark);
    }

    protected override void OnParametersSet() {
        _needle = Search.Length > 0 ? [Search] : [];
    }

    RenderFragment LeafSpan() {
        return builder => {
            var clamped = IsClamped;
            var sensitive = IsSensitive;
            var cls = "jv " + Node.TokenClass;
            if (clamped) cls += " jv-clamped";
            if (_clampOpen) cls += " jv-open";
            if (sensitive) cls += " " + RevealState.Class(RevealKey);

            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", cls);
            if (clamped || sensitive) {
                builder.AddAttribute(2, "title", sensitive ? "Click to reveal" : "Click to expand");
                builder.AddAttribute(3, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, OnLeafClick));
                builder.AddEventStopPropagationAttribute(4, "onclick", true);
            }

            builder.OpenComponent<SpanText>(5);
            builder.AddComponentParameter(6, nameof(SpanText.Text), LeafDisplay());
            builder.AddComponentParameter(7, nameof(SpanText.Spans), Marks(LeafDisplay()));
            builder.CloseComponent();
            builder.CloseElement();
        };
    }

    void OnLeafClick() {
        if (IsSensitive) RevealState.Toggle(RevealKey);
        else if (IsClamped) _clampOpen = !_clampOpen;
    }

}
