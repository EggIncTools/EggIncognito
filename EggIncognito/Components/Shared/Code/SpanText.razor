@using EggIncognito.Core.Services.Syntax
@using Microsoft.AspNetCore.Components.Rendering
@Content

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public IReadOnlyList<Span>? Spans { get; set; }
    [Parameter] public EventCallback<string> OnSegmentClick { get; set; }
    [Parameter] public string ClickClass { get; set; } = TokenClasses.Blur;
    [Parameter] public string? ClickTitle { get; set; } = "Click to reveal";

    RenderFragment Content => builder => Emit(builder, Text, Spans, OnSegmentClick.HasDelegate && ClickClass.Length > 0 ? this : null);

    public static RenderFragment Plain(string? text, IReadOnlyList<Span>? spans) => builder => Emit(builder, text, spans, null);

    static void Emit(RenderTreeBuilder builder, string? value, IReadOnlyList<Span>? spans, SpanText? clicks) {
        var text = value ?? "";
        if (text.Length == 0) return;
        var seq = 0;
        foreach (var seg in TextSpans.Slice(text, spans)) {
            var body = text.Substring(seg.Start, seg.Length);
            if (seg.Class is null) {
                builder.AddContent(seq++, body);
                continue;
            }

            if (seg.Class == TokenClasses.Mark) {
                builder.OpenElement(seq++, "mark");
                builder.AddContent(seq++, body);
                builder.CloseElement();
                continue;
            }

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", seg.Class);
            if (clicks is not null && seg.Class.Contains(clicks.ClickClass, StringComparison.Ordinal)) {
                builder.AddAttribute(seq++, "title", clicks.ClickTitle);
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(clicks, () => clicks.OnSegmentClick.InvokeAsync(body)));
                builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
            }

            builder.AddContent(seq++, body);
            builder.CloseElement();
        }
    }

}
