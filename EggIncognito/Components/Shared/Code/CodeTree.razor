@using EggIncognito.Components.Capture
@implements IDisposable

<div class="code-surface jtree-viewer @(_needle.Length > 0 ? "jtree-searching" : "")" style="@RootStyle">
    <div class="code-toolbar">
        @Tools
        <button class="btn-mini" type="button" @onclick="ExpandAll">Expand all</button>
        <button class="btn-mini" type="button" @onclick="CollapseAll">Collapse all</button>
        <FilterInput Class="jtree-search" Placeholder="Filter keys" AriaLabel="Filter keys and values"
                     Value="@_search" ValueChanged="OnSearchInput"/>
        <span class="jtree-search-count">@_count</span>
        @Actions
        @if (CopyText is not null) {
            <CopyButton GetText="CopyText" ButtonClass="btn-mini data-copy" IconClass="icon-sm"
                        Label="Copy" CopiedLabel="Copied"/>
        }
    </div>
    @if (Root is not null) {
        <CodeTreeRow Node="Root" View="View" Search="@_needle" IsRoot="true" Reveal="RevealState"/>
    }
</div>

@code {
    [Parameter] public CodeTreeNode? Root { get; set; }
    [Parameter] public CaptureViewState View { get; set; } = new();
    [Parameter] public RenderFragment? Tools { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public Func<string>? CopyText { get; set; }
    [Parameter] public CodeRevealState? Reveal { get; set; }
    [Parameter] public string MaxHeight { get; set; } = "";

    readonly CodeRevealState _ownReveal = new();

    string _search = "";
    string _needle = "";
    string _count = "";
    CancellationTokenSource? _debounceCts;

    CodeRevealState RevealState => Reveal ?? _ownReveal;

    string? RootStyle => string.IsNullOrEmpty(MaxHeight) ? null : $"--jtree-max-h:{MaxHeight}";

    async Task OnSearchInput(string value) {
        _search = value;
        var previous = _debounceCts;
        var cts = _debounceCts = new CancellationTokenSource();
        previous?.Cancel();
        previous?.Dispose();
        try {
            await Task.Delay(250, cts.Token);
        }
        catch (TaskCanceledException) {
            return;
        }

        ApplySearch(_search);
    }

    public void Dispose() {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
    }

    void ExpandAll() {
        _debounceCts?.Cancel();
        _search = "";
        _needle = "";
        _count = "";
        if (Root is null) return;
        SetExpansion(Root, true);
        ClearMarks(Root);
    }

    void CollapseAll() {
        _debounceCts?.Cancel();
        _search = "";
        _needle = "";
        _count = "";
        if (Root is null) return;
        ClearMarks(Root);
        SetExpansion(Root, false);
        Root.Expanded = true;
    }

    static void SetExpansion(CodeTreeNode node, bool expand) {
        if (node.IsContainer) node.Expanded = expand;
        foreach (var c in node.Children) SetExpansion(c, expand);
    }

    static void ClearMarks(CodeTreeNode node) {
        node.Dim = false;
        node.SelfMatch = false;
        foreach (var c in node.Children) ClearMarks(c);
    }

    void ApplySearch(string query) {
        var needle = query.Trim().ToLowerInvariant();
        if (needle == _needle && Root is not null) return;
        _needle = needle;
        if (Root is null) return;
        if (needle.Length == 0) {
            ResetToDefault(Root);
            _count = "";
            return;
        }

        var matches = 0;

        foreach (var c in Root.Children) Visit(c, needle, ref matches);
        Root.Dim = false;
        Root.SelfMatch = false;
        if (Root.IsContainer) Root.Expanded = true;
        _count = matches + (matches == 1 ? " match" : " matches");
    }

    static bool Visit(CodeTreeNode node, string needle, ref int matches) {
        var selfMatch = false;
        if (node.KeyTextLower is not null && node.KeyTextLower.Contains(needle))
            selfMatch = true;
        if (!node.IsContainer && node.LeafTextLower.Contains(needle))
            selfMatch = true;

        var childMatch = false;
        foreach (var c in node.Children)
            if (Visit(c, needle, ref matches))
                childMatch = true;

        var matched = selfMatch || childMatch;
        node.SelfMatch = selfMatch;
        if (selfMatch) matches++;
        if (childMatch && node.IsContainer) node.Expanded = true;
        node.Dim = !matched;
        return matched;
    }

    static void ResetToDefault(CodeTreeNode node) {
        if (node.IsContainer) node.Expanded = node.ShouldDefaultExpand();
        node.Dim = false;
        node.SelfMatch = false;
        foreach (var c in node.Children) ResetToDefault(c);
    }

}
