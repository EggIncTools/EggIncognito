@using EggIncognito.Services.Feed

<div class="tpl-editor">
    @if (Label is { Length: > 0 } || Hint is { Length: > 0 }) {
        <div class="tpl-bar">
            @if (Label is { Length: > 0 }) {
                <span class="tpl-label">@Label</span>
            }
            @if (Hint is { Length: > 0 }) {
                <span class="tpl-hint">@Hint</span>
            }
        </div>
    }
    <div class="tpl-main">
        <textarea class="tpl-area" rows="@Rows" spellcheck="false" aria-label="@(Label is { Length: > 0 } ? Label : "Message")"
                  value="@Value" @oninput="OnInput"></textarea>
        @if (Tokens.Count > 0) {
            <div class="tpl-tokens">
                <span class="tpl-tokens-head">Variables</span>
                <ul class="tpl-token-list">
                    @foreach (var token in Tokens) {
                        <li>
                            <button type="button" class="tpl-token" @onclick="@(() => Insert(token.Name))">
                                <span class="tpl-token-name">@token.Label</span>
                                @if (token.Example is { Length: > 0 }) {
                                    <span class="tpl-token-ex">(@token.Example)</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
    @if (Unknown() is { Count: > 0 } unknown) {
        <div class="tpl-warn">
            @(unknown.Count == 1 ? "Unknown variable" : "Unknown variables"): @string.Join(", ", unknown.Select(Wrap))
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<FeedVarInfo> Tokens { get; set; } = [];
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public int Rows { get; set; } = 4;

    int? _caret;

    static string Wrap(string name) {
        return "{{" + name + "}}";
    }

    List<string> Unknown() {
        var missing = new List<string>();
        foreach (var name in FeedTemplate.Tokens(Value)) {
            if (!Tokens.Any(t => string.Equals(t.Name, name, StringComparison.Ordinal))) missing.Add(name);
        }

        return missing;
    }

    Task OnInput(ChangeEventArgs e) {
        var next = e.Value?.ToString() ?? "";
        _caret = EditEnd(Value ?? "", next);
        return ValueChanged.InvokeAsync(next);
    }

    static int EditEnd(string before, string after) {
        int suffix = 0;
        while (suffix < before.Length && suffix < after.Length && before[^(suffix + 1)] == after[^(suffix + 1)]) suffix++;
        return after.Length - suffix;
    }

    Task Insert(string name) {
        var token = Wrap(name);
        var text = Value ?? "";
        int at = Math.Clamp(_caret ?? text.Length, 0, text.Length);
        _caret = at + token.Length;
        return ValueChanged.InvokeAsync(text.Insert(at, token));
    }

}
