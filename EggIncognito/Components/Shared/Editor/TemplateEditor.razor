@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<TemplateEditor> Logger
@using EggIncognito.Services.Feed
@implements IAsyncDisposable

<div class="tpl-editor">
    @if (Label is { Length: > 0 } || Hint is { Length: > 0 }) {
        <div class="tpl-bar">
            @if (Label is { Length: > 0 }) {
                <span class="tpl-label">@Label</span>
            }
            @if (Hint is { Length: > 0 }) {
                <span class="tpl-hint">@Hint</span>
            }
        </div>
    }
    <div class="tpl-main">
        <textarea class="tpl-area" rows="@Rows" spellcheck="false" aria-label="@(Label is { Length: > 0 } ? Label : "Message")"
                  value="@Value" @oninput="OnInput" @ref="_area"></textarea>
        @if (Tokens.Count > 0) {
            <div class="tpl-tokens">
                <span class="tpl-tokens-head">Variables</span>
                <ul class="tpl-token-list">
                    @foreach (var token in Tokens) {
                        <li>
                            <button type="button" class="tpl-token" @onclick="@(() => Insert(token.Name))">
                                <span class="tpl-token-name">@token.Label</span>
                                @if (token.Example is { Length: > 0 }) {
                                    <span class="tpl-token-ex">(@token.Example)</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
    @if (Unknown() is { Count: > 0 } unknown) {
        <div class="tpl-warn">
            @(unknown.Count == 1 ? "Unknown variable" : "Unknown variables"): @string.Join(", ", unknown.Select(Wrap))
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<FeedVarInfo> Tokens { get; set; } = [];
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public int Rows { get; set; } = 4;

    ElementReference _area;
    IJSObjectReference? _module;

    static string Wrap(string name) {
        return "{{" + name + "}}";
    }

    List<string> Unknown() {
        var missing = new List<string>();
        foreach (var name in FeedTemplate.Tokens(Value)) {
            if (!Tokens.Any(t => string.Equals(t.Name, name, StringComparison.Ordinal))) missing.Add(name);
        }

        return missing;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || _module is not null) return;
        try {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", InteropAsset.Url(Env, "./interop/caretInsert.js"));
        } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
            Logger.LogDebug(ex, "caret insert interop could not be loaded");
        }
    }

    Task OnInput(ChangeEventArgs e) {
        return ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }

    async Task Insert(string name) {
        var token = Wrap(name);
        var next = (Value ?? "") + token;
        if (_module is not null) {
            try {
                next = await _module.InvokeAsync<string>("insert", _area, token);
            } catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException) {
                Logger.LogDebug(ex, "caret insert failed, appending instead");
                next = (Value ?? "") + token;
            }
        }

        await ValueChanged.InvokeAsync(next);
    }

    public ValueTask DisposeAsync() {
        return _module.DisposeModuleQuietAsync(null, Logger);
    }

}
