@using EggIncognito.Services.Artifacts
@inject CraftProgressLoader Progress

<div class="acct-eid">
    <SubSectionHead>Egg Inc accounts</SubSectionHead>
    <EggIdentity.UI.Suite.SuiteEidEditor ValidateAsync="ValidateAsync"/>
    <Note Small="true">Shared with every EggInc.tools app. The active account is the one their tools load.</Note>
</div>

@code {
    async Task<EidSnapshot?> ValidateAsync(string eid) {
        var progress = await Progress.LoadAsync(eid, CancellationToken.None);
        return progress?.Snapshot ?? throw new InvalidOperationException("No backup was found for that EID.");
    }

}
