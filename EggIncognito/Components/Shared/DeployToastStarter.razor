@using EggIdentity.Deploy.AdminUi
@rendermode @(RenderModes.InteractiveServer)
@inject IServiceProvider Services
@inject ILogger<DeployToastStarter> Logger

@code {

    protected override void OnInitialized() {
        try {
            Services.GetService<DeployToastBridge>()?.Start();
        } catch (Exception ex) {
            Logger.LogError(ex, "the deploy toast bridge could not start");
        }
    }

}
