@inherits LayoutComponentBase
@using EggIdentity.Consent
@using EggIdentity.Visits
@using EggIncognito.Startup
@inject AuthState Auth
@inject IHttpContextAccessor HttpContextAccessor
@inject BootFlags Boot
<CircuitGuard Name="Page" Scope="FaultScope.Page">@Body</CircuitGuard>
@if (Boot.DbEnabled) {
    <VisitCounter/>
}
<ToastHost @rendermode="RenderModes.InteractiveServer"/>
<EggIncognito.Components.Theme.ViewerThemeStyle @rendermode="RenderModes.InteractiveServer"/>
<DownloadSink @rendermode="RenderModes.InteractiveServer"/>
<DeployToastStarter/>
<div class="egi-consent">
    <CookieBanner SessionToken="@SessionToken" PrivacyUrl="/privacy" TermsUrl="/terms" @rendermode="RenderModes.InteractiveServer"/>
</div>

@code {

    string? SessionToken {
        get {
            string token = HttpContextAccessor.HttpContext?.Request.Cookies[Auth.SessionCookieName] ?? "";
            return token.Length == 0 ? null : token;
        }
    }

}
