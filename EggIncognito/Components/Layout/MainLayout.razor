@inherits LayoutComponentBase
@using EggIdentity.Consent
@using EggIdentity.Visits
@using EggIncognito.Startup
@inject AuthState Auth
@inject IHttpContextAccessor HttpContextAccessor
@inject BootFlags Boot
@Body
@if (Boot.DbEnabled) {
    <VisitCounter/>
}
<ToastHost @rendermode="RenderModes.InteractiveServer"/>
<EggIncognito.Components.Theme.ViewerThemeStyle @rendermode="RenderModes.InteractiveServer"/>
<DownloadSink @rendermode="RenderModes.InteractiveServer"/>
<DeployToastStarter/>
<CookieBanner SessionToken="@SessionToken" PrivacyUrl="/privacy" @rendermode="RenderModes.InteractiveServer"/>
<footer id="siteFooter" class="site-footer">
    <div class="site-footer-inner">
        <p class="site-footer-disclaimer">
            EggIncognito is an independent, fan-made tool and is not affiliated with, endorsed by, or
            sponsored by Auxbrain Inc. Egg, Inc. and related marks are the property of their respective owners.
        </p>
        <span class="site-footer-sep" aria-hidden="true"></span>
        <nav class="site-footer-links">
            <a href="/terms" class="site-footer-link">Terms</a>
            <span class="site-footer-pipe">|</span>
            <a href="/privacy" class="site-footer-link">Privacy &amp; Cookies</a>
            <span class="site-footer-pipe">|</span>
            <a href="https://github.com/EggIncTools/EggIncognito/blob/main/LICENSE" target="_blank" rel="noopener" class="site-footer-link">MIT License</a>
            <span class="site-footer-pipe">|</span>
            <span class="site-footer-copy">© 2026 David Cole</span>
        </nav>
    </div>
</footer>

@code {

    string? SessionToken {
        get {
            string token = HttpContextAccessor.HttpContext?.Request.Cookies[Auth.SessionCookieName] ?? "";
            return token.Length == 0 ? null : token;
        }
    }

}
