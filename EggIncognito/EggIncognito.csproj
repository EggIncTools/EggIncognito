<Project Sdk="Microsoft.NET.Sdk.Web" InitialTargets="SyncFixtures;BuildStyles">
  <PropertyGroup>
    <UserSecretsId>e7aa6a77-af5b-41a6-90e6-4d9b1e792645</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EggIdentity.Bot.AdminUi" />
    <PackageReference Include="EggIdentity.AdminUi" />
    <PackageReference Include="EggIdentity.Deploy" />
    <PackageReference Include="EggIdentity.Deploy.AdminUi" />
    <PackageReference Include="EggIdentity.Fallback" />
    <PackageReference Include="EggIdentity.Metrics" />
    <PackageReference Include="EggIdentity.Metrics.AdminUi" />
    <PackageReference Include="EggIdentity.Settings" />
    <PackageReference Include="EggIdentity.Settings.AdminUi" />
    <PackageReference Include="EggIdentity.Settings.Store" />
    <PackageReference Include="EggIdentity.Styles" />
    <PackageReference Include="EggIdentity.UI" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIncognito.Core\EggIncognito.Core.csproj" />
    <ProjectReference Include="..\EggIncognito.GameData\EggIncognito.GameData.csproj" />
    <ProjectReference Include="..\EggIncognito.Capture\EggIncognito.Capture.csproj" />
    <ProjectReference Include="..\EggIncognito.Data\EggIncognito.Data.csproj" />
    <ProjectReference Include="..\EggIncognito.Bot\EggIncognito.Bot.csproj" />
    <ProjectReference Include="..\EggIncognito.RouteGenerator\EggIncognito.RouteGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="RouteMap\routes.yaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DeviceTools\ios\frida\*.js" />
  </ItemGroup>

  <ItemGroup>
    <_StylesInput Include="Styles\app.v4.css" />
    <_StylesInput Include="Components\**\*.razor" />
    <_StylesInput Include="wwwroot\**\*.js" />
    <_StylesInput Include="wwwroot\**\*.html" />
    <_StylesInput Include="**\*.cs" Exclude="bin\**;obj\**;Tests\**" />
    <_StylesInput Include="..\EggIncognito.Core\Services\MarkdownRenderer.cs" Condition="Exists('..\EggIncognito.Core\Services\MarkdownRenderer.cs')" />
    <_StylesInput Include="..\EggIncognito.CssBuild\**\*.cs" Exclude="..\EggIncognito.CssBuild\bin\**;..\EggIncognito.CssBuild\obj\**" />
  </ItemGroup>
  <Target Name="SyncFixtures"
          Condition="'$(SyncFixtures)' != 'false' And '$(EGI_PROD_URL)' != '' And '$(EGI_PROD_API_KEY)' != '' And Exists('$(MSBuildProjectDirectory)/../EggIncognito.FixtureSync/Program.cs')"
          Returns="">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../EggIncognito.FixtureSync&quot; --configuration Release -- &quot;$(MSBuildProjectDirectory)&quot;" ContinueOnError="true" />
  </Target>
  <Target Name="BuildStyles"
          Condition="'$(BuildStylesCss)' != 'false' And Exists('$(MSBuildProjectDirectory)/../EggIncognito.CssBuild/Program.cs')"
          Inputs="@(_StylesInput)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\styles.css"
          Returns="">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../EggIncognito.CssBuild&quot; --configuration Release -- &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>
</Project>
